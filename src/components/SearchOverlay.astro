---
// SearchOverlay.astro — Site-wide search, all pages, zero dependencies
---

<div id="search-overlay" class="search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site search">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-modal">
    <div class="search-header">
      <div class="search-input-wrap">
        <svg class="search-icon-inner" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="Search routes, packages, destinations..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Search"
        />
      </div>
      <button id="search-close" class="search-close" aria-label="Close search">✕</button>
    </div>
    <div class="search-results" id="search-results">
      <div class="search-empty" id="search-empty">
        <p class="search-hint">Try: <span onclick="document.getElementById('search-input').value='mussoorie';window.shriSearch()">Mussoorie</span>, <span onclick="document.getElementById('search-input').value='char dham';window.shriSearch()">Char Dham</span>, <span onclick="document.getElementById('search-input').value='delhi';window.shriSearch()">Delhi</span>, <span onclick="document.getElementById('search-input').value='airport';window.shriSearch()">Airport</span></p>
      </div>
      <div id="search-output" class="search-output" style="display:none"></div>
    </div>
  </div>
</div>

<script is:inline>
