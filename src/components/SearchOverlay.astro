// ── Fuzzy search ──────────────────────────────────────────────
function shriSearch() {
  const q = (document.getElementById('search-input')?.value || '').toLowerCase().trim();
  const output  = document.getElementById('search-output');
  const empty   = document.getElementById('search-empty');
  if (!output || !empty) return;

  if (!q || q.length < 2) {
    output.style.display = 'none';
    empty.style.display  = 'block';
    return;
  }

  const routes   = ROUTES.filter(r => r.search.includes(q)).slice(0, 4);
  const packages = PACKAGES.filter(p => p.search.includes(q)).slice(0, 3);
  const blogs    = BLOGS.filter(b => b.search.includes(q)).slice(0, 2);
  const total    = routes.length + packages.length + blogs.length;

  if (total === 0) {
    // Default: assume Uttarakhand (small villages won't be in any list)
    // Only show "outside UK" for known major non-Uttarakhand cities
    const NON_UTTARAKHAND = [
      'mumbai','delhi','goa','chennai','bangalore','bengaluru','kolkata','hyderabad',
      'pune','ahmedabad','jaipur','lucknow','agra','varanasi','amritsar','surat',
      'bhopal','indore','nagpur','patna','ranchi','bhubaneswar','kochi','coimbatore',
      'chandigarh','shimla','manali','dharamsala','amritsar','jammu','srinagar',
      'leh','ladakh','spiti','gurgaon','noida','faridabad','ghaziabad'
    ];
    const isOutsideUK = NON_UTTARAKHAND.some(p => q.includes(p) || p.includes(q));
    const isUttarakhand = !isOutsideUK;
    const displayQ = q.charAt(0).toUpperCase() + q.slice(1);
    const waNum = '916397321825';
    const waText = encodeURIComponent(`Hi Shri Taxi, I'm looking for a taxi to ${displayQ}. Can you help plan my trip?`);
    if (isUttarakhand) {
      output.innerHTML = `
        <div class="search-unlisted">
          <p class="search-unlisted-msg"><strong>${displayQ}</strong> isn't on our site yet — but our pahadi drivers already know the road. Let's connect and plan your trip.</p>
          <a href="https://wa.me/${waNum}?text=${waText}" target="_blank" rel="noopener" class="search-wa-btn">
            💬 Plan My Trip to ${displayQ} →
          </a>
        </div>`;
    } else {
      output.innerHTML = `
        <div class="search-unlisted">
          <p class="search-unlisted-msg">We serve Uttarakhand routes — Dehradun, Mussoorie, Haridwar, Rishikesh, Char Dham and beyond.</p>
          <a href="/popular-routes" class="search-routes-btn">View All Routes →</a>
        </div>`;
    }
    output.style.display = 'block';
    empty.style.display  = 'none';
    return;
  }

  let html = '';

  if (routes.length) {
    html += `<div class="search-group"><p class="search-group-label">🚗 Routes</p>`;
    routes.forEach(r => {
      html += `<a href="${r.href}" class="search-item" onclick="closeSearch()">
        <span class="search-item-main">${r.from} → ${r.to}</span>
        <span class="search-item-price">${r.price} <span class="search-item-note">one way</span></span>
      </a>`;
    });
    html += '</div>';
  }

  if (packages.length) {
    html += `<div class="search-group"><p class="search-group-label">📦 Packages</p>`;
    packages.forEach(p => {
      html += `<a href="${p.href}" class="search-item" onclick="closeSearch()">
        <span class="search-item-main">${p.name}</span>
        <span class="search-item-price">${p.price} <span class="search-item-note">from</span></span>
      </a>`;
    });
    html += '</div>';
  }

  if (blogs.length) {
    html += `<div class="search-group"><p class="search-group-label">📝 Guides</p>`;
    blogs.forEach(b => {
      html += `<a href="${b.href}" class="search-item" onclick="closeSearch()">
        <span class="search-item-main">${b.title}</span>
        <span class="search-item-badge">Blog</span>
      </a>`;
    });
    html += '</div>';
  }

  output.innerHTML = html;
  output.style.display = 'block';
  empty.style.display  = 'none';
}
window.shriSearch = shriSearch;

// ── Open / Close ──────────────────────────────────────────────
function openSearch() {
  const overlay = document.getElementById('search-overlay');
  const input   = document.getElementById('search-input');
  if (!overlay) return;
  overlay.classList.add('open');
  overlay.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  setTimeout(() => input?.focus(), 50);
}

function closeSearch() {
  const overlay = document.getElementById('search-overlay');
  const input   = document.getElementById('search-input');
  const output  = document.getElementById('search-output');
  const empty   = document.getElementById('search-empty');
  if (!overlay) return;
  overlay.classList.remove('open');
  overlay.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
  if (input)  input.value = '';
  if (output) { output.innerHTML = ''; output.style.display = 'none'; }
  if (empty)  empty.style.display = 'block';
}
window.openSearch  = openSearch;
window.closeSearch = closeSearch;

// ── Event listeners ───────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('search-input')  ?.addEventListener('input', shriSearch);
  document.getElementById('search-close')  ?.addEventListener('click', closeSearch);
  document.getElementById('search-backdrop')?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.key === '/' || (e.metaKey && e.key === 'k')) && !e.target.closest('input,textarea')) {
      e.preventDefault(); openSearch();
    }
  });

  // Wire all search trigger buttons
  document.querySelectorAll('[data-search-trigger]').forEach(btn => {
    btn.addEventListener('click', openSearch);
  });
});
</script>

<style>
/* ── Overlay backdrop ── */
.search-overlay {
  position: fixed; inset: 0; z-index: 9999;
  display: none; align-items: flex-start; justify-content: center;
  padding-top: 60px;
}
.search-overlay.open { display: flex; }
.search-backdrop {
  position: absolute; inset: 0;
  background: rgba(15,23,42,0.7);
  backdrop-filter: blur(4px);
  animation: fadeIn 0.15s ease;
}
@keyframes fadeIn { from { opacity:0 } to { opacity:1 } }

/* ── Modal ── */
.search-modal {
  position: relative; z-index: 1;
  background: #fff;
  border-radius: var(--radius-lg);
  width: 100%; max-width: 640px;
  margin: 0 16px;
  box-shadow: 0 24px 64px rgba(0,0,0,0.2);
  animation: slideDown 0.2s ease;
  overflow: hidden;
}
@keyframes slideDown { from { transform:translateY(-16px); opacity:0 } to { transform:translateY(0); opacity:1 } }

/* ── Header ── */
.search-header {
  display: flex; align-items: center; gap: 8px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  background: #fff;
}
.search-input-wrap {
  flex: 1; display: flex; align-items: center; gap: 10px;
  background: var(--mint);
  border: 1.5px solid var(--teal-light);
  border-radius: var(--radius-md);
  padding: 8px 14px;
}
.search-icon-inner { color: var(--teal); flex-shrink: 0; }
.search-input {
  flex: 1; border: none; background: transparent;
  font-size: 15px; color: var(--slate);
  outline: none; font-family: inherit;
}
.search-input::placeholder { color: var(--muted); }
.search-close {
  width: 36px; height: 36px;
  border: 1.5px solid var(--border); border-radius: var(--radius-md);
  background: #fff; color: var(--muted);
  font-size: 16px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s; flex-shrink: 0;
}
.search-close:hover { background: var(--slate); color: #fff; border-color: var(--slate); }

/* ── Results ── */
.search-results { max-height: 420px; overflow-y: auto; }
.search-empty {
  padding: 24px 20px; text-align: center;
}
.search-hint {
  font-size: 13px; color: var(--muted);
}
.search-hint span {
  color: var(--teal); font-weight: 600; cursor: pointer;
  padding: 2px 8px; background: var(--mint); border-radius: 20px;
  margin: 0 3px;
}
.search-hint span:hover { background: var(--teal); color: #fff; }
.search-output { padding: 8px 0; }

.search-unlisted { padding: 20px; }
.search-unlisted-msg {
  font-size: 14px; color: var(--slate); line-height: 1.7;
  margin-bottom: 14px;
}
.search-wa-btn {
  display: inline-flex; align-items: center; gap: 8px;
  background: #25d366; color: #fff;
  font-size: 14px; font-weight: 600;
  padding: 10px 18px; border-radius: var(--radius-md);
  text-decoration: none; transition: background 0.15s;
}
.search-wa-btn:hover { background: #128c7e; }
.search-routes-btn {
  display: inline-flex; align-items: center;
  background: var(--teal); color: #fff;
  font-size: 13px; font-weight: 600;
  padding: 8px 16px; border-radius: var(--radius-md);
  text-decoration: none; transition: background 0.15s;
}
.search-routes-btn:hover { background: var(--teal-dark, #0f766e); }
.search-no-result {
  padding: 20px; font-size: 14px; color: var(--muted); text-align: center;
}
.search-group { padding: 4px 0; }
.search-group-label {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--muted);
  padding: 8px 20px 4px;
}
.search-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 20px; text-decoration: none; gap: 12px;
  transition: background 0.1s;
  border-left: 3px solid transparent;
}
.search-item:hover {
  background: var(--mint);
  border-left-color: var(--teal);
}
.search-item-main {
  font-size: 14px; font-weight: 600; color: var(--slate); flex: 1;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.search-item-price {
  font-size: 14px; font-weight: 700; color: var(--teal);
  font-family: 'Playfair Display', serif; white-space: nowrap;
}
.search-item-note { font-size: 11px; color: var(--muted); font-family: inherit; font-weight: 400; }
.search-item-badge {
  font-size: 10px; font-weight: 700; color: var(--teal);
  background: var(--mint); padding: 2px 8px; border-radius: 20px;
  white-space: nowrap;
}

@media (max-width: 600px) {
  .search-overlay { padding-top: 0; align-items: flex-end; }
  .search-modal { margin: 0; border-radius: var(--radius-lg) var(--radius-lg) 0 0; max-width: 100%; }
  .search-results { max-height: 60vh; }
}
</style>
