    {id:'mukteshwar',name:`Nainital & Mukteshwar Tour Package`,price:'₹13,999',href:'/packages/mukteshwar',search:'Nainital & Mukteshwar Tour Package mukteshwar'.toLowerCase()},
    {id:'neem-karoli',name:`Neem Karoli Baba Ashram Trip`,price:'₹3,599',href:'/packages/neem-karoli',search:'Neem Karoli Baba Ashram Trip neem-karoli'.toLowerCase()},
    {id:'nainital',name:`Nainital Tour Package`,price:'₹10,999',href:'/packages/nainital',search:'Nainital Tour Package nainital'.toLowerCase()},
