---
import { Image } from 'astro:assets';
import { packages } from '../data/packages';
---

<section id="packages" class="section pkg-section">
  <div class="container">
    <div class="section-title">
      <h2>Tourist Packages</h2>
      <p>Ready-made itineraries with a driver who knows the route.</p>
    </div>

    <div class="grid">
      {packages.map((p) => (
        <article class="card pkg">
          {p.image && (
            <div class="hero">
              <Image src={p.image} alt={p.title} widths={[400, 800, 1200]} sizes="(max-width: 480px) 100vw, (max-width: 900px) 50vw, 33vw" />
            </div>
          )}
          <div class="head">
            <h3>{p.title}</h3>
            <span class="nights">{p.nights === 0 ? 'Day trip' : `${p.nights}N`}</span>
          </div>
          <ul>
            {p.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <!-- <a href="#book" class="cta-link">Enquire →</a> -->
          <a
            href={p.href ?? '#book'}
            class={`cta-link ${p.href ? 'cta-link--page' : ''}`}
            {...(p.href ? {} : {})}
          >
            {p.href ? 'View Package →' : 'Enquire →'}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pkg-section { background: var(--snow); }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .pkg { display: flex; flex-direction: column; overflow: hidden; }
  .hero {
    aspect-ratio: 8 / 5;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .pkg:hover .hero :global(img) {
    transform: scale(1.03);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .head h3 { margin: 0; }
  .nights {
    background: var(--forest-green);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    color: var(--mtn-grey);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  ul li::before { content: '· '; color: var(--gold); }
  .cta-link {
    color: var(--deep-green);
    font-weight: 600;
    margin-top: auto;
    text-decoration: none;
    transition: opacity 0.2s;
  }
   .cta-link:hover {
    opacity: 0.75;
  }
  /* Char Dham and any future dedicated-page packages get a slightly bolder CTA */
  .cta-link--page {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--forest-green);
    font-weight: 700;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
