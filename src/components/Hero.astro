---
import { routePrices, locationMap, surchargeMap, localRates, localPackages, localCities, estimatedRates, approxDistances, longRouteDestinations, customQuoteOnly, airportPerDayRoutes } from '../data/routePrices.ts';
// Serialize at BUILD TIME — injected as plain JSON string, no serialization issues
const priceDataJson = JSON.stringify({
  routePrices,
  locationMap,
  surchargeMap,
  localRates,
  perKmRanges: estimatedRates,
  approxDistances,
  localPackages,
  localCities,
  longRouteDestinations: [...longRouteDestinations],
  cityGroups: [
    ['dehradun','dehradun_station','dehradun_isbt'],
    ['haridwar'],
    ['rishikesh'],
    ['mussoorie'],
    ['dhanaulti'],
    ['tehri'],
  ],
  customQuoteOnly: [...customQuoteOnly],
  airportPerDayRoutes: [...airportPerDayRoutes],
});
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---
<section class="hero" id="home" aria-label="Hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-inner">
    <!-- Left: Headline + CTAs -->
    <div class="hero-content">
      <h1 class="hero-title">Pahadi Roots.<br/>Trusted Routes.</h1>
      <p class="hero-sub">Ride the Himalayan Roads of Devbhoomi with Experienced Local Pahadi Drivers.</p>
      <p class="hero-trust-line">
        <span>Uttarakhand's most loved cab</span>
        <span class="hero-dot">•</span>
        <span>Transparent fares</span>
        <span class="hero-dot">•</span>
        <span>Char Dham specialists</span>
      </p>

      <!-- SEO: crawlable service area — visually hidden but indexed by Google -->
      <p class="seo-context">
         <!-- Shri Taxi provides reliable and affordable taxi service in Dehradun for local travel, airport transfers, outstation trips and Char Dham Yatra packages. Book cab from Dehradun to Mussoorie, Haridwar, Rishikesh, Nainital, Kedarnath, Badrinath, Jolly Grant Airport and all Uttarakhand destinations. Experienced local hill drivers, transparent pricing, no hidden charges. Available 24/7 for airport pickup, railway station transfer and hill station tours.-->
      Shri Taxi provides reliable and affordable taxi service across Uttarakhand — Dehradun, Haridwar, Rishikesh, Mussoorie, Nainital, Auli, Dhanaulti, Kanatal, Tehri and Char Dham Yatra. Book cab from Dehradun to Jolly Grant Airport, Delhi NCR, Chandigarh and all major Uttarakhand destinations. Also serving Delhi to Dehradun, Delhi to Haridwar, Delhi to Rishikesh and Delhi to Char Dham routes. Experienced local pahadi drivers, transparent pricing, no hidden charges. Available 24/7 for airport pickup, railway station transfer, hill station tours and pilgrimages.
      </p>

      <!-- Primary CTAs -->
      <div class="hero-ctas">
        <a href={`tel:${phone}`} class="btn btn-call hero-btn">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.49 12a19.79 19.79 0 01-3.07-8.67A2 2 0 013.4 1.27h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 9a16 16 0 006.29 6.29l1.79-1.79a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          Call Now
        </a>
        <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp hero-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.106.549 4.09 1.508 5.814L.057 23.25l5.561-1.46A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.49-5.191-1.352l-.371-.22-3.301.867.881-3.22-.241-.393A10 10 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          WhatsApp Booking
        </a>

      </div>
    </div>

    <!-- Right: Booking Card -->
    <div class="booking-card" id="booking">
      <div class="booking-card-header">
        <h2 class="booking-title">Book Your Taxi</h2>
        <p class="booking-sub">Fast, Easy &amp; Secure Booking</p>
      </div>

      <!-- Trip type tabs -->
      <div class="trip-tabs" role="tablist">
        <button class="trip-tab active" data-trip="one-way" role="tab" aria-selected="true">One Way</button>
        <button class="trip-tab" data-trip="round-trip" role="tab" aria-selected="false">Round Trip</button>
        <button class="trip-tab" data-trip="local" role="tab" aria-selected="false">Local Hire</button>
        <button class="trip-tab" data-trip="airport" role="tab" aria-selected="false">Airport</button>
      </div>

      <form class="booking-form" id="booking-form" data-wa={wa} novalidate>
        <input type="hidden" name="trip_type" id="trip_type_input" value="one-way" />

        <!-- Local Hire Tab UI (shown only when Local Hire tab active) -->
        <div class="local-tab-ui" id="local-tab-ui">

          <!-- City selector -->
          <div class="form-group">
            <label class="form-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
              Which city are you in?
            </label>
            <div class="local-cities" id="local-cities"></div>
            <input type="hidden" name="local_city" id="local_city_input" />
          </div>

          <!-- Package selector -->
          <div class="form-group">
            <label class="form-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              Choose Package
            </label>
            <div class="local-packages" id="local-packages"></div>
            <input type="hidden" name="local_package" id="local_package_input" />
          </div>

          <!-- Price result for local -->
          <div class="price-result" id="local-price-result" style="display:none;">
            <div class="price-result-inner">
              <div class="price-result-header">
                <span class="price-result-icon">🕐</span>
                <span class="price-result-label" id="local-price-label">Local Hire Rate</span>
              </div>
              <div class="price-result-vehicles" id="local-price-vehicles"></div>
              <p class="price-result-note" id="local-price-note">Driver + Fuel included · Extra km charged beyond package limit</p>
            </div>
          </div>

          <!-- Pickup point -->
          <div class="form-group">
            <label for="local_pickup" class="form-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
              Pickup Point
            </label>
            <input type="text" id="local_pickup" name="local_pickup"
              placeholder="Your hotel, address or landmark"
              class="form-input" autocomplete="off" />
          </div>

          <!-- Sightseeing spots (optional) -->
          <div class="form-group">
            <label for="local_spots" class="form-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Places to visit <span style="font-weight:400;color:var(--muted)">(optional)</span>
            </label>
            <input type="text" id="local_spots" name="local_spots"
              placeholder="e.g. Robber's Cave, Sahastradhara, FRI"
              class="form-input" autocomplete="off" />
          </div>

        </div>

        <!-- Airport Tab UI -->
        <div class="airport-tab-ui" id="airport-tab-ui">

          <!-- Step 1: Journey type -->
          <div class="form-group">
            <label class="form-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Journey Type
            </label>
            <select id="airport_journey" name="airport_journey" class="form-input">
              <option value="">Select Journey Type</option>
              <option value="pickup">📍 Pickup from Airport</option>
              <option value="drop">🚗 Drop to Airport</option>
            </select>
          </div>

          <!-- Step 2: Airport (shown after journey type selected) -->
          <div class="form-group" id="airport-select-group" style="display:none;">
            <label class="form-label" id="airport-select-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Airport
            </label>
            <select id="airport_select" name="airport_select" class="form-input">
              <option value="">Select Airport</option>
              <option value="Jolly Grant Airport (DED)">✈️ Jolly Grant Airport, Dehradun (DED)</option>
              <option value="Delhi Airport (IGI)">✈️ Delhi Airport, IGI (DEL)</option>
              <option value="Chandigarh Airport">✈️ Chandigarh Airport (IXC)</option>
            </select>
          </div>

          <!-- Step 3: Your location (shown after airport selected) -->
          <div class="form-group" id="airport-location-group" style="display:none;">
            <label for="airport_location" class="form-label" id="airport-location-label">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--saffron)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Drop Location
            </label>
            <div class="autocomplete-wrap" id="airport-location-wrap">
              <input type="text" id="airport_location" name="airport_location"
                placeholder="Type your hotel, area or landmark"
                class="form-input autocomplete-input" autocomplete="off" />
              <button type="button" class="ac-clear" id="airport-location-clear" aria-label="Clear">✕</button>
              <div class="ac-dropdown" id="airport-location-dropdown"></div>
            </div>
          </div>

          <!-- Parking note (pickup only) -->
          <p class="airport-info-note" id="airport-parking-note" style="display:none;">
            (* Airport parking charges applicable on pickup)
          </p>

          <!-- Price result -->
          <div class="price-result" id="airport-price-result" style="display:none;">
            <div class="price-result-inner">
              <div class="price-result-header">
                <span class="price-result-icon" id="airport-price-icon">✅</span>
                <span class="price-result-label" id="airport-price-label">Fixed Price</span>
              </div>
              <div class="price-result-vehicles" id="airport-price-vehicles"></div>
              <p class="price-result-note" id="airport-price-note"></p>
            </div>
          </div>

        </div>

        <!-- Pickup -->
        <div class="form-group" id="pickup-group">
          <label for="pickup" class="form-label">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            Pickup Location
          </label>
          <div class="autocomplete-wrap" id="pickup-wrap">
            <input type="text" id="pickup" name="pickup" placeholder="Type or select location" class="form-input autocomplete-input" required autocomplete="off" />
            <button type="button" class="ac-clear" id="pickup-clear" aria-label="Clear pickup">✕</button>
            <div class="ac-dropdown" id="pickup-dropdown"></div>
          </div>
        </div>

        <!-- Drop -->
        <div class="form-group" id="drop-group">
          <label for="drop" class="form-label">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--saffron)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Drop Location
          </label>
          <div class="autocomplete-wrap" id="drop-wrap">
            <input type="text" id="drop" name="drop" placeholder="Type or select destination" class="form-input autocomplete-input" required autocomplete="off" />
            <button type="button" class="ac-clear" id="drop-clear" aria-label="Clear drop">✕</button>
            <div class="ac-dropdown" id="drop-dropdown"></div>
          </div>
        </div>

        <!-- Date + Time -->
        <div class="form-row">
          <div class="form-group">
            <label for="date" class="form-label">Date</label>
            <input type="date" id="date" name="date" class="form-input" required />
          </div>
          <div class="form-group">
            <label for="time" class="form-label">Time</label>
            <input type="time" id="time" name="time" class="form-input" required />
          </div>
        </div>

        <!-- Return Date (Round Trip only) -->
        <div class="form-row" id="return-date-row" style="display:none;">
          <div class="form-group">
            <label for="return_date" class="form-label">Return Date</label>
            <input type="date" id="return_date" name="return_date" class="form-input" />
          </div>
          <div class="form-group">
            <label for="return_time" class="form-label">Return Time</label>
            <input type="time" id="return_time" name="return_time" class="form-input" />
          </div>
        </div>

        <!-- Price Result Box -->
        <div class="price-result" id="price-result" style="display:none;">
          <div class="price-result-inner">
            <div class="price-result-header">
              <span class="price-result-icon" id="price-result-icon">✅</span>
              <span class="price-result-label" id="price-result-label">Fixed Price</span>
            </div>
            <div class="price-result-vehicles" id="price-result-vehicles"></div>
            <p class="price-result-note" id="price-result-note">Driver + Fuel + Toll + Parking included · No hidden costs</p>
          </div>
        </div>

        <!-- Name + Phone -->
        <div class="form-row">
          <div class="form-group">
            <label for="name" class="form-label">Your Name</label>
            <input type="text" id="name" name="name" placeholder="Full name" class="form-input" required />
          </div>
          <div class="form-group">
            <label for="phone" class="form-label">Phone</label>
            <input type="tel" id="phone_no" name="phone" placeholder="+91 XXXXXXXXXX" class="form-input" required />
          </div>
        </div>

        {/* Honeypot — hidden from humans, bots fill it */}
        <label class="honeypot" aria-hidden="true" tabindex="-1">
          <input type="text" name="company" autocomplete="off" tabindex="-1" />
        </label>

        <!-- Cloudflare Turnstile -->
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible"></div>

        <!-- Vehicle Selector -->
        <div class="vehicle-select-section">
          <div class="vehicle-select-label">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3m-3 9h8m-8 0a2 2 0 100 4 2 2 0 000-4zm8 0a2 2 0 100 4 2 2 0 000-4zM9 17V9"/></svg>
            Select Vehicle
          </div>
          <div class="vehicle-grid">
            <label class="vehicle-opt">
              <input type="radio" name="vehicle" value="sedan" />
              <span class="vehicle-card">
                <span class="vehicle-icon">🚗</span>
                <span class="vehicle-name">Sedan</span>
                <span class="vehicle-seats">4+1</span>
              </span>
            </label>
            <label class="vehicle-opt">
              <input type="radio" name="vehicle" value="ertiga" />
              <span class="vehicle-card">
                <span class="vehicle-icon">🚐</span>
                <span class="vehicle-name">Ertiga</span>
                <span class="vehicle-seats">6+1</span>
              </span>
            </label>
            <label class="vehicle-opt">
              <input type="radio" name="vehicle" value="innova" />
              <span class="vehicle-card">
                <span class="vehicle-icon">🚙</span>
                <span class="vehicle-name">Innova Crysta</span>
                <span class="vehicle-seats">6+1</span>
              </span>
            </label>
            <label class="vehicle-opt">
              <input type="radio" name="vehicle" value="traveller" />
              <span class="vehicle-card">
                <span class="vehicle-icon">🚌</span>
                <span class="vehicle-name">Tempo</span>
                <span class="vehicle-seats">12+1</span>
              </span>
            </label>
          </div>
          <p class="vehicle-required-msg" id="vehicle-required-msg" style="display:none;">
            ⚠️ Please select a vehicle type to continue
          </p>
        </div>

        <button type="submit" class="btn btn-teal booking-submit">
          Book Now →
        </button>
        <p class="booking-secure">
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          100% Safe &amp; Secure Booking
        </p>
      </form>
    </div>
  </div>
</section>

<!-- Inject pricing data from routePrices.ts — serialized at build time, zero network cost -->
<script is:inline set:html={`window.__SHRI_TAXI__ = ${priceDataJson};`}></script>

<script>
  // Pre-select vehicle if coming from fleet page
  // Read pricing data injected at build time from routePrices.ts
  const {
    routePrices, locationMap, surchargeMap, localRates,
    estimatedRates: perKmRanges, approxDistances,
    localPackages, localCities,
    longRouteDestinations: longRouteDests,
    cityGroups: cityGroupsData,
    customQuoteOnly: customQuote,
    airportPerDayRoutes: airportPerDay,
  } = (window as any).__SHRI_TAXI__ || {};

  const longRouteSet    = new Set(longRouteDests   || []);
  const cityGroupsArr   = cityGroupsData || [];
  function isSameCityGroup(fk: string, tk: string): boolean {
    return cityGroupsArr.some((g: string[]) => g.includes(fk) && g.includes(tk));
  }
  const customSet       = new Set(customQuote      || []);
  const airportPerDaySet = new Set(airportPerDay   || []);

  // Vehicle display names — module level so all functions can access
  const vehicleNames: Record<string, string> = {
    sedan:     '🚗 Sedan',
    ertiga:    '🚐 Ertiga',
    innova:    '🚙 Innova',
    traveller: '🚌 Tempo',
  };

  document.addEventListener('DOMContentLoaded', () => {
    const selectedVehicle = sessionStorage.getItem('selectedVehicle');
    if (selectedVehicle) {
      const radio = document.querySelector(`input[name="vehicle"][value="${selectedVehicle}"]`) as HTMLInputElement;
      if (radio) {
        radio.checked = true;
        // Scroll booking form into view smoothly
        document.getElementById('booking')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      sessionStorage.removeItem('selectedVehicle');
    }
  });

  // Close popup
  const popup = document.getElementById('booking-popup');
  const closeBtn = document.getElementById('popup-close');

  function closePopup() {
    popup?.classList.remove('active');
    popup?.setAttribute('aria-hidden', 'true');
  }

  closeBtn?.addEventListener('click', closePopup);
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) closePopup();
  });

  // Trip tabs
  const tabs = document.querySelectorAll('.trip-tab');
  const tripInput = document.getElementById('trip_type_input') as HTMLInputElement;
  const returnDateRow = document.getElementById('return-date-row') as HTMLElement;
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected','true');
      const tripType = tab.getAttribute('data-trip') || '';
      if (tripInput) tripInput.value = tripType;
      // Show/hide return date for round trip
      if (returnDateRow) {
        returnDateRow.style.display = tripType === 'round-trip' ? 'grid' : 'none';
      }
      // Show/hide local/airport tab UI
      if (tripType === 'local') { showLocalTab(); hideAirportTab(); }
      else if (tripType === 'airport') { showAirportTab(); hideLocalTab(); }
      else { hideLocalTab(); hideAirportTab(); }
    });
  });



  // ── CUSTOM AUTOCOMPLETE ─────────────────────────────────

  const locations: Array<{ name: string; category: string; icon: string }> = [
    // Dehradun
    { name: 'Dehradun',                          category: 'Dehradun',     icon: '🏙️' },
    { name: 'Clock Tower, Dehradun',             category: 'Dehradun',     icon: '🕐' },
    { name: 'Rajpur Road, Dehradun',             category: 'Dehradun',     icon: '🏙️' },
    { name: 'Sahastradhara, Dehradun',           category: 'Dehradun',     icon: '💧' },
    { name: 'ISBT Dehradun',                     category: 'Dehradun',     icon: '🚌' },
    { name: 'Dehradun Railway Station',          category: 'Dehradun',     icon: '🚂' },
    { name: 'Jolly Grant Airport (DED)',         category: 'Airport',      icon: '✈️' },
    { name: 'FRI (Forest Research Institute)',   category: 'Dehradun',     icon: '🌲' },
    { name: 'Mindrolling Monastery, Dehradun',   category: 'Dehradun',     icon: '🛕' },
    { name: "Robber's Cave, Dehradun",           category: 'Dehradun',     icon: '🗻' },
    // Hill Stations
    { name: 'Mussoorie',                         category: 'Hill Stations', icon: '🏔️' },
    { name: 'Mall Road, Mussoorie',              category: 'Hill Stations', icon: '🛍️' },
    { name: 'Kempty Falls',                      category: 'Hill Stations', icon: '💧' },
    { name: 'Dhanaulti',                         category: 'Hill Stations', icon: '🌲' },
    { name: 'Landour',                           category: 'Hill Stations', icon: '🏔️' },
    { name: 'Kanatal',                           category: 'Hill Stations', icon: '🏕️' },
    { name: 'Chamba',                            category: 'Hill Stations', icon: '🏔️' },
    { name: 'Tehri',                             category: 'Hill Stations', icon: '💧' },
    { name: 'New Tehri',                         category: 'Hill Stations', icon: '💧' },
    { name: 'Lansdowne',                         category: 'Hill Stations', icon: '🏔️' },
    // Spiritual
    { name: 'Haridwar',                          category: 'Spiritual',    icon: '🛕' },
