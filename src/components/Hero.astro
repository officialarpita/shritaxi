        <h2 class="booking-title">Book Your Taxi</h2>
        <p class="booking-sub">Fast, Easy &amp; Secure Booking</p>
      </div>

      <!-- Trip type tabs -->
      <div class="trip-tabs" role="tablist">
        <button class="trip-tab active" data-trip="one-way" role="tab" aria-selected="true">One Way</button>
