  // Surcharge locations
  const surchargeLocations: Record<string, number> = {
    'dehradun_station': 300,
    'dehradun_isbt': 300,
  };

  // Pricing data — matches pricing.ts fixed routes
  // Format: 'from_to': { sedan, ertiga, innova, traveller }
  // Route prices — OW = one way, RT = round trip, tempo = 'best' means call for price


  // Maps surcharge keys back to base city for route lookup
  const routeKeyMap: Record<string, string> = {
    'dehradun_station': 'dehradun',
    'dehradun_isbt':    'dehradun',
  };

  function normaliseLocation(input: string): string {
    const cleaned = input
      .toLowerCase()
      .trim()
      .replace(/\s+/g, ' ');
    if (locationMap[cleaned]) return locationMap[cleaned];
    const withoutParens = cleaned.replace(/\s*\(.*?\)/g, '').trim();
    if (locationMap[withoutParens]) return locationMap[withoutParens];
    const firstPart = cleaned.split(',')[0].trim();
    if (locationMap[firstPart]) return locationMap[firstPart];
    return cleaned;
  }

  // For route key lookup — maps surcharge locations to base city
  function normaliseForRoute(input: string): string {
    const key = normaliseLocation(input);
    return routeKeyMap[key] || key;
  }

  function getSurcharge(rawLocation: string): number {
    const key = rawLocation.toLowerCase().trim();
    const mapped = locationMap[key];
    return surchargeMap[mapped || ''] || 0;
  }

  function formatPrice(n: number): string {
    return '₹' + n.toLocaleString('en-IN');
  }

  function calculatePrice() {
    // Delegate to airport calculator when airport tab is active
    const form = document.getElementById('booking-form');
    if (form?.classList.contains('airport-active')) {
      calculateAirportPrice();
      return;
    }
    const pickupRaw  = (document.getElementById('pickup') as HTMLInputElement)?.value || '';
    const dropRaw    = (document.getElementById('drop') as HTMLInputElement)?.value || '';
    const tripType   = (document.getElementById('trip_type_input') as HTMLInputElement)?.value || 'one-way';
    const isRound    = tripType === 'round-trip';

    // Element references — declared once at top, used throughout
    const resultEl   = document.getElementById('price-result')!;
    const innerEl    = resultEl?.querySelector('.price-result-inner')!;
    const iconEl     = document.getElementById('price-result-icon')!;
    const labelEl    = document.getElementById('price-result-label')!;
    const vehiclesEl = document.getElementById('price-result-vehicles')!;
    const noteEl     = document.getElementById('price-result-note')!;
    const waNum      = (document.getElementById('booking-form') as HTMLFormElement)?.dataset.wa || '';

    // Local tab — handled by separate local UI, skip main price calculator
    if (tripType === 'local') return;

    if (!pickupRaw.trim() || !dropRaw.trim()) {
      hidePrice();
      return;
    }

    const fromKey     = normaliseLocation(pickupRaw);   // for city/long route checks
    const toKey       = normaliseLocation(dropRaw);
    const fromRouteKey = normaliseForRoute(pickupRaw);  // for fixed price lookup
    const toRouteKey   = normaliseForRoute(dropRaw);

    // ── WITHIN CITY CHECK ─────────────────────────────────────
    // Uses raw input to detect different Dehradun locations even if they share the same key
    const isDifferentPlace = pickupRaw.trim().toLowerCase() !== dropRaw.trim().toLowerCase();
    if (isSameCityGroup(fromKey, toKey) && isDifferentPlace) {
      innerEl.classList.add('estimated');
      iconEl.textContent  = '📞';
      labelEl.textContent = 'City Ride — Contact Us';
      vehiclesEl.innerHTML = '';
      noteEl.innerHTML    = 'For local Dehradun rides (Airport, ISBT, Railway Station, Clock Tower) please contact us for current fare. <a href="https://wa.me/' + waNum + '?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20city%20ride%20in%20Dehradun" target="_blank" style="color:var(--teal);font-weight:700;">💬 WhatsApp Us →</a>';
      resultEl.style.display = 'block';
      return;
    }

    // ── CUSTOM QUOTE ONLY (Agra/Jaipur/Lucknow) ──────────────
    if (customSet && (customSet.has(fromKey) || customSet.has(toKey))) {
      innerEl.classList.add('estimated');
      iconEl.textContent  = '📞';
      labelEl.textContent = 'Custom Quote Required';
      vehiclesEl.innerHTML = '';
      noteEl.innerHTML    = 'This route requires a custom quote. <a href="https://wa.me/' + waNum + '?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20quote%20from%20' + encodeURIComponent(pickupRaw) + '%20to%20' + encodeURIComponent(dropRaw) + '" target="_blank" style="color:var(--teal);font-weight:700;">💬 Get WhatsApp Quote →</a>';
      resultEl.style.display = 'block';
      return;
    }

    // ── DELHI/CHANDIGARH AIRPORT → DEHRADUN (per-day + parking) 
    const isAirportPerDay = fromKey === 'delhi_airport' || fromKey === 'chandigarh_airport' ||
                            toKey   === 'delhi_airport' || toKey   === 'chandigarh_airport';
    if (isAirportPerDay) {
      innerEl.classList.remove('estimated');
      iconEl.textContent  = '✈️';
      labelEl.textContent = 'Per Day Rate + Airport Parking';
      vehiclesEl.innerHTML = [
        { v: vehicleNames['sedan'],     p: localRates.sedan.perDay },
        { v: vehicleNames['ertiga'],    p: localRates.ertiga.perDay },
        { v: vehicleNames['innova'],    p: localRates.innova.perDay },
        { v: vehicleNames['traveller'], p: 'best' as const },
      ].map(({ v, p }) =>
        `<div class="price-vehicle-item">
          <span class="price-vehicle-name">${v}</span>
          <span class="price-vehicle-amt">${p === 'best' ? '📞 Call for best price' : '₹' + Number(p).toLocaleString('en-IN') + '/day'}</span>
        </div>`
      ).join('');
      noteEl.innerHTML = '📍 Up to ' + localRates.limitKm + 'km/day · Extra km at ₹' + localRates.sedan.extraKmRate + '/km · (* Airport parking charges applicable on pickup)';
      resultEl.style.display = 'block';
      return;
    }

    // ── LONG ROUTE (per-day rate) ─────────────────────────────
    if (longRouteSet && (longRouteSet.has(toKey) || longRouteSet.has(fromKey))) {
      innerEl.classList.remove('estimated');
      iconEl.textContent  = '📅';
      labelEl.textContent = 'Per Day Package Rate';
      vehiclesEl.innerHTML = [
        { v: vehicleNames['sedan'],     p: localRates.sedan.perDay },
        { v: vehicleNames['ertiga'],    p: localRates.ertiga.perDay },
        { v: vehicleNames['innova'],    p: localRates.innova.perDay },
        { v: vehicleNames['traveller'], p: 'best' as const },
      ].map(({ v, p }) =>
        `<div class="price-vehicle-item">
          <span class="price-vehicle-name">${v}</span>
          <span class="price-vehicle-amt">${p === 'best' ? '📞 Call for best price' : '₹' + Number(p).toLocaleString('en-IN') + '/day'}</span>
        </div>`
      ).join('');
      noteEl.innerHTML = '📍 Up to ' + localRates.limitKm + 'km/day · Extra km at ₹' + localRates.sedan.extraKmRate + '/km (Sedan) · Need one-way drop? <a href="https://wa.me/' + waNum + '?text=Hi%20Shri%20Taxi%2C%20I%20need%20one%20way%20drop%20to%20' + encodeURIComponent(dropRaw) + '" target="_blank" style="color:var(--teal);font-weight:700;">WhatsApp us →</a>';
      resultEl.style.display = 'block';
      return;
    }

    const routeKey = `${fromRouteKey}_${toRouteKey}`;
    const prices   = routePrices[routeKey];


    // Surcharges — skipped when route is an exact match (price already factors it in)
    const hasExactMatch = !!prices;
    const pickupSurcharge = hasExactMatch ? 0 : getSurcharge(pickupRaw);
    const dropSurcharge   = hasExactMatch ? 0 : (isRound ? 0 : getSurcharge(dropRaw));
    const vehicles = ['sedan', 'ertiga', 'innova', 'traveller'];

    // Same location check — compare raw input so Clock Tower→Rajpur Road is NOT flagged
    if (pickupRaw.trim().toLowerCase() === dropRaw.trim().toLowerCase()) {
      hidePrice();
      innerEl.classList.add('estimated');
      iconEl.textContent  = '⚠️';
      labelEl.textContent = 'Same pickup & drop location';
      vehiclesEl.innerHTML = '';
      noteEl.textContent  = 'Please select different pickup and drop locations.';
      resultEl.style.display = 'block';
      return;
    }

    // AIRPORT TAB — show estimated if route not found, don't hide

    if (prices) {
      // FIXED PRICE ROUTE — uses separate one-way and round-trip prices
      innerEl.classList.remove('estimated');
      iconEl.textContent  = '✅';
      labelEl.textContent = isRound ? 'Round Trip Price — All Inclusive' : 'Fixed Price — All Inclusive';

      const surchargeTotal = pickupSurcharge + dropSurcharge;

      vehiclesEl.innerHTML = [
        { label: vehicleNames['sedan'],     ow: prices.sedan_ow,  rt: prices.sedan_rt,  tempo: undefined },
        { label: vehicleNames['ertiga'],    ow: prices.ertiga_ow, rt: prices.ertiga_rt, tempo: undefined },
        { label: vehicleNames['innova'],    ow: prices.innova_ow, rt: prices.innova_rt, tempo: undefined },
        { label: vehicleNames['traveller'], ow: 0,                rt: 0,                tempo: prices.tempo },
      ].map(({ label, ow, rt, tempo }) => {
        if (tempo === 'best') {
          return `<div class="price-vehicle-item">
            <span class="price-vehicle-name">${label}</span>
            <span class="price-vehicle-amt price-vehicle-best">📞 Call for best price</span>
          </div>`;
        }
        if (!ow || ow === 0) return '';
        const base  = isRound ? rt : ow;
        const total = base + surchargeTotal;
        const surchargeNote = surchargeTotal > 0
          ? `<span class="price-vehicle-surcharge">${formatPrice(base)} + ${formatPrice(surchargeTotal)} pickup surcharge${isRound ? ' (drop waived ✓)' : ''} = ${formatPrice(total)}</span>`
          : '';
        return `<div class="price-vehicle-item">
          <span class="price-vehicle-name">${label}</span>
          <span class="price-vehicle-amt">${formatPrice(total)}</span>
          ${surchargeNote}
        </div>`;
      }).join('');

      const isAirportPickupRoute = prices.airportPickup === true;
      noteEl.innerHTML = 'Driver + Fuel + Toll + Parking included · No hidden costs' + (isAirportPickupRoute ? ' · (* Airport parking charges applicable on pickup)' : '');
      resultEl.style.display = 'block';

    } else {
      // ESTIMATED — unknown route
      innerEl.classList.add('estimated');
      iconEl.textContent  = '📍';
      labelEl.textContent = 'Estimated Price';

      // Try to get approximate distance
      const distKey = approxDistances[toKey] || approxDistances[fromKey];
      const dist    = distKey || 150; // default 150km if unknown
      const multiplier = isRound ? 2 : 1;

      vehiclesEl.innerHTML = vehicles.map(v => {
        const [low, high] = perKmRanges[v];
        const base_low  = Math.round(dist * low  * multiplier / 100) * 100;
        const base_high = Math.round(dist * high * multiplier / 100) * 100;
        return `<div class="price-vehicle-item">
          <span class="price-vehicle-name">${vehicleNames[v]}</span>
          <span class="price-vehicle-amt">${formatPrice(base_low)}–${formatPrice(base_high)}</span>
        </div>`;
      }).join('');

      noteEl.innerHTML = 'Estimated range · Exact fare confirmed on WhatsApp &nbsp;<a href="https://wa.me/' + (document.getElementById('booking-form') as HTMLFormElement)?.dataset.wa + '?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20quote%20from%20' + encodeURIComponent(pickupRaw) + '%20to%20' + encodeURIComponent(dropRaw) + '" target="_blank" style="color:var(--teal);font-weight:700;">Get WhatsApp Quote →</a>';
      resultEl.style.display = 'block';
    }
  }

  function hidePrice() {
    const resultEl = document.getElementById('price-result');
    if (resultEl) resultEl.style.display = 'none';
  }

  // Watch pickup, drop inputs
  const pickupInput = document.getElementById('pickup') as HTMLInputElement;
  const dropInput   = document.getElementById('drop') as HTMLInputElement;

  pickupInput?.addEventListener('change', calculatePrice);
  pickupInput?.addEventListener('blur', calculatePrice);
  dropInput?.addEventListener('change', calculatePrice);
  dropInput?.addEventListener('blur', calculatePrice);

  // Recalculate when trip type changes
  document.querySelectorAll('.trip-tab').forEach(tab => {
    tab.addEventListener('click', () => setTimeout(calculatePrice, 100));
  });

  // ── END PRICE CALCULATOR ──────────────────────────────────

  // Time picker — auto dismiss after selection on all devices
  const timeInput = document.getElementById('time') as HTMLInputElement;
  timeInput?.addEventListener('change', () => {
    setTimeout(() => {
      timeInput.blur();
      // Move focus to next field (name) so picker fully dismisses
      const nameInput = document.getElementById('name') as HTMLInputElement;
      nameInput?.focus();
      nameInput?.blur();
    }, 150);
  });

  // Set min date to today — using LOCAL date to avoid timezone offset bug
  const dateInput = document.getElementById('date') as HTMLInputElement;
  if (dateInput) {
    const now = new Date();
    const localDate = now.getFullYear() + '-' +
      String(now.getMonth() + 1).padStart(2, '0') + '-' +
      String(now.getDate()).padStart(2, '0');
    dateInput.min = localDate;
    dateInput.value = localDate;
  }

  // Form submit — matches original BookingForm logic with Turnstile
  const form = document.getElementById('booking-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Vehicle required check
    const vehicleSelected = form.querySelector('input[name="vehicle"]:checked') as HTMLInputElement;
    const vehicleMsg = document.getElementById('vehicle-required-msg') as HTMLElement;
    if (!vehicleSelected) {
      if (vehicleMsg) { vehicleMsg.style.display = 'block'; }
      // Scroll to vehicle section
      document.querySelector('.vehicle-select-section')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      btn.disabled = false;
      btn.textContent = 'Book Now →';
      return;
    }
    if (vehicleMsg) vehicleMsg.style.display = 'none';

    const fd = new FormData(form);

    const payload: Record<string, string> = {};
    fd.forEach((v, k) => { payload[k] = v.toString(); });

    btn.disabled = true;
    btn.textContent = 'Processing…';

    try {
      // Build WhatsApp message with all booking details
      const pickup  = payload.pickup  || '';
      const drop    = payload.drop    || '';
      const date    = payload.date    || '';
      const time    = payload.time    || '';
      const vehicle = payload.vehicle || '';
      const name    = payload.name    || '';
      const phone   = payload.phone   || '';
      const tripLabels: Record<string, string> = {
        'one-way': 'One Way',
        'round-trip': 'Round Trip',
        'local': 'Local',
        'airport': 'Airport',
      };
      const trip = tripLabels[payload.trip_type] || payload.trip_type || 'One Way';

      // Descriptive vehicle names for WhatsApp message
      const vehicleFullNames: Record<string, string> = {
        sedan: 'Sedan (Dzire/Baleno)',
        ertiga: 'Maruti Ertiga',
        innova: 'Toyota Innova Crysta',
        traveller: 'Tempo Traveller',
      };

      // Booking ID: SHRI-YYMMDD-XXXX (4-char base36 random suffix)
      const d = new Date();
      const yymmdd = d.toISOString().slice(2, 10).replace(/-/g, '');
      const rand = Math.random().toString(36).slice(2, 6).toUpperCase();
      const bookingId = `SHRI-${yymmdd}-${rand}`;
      payload.booking_id = bookingId;

      // Build message — handle local hire separately
      const localCity    = payload.local_city    || '';
      const localPackage = payload.local_package || '';
      const localPickup  = payload.local_pickup  || '';
      const localSpots   = payload.local_spots   || '';
      const airportSel   = payload.airport_select || '';
      const airportCity  = payload.airport_city   || '';

      let msg = '';
      if (payload.trip_type === 'local') {
        msg = `Hi Shri Taxi, I'd like to book a Local Hire cab.\n\n*Booking ID:* ${bookingId}\n\n*City:* ${localCity}\n*Package:* ${localPackage}\n*Pickup Point:* ${localPickup}\n${localSpots ? '*Places to visit:* ' + localSpots + '\n' : ''}*Date:* ${date}\n*Time:* ${time}\n*Vehicle:* ${vehicleFullNames[vehicle] || vehicle}\n*Name:* ${name}\n*Phone:* ${phone}\n\nPlease confirm. Thanks!`;
      } else if (payload.trip_type === 'airport') {
        msg = `Hi Shri Taxi, I'd like to book an Airport Transfer.\n\n*Booking ID:* ${bookingId}\n\n*Airport:* ${airportSel}\n*City:* ${airportCity}\n*Date:* ${date}\n*Time:* ${time}\n*Vehicle:* ${vehicleFullNames[vehicle] || vehicle}\n*Name:* ${name}\n*Phone:* ${phone}\n\nPlease confirm direction (pickup/drop) and fare. Thanks!`;
      } else {
        msg = `Hi Shri Taxi, I'd like to book a cab.\n\n*Booking ID:* ${bookingId}\n\n*Pickup:* ${pickup}\n*Drop:* ${drop}\n*Date:* ${date}\n*Time:* ${time}\n*Vehicle:* ${vehicleFullNames[vehicle] || vehicle}\n*Trip Type:* ${trip}\n*Name:* ${name}\n*Phone:* ${phone}\n\nPlease confirm. Thanks!`;
      }

      const wa = form.dataset.wa || '';
      const waUrl = `https://wa.me/${wa}?text=${encodeURIComponent(msg)}`;

      // Show success popup
      const popup   = document.getElementById('booking-popup');
      const details = document.getElementById('popup-details');
      const waLink  = document.getElementById('popup-wa') as HTMLAnchorElement;

      if (popup && details) {
        details.innerHTML = `
          <div><strong>Booking ID:</strong> ${bookingId}</div>
          <div><strong>${pickup}</strong> → <strong>${drop}</strong></div>
          ${vehicleFullNames[vehicle] ? `<div>Vehicle: ${vehicleFullNames[vehicle]}</div>` : ''}
          ${date ? `<div>${date}${time ? ' · ' + time : ''}</div>` : ''}
          ${name ? `<div>${name}</div>` : ''}
        `;
        if (waLink) waLink.href = waUrl;
        popup.setAttribute('aria-hidden', 'false');
        popup.classList.add('active');
      }

      // Send to API for Telegram + Google Sheets logging
      const token = (fd.get('cf-turnstile-response') || '').toString();
      payload.turnstile_token = token;
      console.log('Sending to API:', JSON.stringify(payload));
      fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).then(r => r.json()).then(d => console.log('API response:', d)).catch(e => console.error('API error:', e));

      btn.textContent = '✓ Booking Confirmed!';
      btn.style.background = 'var(--whatsapp)';

    } catch (err) {
      console.error('Booking handler error:', err);
      btn.textContent = '✓ Booking Confirmed!';
      btn.style.background = 'var(--whatsapp)';
    } finally {
      btn.disabled = false;
    }

    // Reset form and Turnstile after 4 seconds
    setTimeout(() => {
      btn.textContent = 'Book Now →';
      btn.style.background = '';
      form.reset();
      // Just reset Turnstile — never re-render manually (causes postMessage error)
      // @ts-ignore
      if (window.turnstile) window.turnstile.reset();
    }, 4000);
  });
</script>

