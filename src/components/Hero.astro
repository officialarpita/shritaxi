---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
---

<section class="hero">
  <!-- Background -->
  <div class="hero-bg">
    <img src="/images/hero-mountains.jpg" alt="Uttarakhand mountains" class="hero-bg-img" loading="eager" fetchpriority="high" />
    <div class="hero-overlay"></div>
    <!-- Mountain silhouette decoration -->
    <div class="hero-mountain-decor" aria-hidden="true">
      <svg viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,120 L0,80 L120,30 L240,70 L360,15 L480,60 L600,8 L720,55 L840,10 L960,50 L1080,20 L1200,58 L1320,25 L1440,60 L1440,120 Z" fill="rgba(255,255,255,0.04)"/>
        <path d="M0,120 L0,95 L180,55 L360,85 L540,40 L720,75 L900,38 L1080,70 L1260,45 L1440,75 L1440,120 Z" fill="rgba(255,255,255,0.06)"/>
      </svg>
    </div>
  </div>

  <div class="container hero-content">

    <!-- Left: Text + CTAs -->
    <div class="hero-text">
      <div class="hero-label">
        <span class="live-dot"></span>
        Dehradun · Uttarakhand · Delhi NCR
      </div>

      <h1 class="hero-title">
        Taxi Service in<br/>
        <em>Uttarakhand</em>
      </h1>

      <p class="hero-sub">
        Airport, Dehradun, Mussoorie, Haridwar,<br class="hero-br"/>
        Rishikesh & Char Dham — All Routes Covered
      </p>

      <!-- Trust pills -->
      <div class="hero-trust">
        <span class="trust-pill">⭐ 4.9 / 5.0 Rating</span>
        <span class="trust-pill">✓ No Hidden Costs</span>
        <span class="trust-pill">🏔️ Pahadi Drivers</span>
        <span class="trust-pill">📞 24/7 Available</span>
      </div>

      <!-- Primary CTAs -->
      <div class="hero-ctas">
        <a href={`tel:${phone}`} class="btn btn-saffron btn-lg hero-cta-primary">
          📞 Call Now
        </a>
        <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg hero-cta-primary">
          💬 WhatsApp Us
        </a>
      </div>

      <!-- Response time -->
      <p class="hero-response">
        <span class="live-dot"></span>
        We're online · Average response: <strong>8 minutes</strong>
      </p>
    </div>

    <!-- Right: Booking Form -->
    <div class="hero-form-wrap">
      <div class="hero-form">
        <div class="hero-form-header">
          <h2>Book Your Taxi</h2>
          <p>Fast, Easy & Secure Booking</p>
        </div>

        <!-- Tabs -->
        <div class="form-tabs" role="tablist">
          {['One Way', 'Round Trip', 'Airport'].map((t, i) => (
            <button class={`form-tab${i === 0 ? ' form-tab--active' : ''}`} role="tab" data-tab={t.toLowerCase().replace(' ', '-')}>
              {t}
            </button>
          ))}
        </div>

        <!-- Form -->
        <form class="booking-form" onsubmit="handleBooking(event)">
          <div class="form-field">
            <label class="form-label">📍 Pickup Location</label>
            <input type="text" class="form-input" placeholder="e.g. Jolly Grant Airport, Delhi NCR" id="pickup" required />
          </div>
          <div class="form-field">
            <label class="form-label">📍 Drop Location</label>
            <input type="text" class="form-input" placeholder="e.g. Mussoorie, Haridwar, Dehradun" id="drop" required />
          </div>
          <div class="form-row">
            <div class="form-field">
              <label class="form-label">📅 Date</label>
              <input type="date" class="form-input" id="date" required />
            </div>
            <div class="form-field">
              <label class="form-label">🚗 Vehicle</label>
              <select class="form-input form-select" id="vehicle">
                <option value="sedan">Sedan (4+1)</option>
                <option value="ertiga">Ertiga (6+1)</option>
                <option value="innova">Innova Crysta (6+1)</option>
                <option value="tempo">Tempo Traveller (12+1)</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label class="form-label">👤 Your Name</label>
              <input type="text" class="form-input" placeholder="Full name" id="name" required />
            </div>
            <div class="form-field">
              <label class="form-label">📞 Phone</label>
              <input type="tel" class="form-input" placeholder="+91 XXXXXXXXXX" id="phone-input" required />
            </div>
          </div>
          <button type="submit" class="btn btn-teal btn-full form-submit">
            Get Instant Quote →
          </button>
          <p class="form-note">🔒 Confirmed within 15 minutes · No advance payment needed</p>
        </form>
      </div>
    </div>

  </div>

  <!-- Bottom mountain silhouette -->
  <div class="hero-bottom-decor" aria-hidden="true">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,60 L0,35 L160,8 L320,38 L480,5 L640,32 L800,3 L960,30 L1120,8 L1280,35 L1440,15 L1440,60 Z" fill="#ffffff"/>
    </svg>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 620px;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 60px 0 80px;
}

/* Background */
.hero-bg { position: absolute; inset: 0; z-index: 0; }
.hero-bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(0,0,0,0.55) 0%,
    rgba(0,0,0,0.30) 55%,
    rgba(0,0,0,0.05) 100%
  );
}
.hero-mountain-decor {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120px;
}
.hero-mountain-decor svg { width: 100%; height: 100%; }

/* Content */
.hero-content {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 440px;
  gap: 48px;
  align-items: center;
}

/* Text */
.hero-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  margin-bottom: 16px;
}
.hero-title {
  font-size: clamp(32px, 5vw, 52px);
  color: #fff;
  line-height: 1.15;
  margin-bottom: 14px;
  font-family: 'Playfair Display', serif;
}
.hero-title em {
  color: #f59e0b;
  font-style: italic;
}
.hero-sub {
  font-size: 16px;
  color: rgba(255,255,255,0.8);
  line-height: 1.65;
  margin-bottom: 20px;
}
.hero-br { display: none; }
.hero-trust { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
.hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
.hero-cta-primary { min-width: 160px; }
.hero-response {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: rgba(255,255,255,0.65);
}
.hero-response strong { color: rgba(255,255,255,0.9); }

/* Booking Form */
.hero-form-wrap { position: relative; }
.hero-form {
  background: #fff;
  border-radius: 20px;
  padding: 28px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
}
.hero-form-header { margin-bottom: 16px; }
.hero-form-header h2 {
  font-size: 20px;
  color: #0d9488;
  font-family: 'Playfair Display', serif;
  margin-bottom: 2px;
}
.hero-form-header p { font-size: 12px; color: #64748b; }

/* Form Tabs */
.form-tabs {
  display: flex;
  gap: 4px;
  background: #f1f5f9;
  border-radius: 8px;
  padding: 4px;
  margin-bottom: 16px;
}
.form-tab {
  flex: 1;
  padding: 7px;
  border: none;
  background: transparent;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  cursor: pointer;
  transition: all 0.15s;
}
.form-tab--active { background: #fff; color: #0d9488; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }

/* Form Fields */
.form-field { display: flex; flex-direction: column; gap: 4px; }
.form-label { font-size: 12px; font-weight: 600; color: #475569; }
.form-input {
  padding: 10px 12px;
  border: 1.5px solid #e2e8f0;
  border-radius: 8px;
  font-size: 13px;
  font-family: 'DM Sans', sans-serif;
  color: #1e293b;
  background: #fff;
  transition: border-color 0.15s;
  width: 100%;
}
.form-input:focus { outline: none; border-color: #0d9488; }
.form-input::placeholder { color: #94a3b8; }
.form-select { cursor: pointer; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.booking-form { display: flex; flex-direction: column; gap: 10px; }
.form-submit { margin-top: 4px; font-size: 15px; padding: 13px; }
.form-note { font-size: 11px; color: #64748b; text-align: center; margin-top: 4px; }

/* Bottom decoration */
.hero-bottom-decor {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  z-index: 1;
}
.hero-bottom-decor svg { width: 100%; height: 100%; }

/* Responsive */
@media (max-width: 1024px) {
  .hero-content { grid-template-columns: 1fr; gap: 32px; }
  .hero { padding: 48px 0 60px; min-height: auto; }
}

@media (max-width: 768px) {
  .hero { padding: 36px 0 48px; }
  .hero-title { font-size: clamp(28px, 7vw, 38px); }
  .hero-form { padding: 20px; border-radius: 16px; }
  .hero-cta-primary { flex: 1; min-width: 120px; }
  .hero-br { display: block; }
}

@media (max-width: 480px) {
  .form-row { grid-template-columns: 1fr; }
  .hero-ctas { flex-direction: column; }
  .hero-cta-primary { width: 100%; }
  .form-tabs .form-tab { font-size: 11px; padding: 6px; }
}
</style>

<script>
  // Set min date to today
  const dateInput = document.getElementById('date') as HTMLInputElement;
  if (dateInput) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.min = today;
    dateInput.value = today;
  }

  // Form tabs
  document.querySelectorAll('.form-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.form-tab').forEach(t => t.classList.remove('form-tab--active'));
      tab.classList.add('form-tab--active');
    });
  });

  // Booking form → WhatsApp
  (window as any).handleBooking = function(e: Event) {
    e.preventDefault();
    const pickup  = (document.getElementById('pickup') as HTMLInputElement)?.value;
    const drop    = (document.getElementById('drop') as HTMLInputElement)?.value;
    const date    = (document.getElementById('date') as HTMLInputElement)?.value;
    const vehicle = (document.getElementById('vehicle') as HTMLSelectElement)?.value;
    const name    = (document.getElementById('name') as HTMLInputElement)?.value;
    const phone   = (document.getElementById('phone-input') as HTMLInputElement)?.value;

    const msg = `Hi Shri Taxi! I want to book a cab.
📍 Pickup: ${pickup}
📍 Drop: ${drop}
📅 Date: ${date}
🚗 Vehicle: ${vehicle}
👤 Name: ${name}
📞 Phone: ${phone}`;

    const wa = '916397321825';
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(msg)}`, '_blank');
  };
</script>
