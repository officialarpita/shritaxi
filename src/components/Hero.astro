  function calculateAirportPrice() {
    const airportVal  = (document.getElementById('airport_select') as HTMLSelectElement)?.value;
    const locationVal = (document.getElementById('airport_location') as HTMLInputElement)?.value;
    if (!airportVal || !locationVal.trim() || !airportJourneyType) return;

    // Build from/to based on journey type
    const fromRaw = airportJourneyType === 'pickup' ? airportVal : locationVal;
    const toRaw   = airportJourneyType === 'pickup' ? locationVal : airportVal;
    const frk     = normaliseForRoute(fromRaw);
    const trk     = normaliseForRoute(toRaw);
    const prices  = routePrices[`${frk}_${trk}`] || routePrices[`${trk}_${frk}`];

    const resultEl   = document.getElementById('airport-price-result')!;
    const innerEl    = resultEl.querySelector('.price-result-inner')!;
    const iconEl     = document.getElementById('airport-price-icon')!;
    const labelEl    = document.getElementById('airport-price-label')!;
    const vehiclesEl = document.getElementById('airport-price-vehicles')!;
    const noteEl     = document.getElementById('airport-price-note')!;

    const airportKey = normalise(airportVal);
    const isPerDay   = airportKey === 'delhi_airport' || airportKey === 'chandigarh_airport';

    if (isPerDay) {
      innerEl.classList.remove('estimated');
      iconEl.textContent  = '✈️';
      labelEl.textContent = 'Per Day Rate';
      vehiclesEl.innerHTML = [
        { v: vehicleNames['sedan'],     p: localRates.sedan.perDay },
        { v: vehicleNames['ertiga'],    p: localRates.ertiga.perDay },
        { v: vehicleNames['innova'],    p: localRates.innova.perDay },
        { v: vehicleNames['traveller'], p: 'best' },
      ].map(({ v, p }) =>
        `<div class="price-vehicle-item">
          <span class="price-vehicle-name">${v}</span>
          <span class="price-vehicle-amt">${p === 'best' ? '📞 Call for best price' : '₹' + Number(p).toLocaleString('en-IN') + '/day'}</span>
        </div>`
      ).join('');
      noteEl.textContent = '📍 Up to ' + localRates.limitKm + 'km/day · Driver + Fuel included';

    } else if (prices) {
      innerEl.classList.remove('estimated');
      iconEl.textContent  = '✅';
      labelEl.textContent = 'Fixed Price — All Inclusive';
      vehiclesEl.innerHTML = [
        { label: vehicleNames['sedan'],     p: prices.sedan_ow  },
        { label: vehicleNames['ertiga'],    p: prices.ertiga_ow },
        { label: vehicleNames['innova'],    p: prices.innova_ow },
        { label: vehicleNames['traveller'], p: 0, tempo: 'best' as const },
      ].map(({ label, p, tempo }) => {
        if (tempo === 'best') return `<div class="price-vehicle-item"><span class="price-vehicle-name">${label}</span><span class="price-vehicle-amt price-vehicle-best">📞 Call for best price</span></div>`;
        if (!p) return '';
        return `<div class="price-vehicle-item"><span class="price-vehicle-name">${label}</span><span class="price-vehicle-amt">${formatPrice(p)}</span></div>`;
      }).join('');
      noteEl.textContent = 'Driver + Fuel + Toll + Parking included · No hidden costs';

    } else {
      innerEl.classList.add('estimated');
      iconEl.textContent  = '📞';
      labelEl.textContent = 'Contact for Quote';
      vehiclesEl.innerHTML = '';
      const waNum2 = (document.getElementById('booking-form') as HTMLFormElement)?.dataset.wa || '';
      noteEl.innerHTML = `Contact us for this route. <a href="https://wa.me/${waNum2}?text=Hi%20Shri%20Taxi%2C%20I%20need%20airport%20transfer%20from%20${encodeURIComponent(fromRaw)}%20to%20${encodeURIComponent(toRaw)}" target="_blank" style="color:var(--teal);font-weight:700;">💬 WhatsApp for quote →</a>`;
    }
