              <span class="vehicle-card">
                <span class="vehicle-icon">🚌</span>
                <span class="vehicle-name">Tempo</span>
                <span class="vehicle-seats">12+1</span>
              </span>
            </label>
          </div>
        </div>

        <!-- Price Result Box -->
        <div class="price-result" id="price-result" style="display:none;">
          <div class="price-result-inner">
            <div class="price-result-header">
              <span class="price-result-icon" id="price-result-icon">✅</span>
              <span class="price-result-label" id="price-result-label">Fixed Price</span>
            </div>
            <div class="price-result-vehicles" id="price-result-vehicles"></div>
            <p class="price-result-note" id="price-result-note">Driver + Fuel + Toll + Parking included · No hidden costs</p>
