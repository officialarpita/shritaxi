---
import { Image } from 'astro:assets';

import AirportImg   from '../assets/images/airportTransfer1.jpeg';
import MussoorieImg from '../assets/images/Mussori2.jpeg';
import HaridwarImg  from '../assets/images/Haridwar.jpeg';
import RishikeshImg from '../assets/images/Hrisikesh2.jpeg';
import NainitalImg  from '../assets/images/Nainital.jpeg';
import KedarnathImg from '../assets/images/CharDham2.jpeg';
import BadrinathImg from '../assets/images/Badrinath.jpeg';
import OutstationImg from '../assets/images/outstationCab.jpeg';

const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const routes = [
  {
    from: 'Jolly Grant',
    to: 'Dehradun',
    distance: '27 km',
    duration: '45 min',
    img: AirportImg,
    tag: 'Airport Transfer',
  },
  {
    from: 'Dehradun',
    to: 'Mussoorie',
    distance: '35 km',
    duration: '1 hr 30 min',
    img: MussoorieImg,
    tag: 'Hill Station',
  },
  {
    from: 'Dehradun',
    to: 'Haridwar',
    distance: '54 km',
    duration: '1 hr 30 min',
    img: HaridwarImg,
    tag: 'Spiritual',
  },
  {
    from: 'Dehradun',
    to: 'Rishikesh',
    distance: '46 km',
    duration: '1 hr 15 min',
    img: RishikeshImg,
    tag: 'Spiritual',
  },
  {
    from: 'Dehradun',
    to: 'Nainital',
    distance: '285 km',
    duration: '7 hrs',
    img: NainitalImg,
    tag: 'Hill Station',
  },
  {
    from: 'Dehradun',
    to: 'Kedarnath',
    distance: '250 km',
    duration: '9 hrs',
    img: KedarnathImg,
    tag: 'Char Dham',
  },
  {
    from: 'Dehradun',
    to: 'Badrinath',
    distance: '320 km',
    duration: '11 hrs',
    img: BadrinathImg,
    tag: 'Char Dham',
  },
  {
    from: 'Dehradun',
    to: 'Delhi NCR',
    distance: '310 km',
    duration: '6 hrs',
    img: OutstationImg,
    tag: 'Outstation',
  },
];
---

<section class="section section--mint" id="routes">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="section-label">Popular Routes from Dehradun</p>
        <h2 class="section-title">Where Do You Want to Go?</h2>
        <p class="section-sub">Fixed-price cabs on the routes our travellers book most</p>
      </div>
      <a href="/packages" class="btn btn-outline view-all">View All Routes →</a>
    </div>

    <div class="routes-grid">
      {routes.map(r => (
        <a
          href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20cab%20from%20${encodeURIComponent(r.from)}%20to%20${encodeURIComponent(r.to)}`}
          target="_blank"
          rel="noopener"
          class="route-card"
          aria-label={`Get quote for taxi from ${r.from} to ${r.to}`}
        >
          <!-- Image -->
          <div class="route-img-wrap">
            <Image
              src={r.img}
              alt={`${r.from} to ${r.to} taxi`}
              width={400}
              height={200}
              class="route-img"
              loading="lazy"
            />
            <div class="route-overlay" aria-hidden="true"></div>
            <span class="route-tag">{r.tag}</span>
          </div>

          <!-- Body -->
          <div class="route-body">
            <div class="route-names">
              <span class="route-from">{r.from}</span>
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <span class="route-to">{r.to}</span>
            </div>
            <div class="route-meta">
              <span class="route-info">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {r.duration}
              </span>
              <span class="route-info">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12h18M12 3l9 9-9 9"/></svg>
                {r.distance}
              </span>
            </div>
            <div class="route-cta">
              Get Quote on WhatsApp
              <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 28px;
  flex-wrap: wrap;
  gap: 16px;
}

/* Grid — 4 col desktop, scrollable on mobile */
.routes-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

/* Card */
.route-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: box-shadow 0.2s, transform 0.2s;
}
.route-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

/* Image */
.route-img-wrap {
  position: relative;
  height: 140px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--teal-dark), var(--teal));
}

.route-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.35s;
}
.route-card:hover .route-img { transform: scale(1.06); }

.route-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.35) 0%, transparent 60%);
}

.route-tag {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(255,255,255,0.92);
  color: var(--teal);
  font-size: 10px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 20px;
  letter-spacing: 0.3px;
}

/* Body */
.route-body {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

.route-names {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.route-from {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
}

.route-to {
  font-size: 15px;
  font-weight: 700;
  color: var(--slate);
}

.route-meta {
  display: flex;
  gap: 12px;
}

.route-info {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  color: var(--muted);
}

.route-cta {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 600;
  color: var(--saffron);
  margin-top: auto;
  padding-top: 8px;
  border-top: 1px solid var(--border);
}

/* Responsive */
@media (max-width: 1024px) {
  .routes-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 768px) {
  /* Horizontal scroll on mobile */
  .routes-grid {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 12px;
    margin: 0 -20px;
    padding: 0 20px 8px;
  }
  .routes-grid::-webkit-scrollbar { display: none; }
  .route-card {
    flex-shrink: 0;
    width: 200px;
  }
  .route-img-wrap { height: 120px; }
  .view-all { width: 100%; justify-content: center; }
}
</style>
