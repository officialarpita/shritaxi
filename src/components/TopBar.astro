---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
---
<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span class="topbar-item">🕐 24/7 Customer Support</span>
      <span class="topbar-divider">·</span>
      <span class="topbar-item">🏔️ Pahadi Roots. Trusted Routes.</span>
    </div>
    <div class="topbar-right">
      <a href={`tel:${phone}`} class="topbar-link">📞 {phone}</a>
      <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener" class="topbar-link topbar-wa">💬 WhatsApp Us</a>
    </div>
  </div>
</div>

<style>
.topbar {
  background: #0f766e;
  padding: 7px 0;
  font-size: 12.5px;
  color: rgba(255,255,255,0.85);
}
.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.topbar-left { display: flex; align-items: center; gap: 10px; }
.topbar-divider { opacity: 0.4; }
.topbar-item { font-weight: 500; }
.topbar-right { display: flex; align-items: center; gap: 16px; }
.topbar-link {
  color: rgba(255,255,255,0.9);
  font-weight: 600;
  transition: color 0.15s;
}
.topbar-link:hover { color: #fff; }
.topbar-wa { background: rgba(37,211,102,0.2); padding: 2px 10px; border-radius: 20px; }

@media (max-width: 768px) {
  .topbar-left { display: none; }
  .topbar-inner { justify-content: center; }
  .topbar-right { gap: 12px; }
}
</style>
