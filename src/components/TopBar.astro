---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
---
<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>24/7 Customer Support</span>
    </div>
    <div class="topbar-center">We are available 24/7 for you!</div>
    <div class="topbar-right">
      <a href={`tel:${phone}`} class="topbar-link">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.49 12a19.79 19.79 0 01-3.07-8.67A2 2 0 013.4 1.27h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 9a16 16 0 006.29 6.29l1.79-1.79a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        {phone}
      </a>
      <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener" class="topbar-link topbar-wa">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.106.549 4.09 1.508 5.814L.057 23.25l5.561-1.46A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.49-5.191-1.352l-.371-.22-3.301.867.881-3.22-.241-.393A10 10 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        WhatsApp Us
      </a>
    </div>
  </div>
</div>

<style>
.topbar {
  background: var(--teal-deeper);
  color: rgba(255,255,255,0.85);
  font-size: 12px;
  font-weight: 500;
}
.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 36px;
  gap: 16px;
}
.topbar-left {
  display: flex;
  align-items: center;
  gap: 6px;
}
.topbar-center {
  font-size: 12px;
  color: rgba(255,255,255,0.7);
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 16px;
}
.topbar-link {
  display: flex;
  align-items: center;
  gap: 5px;
  color: rgba(255,255,255,0.9);
  transition: color 0.2s;
}
.topbar-link:hover { color: #fff; }
.topbar-wa { color: #7ee8a2; }
.topbar-wa:hover { color: #a7f3d0; }
@media (max-width: 768px) {
  .topbar-center, .topbar-left { display: none; }
  .topbar-inner { justify-content: flex-end; }
}
</style>
