---
import { Image } from 'astro:assets';

import CharDhamImg  from '../assets/images/CharDham1.jpeg';
//import MussoorieImg from '../assets/images/Mussori1.jpeg';
import MussoorieImg from '../assets/images/Mussori2.jpeg';
import RishikeshImg from '../assets/images/Hrisikesh1.jpeg';
import NainitalImg  from '../assets/images/Nainital2.jpg';
import AuliImg      from '../assets/images/Auli_togo.jpg';

const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '+916397321825';

const packages = [
  {
    id: 'char-dham',
    name: 'Char Dham Yatra',
    nights: '10N',
    highlights: ['Yamunotri', 'Gangotri', 'Kedarnath', 'Badrinath'],
    price: '₹18,000',
    priceNote: 'onwards per cab',
    badge: 'Most Popular',
    badgeColor: '#fb923c',
    href: '/char-dham-yatra',
    img: CharDhamImg,
  },
  {
    id: 'mussoorie',
    name: 'Mussoorie Day Trip',
    nights: 'Day Trip',
    highlights: ['Kempty Falls', 'Mall Road', 'Gun Hill', 'Camel\'s Back Road'],
    price: '₹1,800',
    priceNote: 'onwards per cab',
    badge: 'Quick Getaway',
    badgeColor: '#0d9488',
    href: '/packages#mussoorie',
    img: MussoorieImg,
  },
  {
    id: 'rishikesh',
    name: 'Rishikesh + Haridwar',
    nights: '1N',
    highlights: ['Ganga Aarti', 'Laxman Jhula', 'Beatles Ashram', 'Ram Jhula'],
    price: '₹2,500',
    priceNote: 'onwards per cab',
    badge: 'Spiritual',
    badgeColor: '#8b5cf6',
    href: '/packages#rishikesh',
    img: RishikeshImg,
  },
  {
    id: 'nainital',
    name: 'Nainital Weekend',
    nights: '2N',
    highlights: ['Naini Lake', 'Naina Devi Temple', 'Tiffin Top', 'Sat Tal'],
    price: '₹6,500',
    priceNote: 'onwards per cab',
    badge: 'Family Favourite',
    badgeColor: '#0d9488',
    href: '/packages#nainital',
    img: NainitalImg,
  },
  {
    id: 'auli',
    name: 'Auli Snow Trip',
    nights: '2N',
    highlights: ['Skiing Slopes', 'Cable Car Ride', 'Gorson Bugyal', 'Nanda Devi Views'],
    price: '₹8,000',
    priceNote: 'onwards per cab',
    badge: 'Adventure',
    badgeColor: '#3b82f6',
    href: '/packages#auli',
    img: AuliImg,
  },
];
---


<section class="section" id="packages">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="section-label">Tourist Packages</p>
        <h2 class="section-title">Popular Uttarakhand Tour Packages</h2>
        <p class="section-sub">Explore Uttarakhand with curated travel packages for Char Dham Yatra, Mussoorie sightseeing, Rishikesh &amp; Haridwar tours, Nainital weekend trips and Auli snow adventures</p>
      </div>
      <a href="/packages" class="btn btn-outline view-all">View All Packages →</a>
    </div>

    <!-- Swipe hint — mobile only -->
    <div class="swipe-hint" id="pkg-swipe-hint" aria-hidden="true">
      <span>Swipe to explore packages</span>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <div class="pkg-grid">
      {packages.map(p => (
        <div class="pkg-card">
          <!-- Image -->
          <div class="pkg-img-wrap">
            <Image
              src={p.img}
              alt={p.name}
              width={320}
              height={180}
              class="pkg-img"
              loading="lazy"
            />
            <div class="pkg-overlay" aria-hidden="true"></div>
            <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.badge}</span>
            <span class="pkg-nights">{p.nights}</span>
          </div>

          <!-- Body -->
          <div class="pkg-body">
            <h3 class="pkg-name">{p.name}</h3>
            <ul class="pkg-highlights">
              {p.highlights.map(h => (
                <li>{h}</li>
              ))}
            </ul>
            <div class="pkg-footer">
              <div class="pkg-price-wrap">
                <span class="pkg-price">{p.price}</span>
                <span class="pkg-price-note">{p.priceNote}</span>
              </div>
              <div class="pkg-actions">
                <a href={p.href} class="btn btn-outline pkg-btn">View Package →</a>
                <a
                  href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20the%20${encodeURIComponent(p.name)}%20package`}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-whatsapp pkg-btn"
                >
                  Enquire
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- View all CTA bottom -->
    <div class="pkg-view-all">
      <a href="/packages" class="btn btn-teal">View all packages →</a>
    </div>

  </div>
</section>

<style>
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 28px;
  flex-wrap: wrap;
  gap: 16px;
}

/* Grid */
.pkg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

/* Card */
.pkg-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s, transform 0.2s;
}
.pkg-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

/* Image */
.pkg-img-wrap {
  position: relative;
  height: 180px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--teal-dark), var(--teal));
}

.pkg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.35s;
}
.pkg-card:hover .pkg-img { transform: scale(1.06); }

.pkg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 55%);
}

.pkg-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  letter-spacing: 0.3px;
  z-index: 1;
}

.pkg-nights {
  position: absolute;
  top: 12px;
  right: 12px;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  backdrop-filter: blur(4px);
  z-index: 1;
}

/* Body */
.pkg-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

.pkg-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--teal);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.2;
}

.pkg-highlights {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.pkg-highlights li {
  font-size: 12px;
  color: var(--muted);
  padding-left: 12px;
  position: relative;
}

.pkg-highlights li::before {
  content: '·';
  position: absolute;
  left: 0;
  color: var(--teal);
  font-weight: 700;
}

/* Footer */
.pkg-footer {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.pkg-price-wrap { display: flex; flex-direction: column; gap: 1px; }

.pkg-price {
  font-size: 20px;
  font-weight: 700;
  color: var(--teal);
  font-family: 'Playfair Display', serif;
  line-height: 1;
}

.pkg-price-note {
  font-size: 11px;
  color: var(--muted);
}

.pkg-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.pkg-btn {
  justify-content: center;
  padding: 9px 8px;
  font-size: 12px;
}

/* View all CTA */
.pkg-view-all {
  display: flex;
  justify-content: center;
}

/* Swipe hint — mobile only */
.swipe-hint {
  display: none;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--teal);
  margin-bottom: 10px;
  animation: fade-hint 3s ease forwards;
}
@keyframes fade-hint {
  0%   { opacity: 1; }
  70%  { opacity: 1; }
  100% { opacity: 0; }
}

/* Responsive */
@media (max-width: 1024px) {
  .pkg-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  /* Show swipe hint */
  .swipe-hint { display: flex; }

  /* Horizontal scroll with peek effect */
  .pkg-grid {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 12px;
    margin: 0 -20px;
    padding: 0 20px 8px;
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }
  .pkg-grid::-webkit-scrollbar { display: none; }
  .pkg-grid.scrolled-end {
    mask-image: none;
    -webkit-mask-image: none;
  }
  .pkg-card {
    flex-shrink: 0;
    width: 260px;
  }
  .view-all { width: 100%; justify-content: center; }
}
</style>

<script>
  const grid = document.querySelector('.pkg-grid') as HTMLElement;
  const hint = document.getElementById('pkg-swipe-hint');
  if (grid && hint) {
    grid.addEventListener('scroll', () => {
      hint.style.display = 'none';
      const atEnd = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 20;
      grid.classList.toggle('scrolled-end', atEnd);
    }, { passive: true });
  }
</script>
