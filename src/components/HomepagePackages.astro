---
import { Image } from 'astro:assets';

import CharDham  from '../assets/images/CharDham1.jpeg';
import Mussoorie from '../assets/images/Mussori1.jpeg';
import Rishikesh from '../assets/images/Hrisikesh1.jpeg';
import Nainital  from '../assets/images/Nainital.jpeg';
import HillStation from '../assets/images/HillStation.jpeg';

const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const packages = [
  {
    id: 'char-dham',
    name: 'Char Dham Yatra',
    emoji: '🙏',
    nights: '10 Nights',
    highlight: 'Yamunotri · Gangotri · Kedarnath · Badrinath',
    price: '₹18,000',
    priceNote: 'onwards per cab',
    badge: 'Most Popular',
    badgeColor: '#fb923c',
    href: '/char-dham-yatra',
    img: CharDham,
  },
  {
    id: 'mussoorie',
    name: 'Mussoorie Day Trip',
    emoji: '🏔️',
    nights: '1 Day',
    highlight: 'Mall Road · Kempty Falls · Gun Hill',
    price: '₹1,800',
    priceNote: 'onwards per cab',
    badge: 'Quick Getaway',
    badgeColor: '#0d9488',
    href: '/packages#mussoorie',
    img: Mussoorie,
  },
  {
    id: 'rishikesh',
    name: 'Rishikesh + Haridwar',
    emoji: '🌊',
    nights: '1 Night',
    highlight: 'Laxman Jhula · Ganga Aarti · Har ki Pauri',
    price: '₹2,500',
    priceNote: 'onwards per cab',
    badge: 'Spiritual',
    badgeColor: '#8b5cf6',
    href: '/packages#rishikesh',
    img: Rishikesh,
  },
  {
    id: 'nainital',
    name: 'Nainital Weekend',
    emoji: '🏞️',
    nights: '2 Nights',
    highlight: 'Naini Lake · Mall Road · Snow View Point',
    price: '₹6,500',
    priceNote: 'onwards per cab',
    badge: 'Family Favourite',
    badgeColor: '#0d9488',
    href: '/packages#nainital',
    img: Nainital,
  },
  {
    id: 'auli',
    name: 'Auli Snow Trip',
    emoji: '⛷️',
    nights: '2 Nights',
    highlight: 'Skiing · Ropeway · Gorson Bugyal',
    price: '₹8,000',
    priceNote: 'onwards per cab',
    badge: 'Adventure',
    badgeColor: '#3b82f6',
    href: '/packages#auli',
    img: HillStation,
  },
];
---

<section class="section" id="packages">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="section-label">Tourist Packages</p>
        <h2 class="section-title">Explore Uttarakhand Your Way</h2>
        <p class="section-sub">Curated tours with experienced hill drivers — all-inclusive cab packages</p>
      </div>
      <a href="/packages" class="btn btn-outline view-all">View All Packages →</a>
    </div>

    <div class="pkg-scroll">
      <div class="pkg-grid">
        {packages.map(p => (
          <div class="pkg-card">
            <div class="pkg-img-wrap">
              <Image
                src={p.img}
                alt={p.name}
                width={300}
                height={160}
                class="pkg-img"
                loading="lazy"
              />
              <div class="pkg-img-overlay" aria-hidden="true"></div>
              <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.badge}</span>
              <span class="pkg-nights">{p.nights}</span>
              <span class="pkg-emoji">{p.emoji}</span>
            </div>

            <div class="pkg-body">
              <h3 class="pkg-name">{p.name}</h3>
              <p class="pkg-highlight">{p.highlight}</p>
              <div class="pkg-price-row">
                <span class="pkg-price">{p.price}</span>
                <span class="pkg-price-note">{p.priceNote}</span>
              </div>
              <div class="pkg-actions">
                <a href={p.href} class="btn btn-outline pkg-btn">View Details</a>
                <a
                  href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20the%20${encodeURIComponent(p.name)}%20package`}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-whatsapp pkg-btn"
                >
                  Enquire
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 32px;
  flex-wrap: wrap;
  gap: 16px;
}

.pkg-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  margin: 0 -20px;
  padding: 0 20px 8px;
}
.pkg-scroll::-webkit-scrollbar { display: none; }

.pkg-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  min-width: 900px;
}

.pkg-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s, transform 0.2s;
}
.pkg-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

.pkg-img-wrap {
  position: relative;
  height: 150px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--teal-dark), var(--teal));
}

.pkg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}
.pkg-card:hover .pkg-img { transform: scale(1.05); }

.pkg-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
}

.pkg-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 2;
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 20px;
}

.pkg-nights {
  position: absolute;
  bottom: 10px;
  left: 10px;
  z-index: 2;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 11px;
  font-weight: 500;
  padding: 3px 8px;
  border-radius: 20px;
  backdrop-filter: blur(4px);
}

.pkg-emoji {
  position: absolute;
  bottom: 10px;
  right: 10px;
  z-index: 2;
  font-size: 22px;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pkg-body {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.pkg-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--slate);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.2;
}

.pkg-highlight {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.5;
}

.pkg-price-row {
  margin-top: auto;
  padding-top: 8px;
  border-top: 1px solid var(--border);
}

.pkg-price {
  font-size: 18px;
  font-weight: 700;
  color: var(--teal);
  font-family: 'Playfair Display', serif;
  display: block;
}

.pkg-price-note {
  font-size: 11px;
  color: var(--muted);
}

.pkg-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.pkg-btn {
  justify-content: center;
  padding: 9px 8px;
  font-size: 12px;
}

@media (max-width: 1100px) {
  .pkg-grid { grid-template-columns: repeat(3, 240px); }
}
@media (max-width: 768px) {
  .pkg-grid { grid-template-columns: repeat(2, 220px); gap: 12px; }
  .view-all { width: 100%; justify-content: center; }
}
</style>
