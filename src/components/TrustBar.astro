---
const stats = [
  { value: '10,000+', label: 'Happy Customers' },
  { value: '50+',     label: 'Destinations' },
  { value: '24/7',    label: 'Booking Support' },
  { value: '100%',    label: 'Transparent Pricing' },
  { value: '7+',      label: 'Years of Service' },
  { value: '1 hr',    label: 'Before Trip — Free Cancellation' },
];
---
<div class="trustbar">
  <div class="container trustbar-inner">
    {stats.map(s => (
      <div class="trust-item">
        <span class="trust-value">{s.value}</span>
        <span class="trust-label">{s.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
.trustbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}

.trustbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0;
  padding-top: 20px;
  padding-bottom: 20px;
}

.trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 8px 16px;
  flex: 1;
  min-width: 120px;
  position: relative;
}

.trust-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1px;
  background: var(--border);
}

.trust-value {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  color: var(--teal);
  font-weight: 700;
  line-height: 1;
  margin-bottom: 4px;
}

.trust-label {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
  line-height: 1.3;
}

@media (max-width: 768px) {
  .trustbar-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .trust-item:nth-child(3)::after,
  .trust-item:last-child::after { display: none; }
  .trust-item { padding: 12px 8px; }
  .trust-value { font-size: 18px; }
}

@media (max-width: 420px) {
  .trustbar-inner { grid-template-columns: repeat(2, 1fr); }
  .trust-item:nth-child(2)::after,
  .trust-item:nth-child(4)::after { display: none; }
}
</style>
