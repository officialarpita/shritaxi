---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const usps = [
  { icon: '⭐', value: '4.9 / 5.0', label: 'Google Rating',      href: null },
  { icon: '✓',  value: '30+',        label: 'Verified Reviews',   href: null },
  { icon: '🔒', value: '₹0',         label: 'Hidden Costs',       href: null },
  { icon: '🏔️', value: '50+',        label: 'Char Dham Trips',    href: null },
  { icon: '🗓️', value: '7+ Years',   label: 'Serving Uttarakhand', href: null },
  { icon: '🌿', value: 'Green',      label: 'Mission — Join Now', href: '/green-mission' },
];
---

<div class="trustbar">
  <div class="container trustbar-inner">
    {usps.map(u => (
      u.href
        ? <a href={u.href} class="trust-item trust-item--link" aria-label="Join Green Mission">
            <span class="trust-icon">{u.icon}</span>
            <span class="trust-value trust-value--green">{u.value}</span>
            <span class="trust-label">{u.label}</span>
            <span class="trust-arrow">→</span>
          </a>
        : <div class="trust-item">
            <span class="trust-icon">{u.icon}</span>
            <span class="trust-value">{u.value}</span>
            <span class="trust-label">{u.label}</span>
          </div>
    ))}
  </div>
</div>

<style>
.trustbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  padding: 0;
}

.trustbar-inner {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 0;
}

.trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 14px 10px;
  flex: 1;
  position: relative;
  gap: 2px;
}

.trust-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0; top: 20%; height: 60%;
  width: 1px; background: var(--border);
}

/* Green Mission — clickable tile */
.trust-item--link {
  text-decoration: none;
  background: #f0fdf4;
  border-left: 1px solid #bbf7d0;
  cursor: pointer;
  transition: background var(--transition);
}
.trust-item--link:hover { background: #dcfce7; }
.trust-item--link::after { display: none !important; }

.trust-icon  { font-size: 18px; line-height: 1; margin-bottom: 2px; }
.trust-value {
  font-family: var(--font-display);
  font-size: 16px;
  color: var(--teal);
  font-weight: 700;
  line-height: 1;
}
.trust-value--green { color: #16a34a; }
.trust-label { font-size: 11px; color: var(--muted); font-weight: 500; line-height: 1.3; }
.trust-arrow { font-size: 13px; font-weight: 700; color: #16a34a; margin-top: 1px; }

/* Mobile — 3×2 grid */
@media (max-width: 768px) {
  .trustbar-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .trust-item { padding: 12px 6px; }
  .trust-item:nth-child(3)::after,
  .trust-item:nth-child(6)::after { display: none; }
  .trust-value { font-size: 14px; }
  .trust-label { font-size: 10px; }
}

/* Small mobile — 2×3 grid */
@media (max-width: 420px) {
  .trustbar-inner { grid-template-columns: repeat(2, 1fr); }
  .trust-item:nth-child(2)::after,
  .trust-item:nth-child(4)::after { display: none; }
}
</style>
