---
import { Image } from 'astro:assets';
import { fleet } from '../data/fleet';
---

<section id="fleet" class="section">
  <div class="container">
    <div class="section-title">
      <h2>Our Fleet</h2>
      <p>Clean, well-maintained vehicles for every kind of trip.</p>
    </div>

    <div class="grid">
      {fleet.map((v) => (
        <article class="card vehicle">
          <div class="photo">
            <Image src={v.image} alt={v.name} widths={[240, 480]} sizes="(max-width: 480px) 100vw, (max-width: 900px) 50vw, 25vw" />
          </div>
          <h3>{v.name}</h3>
          <p class="segment">{v.segment}</p>
          <ul class="specs">
            <li><strong>{v.seats}</strong> seats</li>
            <li>{v.luggage}</li>
          </ul>
          <p class="best-for">{v.bestFor}</p>
          <a href="#book" class="book-link">Book {v.segment} →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .vehicle {
    display: flex;
    flex-direction: column;
  }
  .photo {
    aspect-ratio: 3 / 2;
    background: var(--snow);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .vehicle h3 { margin-bottom: 0.1rem; }
  .segment {
    display: inline-block;
    background: var(--gold);
    color: var(--forest-green);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin: 0 0 0.75rem;
    align-self: flex-start;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--mtn-grey);
  }
  .best-for { color: var(--asphalt); font-size: 0.9rem; margin-bottom: 1rem; }
  .book-link { color: var(--deep-green); font-weight: 600; margin-top: auto; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
