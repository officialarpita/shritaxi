---
const sections = [
  { href: '#mussoorie', label: '🏔️ Mussoorie', sub: 'Day trip' },
  { href: '#rishikesh', label: '🕌 Rishikesh + Haridwar', sub: '1 night' },
  { href: '#nainital',  label: '🏞️ Nainital',  sub: '2 nights' },
  { href: '#auli',      label: '⛷️ Auli Snow',  sub: '2 nights' },
  { href: '#char-dham', label: '🛕 Char Dham',  sub: '10 nights' },
];
---

<div class="pkg-nav">
  <div class="container">
    <p class="label">Jump to package</p>
    <div class="links">
      {sections.map((s) => (
        <a href={s.href} class="link">
          <span class="link-label">{s.label}</span>
          <span class="link-sub">{s.sub}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .pkg-nav {
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    padding: 16px 0;
    position: sticky;
    top: 60px;
    z-index: 40;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .label {
    font-size: 11px;
    color: #9ca3af;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .link {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    background: #f8faf9;
  }

  .link:hover {
    border-color: #1b6b3a;
    background: #eaf3de;
    text-decoration: none;
  }

  .link-label {
    font-size: 12px;
    font-weight: 500;
    color: #1b2b1e;
    white-space: nowrap;
  }

  .link-sub {
    font-size: 10px;
    color: #9ca3af;
  }

  @media (max-width: 600px) {
    .container {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
