---
interface Props {
  phone: string;
  waLink: string;
}
const { phone, waLink } = Astro.props;
---

<section class="pkg-hero">
  <div class="container">
    <p class="eyebrow"><span class="dot"></span>Dehradun · Uttarakhand · All Tour Packages</p>
    <h1>Explore Uttarakhand<br /><em>Your Way</em></h1>
    <p class="sub">
      Day trips, weekend getaways, pilgrimage routes &amp; snow adventures —
      all with verified drivers, AC vehicles, and transparent pricing from Dehradun.
    </p>
    <div class="ctas">
      <a href={waLink} class="btn btn-primary" target="_blank" rel="noopener">💬 WhatsApp us</a>
      <a href={`tel:${phone}`} class="btn btn-ghost">📞 Call Now</a>
    </div>
  </div>
</section>

<style>
  .pkg-hero {
    background: #1b2b1e;
    padding: 56px 0 48px;
    position: relative;
    overflow: hidden;
  }

  .pkg-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 1200 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolygon fill='%23ffffff06' points='0,100 200,30 400,70 600,10 800,55 1000,20 1200,60 1200,100'/%3E%3C/svg%3E");
    background-size: cover;
    pointer-events: none;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: 16px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8a020;
    flex-shrink: 0;
  }

  h1 {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700;
    color: #fff;
    line-height: 1.12;
    letter-spacing: -1px;
    margin-bottom: 16px;
  }

  h1 em {
    color: #e8a020;
    font-style: italic;
  }

  .sub {
    font-size: 15px;
    font-weight: 300;
    color: rgba(255,255,255,0.65);
    line-height: 1.75;
    max-width: 560px;
    margin-bottom: 28px;
  }

  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn:hover { opacity: 0.88; }

  .btn-primary { background: #e8a020; color: #1b2b1e; font-weight: 600; }
  .btn-ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.3); }
</style>
