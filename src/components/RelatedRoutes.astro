---
interface RelatedItem {
  title: string;
  href: string;
  price: string;
  duration: string;
  tag: string;
}

interface Props {
  currentPage: string;
  routes?: RelatedItem[];
  packages?: RelatedItem[];
}

const { currentPage, routes = [], packages = [] } = Astro.props;

// Combine routes + packages, filter self-links, limit to 4
const allItems = [...routes, ...packages].filter(r => r.href !== currentPage).slice(0, 6);

const tagColors: Record<string, string> = {
  'Hill Station': '#0d9488',
  'Spiritual':    '#8b5cf6',
  'Adventure':    '#3b82f6',
  'Airport':      '#fb923c',
  'Outstation':   '#fb923c',
  'Pilgrimage':   '#f59e0b',
  'Packages':     '#0d9488',
  'Wildlife':     '#16a34a',
  'Nature':       '#16a34a',
};
---

{allItems.length > 0 && (
<section class="related-routes">
  <div class="container">
    <h2 class="related-title">You May Also Like</h2>
    <p class="related-sub">More routes and packages with Shri Taxi — fixed price, all inclusive</p>
    <div class="related-scroll">
      {allItems.map(r => (
        <a href={r.href} class="related-card">
          <div class="related-card-inner">
            <span class="related-tag" style={`background:${tagColors[r.tag] || '#0d9488'}`}>{r.tag}</span>
            <h3 class="related-name">{r.title}</h3>
            <div class="related-meta">
              <span class="related-price">{r.price}</span>
              <span class="related-sep">·</span>
              <span class="related-duration">{r.duration}</span>
            </div>
            <span class="related-cta">Book Now →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<style>
.related-routes { background: #fff; padding: 32px 0; border-top: 3px solid var(--teal); }
.related-title { font-size: 20px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 4px; padding-left: 14px; border-left: 4px solid var(--teal); }
.related-sub { font-size: 13px; color: var(--muted); margin-bottom: 18px; }

/* Mobile — horizontal scroll strip */
.related-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 6px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.related-scroll::-webkit-scrollbar { display: none; }
.related-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  flex: 0 0 230px;
  min-width: 230px;
  transition: box-shadow 0.2s, transform 0.2s;
}
.related-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.related-card-inner { padding: 18px 16px; display: flex; flex-direction: column; gap: 8px; }
.related-tag { display: inline-block; color: #fff; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; width: fit-content; }
.related-name { font-size: 14px; font-weight: 700; color: var(--slate); line-height: 1.3; }
.related-meta { display: flex; align-items: center; gap: 6px; }
.related-price { font-size: 16px; font-weight: 700; color: var(--teal); font-family: 'Playfair Display', serif; }
.related-sep { color: var(--muted); font-size: 12px; }
.related-duration { font-size: 11px; color: var(--muted); }
.related-cta { font-size: 12px; font-weight: 600; color: var(--saffron); margin-top: 4px; }

/* Desktop — grid layout */
@media (min-width: 768px) {
  .related-routes { padding: 48px 0; }
  .related-title { font-size: 22px; }
  .related-scroll {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    overflow-x: visible;
    padding-bottom: 0;
  }
  .related-card { flex: unset; min-width: unset; }
}
</style>
