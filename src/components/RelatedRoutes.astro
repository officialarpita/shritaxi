---
interface RelatedItem {
  title: string;
  href: string;
  price: string;
  duration: string;
  tag: string;
}

interface Props {
  currentPage: string;
  routes?: RelatedItem[];
  packages?: RelatedItem[];
}

const { currentPage, routes = [], packages = [] } = Astro.props;

// Combine routes + packages, filter self-links, limit to 4
const allItems = [...routes, ...packages].filter(r => r.href !== currentPage).slice(0, 6);

const tagColors: Record<string, string> = {
  'Hill Station': '#0d9488',
  'Spiritual':    '#8b5cf6',
  'Adventure':    '#3b82f6',
  'Airport':      '#fb923c',
  'Outstation':   '#f59e0b',
  'Pilgrimage':   '#f59e0b',
  'Packages':     '#0d9488',
  'Wildlife':     '#16a34a',
  'Nature':       '#16a34a',
};

const tagColorsDark: Record<string, string> = {
  'Hill Station': '#0f766e',
  'Spiritual':    '#7c3aed',
  'Adventure':    '#2563eb',
  'Airport':      '#ea580c',
  'Outstation':   '#d97706',
  'Pilgrimage':   '#d97706',
  'Packages':     '#0f766e',
  'Wildlife':     '#15803d',
  'Nature':       '#15803d',
};

const tagIcons: Record<string, string> = {
  'Hill Station': '🏔️',
  'Spiritual':    '🙏',
  'Adventure':    '🏄',
  'Airport':      '✈️',
  'Outstation':   '🚗',
  'Pilgrimage':   '🕉️',
  'Packages':     '📦',
  'Wildlife':     '🐯',
  'Nature':       '🌿',
};
---

{allItems.length > 0 && (
<section class="related-routes">
  <div class="container">
    <h2 class="related-title">You May <span class="related-title-accent">Also Like</span></h2>
    <p class="related-sub">More routes and packages with Shri Taxi — fixed price, all inclusive</p>
    <div class="related-scroll">
      {allItems.map(r => (
        <a href={r.href} class="related-card">
          <div class="related-card-header" style={`background:linear-gradient(135deg,${tagColors[r.tag] || '#0d9488'},${tagColorsDark[r.tag] || '#0f766e'})`}>
            <span class="related-card-icon">{tagIcons[r.tag] || '🚗'}</span>
            <span class="related-tag-label">{r.tag}</span>
          </div>
          <div class="related-card-body">
            <h3 class="related-name">{r.title}</h3>
            <div class="related-meta">
              <span class="related-price">{r.price}</span>
              <span class="related-sep">·</span>
              <span class="related-duration">{r.duration}</span>
            </div>
            <span class="related-cta">Book Now →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<style>
.related-routes { background: #fff; padding: 32px 0; border-top: 3px solid var(--teal); }
.related-title { font-size: 22px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 4px; padding-left: 14px; border-left: 4px solid var(--teal); font-weight: 700; }
.related-title-accent { color: var(--teal); font-style: italic; }
.related-sub { font-size: 13px; color: var(--muted); margin-bottom: 18px; }

/* Mobile — horizontal scroll strip */
.related-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 6px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.related-scroll::-webkit-scrollbar { display: none; }
.related-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  flex: 0 0 200px;
  min-width: 200px;
  overflow: hidden;
  transition: box-shadow 0.25s, transform 0.25s;
}
.related-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.12); transform: translateY(-4px); }
.related-card-header {
  padding: 20px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-height: 80px;
}
.related-card-icon { font-size: 28px; line-height: 1; }
.related-tag-label { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.9); text-transform: uppercase; letter-spacing: 0.06em; }
.related-card-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
.related-name { font-size: 13px; font-weight: 700; color: var(--slate); line-height: 1.3; }
.related-meta { display: flex; align-items: center; gap: 6px; }
.related-price { font-size: 16px; font-weight: 700; color: var(--teal); font-family: 'Playfair Display', serif; }
.related-sep { color: var(--muted); font-size: 12px; }
.related-duration { font-size: 11px; color: var(--muted); }
.related-cta { font-size: 12px; font-weight: 600; color: var(--saffron); margin-top: 2px; }

/* Desktop — grid layout */
@media (min-width: 768px) {
  .related-routes { padding: 48px 0; }
  .related-title { font-size: 22px; }
  .related-scroll {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    overflow-x: visible;
    padding-bottom: 0;
  }
  .related-card { flex: unset; min-width: unset; }
}
</style>
