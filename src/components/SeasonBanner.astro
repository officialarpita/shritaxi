---
const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
// Char Dham closing date — Kedarnath closes first ~Nov 3, 2026
const closingDate = new Date('2026-11-03T00:00:00');
const now = new Date();
const isSeasonOpen = now < closingDate;
---

{isSeasonOpen && (
  <div class="season-banner" id="season-banner">
    <div class="container season-inner">
      <div class="season-left">
        <span class="season-icon">🙏</span>
        <div class="season-text">
          <strong>Char Dham 2026 Season is OPEN</strong>
          <span class="season-sub"> — Yamunotri, Gangotri, Kedarnath & Badrinath. Limited cabs available.</span>
        </div>
      </div>
      <div class="season-right">
        <div class="season-countdown" id="countdown">
          <div class="countdown-item"><span class="countdown-num" id="cd-days">00</span><span class="countdown-label">Days</span></div>
          <div class="countdown-sep">:</div>
          <div class="countdown-item"><span class="countdown-num" id="cd-hours">00</span><span class="countdown-label">Hrs</span></div>
          <div class="countdown-item"><span class="countdown-num" id="cd-mins">00</span><span class="countdown-label">Min</span></div>
        </div>
        <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Char%20Dham%20Yatra%202026`} target="_blank" rel="noopener" class="season-btn">Book Now →</a>
        <button class="season-close" id="season-close" aria-label="Close banner">✕</button>
      </div>
    </div>
  </div>
)}

<style>
.season-banner {
  background: linear-gradient(90deg, #0f766e, #0d9488);
  padding: 9px 0;
  border-bottom: 2px solid #f59e0b;
}
.season-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.season-left { display: flex; align-items: center; gap: 10px; flex: 1; }
.season-icon { font-size: 18px; flex-shrink: 0; }
.season-text { font-size: 13px; color: rgba(255,255,255,0.95); }
.season-text strong { color: #fff; }
.season-sub { color: rgba(255,255,255,0.8); }
.season-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }

/* Countdown */
.season-countdown { display: flex; align-items: center; gap: 4px; }
.countdown-item { display: flex; flex-direction: column; align-items: center; }
.countdown-num {
  font-size: 16px;
  font-weight: 700;
  color: #f59e0b;
  line-height: 1;
  font-family: 'DM Sans', sans-serif;
  min-width: 24px;
  text-align: center;
}
.countdown-label { font-size: 9px; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.5px; }
.countdown-sep { color: #f59e0b; font-weight: 700; font-size: 16px; margin-bottom: 10px; }

.season-btn {
  background: #f59e0b;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  padding: 6px 16px;
  border-radius: 20px;
  white-space: nowrap;
  transition: background 0.15s;
}
.season-btn:hover { background: #d97706; }
.season-close {
  background: none;
  border: none;
  color: rgba(255,255,255,0.6);
  font-size: 14px;
  cursor: pointer;
  padding: 4px;
  transition: color 0.15s;
}
.season-close:hover { color: #fff; }

@media (max-width: 768px) {
  .season-sub { display: none; }
  .season-countdown { display: none; }
  .season-banner { padding: 8px 0; }
  .season-text { font-size: 12px; }
}
@media (max-width: 480px) {
  .season-left { flex: 1; }
}
</style>

<script>
  // Countdown timer
  const closingDate = new Date('2026-11-03T00:00:00').getTime();

  function updateCountdown() {
    const now = Date.now();
    const diff = closingDate - now;
    if (diff <= 0) return;

    const days  = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins  = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

    const dEl = document.getElementById('cd-days');
    const hEl = document.getElementById('cd-hours');
    const mEl = document.getElementById('cd-mins');

    if (dEl) dEl.textContent = String(days).padStart(2, '0');
    if (hEl) hEl.textContent = String(hours).padStart(2, '0');
    if (mEl) mEl.textContent = String(mins).padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 60000);

  // Close banner
  document.getElementById('season-close')?.addEventListener('click', () => {
    const banner = document.getElementById('season-banner');
    if (banner) {
      banner.style.maxHeight = banner.offsetHeight + 'px';
      banner.style.transition = 'max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease';
      banner.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        banner.style.maxHeight = '0';
        banner.style.opacity = '0';
        banner.style.padding = '0';
      });
      setTimeout(() => banner.remove(), 350);
    }
  });
</script>
