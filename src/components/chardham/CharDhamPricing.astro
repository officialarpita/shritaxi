---
const dhams = [
  {
    id: 'ek-dham',
    title: 'One Dham Yatra Package',
    subtitle: 'Badrinath · Kedarnath · Gangotri · Yamunotri',
    description:
      'A one Dham yatra package is tailored for pilgrims looking to visit a single sacred site — Badrinath, Kedarnath, Gangotri, or Yamunotri. The package includes cab service for transportation to and from your chosen pilgrimage site, ensuring a convenient and comfortable journey. You can book from Delhi NCR (Gurgaon, Noida, Faridabad, Ghaziabad, Meerut, etc.), Haridwar, Rishikesh, or Dehradun.',
    rows: [
      { cab: 'Hatchback',     delhi: '₹4,696', dehradun: '₹4,325' },
      { cab: 'Sedan',         delhi: '₹4,943', dehradun: '₹4,325' },
      { cab: 'SUV',           delhi: '₹6,179', dehradun: '₹5,561' },
      { cab: 'Innova',        delhi: '₹8,033', dehradun: '₹6,797' },
      { cab: 'Innova Crysta', delhi: '₹8,033', dehradun: '₹7,415' },
    ],
  },
  {
    id: 'do-dham',
    title: 'Do Dham Yatra Package',
    subtitle: 'Kedarnath + Badrinath',
    description:
      'The Do Dham package covers the two most sacred and visited dhams — Kedarnath and Badrinath. Ideal for pilgrims with limited time who wish to complete the most spiritually significant circuit. Cab service covers the full route from your departure city back to your base. Accommodation and meals are not included.',
    rows: [
      { cab: 'Hatchback',     delhi: '₹5,200', dehradun: '₹4,800' },
      { cab: 'Sedan',         delhi: '₹5,500', dehradun: '₹4,900' },
      { cab: 'SUV',           delhi: '₹6,800', dehradun: '₹6,100' },
      { cab: 'Innova',        delhi: '₹8,800', dehradun: '₹7,500' },
      { cab: 'Innova Crysta', delhi: '₹9,200', dehradun: '₹8,000' },
    ],
  },
  {
    id: 'char-dham',
    title: 'Char Dham Yatra Package',
    subtitle: 'Yamunotri · Gangotri · Kedarnath · Badrinath',
    description:
      'The complete Char Dham circuit covers all four sacred abodes of Uttarakhand in the traditional pilgrimage order — Yamunotri, Gangotri, Kedarnath, and Badrinath. Our packages include a specialist hill driver experienced on all mountain routes, with full route coverage from your starting city. Registration assistance and on-trip support are included.',
    rows: [
      { cab: 'Hatchback',     delhi: '₹6,100', dehradun: '₹5,500' },
      { cab: 'Sedan',         delhi: '₹6,500', dehradun: '₹5,800' },
      { cab: 'SUV',           delhi: '₹8,200', dehradun: '₹7,200' },
      { cab: 'Innova',        delhi: '₹10,500', dehradun: '₹9,000' },
      { cab: 'Innova Crysta', delhi: '₹11,000', dehradun: '₹9,500' },
    ],
  },
  {
    id: 'group',
    title: 'Group / Tempo Traveller Package',
    subtitle: 'Best for families & groups of up to 12',
    description:
      'Our Tempo Traveller group package is ideal for large families or pilgrim groups travelling together. The vehicle comfortably seats 12+1 passengers with ample luggage space. A dedicated trip coordinator is assigned for the full journey. All four dhams are covered in the standard itinerary.',
    rows: [
      { cab: 'Tempo Traveller (12+1)', delhi: '₹12,500', dehradun: '₹10,800' },
      { cab: 'Luxury Tempo (14+1)',    delhi: '₹15,000', dehradun: '₹13,000' },
    ],
  },
];
---

<section class="cd-pricing">
  <div class="container">
    <p class="section-label">Detailed pricing</p>
    <h2>Per Day Cab Rates by Package</h2>
    <p class="section-sub">
      All rates are per vehicle per day. Toll, parking, and state taxes are
      charged at actuals. Prices vary by season — contact us for exact quotes.
    </p>

    <div class="packages">
      {dhams.map((d) => (
        <div class="pkg-block" id={d.id}>
          <div class="pkg-header">
            <h3>{d.title}</h3>
            <span class="pkg-sub">{d.subtitle}</span>
          </div>
          <p class="pkg-desc">{d.description}</p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Cab Type</th>
                  <th>Per Day from Delhi NCR</th>
                  <th>Per Day from Dehradun / Haridwar / Rishikesh</th>
                </tr>
              </thead>
              <tbody>
                {d.rows.map((row, i) => (
                  <tr class={i % 2 === 0 ? 'even' : ''}>
                    <td class="cab-name">{row.cab}</td>
                    <td class="price">{row.delhi}</td>
                    <td class="price">{row.dehradun}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="table-note">
            * Prices are indicative and subject to change. AC usage, driver
            allowance included. Toll &amp; parking extra.
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cd-pricing {
    padding: 56px 0;
    background: #fff;
    border-top: 0.5px solid #e5e7eb;
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #1b6b3a;
    margin-bottom: 6px;
  }

  h2 {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 28px;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;
  }

  .section-sub {
    font-size: 14px;
    color: #6b7280;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  /* ── Package blocks ── */
  .packages {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .pkg-block {
    scroll-margin-top: 80px;
  }

  .pkg-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .pkg-header h3 {
    font-size: 18px;
    font-weight: 700;
    color: #111;
    margin: 0;
  }

  .pkg-sub {
    font-size: 12px;
    color: #9ca3af;
    font-weight: 400;
  }

  .pkg-desc {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.75;
    margin-bottom: 20px;
    max-width: 820px;
  }

  /* ── Table ── */
  .table-wrap {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  thead tr {
    background: #1b6b3a;
  }

  thead th {
    color: #fff;
    font-weight: 600;
    font-size: 12px;
    padding: 13px 20px;
    text-align: center;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }

  thead th:first-child {
    text-align: left;
    border-radius: 9px 0 0 0;
  }

  thead th:last-child {
    border-radius: 0 9px 0 0;
  }

  tbody tr {
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.15s;
  }

  tbody tr:last-child {
    border-bottom: none;
  }

  tbody tr.even {
    background: #f8faf9;
  }

  tbody tr:hover {
    background: #eaf3de;
  }

  td {
    padding: 14px 20px;
    color: #374151;
  }

  .cab-name {
    font-weight: 500;
    color: #111;
    text-align: left;
  }

  .price {
    text-align: center;
    font-weight: 600;
    color: #1b6b3a;
    font-size: 14px;
  }

  /* ── Note ── */
  .table-note {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 10px;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    thead th,
    td {
      padding: 10px 12px;
      font-size: 12px;
    }
  }
</style>
