---
const stops = [
  { code: 'DDN', name: 'Dehradun', km: 'Start', active: true },
  { code: 'YMT', name: 'Yamunotri', km: '~175 km', active: true },
  { code: 'GNG', name: 'Gangotri', km: '~260 km', active: true },
  { code: 'KDR', name: 'Kedarnath', km: '~460 km', active: true },
  { code: 'BDR', name: 'Badrinath', km: '~540 km', active: true },
  { code: 'DDN', name: 'Dehradun', km: 'Return', active: false },
];
---

<section class="cd-route">
  <div class="container">
    <p class="section-label">Pilgrimage route</p>
    <h2>Complete circuit from Dehradun</h2>

    <div class="route-track">
      {stops.map((stop, i) => (
        <>
          <div class="stop">
            <div class={`stop-dot ${stop.active ? 'active' : 'return'}`}>
              {stop.code}
            </div>
            <div class="stop-name">{stop.name}</div>
            <div class="stop-km">{stop.km}</div>
          </div>
          {i < stops.length - 1 && (
            <div class={`line ${stop.active ? 'active' : ''}`} />
          )}
        </>
      ))}
    </div>

    <p class="note">
      All distances are approximate road distances from Dehradun. Actual travel
      time varies by weather and road conditions. Our drivers are experienced on
      all mountain routes.
    </p>
  </div>
</section>

<style>
  .cd-route {
    padding: 48px 0;
    background: #fff;
    border-top: 0.5px solid #e5e7eb;
    border-bottom: 0.5px solid #e5e7eb;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #1b6b3a;
    margin-bottom: 6px;
  }

  h2 {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 26px;
    font-weight: 700;
    color: #111;
    margin-bottom: 32px;
  }

  .route-track {
    display: flex;
    align-items: flex-start;
    gap: 0;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
    flex: 1;
  }

  .stop-dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    flex-shrink: 0;
  }

  .stop-dot.active {
    background: #1b2b1e;
    color: #e8a020;
  }

  .stop-dot.return {
    background: #e8a020;
    color: #1b2b1e;
  }

  .stop-name {
    font-size: 12px;
    font-weight: 500;
    color: #111;
    text-align: center;
  }

  .stop-km {
    font-size: 11px;
    color: #9ca3af;
    text-align: center;
    margin-top: 2px;
  }

  .line {
    flex: 1;
    height: 2px;
    background: #e5e7eb;
    margin-top: 22px;
    min-width: 16px;
  }

  .line.active {
    background: #e8a020;
  }

  .note {
    font-size: 12px;
    color: #9ca3af;
    margin-top: 20px;
    line-height: 1.6;
  }
</style>
