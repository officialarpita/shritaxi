---
interface Props {
  phone: string;
  waLink: string;
}
const { phone, waLink } = Astro.props;
---

<section class="cd-cta">
  <div class="container">
    <div class="inner">
      <div class="copy">
        <h2>Ready to begin your Char Dham Yatra?</h2>
        <p>
          Call or WhatsApp us — we'll plan everything from pickup to darshan.
          Our team responds within minutes, 24/7.
        </p>
      </div>
      <div class="btns">
        <a href={waLink} class="btn btn-primary" target="_blank" rel="noopener">
          💬 WhatsApp us
        </a>
        <a href={`tel:${phone}`} class="btn btn-ghost">📞 Call now</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cd-cta {
    padding: 48px 0;
    background: #f8faf9;
    border-top: 0.5px solid #e5e7eb;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .inner {
    background: #1b2b1e;
    border-radius: 14px;
    padding: 32px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
  }

  p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.65;
    max-width: 420px;
  }

  .btns {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .btn:hover {
    opacity: 0.88;
  }

  .btn-primary {
    background: #e8a020;
    color: #1b2b1e;
  }

  .btn-ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 600px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
  }
</style>
