---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/#packages', label: 'Packages' },
  { href: '/char-dham-yatra', label: 'Char Dham Yatra' },
  { href: '/#faq', label: 'FAQ' },
];

// A link is "active" if the current page path starts with the link's pathname
// We strip the hash from href to get just the pathname for comparison
function isActive(href: string): boolean {
  const path = href.split('#')[0]; // e.g. '/' or '/char-dham-yatra'
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header class="header">
  <div class="container inner">
    <a href="/" class="logo">
      <span class="logo-mark">🚕</span>
      <span class="logo-text">Shri Taxi</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>
    <nav class="nav" aria-label="Primary">
      <ul>
        {navLinks.map((l) => (
          <li>
            <a href={l.href} class={isActive(l.href) ? 'active' : ''}>
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/#book" class="btn btn-gold cta">Book Now</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.75rem;
    gap: 1rem;
  }

  /* ── Logo ── */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    color: var(--forest-green);
    font-size: 1.25rem;
    text-decoration: none;
  }

  .logo-mark {
    background: var(--gold);
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  /* ── Nav ── */
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    color: var(--asphalt);
    font-weight: 500;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .nav a:hover {
    color: var(--forest-green);
  }

  /* Active state — highlights current page link */
  .nav a.active {
    color: var(--forest-green);
    border-bottom: 2px solid var(--forest-green);
    font-weight: 600;
  }

  /* Book Now button — never gets active underline */
  .cta {
    padding: 0.5rem 1rem;
    border-bottom: none !important;
  }

  /* ── Mobile toggle — hidden on desktop ── */
  .nav-toggle,
  .burger {
    display: none;
  }

  @media (max-width: 820px) {
    .burger {
      display: flex;
      flex-direction: column;
      gap: 4px;
      cursor: pointer;
      padding: 0.5rem;
    }

    .burger span {
      width: 24px;
      height: 2px;
      background: var(--forest-green);
      border-radius: 2px;
      transition: transform 0.2s;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      padding: 1rem 1.25rem;
      box-shadow: var(--shadow-md);
      display: none;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .nav ul li {
      text-align: left;
    }

    /* Active underline becomes left border on mobile */
    .nav a.active {
      border-bottom: none;
      border-left: 3px solid var(--forest-green);
      padding-left: 8px;
    }

    .nav-toggle:checked ~ .nav {
      display: block;
    }
  }
</style>
