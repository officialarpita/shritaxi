---
const reasons = [
  {
    icon: '🏔️',
    title: 'Local Mountain Drivers',
    desc: 'Born and raised in Uttarakhand. Our drivers know every road, shortcut and safe route through the hills.',
  },
  {
    icon: '💰',
    title: 'Fixed Transparent Pricing',
    desc: 'Price quoted is price paid. No hidden charges, no surge pricing, no surprises at the end of your trip.',
  },
  {
    icon: '📞',
    title: '24/7 Support',
    desc: 'We are reachable before, during and after your trip. One number for everything — always on, always responsive.',
  },
];
---

<section class="section section--mint" id="why-us">
  <div class="container">
    <div class="why-head">
      <p class="section-label">Why Choose Us</p>
      <h2 class="section-title">We Make Your Journey Safe &amp; Comfortable</h2>
    </div>

    <div class="why-grid">
      {reasons.map((r, i) => (
        <div class="why-card">
          <div class="why-icon">{r.icon}</div>
          <div class="why-body">
            <h3 class="why-title">{r.title}</h3>
            <p class="why-desc">{r.desc}</p>
          </div>
          <div class="why-num">0{i + 1}</div>
        </div>
      ))}
    </div>

    <!-- Extra trust row -->
    <div class="trust-extras">
      <div class="trust-extra">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        Professional &amp; Verified Drivers
      </div>
      <div class="trust-extra">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        Neat, Clean &amp; Sanitized Vehicles
      </div>
      <div class="trust-extra">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        On-time Pickup &amp; Drop Guarantee
      </div>
      <div class="trust-extra">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--teal)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        1 Hour Free Cancellation Policy
      </div>
    </div>
  </div>
</section>

<style>
.why-head {
  margin-bottom: 40px;
  max-width: 520px;
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

.why-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.2s, transform 0.2s;
}
.why-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}

.why-icon {
  font-size: 40px;
  margin-bottom: 16px;
  display: block;
}

.why-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--slate);
  margin-bottom: 10px;
  font-family: 'DM Sans', sans-serif;
}

.why-desc {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.65;
}

.why-num {
  position: absolute;
  bottom: -10px;
  right: 16px;
  font-size: 64px;
  font-weight: 700;
  color: var(--teal);
  opacity: 0.06;
  font-family: 'Playfair Display', serif;
  line-height: 1;
  pointer-events: none;
}

/* Extra trust row */
.trust-extras {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px 24px;
}

.trust-extra {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--slate);
}

/* Responsive */
@media (max-width: 900px) {
  .why-grid { grid-template-columns: 1fr; gap: 14px; }
  .trust-extras { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 500px) {
  .trust-extras { grid-template-columns: 1fr; }
  .why-card { padding: 20px 18px; }
}
</style>
