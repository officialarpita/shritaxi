---
const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const faqs = [
  {
    q: 'Do you offer free cancellation?',
    a: 'Yes! You can cancel your booking for free up to 1 hour before your trip starts. No questions asked, full refund processed immediately.',
  },
  {
    q: 'How is pricing calculated? Are there hidden charges?',
    a: 'All our prices are fixed and transparent. The price quoted during booking is the final price — no hidden charges, no toll surprises, no extra fuel charges for hill routes.',
  },
  {
    q: 'Are hill station routes safe at night?',
    a: 'Yes. Our drivers are experienced mountain locals who know these routes in all weather conditions. We have a strict vehicle maintenance schedule and GPS tracking on all cabs.',
  },
  {
    q: 'How far in advance should I book a Char Dham taxi?',
    a: 'For airport transfers, 2-3 hours is enough. For Char Dham or multi-day packages we recommend booking at least 3-5 days in advance, especially during peak season (April–June).',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We accept cash, UPI (GPay, PhonePe, Paytm) and bank transfer. Full advance payment is not required — a small token amount confirms your booking.',
  },
  {
    q: 'Do you provide cabs from Delhi to Dehradun?',
    a: 'Yes! We operate outstation cabs between Delhi NCR and Dehradun, as well as from Delhi to all major Uttarakhand destinations including Mussoorie, Rishikesh, Haridwar and Char Dham.',
  },
];

// FAQ schema for Google featured snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<section class="section" id="faq">
  <div class="container faq-inner">

    <!-- Left -->
    <div class="faq-left">
      <p class="section-label">Frequently Asked</p>
      <h2 class="section-title">Got Questions?<br>We've Got Answers.</h2>
      <p class="section-sub">Still have doubts? WhatsApp us anytime — we reply within minutes.</p>
      <a
        href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20have%20a%20question`}
        target="_blank"
        rel="noopener"
        class="btn btn-whatsapp"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.106.549 4.09 1.508 5.814L.057 23.25l5.561-1.46A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.49-5.191-1.352l-.371-.22-3.301.867.881-3.22-.241-.393A10 10 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        Ask on WhatsApp
      </a>
    </div>

    <!-- Right: accordion -->
    <div class="faq-right">
      {faqs.map((f) => (
        <details class="faq-item" name="faq-group">
          <summary class="faq-q">
            <span>{f.q}</span>
            <svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>

  </div>
</section>

<!-- FAQ Schema for Google Featured Snippets -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<style>
.faq-inner {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 64px;
  align-items: start;
}

.faq-left .section-sub { margin-bottom: 24px; }

.faq-right {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1px solid var(--border);
}
.faq-item:first-child { border-top: 1px solid var(--border); }

.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  color: var(--slate);
  list-style: none;
  user-select: none;
  transition: color 0.15s;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-q:hover { color: var(--teal); }

.faq-chevron {
  flex-shrink: 0;
  color: var(--muted);
  transition: transform 0.25s, color 0.15s;
}

details[open] > .faq-q { color: var(--teal); }
details[open] > .faq-q .faq-chevron { transform: rotate(180deg); color: var(--teal); }

.faq-a {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.75;
  padding-bottom: 18px;
  padding-right: 36px;
}

@media (max-width: 900px) {
  .faq-inner { grid-template-columns: 1fr; gap: 32px; }
}

@media (max-width: 600px) {
  .faq-q { font-size: 14px; }
  .faq-a { padding-right: 0; }
}
</style>
