---
import { Image } from 'astro:assets';
import { services } from '../data/services';
---

<section id="services" class="section">
  <div class="container">
    <div class="section-title">
      <h2>Our Main Services</h2>
      <p>From airport drops to multi-day Char Dham tours — one number for everything.</p>
    </div>

    <div class="grid">
      {services.map((s) => (
        <article class="card item">
          <div class="thumb">
            <Image src={s.image} alt={s.title} widths={[96, 192]} sizes="96px" />
          </div>
          <h3>{s.title}</h3>
          <p>{s.blurb}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .item h3 { color: var(--forest-green); font-size: 1.05rem; margin-bottom: 0.25rem; }
  .item p { color: var(--mtn-grey); font-size: 0.9rem; margin: 0; }
  .thumb {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--snow);
    margin-bottom: 0.75rem;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
