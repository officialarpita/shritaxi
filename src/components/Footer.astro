---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const quickLinks = [
  { label: 'Home',           href: '/' },
  { label: 'About Us',       href: '/about' },
  { label: 'Our Fleet',      href: '/services#fleet' },
  { label: 'Packages',       href: '/packages' },
  { label: 'Contact Us',     href: '/#contact' },
];

const services = [
  { label: 'Airport Transfer',    href: '/services#airport' },
  { label: 'Local Taxi Service',  href: '/services#local' },
  { label: 'Outstation Cab',      href: '/services#outstation' },
  { label: 'Char Dham Yatra',     href: '/char-dham-yatra' },
  { label: 'Hill Station Tours',  href: '/packages' },
  { label: 'Corporate Travel',    href: '/services#corporate' },
];

const popularRoutes = [
  { label: 'Dehradun to Mussoorie',  href: '/#routes' },
  { label: 'Dehradun to Haridwar',   href: '/#routes' },
  { label: 'Dehradun to Rishikesh',  href: '/#routes' },
  { label: 'Dehradun to Nainital',   href: '/#routes' },
  { label: 'Airport to Dehradun',    href: '/#routes' },
  { label: 'Dehradun to Delhi',      href: '/#routes' },
];
---

<!-- CTA Banner above footer -->
<div class="footer-cta">
  <div class="container footer-cta-inner">
    <div class="footer-cta-text">
      <div class="footer-cta-icon">🚕</div>
      <div>
        <h3 class="footer-cta-title">Need a Taxi Right Now?</h3>
        <p class="footer-cta-sub">Call us or WhatsApp for instant booking — we confirm within minutes</p>
      </div>
    </div>
    <div class="footer-cta-btns">
      <a href={`tel:${phone}`} class="btn btn-call">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.49 12a19.79 19.79 0 01-3.07-8.67A2 2 0 013.4 1.27h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 9a16 16 0 006.29 6.29l1.79-1.79a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Call Now
      </a>
      <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.106.549 4.09 1.508 5.814L.057 23.25l5.561-1.46A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.49-5.191-1.352l-.371-.22-3.301.867.881-3.22-.241-.393A10 10 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        WhatsApp Us
      </a>
    </div>
  </div>
</div>

<!-- Main Footer -->
<footer class="footer" id="contact">
  <div class="container footer-grid">

    <!-- Brand column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="footer-logo-name">Shri Taxi</span>
        <span class="footer-logo-tag">Safe Journeys, Happy Memories</span>
      </a>
      <p class="footer-about">
        Dehradun-based taxi service covering Uttarakhand, hill stations, Char Dham routes and outstation trips across North India.
      </p>
      <div class="footer-contact-info">
        <a href={`tel:${phone}`} class="footer-contact-link">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.49 12a19.79 19.79 0 01-3.07-8.67A2 2 0 013.4 1.27h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 9a16 16 0 006.29 6.29l1.79-1.79a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          {phone}
        </a>
        <span class="footer-contact-link">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Dehradun, Uttarakhand, India
        </span>
        <span class="footer-contact-link">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          24/7 Available
        </span>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="footer-col">
      <h4 class="footer-col-title">Quick Links</h4>
      <ul class="footer-links">
        {quickLinks.map(l => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
      </ul>
    </div>

    <!-- Services -->
    <div class="footer-col">
      <h4 class="footer-col-title">Our Services</h4>
      <ul class="footer-links">
        {services.map(l => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
      </ul>
    </div>

    <!-- Popular Routes -->
    <div class="footer-col">
      <h4 class="footer-col-title">Popular Routes</h4>
      <ul class="footer-links">
        {popularRoutes.map(l => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
      </ul>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© 2026 Shri Taxi · All Rights Reserved</span>
      <div class="footer-legal">
        <a href="/privacy-policy" class="footer-legal-link">Privacy Policy</a>
        <span>·</span>
        <a href="/terms" class="footer-legal-link">Terms &amp; Conditions</a>
        <span>·</span>
        <a href="/sitemap-index.xml" class="footer-legal-link">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
/* ── CTA Banner ── */
.footer-cta {
  background: var(--teal);
  padding: 28px 0;
}

.footer-cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.footer-cta-text {
  display: flex;
  align-items: center;
  gap: 16px;
}

.footer-cta-icon { font-size: 32px; flex-shrink: 0; }

.footer-cta-title {
  font-size: 20px;
  color: #fff;
  font-family: 'Playfair Display', serif;
  margin-bottom: 3px;
}

.footer-cta-sub {
  font-size: 13px;
  color: rgba(255,255,255,0.75);
}

.footer-cta-btns {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

/* ── Main Footer ── */
.footer {
  background: var(--teal-dark);
  color: rgba(255,255,255,0.85);
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  padding-top: 48px;
  padding-bottom: 40px;
}

/* Brand */
.footer-logo {
  display: flex;
  flex-direction: column;
  margin-bottom: 14px;
}

.footer-logo-name {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  color: #fff;
  line-height: 1;
}

.footer-logo-tag {
  font-size: 11px;
  color: rgba(255,255,255,0.55);
  margin-top: 2px;
}

.footer-about {
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  line-height: 1.65;
  margin-bottom: 16px;
}

.footer-contact-info {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer-contact-link {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  transition: color 0.15s;
}
.footer-contact-link:hover { color: #fff; }

/* Columns */
.footer-col-title {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 16px;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-link {
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  transition: color 0.15s;
}
.footer-link:hover { color: var(--saffron-light); }

/* Bottom bar */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
}

.footer-bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  padding-bottom: 16px;
  font-size: 12px;
  color: rgba(255,255,255,0.45);
  flex-wrap: wrap;
  gap: 8px;
}

.footer-legal {
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer-legal-link {
  color: rgba(255,255,255,0.45);
  transition: color 0.15s;
}
.footer-legal-link:hover { color: rgba(255,255,255,0.8); }

/* Responsive */
@media (max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .footer-brand { grid-column: 1 / -1; }
}

@media (max-width: 600px) {
  .footer-grid { grid-template-columns: 1fr; gap: 24px; }
  .footer-cta-inner { flex-direction: column; align-items: flex-start; }
  .footer-cta-btns { width: 100%; }
  .footer-cta-btns .btn { flex: 1; justify-content: center; }
  .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
}
</style>
