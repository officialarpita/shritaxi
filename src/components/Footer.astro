---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
const year  = new Date().getFullYear();
---

<footer class="footer">

  <!-- Top CTA bar -->
  <div class="footer-cta">
    <div class="container footer-cta-inner">
      <div class="footer-cta-text">
        <h2>Ready to Book Your Uttarakhand Taxi?</h2>
        <p>Instant confirmation · No hidden costs · Pahadi drivers · 24/7</p>
      </div>
      <div class="footer-cta-btns">
        <a href={`tel:${phone}`} class="btn btn-saffron">📞 {phone}</a>
        <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Booking</a>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="footer-main">
    <div class="container footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/images/logo.png" alt="Shri Taxi" width="140" height="70" loading="lazy" />
        </a>
        <p class="footer-tagline">Pahadi Roots. Trusted Routes.</p>
        <p class="footer-desc">Reliable taxi service across Uttarakhand — Dehradun, Mussoorie, Haridwar, Rishikesh, Nainital and Char Dham Yatra 2026.</p>
        <div class="footer-trust">
          <span>⭐ 4.9 Rating</span>
          <span>·</span>
          <span>30+ Reviews</span>
          <span>·</span>
          <span>Since 2019</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h3 class="footer-col-title">Quick Links</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/cab-services">Cab Services</a></li>
          <li><a href="/popular-routes">Popular Routes</a></li>
          <li><a href="/packages">Tour Packages</a></li>
          <li><a href="/char-dham-yatra">Char Dham Yatra 2026</a></li>
          <li><a href="/faq">FAQs</a></li>
          <li><a href="/green-mission">Green Mission 🌿</a></li>
          <li><a href="/rewards">Shri Taxi Rewards 🏆</a></li>
        </ul>
      </div>

      <!-- Dehradun Routes -->
      <div class="footer-col">
        <h3 class="footer-col-title">From Dehradun</h3>
        <ul class="footer-links">
          <li><a href="/routes/dehradun-to-mussoorie">Dehradun → Mussoorie</a></li>
          <li><a href="/routes/dehradun-to-haridwar">Dehradun → Haridwar</a></li>
          <li><a href="/routes/dehradun-to-rishikesh">Dehradun → Rishikesh</a></li>
          <li><a href="/routes/jolly-grant-airport">Jolly Grant Airport</a></li>
          <li><a href="/routes/dehradun-to-nainital">Dehradun → Nainital</a></li>
          <li><a href="/routes/dehradun-to-chandigarh">Dehradun → Chandigarh</a></li>
        </ul>
      </div>

      <!-- Delhi Routes -->
      <div class="footer-col">
        <h3 class="footer-col-title">From Delhi & Chandigarh</h3>
        <ul class="footer-links">
          <li><a href="/routes/delhi-to-dehradun">Delhi → Dehradun</a></li>
          <li><a href="/routes/delhi-to-haridwar">Delhi → Haridwar</a></li>
          <li><a href="/routes/delhi-to-rishikesh">Delhi → Rishikesh</a></li>
          <li><a href="/routes/delhi-to-mussoorie">Delhi → Mussoorie</a></li>
          <li><a href="/routes/delhi-to-nainital">Delhi → Nainital</a></li>
          <li><a href="/routes/chandigarh-to-dehradun">Chandigarh → Dehradun</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {year} Shri Taxi · All Rights Reserved · Dehradun, Uttarakhand</p>
      <div class="footer-bottom-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <span>·</span>
        <a href="/terms">Terms of Service</a>
        <span>·</span>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </div>
  </div>

</footer>

<style>
.footer { background: #0f172a; color: rgba(255,255,255,0.75); }

/* CTA Bar */
.footer-cta { background: #0d9488; padding: 36px 0; }
.footer-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.footer-cta-text h2 { font-size: 22px; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 6px; }
.footer-cta-text p { font-size: 14px; color: rgba(255,255,255,0.8); }
.footer-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }

/* Main */
.footer-main { padding: 48px 0 32px; }
.footer-grid { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr; gap: 40px; }

/* Brand */
.footer-logo { display: inline-block; margin-bottom: 12px; }
.footer-logo img { filter: brightness(1.1); }
.footer-tagline { font-size: 13px; color: #f59e0b; font-weight: 600; font-style: italic; margin-bottom: 10px; }
.footer-desc { font-size: 13px; line-height: 1.7; color: rgba(255,255,255,0.6); margin-bottom: 14px; }
.footer-trust { display: flex; gap: 8px; font-size: 12px; color: rgba(255,255,255,0.5); }

/* Columns */
.footer-col-title { font-size: 13px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px; font-family: 'DM Sans', sans-serif; }
.footer-links { display: flex; flex-direction: column; gap: 8px; }
.footer-links a { font-size: 13px; color: rgba(255,255,255,0.6); transition: color 0.15s; }
.footer-links a:hover { color: #0d9488; }

/* Bottom */
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding: 16px 0; }
.footer-bottom-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.4); }
.footer-bottom-links { display: flex; align-items: center; gap: 8px; font-size: 12px; color: rgba(255,255,255,0.4); }
.footer-bottom-links a { color: rgba(255,255,255,0.4); transition: color 0.15s; }
.footer-bottom-links a:hover { color: rgba(255,255,255,0.7); }

/* Responsive */
@media (max-width: 1024px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; } }
@media (max-width: 600px) {
  .footer-grid { grid-template-columns: 1fr; gap: 24px; }
  .footer-cta-inner { flex-direction: column; text-align: center; }
  .footer-cta-btns { flex-direction: column; width: 100%; }
  .footer-cta-btns .btn { justify-content: center; }
  .footer-bottom-inner { flex-direction: column; text-align: center; }
}
</style>
