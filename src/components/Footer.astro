---
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+919999999999';
const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '+919999999999';
const waNumber = whatsapp.replace(/[^0-9]/g, '');
const year = new Date().getFullYear();

const serviceCities = ['Dehradun', 'Mussoorie', 'Haridwar', 'Rishikesh', 'Nainital', 'Auli', 'Chopta', 'Kedarnath', 'Badrinath', 'Jolly Grant Airport'];
---

<footer class="footer">
  <div class="container grid">
    <div>
      <div class="brand">
        <span class="mark">🚕</span>
        <strong>Shri Taxi</strong>
      </div>
      <p class="tag">Trusted taxi service in Dehradun and across Uttarakhand.</p>
    </div>

    <div>
      <h4>Contact</h4>
      <ul>
        <li><a href={`tel:${phone}`}>📞 {phone}</a></li>
        <li>
          <a
            href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Hi, I would like to book a taxi.')}`}
            target="_blank"
            rel="noopener"
          >💬 WhatsApp</a>
        </li>
        <li>24/7 booking support</li>
      </ul>
    </div>

    <div>
      <h4>Service Cities</h4>
      <ul class="cities">
        {serviceCities.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#fleet">Fleet</a></li>
        <li><a href="#routes">Popular Routes</a></li>
        <li><a href="#packages">Tour Packages</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </div>
  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <span>© {year} Shri Taxi. All rights reserved.</span>
      <span class="muted">Uttarakhand · Tourist Taxi Service</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--forest-green);
    color: var(--white);
    padding-top: 3rem;
    margin-top: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .brand { display: flex; align-items: center; gap: 0.5rem; font-size: 1.25rem; margin-bottom: 0.5rem; }
  .mark {
    background: var(--gold);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--forest-green);
    font-size: 1rem;
  }
  .tag { opacity: 0.85; margin: 0; }
  .footer h4 { color: var(--gold); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
  .footer ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.9rem; }
  .footer a { color: var(--white); opacity: 0.9; }
  .footer a:hover { opacity: 1; text-decoration: underline; }
  .cities {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 1rem !important;
  }
  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .muted { opacity: 0.7; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
    .bottom-inner { flex-direction: column; }
  }
</style>
