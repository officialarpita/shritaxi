---
import { testimonials, aggregateRating } from '../data/testimonials';

// Separate featured review from regular reviews
const featuredReview = testimonials.find((t) => t.featured);
const regularReviews = testimonials.filter((t) => !t.featured);

// Generate star rating HTML
function renderStars(rating: number) {
  return '⭐'.repeat(rating);
}

// Generate initials avatar background color based on name
function getAvatarColor(initials: string) {
  const colors = ['#1b6b3a', '#e8a020', '#2d5a3d', '#d97706', '#059669'];
  const index = initials.charCodeAt(0) % colors.length;
  return colors[index];
}

// Schema markup for SEO
const reviewsSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Shri Taxi - Dehradun Cab Service',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue.toString(),
    reviewCount: aggregateRating.reviewCount.toString(),
    bestRating: aggregateRating.bestRating.toString(),
    worstRating: aggregateRating.worstRating.toString(),
  },
  review: testimonials.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.author },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: t.rating.toString(),
      bestRating: '5',
      worstRating: '1',
    },
    reviewBody: t.quote,
    datePublished: t.date,
  })),
};
---

<section class="section reviews-section">
  <div class="container">
    <div class="section-title">
      <h2>What Travellers Say</h2>
      <p>Real experiences from tourists and corporate clients who've trusted us with their journeys.</p>
    </div>

    <!-- Featured Review (Hero Treatment) -->
    {featuredReview && (
      <div class="featured-review">
        <div class="avatar" style={`background: ${getAvatarColor(featuredReview.initials)}`}>
          {featuredReview.initials}
        </div>
        <div class="featured-content">
          <div class="featured-header">
            <div class="author-info">
              <strong class="author-name">{featuredReview.author}</strong>
              <span class="stars">{renderStars(featuredReview.rating)}</span>
              {featuredReview.verified && <span class="verified">✓ Verified</span>}
            </div>
            <span class="date">{featuredReview.date}</span>
          </div>
          <p class="quote">"{featuredReview.quote}"</p>
          <span class="context">{featuredReview.context}</span>
        </div>
      </div>
    )}

    <!-- Regular Reviews Grid -->
    <div class="grid">
      {regularReviews.map((t) => (
        <div class="review-card">
          <div class="card-header">
            <div class="avatar-small" style={`background: ${getAvatarColor(t.initials)}`}>
              {t.initials}
            </div>
            <div class="header-text">
              <strong class="author-name">{t.author}</strong>
              <div class="meta">
                <span class="stars">{renderStars(t.rating)}</span>
                {t.verified && <span class="verified-badge">✓</span>}
              </div>
            </div>
            <span class="date-small">{t.date}</span>
          </div>
          <p class="quote-text">"{t.quote}"</p>
          <span class="context-text">{t.context}</span>
        </div>
      ))}
    </div>

    <!-- Aggregate Rating & CTA -->
    <div class="reviews-footer">
      <div class="aggregate">
        <span class="rating-badge">{aggregateRating.ratingValue} ⭐</span>
        <div class="aggregate-text">
          <span class="aggregate-label">Rated by every traveller we've served</span>
          <span class="aggregate-sub">Trusted across Uttarakhand — Char Dham, hills & beyond</span>
        </div>
      </div>
      <div class="ctas">
        <a
          href="https://www.google.com/maps/search/shri+taxi+dehradun"
          target="_blank"
          rel="noopener"
          class="btn btn-outline"
        >
          ⭐ Rate us on Google
        </a>
        <a href="/#book" class="btn btn-primary">Book Your Ride →</a>
      </div>
    </div>

    <!-- Leave a Review nudge -->
    <div class="review-nudge">
      <div class="nudge-icon">🙏</div>
      <div class="nudge-text">
        <strong>Travelled with us recently?</strong>
        <p>Your honest review helps other pilgrims and travellers make the right choice — and helps us grow. It takes less than a minute.</p>
      </div>
      <a
        href="https://www.google.com/maps/search/shri+taxi+dehradun"
        target="_blank"
        rel="noopener"
        class="btn btn-gold"
      >
        Write a Review →
      </a>
    </div>

    <!-- Google Maps Embed -->
    <div class="maps-embed" aria-label="Our Google Maps listing">
      <p class="note">📍 Find us on Google Maps — see live reviews:</p>
      <iframe
        title="Shri Taxi on Google Maps"
        src="https://www.google.com/maps?q=taxi+service+dehradun&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<!-- Schema Markup for SEO -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(reviewsSchema)} />

<style>
  .reviews-section {
    background: var(--snow);
  }

  /* ── Featured Review ── */
  .featured-review {
    background: linear-gradient(135deg, #1b2b1e 0%, #2d5a3d 100%);
    border-radius: 14px;
    padding: 32px;
    margin-bottom: 24px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
    box-shadow: 0 4px 16px rgba(27, 43, 30, 0.15);
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 22px;
    color: #fff;
    flex-shrink: 0;
    border: 3px solid rgba(255, 255, 255, 0.2);
  }

  .featured-content {
    flex: 1;
  }

  .featured-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .author-name {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
  }

  .stars {
    font-size: 14px;
    line-height: 1;
  }

  .verified {
    background: rgba(232, 160, 32, 0.2);
    color: #e8a020;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 12px;
    letter-spacing: 0.3px;
  }

  .date {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  .featured-review .quote {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 12px;
    font-style: italic;
  }

  .featured-review .context {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  /* ── Regular Reviews Grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }

  .review-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: box-shadow 0.2s;
  }

  .review-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .avatar-small {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    color: #fff;
    flex-shrink: 0;
  }

  .header-text {
    flex: 1;
    min-width: 0;
  }

  .header-text .author-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #111;
    margin-bottom: 2px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta .stars {
    font-size: 12px;
    line-height: 1;
  }

  .verified-badge {
    color: #1b6b3a;
    font-size: 11px;
    font-weight: 600;
  }

  .date-small {
    font-size: 11px;
    color: #9ca3af;
    flex-shrink: 0;
  }

  .quote-text {
    font-size: 13px;
    line-height: 1.6;
    color: #374151;
    margin: 0;
    font-style: italic;
  }

  .context-text {
    font-size: 12px;
    color: #6b7280;
    font-weight: 500;
  }

  /* ── Reviews Footer ── */
  .reviews-footer {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .aggregate {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .rating-badge {
    background: #1b6b3a;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 8px;
    font-family: 'Outfit', sans-serif;
    white-space: nowrap;
  }

  .aggregate-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .aggregate-label {
    font-size: 14px;
    font-weight: 600;
    color: #111;
  }

  .aggregate-sub {
    font-size: 12px;
    color: #6b7280;
  }

  .ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .btn:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .btn-primary {
    background: #1b6b3a;
    color: #fff;
  }

  .btn-outline {
    background: transparent;
    color: #1b6b3a;
    border: 1.5px solid #1b6b3a;
  }

  .btn-gold {
    background: #e8a020;
    color: #fff;
    font-weight: 600;
  }

  /* ── Review Nudge Banner ── */
  .review-nudge {
    background: linear-gradient(135deg, #fffbf0 0%, #fef3c7 100%);
    border: 1.5px solid #e8a020;
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .nudge-icon {
    font-size: 28px;
    flex-shrink: 0;
  }

  .nudge-text {
    flex: 1;
    min-width: 200px;
  }

  .nudge-text strong {
    display: block;
    font-size: 15px;
    color: #92400e;
    margin-bottom: 4px;
  }

  .nudge-text p {
    font-size: 13px;
    color: #78350f;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Maps Embed ── */
  .maps-embed {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin-top: 8px;
  }

  .maps-embed .note {
    background: #f3f4f6;
    padding: 10px 16px;
    margin: 0;
    font-size: 13px;
    color: #6b7280;
  }

  .maps-embed iframe {
    width: 100%;
    height: 300px;
    border: 0;
    display: block;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .featured-review {
      flex-direction: column;
      padding: 24px;
    }

    .reviews-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .review-nudge {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .avatar {
      width: 48px;
      height: 48px;
      font-size: 18px;
    }
  }
</style>
