---
import { testimonials, aggregateRating } from '../data/testimonials';

const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const featuredReview = testimonials.find((t) => t.featured);
const regularReviews = testimonials.filter((t) => !t.featured);

function getAvatarColor(initials: string) {
  const colors = ['#0d9488', '#fb923c', '#0f766e', '#d97706', '#059669'];
  const index = initials.charCodeAt(0) % colors.length;
  return colors[index];
}

// Static placeholder — replaced dynamically by client-side JS
const proofFeed = [
  { name: 'Priya S.',   action: 'just booked Char Dham Yatra',     time: '2 hrs ago',  emoji: '🙏' },
  { name: 'Rahul M.',   action: 'booked Airport → Mussoorie',      time: '3 hrs ago',  emoji: '✈️' },
  { name: 'Anjali K.',  action: 'booked Nainital Weekend Package',  time: '5 hrs ago',  emoji: '🏞️' },
  { name: 'Vikram D.',  action: 'booked Corporate cab to Dehradun', time: 'yesterday',  emoji: '💼' },
  { name: 'Sunita R.',  action: 'booked Rishikesh + Haridwar Tour', time: 'yesterday',  emoji: '🌊' },
  { name: 'Amit P.',    action: 'booked Kedarnath taxi for family', time: '2 days ago', emoji: '⛩️' },
  { name: 'Meera T.',   action: 'booked Mussoorie Day Trip',        time: '2 days ago', emoji: '🏔️' },
  { name: 'Sanjay K.',  action: 'booked Outstation cab to Delhi',   time: '3 days ago', emoji: '🚗' },
];

// Schema
const reviewsSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Shri Taxi - Dehradun Cab Service',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue.toString(),
    reviewCount: aggregateRating.reviewCount.toString(),
    bestRating: aggregateRating.bestRating.toString(),
    worstRating: aggregateRating.worstRating.toString(),
  },
  review: testimonials.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.author },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: t.rating.toString(),
      bestRating: '5',
      worstRating: '1',
    },
    reviewBody: t.quote,
    datePublished: t.date,
  })),
};
---

<section class="section section--mint" id="reviews">
  <div class="container">

    <div class="section-head">
      <div>
        <p class="section-label">What Travellers Say</p>
        <h2 class="section-title">Real Experiences, Real Journeys</h2>
        <p class="section-sub">From pilgrims to corporate travellers — hear from those who've trusted us</p>
      </div>
      <div class="rating-badge-wrap">
        <div class="rating-badge">
          <span class="rating-num">{aggregateRating.ratingValue}</span>
          <div class="rating-stars">⭐⭐⭐⭐⭐</div>
          <span class="rating-label">Avg Rating</span>
        </div>
      </div>
    </div>

    <!-- ── Social Proof Notification (Booking.com style) ── -->
    <div class="proof-notification" id="proof-notification" aria-live="polite" aria-label="Recent booking">
      <div class="proof-dot" aria-hidden="true"></div>
      <span class="proof-emoji" id="proof-emoji">🙏</span>
      <div class="proof-body">
        <span class="proof-text" id="proof-text"><strong>Priya S.</strong> just booked Char Dham Yatra</span>
        <span class="proof-time" id="proof-time">2 hrs ago</span>
      </div>
      <span class="proof-live">Live</span>
    </div>

    <!-- SEO crawlable paragraph — visually subtle, keyword rich -->
    <p class="proof-seo">
      Trusted by thousands of travellers for Char Dham Yatra taxi bookings, Dehradun airport transfers, Mussoorie day trips, Rishikesh &amp; Haridwar tours and Uttarakhand hill station cab services.
    </p>

    <!-- ── Featured Review ── -->
    {featuredReview && (
      <div class="featured-review">
        <div class="avatar" style={`background: ${getAvatarColor(featuredReview.initials)}`}>
          {featuredReview.initials}
        </div>
        <div class="featured-content">
          <div class="featured-header">
            <div class="author-info">
              <strong class="author-name">{featuredReview.author}</strong>
              <span class="stars">{'⭐'.repeat(featuredReview.rating)}</span>
              {featuredReview.verified && <span class="verified">✓ Verified</span>}
            </div>
            <span class="review-date">{featuredReview.date}</span>
          </div>
          <p class="quote">"{featuredReview.quote}"</p>
          <span class="context">{featuredReview.context}</span>
        </div>
      </div>
    )}

    <!-- ── Regular Reviews Grid ── -->
    <div class="reviews-grid">
      {regularReviews.map((t) => (
        <div class="review-card">
          <div class="card-header">
            <div class="avatar-small" style={`background: ${getAvatarColor(t.initials)}`}>
              {t.initials}
            </div>
            <div class="header-text">
              <strong class="author-name-sm">{t.author}</strong>
              <div class="meta">
                <span class="stars-sm">{'⭐'.repeat(t.rating)}</span>
                {t.verified && <span class="verified-sm">✓</span>}
              </div>
            </div>
            <span class="date-sm">{t.date}</span>
          </div>
          <p class="quote-sm">"{t.quote}"</p>
          <span class="context-sm">{t.context}</span>
        </div>
      ))}
    </div>

    <!-- ── Footer: CTA + Nudge ── -->
    <div class="reviews-footer">
      <!-- Nudge banner -->
      <div class="review-nudge">
        <div class="nudge-icon">🙏</div>
        <div class="nudge-text">
          <strong>Travelled with us recently?</strong>
          <p>Your honest review helps other pilgrims and travellers make the right choice — and takes less than a minute.</p>
        </div>
        <a
          href="https://www.google.com/maps/search/shri+taxi+dehradun"
          target="_blank"
          rel="noopener"
          class="btn btn-saffron"
        >
          Write a Review →
        </a>
      </div>

      <!-- CTAs -->
      <div class="review-ctas">
        <a
          href="https://www.google.com/maps/search/shri+taxi+dehradun"
          target="_blank"
          rel="noopener"
          class="btn btn-outline"
        >
          ⭐ See Google Reviews
        </a>
        <a href="#booking" class="btn btn-teal">Book Your Ride →</a>
      </div>
    </div>

  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(reviewsSchema)} />

<style>
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
  flex-wrap: wrap;
  gap: 16px;
}

.rating-badge-wrap { flex-shrink: 0; }

.rating-badge {
  background: var(--teal);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 14px 20px;
  text-align: center;
  min-width: 100px;
}

.rating-num {
  display: block;
  font-size: 28px;
  font-weight: 700;
  font-family: 'Playfair Display', serif;
  line-height: 1;
}

.rating-stars { font-size: 13px; margin: 4px 0; }

.rating-label {
  font-size: 11px;
  opacity: 0.8;
}

/* ── Social Proof Strip ── */
.proof-strip {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 24px;
  overflow: hidden;
}

.proof-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 700;
  color: var(--teal);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ── Social Proof Notification ── */
.proof-notification {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
  transition: opacity 0.5s ease;
}

.proof-notification.fade {
  opacity: 0;
}

.proof-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  flex-shrink: 0;
  animation: pulse-dot 1.5s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.5; transform: scale(0.8); }
}

.proof-emoji { font-size: 20px; flex-shrink: 0; }

.proof-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.proof-text {
  font-size: 13px;
  color: var(--slate);
}

.proof-text strong { color: var(--teal); font-weight: 600; }

.proof-time {
  font-size: 11px;
  color: var(--muted);
}

.proof-live {
  font-size: 10px;
  font-weight: 700;
  color: #22c55e;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  padding: 2px 8px;
  border-radius: 20px;
  flex-shrink: 0;
  letter-spacing: 0.5px;
}

/* SEO paragraph — visible but subtle */
.proof-seo {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 20px;
  font-style: italic;
}

/* ── Featured Review ── */
.featured-review {
  background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  margin-bottom: 20px;
  display: flex;
  gap: 20px;
  align-items: flex-start;
}

.avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 20px;
  color: #fff;
  flex-shrink: 0;
  border: 2.5px solid rgba(255,255,255,0.25);
}

.featured-content { flex: 1; }

.featured-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
}

.author-info { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.author-name {
  font-size: 17px;
  font-weight: 600;
  color: #fff;
}

.stars { font-size: 13px; }

.verified {
  background: rgba(251,146,60,0.25);
  color: var(--saffron-light);
  font-size: 11px;
  font-weight: 600;
  padding: 2px 9px;
  border-radius: 12px;
}

.review-date { font-size: 12px; color: rgba(255,255,255,0.5); }

.quote {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(255,255,255,0.92);
  margin: 0 0 10px;
  font-style: italic;
}

.context {
  font-size: 12px;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
}

/* ── Reviews Grid ── */
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.review-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: box-shadow 0.2s;
}
.review-card:hover { box-shadow: var(--shadow-md); }

.card-header { display: flex; align-items: flex-start; gap: 10px; }

.avatar-small {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 13px;
  color: #fff;
  flex-shrink: 0;
}

.header-text { flex: 1; }

.author-name-sm {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--slate);
  margin-bottom: 2px;
}

.meta { display: flex; align-items: center; gap: 6px; }
.stars-sm { font-size: 11px; }
.verified-sm { font-size: 11px; color: var(--teal); font-weight: 600; }
.date-sm { font-size: 11px; color: #9ca3af; flex-shrink: 0; }

.quote-sm {
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
  margin: 0;
  font-style: italic;
}

.context-sm { font-size: 11px; color: var(--muted); font-weight: 500; }

/* ── Footer ── */
.reviews-footer {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.review-nudge {
  background: linear-gradient(135deg, #fffbf0, #fff7ed);
  border: 1.5px solid var(--saffron-light);
  border-radius: var(--radius-md);
  padding: 18px 22px;
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.nudge-icon { font-size: 26px; flex-shrink: 0; }

.nudge-text { flex: 1; min-width: 200px; }
.nudge-text strong { display: block; font-size: 14px; color: #92400e; margin-bottom: 3px; }
.nudge-text p { font-size: 12px; color: #78350f; margin: 0; line-height: 1.5; }

.btn-saffron { background: var(--saffron); color: #fff; }

.review-ctas {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .reviews-grid { grid-template-columns: repeat(2, 1fr); }
  .featured-review { flex-direction: column; padding: 20px; }
  .proof-strip { flex-direction: column; align-items: flex-start; gap: 8px; }
  .proof-track-wrap { width: 100%; }
}

@media (max-width: 600px) {
  .reviews-grid { grid-template-columns: 1fr; }
  .section-head { flex-direction: column; }
  .review-ctas { justify-content: flex-start; }
  .review-nudge { flex-direction: column; align-items: flex-start; }
}
</style>

