---
import { testimonials } from '../data/testimonials';
---

<section class="section reviews-section">
  <div class="container">
    <div class="section-title">
      <h2>What Travellers Say</h2>
      <p>Tourists and corporate clients who've trusted us with their trips.</p>
    </div>

    <div class="grid">
      {testimonials.map((t) => (
        <blockquote class="card quote">
          <p>"{t.quote}"</p>
          <footer>
            <strong>{t.author}</strong>
            <span>{t.context}</span>
          </footer>
        </blockquote>
      ))}
    </div>

    <div class="maps-embed" aria-label="Our Google Maps listing">
      <p class="note">See live reviews on Google Maps:</p>
      {/* Replace the q param below with the client's actual Google Business listing URL */}
      <iframe
        title="Shri Taxi on Google Maps"
        src="https://www.google.com/maps?q=taxi+service+dehradun&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .quote p { color: var(--asphalt); font-size: 0.975rem; margin: 0; line-height: 1.55; }
  .quote footer {
    border-top: 1px solid rgba(0,0,0,0.06);
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
  }
  .quote footer strong { color: var(--forest-green); }
  .quote footer span { color: var(--mtn-grey); font-size: 0.85rem; }
  .maps-embed {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .maps-embed .note {
    background: var(--card-grey);
    padding: 0.625rem 1rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--mtn-grey);
  }
  .maps-embed iframe {
    width: 100%;
    height: 300px;
    border: 0;
    display: block;
  }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
