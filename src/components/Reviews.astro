// Generate a realistic random time offset
function randomTime(): string {
  const minMinutes = 15;
  const maxMinutes = 60 * 72;
  const minutes = Math.floor(Math.random() * (maxMinutes - minMinutes)) + minMinutes;
  if (minutes < 60) return `${minutes} min ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours} hr${hours > 1 ? 's' : ''} ago`;
  const days = Math.floor(hours / 24);
  if (days === 1) return 'yesterday';
  return `${days} days ago`;
}

function pick<T>(arr: T[]): T {
  return arr[Math.floor(Math.random() * arr.length)];
}

function generateFeed(count = 20) {
  const usedNames = new Set<string>();
  const items = [];
  let attempts = 0;
  while (items.length < count && attempts < 100) {
    attempts++;
    const name = pick(NAMES);
    if (usedNames.has(name)) continue;
    usedNames.add(name);
    const action = pick(ACTIONS);
    items.push({ name, action: action.text, emoji: action.emoji, time: randomTime() });
  }
  return items;
}

// Notification rotation — Booking.com style
document.addEventListener('DOMContentLoaded', () => {
  const notification = document.getElementById('proof-notification');
  const emojiEl = document.getElementById('proof-emoji');
  const textEl = document.getElementById('proof-text');
  const timeEl = document.getElementById('proof-time');

  if (!notification || !emojiEl || !textEl || !timeEl) return;

  const feed = generateFeed(20);
  let index = 0;

  function showNext() {
    const item = feed[index % feed.length];
    index++;

    // Fade out
    notification.classList.add('fade');

    setTimeout(() => {
      // Update content
      emojiEl.textContent = item.emoji;
      textEl.innerHTML = `<strong>${item.name}</strong> ${item.action}`;
      timeEl.textContent = item.time;

      // Fade in
      notification.classList.remove('fade');
    }, 500);
  }

  // Show first item immediately then rotate every 5 seconds
  showNext();
  setInterval(showNext, 5000);
});
