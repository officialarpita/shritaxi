---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyBar from '../../components/StickyBar.astro';
import SeasonBanner from '../../components/SeasonBanner.astro';
import { blogPosts } from '../../data/blog';
// Simple inline markdown parser — no external dependency needed
function parseMarkdown(md: string): string {
  return md
    .split('\n\n')
    .map(block => {
      block = block.trim();
      if (!block) return '';
      if (block.startsWith('## '))  return '<h2>' + block.slice(3) + '</h2>';
      if (block.startsWith('### ')) return '<h3>' + block.slice(4) + '</h3>';
      // Bold
      block = block.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      return '<p>' + block.replace(/\n/g, '<br>') + '</p>';
    })
    .join('\n');
}

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const htmlContent = parseMarkdown(post.content);
const formattedDate = new Date(post.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

// Related posts — exclude current
const relatedPosts = blogPosts.filter(p => p.slug !== post.slug).slice(0, 2);

// JSON-LD schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  author: { '@type': 'Organization', name: 'Shri Taxi' },
  publisher: {
    '@type': 'Organization',
    name: 'Shri Taxi',
    url: 'https://shritaxi.com',
  },
  mainEntityOfPage: `https://shritaxi.com/blog/${post.slug}`,
};
---

<Base
  title={`${post.title} | Shri Taxi Blog`}
  description={post.description}
  canonicalUrl={`https://shritaxi.com/blog/${post.slug}`}
>
  <TopBar />
  <Header />
  <SeasonBanner />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main>
    <article class="blog-article">
      <div class="container">
        <div class="blog-article-header">
          <a href="/blog" class="blog-back">← All Posts</a>
          <div class="blog-article-meta">
            <span class="blog-article-category">{post.category}</span>
            <span class="blog-article-date">{formattedDate}</span>
            <span class="blog-article-read">{post.readTime}</span>
          </div>
          <h1 class="blog-article-title">{post.title}</h1>
          <p class="blog-article-desc">{post.description}</p>
        </div>

        <div class="blog-article-body" set:html={htmlContent} />

        <div class="blog-article-cta">
          <div class="blog-article-cta-inner">
            <p class="blog-article-cta-text">Ready to book your trip? Call or WhatsApp us — we confirm in minutes.</p>
            <div class="blog-article-cta-btns">
              <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp</a>
            </div>
          </div>
        </div>

        {relatedPosts.length > 0 && (
          <div class="blog-related">
            <h2 class="blog-related-title">More from our blog</h2>
            <div class="blog-related-grid">
              {relatedPosts.map(rp => (
                <a href={`/blog/${rp.slug}`} class="blog-related-card">
                  <span class="blog-related-cat">{rp.category}</span>
                  <h3 class="blog-related-name">{rp.title}</h3>
                  <span class="blog-related-read">{rp.readTime} →</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </article>
  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
.blog-article { padding: 40px 0 60px; }
.blog-article-header { max-width: 720px; margin: 0 auto 40px; text-align: center; }
.blog-back {
  display: inline-block;
  font-size: 13px;
  color: var(--teal);
  font-weight: 600;
  text-decoration: none;
  margin-bottom: 20px;
}
.blog-back:hover { text-decoration: underline; }
.blog-article-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}
.blog-article-category {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--teal);
  background: var(--mint);
  padding: 3px 10px;
  border-radius: 20px;
}
.blog-article-date, .blog-article-read {
  font-size: 13px;
  color: var(--muted);
}
.blog-article-title {
  font-size: clamp(26px, 4vw, 38px);
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  line-height: 1.25;
  margin-bottom: 14px;
}
.blog-article-desc {
  font-size: 16px;
  color: var(--muted);
  line-height: 1.7;
  max-width: 600px;
  margin: 0 auto;
}
.blog-article-body {
  max-width: 720px;
  margin: 0 auto;
  font-size: 16px;
  line-height: 1.8;
  color: var(--slate);
}
.blog-article-body h2 {
  font-size: 22px;
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  margin: 36px 0 14px;
}
.blog-article-body h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--slate);
  margin: 28px 0 10px;
}
.blog-article-body p {
  margin-bottom: 16px;
}
.blog-article-body strong {
  font-weight: 700;
  color: var(--slate);
}
.blog-article-cta {
  max-width: 720px;
  margin: 48px auto;
}
.blog-article-cta-inner {
  background: var(--teal);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  text-align: center;
}
.blog-article-cta-text {
  font-size: 16px;
  color: #fff;
  margin-bottom: 16px;
  line-height: 1.6;
}
.blog-article-cta-btns {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
.blog-related {
  max-width: 720px;
  margin: 0 auto;
  padding-top: 40px;
  border-top: 1px solid var(--border);
}
.blog-related-title {
  font-size: 20px;
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  margin-bottom: 20px;
}
.blog-related-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.blog-related-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  text-decoration: none;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.blog-related-card:hover {
  border-color: var(--teal);
  box-shadow: 0 4px 16px rgba(13,148,136,0.08);
}
.blog-related-cat {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--teal);
}
.blog-related-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--slate);
  line-height: 1.3;
}
.blog-related-read {
  font-size: 12px;
  color: var(--teal);
  font-weight: 600;
  margin-top: auto;
}
@media (max-width: 600px) {
  .blog-article { padding: 24px 0 40px; }
  .blog-article-title { font-size: 24px; }
  .blog-related-grid { grid-template-columns: 1fr; }
  .blog-article-cta-inner { padding: 20px; }
  .blog-article-cta-btns { flex-direction: column; }
  .blog-article-cta-btns .btn { justify-content: center; }
}
</style>
