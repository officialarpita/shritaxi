---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyBar from '../../components/StickyBar.astro';
import SeasonBanner from '../../components/SeasonBanner.astro';
import { blogPosts } from '../../data/blog';

// Simple inline markdown parser
function parseMarkdown(md: string): string {
  return md
    .split('\n\n')
    .map(block => {
      block = block.trim();
      if (!block) return '';
      if (block.startsWith('## '))  return '<h2>' + block.slice(3) + '</h2>';
      if (block.startsWith('### ')) return '<h3>' + block.slice(4) + '</h3>';
      if (block.startsWith('- ')) {
        const items = block.split('\n').filter(l => l.startsWith('- ')).map(l => '<li>' + l.slice(2) + '</li>').join('');
        return '<ul>' + items + '</ul>';
      }
      block = block.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      block = block.replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" class="blog-link">$1</a>');
      return '<p>' + block.replace(/\n/g, '<br>') + '</p>';
    })
    .join('\n');
}

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const htmlContent = parseMarkdown(post.content);
const formattedDate = new Date(post.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const relatedPosts = blogPosts.filter(p => p.slug !== post.slug).slice(0, 2);

// ── Article JSON-LD ──────────────────────────────────────
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.dateModified || post.date,
  image: post.ogImage || 'https://shritaxi.com/images/og.jpg',
  keywords: post.keywords || '',
  author: { '@type': 'Organization', name: 'Shri Taxi', url: 'https://shritaxi.com' },
  publisher: {
    '@type': 'Organization',
    name: 'Shri Taxi',
    url: 'https://shritaxi.com',
    logo: { '@type': 'ImageObject', url: 'https://shritaxi.com/images/logo.png' },
  },
  mainEntityOfPage: `https://shritaxi.com/blog/${post.slug}`,
};

// ── Breadcrumb JSON-LD ───────────────────────────────────
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shritaxi.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shritaxi.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.title, item: `https://shritaxi.com/blog/${post.slug}` },
  ],
};

// ── FAQPage JSON-LD (only if post has faqs) ──────────────
const faqSchema = post.faqs && post.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faqs.map((faq: { q: string; a: string }) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
} : null;
---

<Base
  title={`${post.title} | Shri Taxi Blog`}
  description={post.description}
  canonicalUrl={`https://shritaxi.com/blog/${post.slug}`}
  ogImage={post.ogImage || 'https://shritaxi.com/images/og.jpg'}
  ogType="article"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {faqSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  )}

  <TopBar />
  <Header />
  <SeasonBanner />

  <main>
    <article class="blog-article">
      <div class="container">

        <!-- Breadcrumb nav -->
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          <a href="/blog">Blog</a>
          <span>›</span>
          <span>{post.category}</span>
        </nav>

        <div class="blog-article-header">
          <div class="blog-article-meta">
            <span class="blog-article-category">{post.category}</span>
            <span class="blog-article-date">{formattedDate}</span>
            <span class="blog-article-read">{post.readTime}</span>
          </div>
          <h1 class="blog-article-title">{post.title}</h1>
          <p class="blog-article-desc">{post.description}</p>
        </div>

        <!-- Main content -->
        <div class="blog-article-body" set:html={htmlContent} />

        <!-- FAQ section (shown only if post has faqs) -->
        {post.faqs && post.faqs.length > 0 && (
          <div class="blog-faq">
            <h2 class="blog-faq-title">Frequently Asked Questions</h2>
            <div class="blog-faq-list">
              {post.faqs.map((faq: { q: string; a: string }) => (
                <details class="faq-item">
                  <summary class="faq-q">{faq.q}</summary>
                  <p class="faq-a">{faq.a}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- CTA -->
        <div class="blog-article-cta">
          <div class="blog-article-cta-inner">
            <p class="blog-article-cta-text">Ready to book your trip? Call or WhatsApp us — we confirm in minutes.</p>
            <div class="blog-article-cta-btns">
              <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp</a>
            </div>
          </div>
        </div>

        <!-- Related posts -->
        {relatedPosts.length > 0 && (
          <div class="blog-related">
            <h2 class="blog-related-title">More from our blog</h2>
            <div class="blog-related-grid">
              {relatedPosts.map(rp => (
                <a href={`/blog/${rp.slug}`} class="blog-related-card">
                  <span class="blog-related-cat">{rp.category}</span>
                  <h3 class="blog-related-name">{rp.title}</h3>
                  <span class="blog-related-read">{rp.readTime} →</span>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </article>
  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
/* ── Breadcrumb ── */
.blog-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--muted);
  padding: 16px 0 0;
  max-width: 720px;
  margin: 0 auto;
}
.blog-breadcrumb a { color: var(--teal); text-decoration: none; font-weight: 500; }
.blog-breadcrumb a:hover { text-decoration: underline; }
.blog-breadcrumb span { color: var(--muted); }

/* ── Article header ── */
.blog-article { padding: 24px 0 60px; }
.blog-article-header { max-width: 720px; margin: 20px auto 40px; text-align: center; }
.blog-article-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}
.blog-article-category {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--teal);
  background: var(--mint);
  padding: 3px 10px;
  border-radius: 20px;
}
.blog-article-date, .blog-article-read { font-size: 13px; color: var(--muted); }
.blog-article-title {
  font-size: clamp(26px, 4vw, 38px);
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  line-height: 1.25;
  margin-bottom: 14px;
}
.blog-article-desc {
  font-size: 16px;
  color: var(--muted);
  line-height: 1.7;
  max-width: 600px;
  margin: 0 auto;
}

/* ── Article body ── */
.blog-article-body {
  max-width: 720px;
  margin: 0 auto;
  font-size: 16px;
  line-height: 1.8;
  color: var(--slate);
}
.blog-article-body h2 {
  font-size: 22px;
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  margin: 36px 0 14px;
}
.blog-article-body h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--slate);
  margin: 28px 0 10px;
}
.blog-article-body p { margin-bottom: 16px; }
.blog-article-body strong { font-weight: 700; color: var(--slate); }
.blog-article-body ul { margin: 0 0 16px 20px; }
.blog-article-body li { margin-bottom: 6px; line-height: 1.7; }
.blog-link { color: var(--teal); font-weight: 600; text-decoration: underline; }
.blog-link:hover { color: #0f766e; }

/* ── FAQ section ── */
.blog-faq {
  max-width: 720px;
  margin: 48px auto;
  background: var(--mint);
  border: 1px solid var(--teal-light);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
}
.blog-faq-title {
  font-size: 22px;
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  margin-bottom: 20px;
}
.blog-faq-list { display: flex; flex-direction: column; gap: 12px; }
.faq-item {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.faq-q {
  font-size: 15px;
  font-weight: 700;
  color: var(--slate);
  padding: 16px 20px;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  transition: background 0.15s;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-q::after { content: '+'; font-size: 20px; color: var(--teal); flex-shrink: 0; transition: transform 0.2s; }
details[open] .faq-q { background: var(--mint); }
details[open] .faq-q::after { content: '−'; }
.faq-a {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.7;
  padding: 0 20px 16px;
  margin: 0;
}

/* ── CTA ── */
.blog-article-cta { max-width: 720px; margin: 48px auto; }
.blog-article-cta-inner {
  background: var(--teal);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  text-align: center;
}
.blog-article-cta-text { font-size: 16px; color: #fff; margin-bottom: 16px; line-height: 1.6; }
.blog-article-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* ── Related posts ── */
.blog-related {
  max-width: 720px;
  margin: 0 auto;
  padding-top: 40px;
  border-top: 1px solid var(--border);
}
.blog-related-title {
  font-size: 20px;
  font-family: 'Playfair Display', serif;
  color: var(--slate);
  margin-bottom: 20px;
}
.blog-related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.blog-related-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  text-decoration: none;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.blog-related-card:hover { border-color: var(--teal); box-shadow: 0 4px 16px rgba(13,148,136,0.08); }
.blog-related-cat { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--teal); }
.blog-related-name { font-size: 15px; font-weight: 700; color: var(--slate); line-height: 1.3; }
.blog-related-read { font-size: 12px; color: var(--teal); font-weight: 600; margin-top: auto; }

/* ── Mobile ── */
@media (max-width: 600px) {
  .blog-article { padding: 16px 0 40px; }
  .blog-article-title { font-size: 24px; }
  .blog-related-grid { grid-template-columns: 1fr; }
  .blog-article-cta-inner { padding: 20px; }
  .blog-article-cta-btns { flex-direction: column; }
  .blog-article-cta-btns .btn { justify-content: center; }
  .blog-faq { padding: 20px; }
}
</style>
