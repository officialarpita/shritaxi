---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyBar from '../../components/StickyBar.astro';
import SeasonBanner from '../../components/SeasonBanner.astro';
import { Image } from 'astro:assets';
import { tourPackages, fmt, delhiCharDhamTiers } from '../../data/pricing';

import CharDhamImg   from '../../assets/images/CharDham1.jpeg';
import NainitalImg   from '../../assets/images/Nainital2.jpg';
import AuliImg       from '../../assets/images/Auli_togo.jpg';
import KedarnathImg  from '../../assets/images/CharDham2.jpeg';
import BadrinathImg  from '../../assets/images/Badrinath.jpeg';
import NeemKaroliImg from '../../assets/images/NeemKaroli.jpeg';
import DhanaultiImg  from '../../assets/images/Dhanaulti.jpeg';
import MunsiyariImg  from '../../assets/images/Munsyari.jpeg';
import ChoptaImg     from '../../assets/images/Chopta.jpeg';
import ChakrataImg   from '../../assets/images/Chakrata.jpg';
import CorbettImg    from '../../assets/images/Corbett.jpg';
import MussoorieImg  from '../../assets/images/Mussori1.jpeg';

export async function getStaticPaths() {
  return tourPackages.map(p => ({
    params: { slug: p.id },
    props: { pkg: p },
  }));
}

const { pkg } = Astro.props;
const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

// Related packages — same destination keyword or circuit packages
const relatedIds: Record<string, string[]> = {
  'nainital':    ['nainital-corbett', 'nainital-ranikhet-corbett', 'mussoorie-corbett-nainital-ranikhet', 'almora-kausani'],
  'dhanaulti':   ['chakrata', 'chopta', 'neem-karoli'],
  'chakrata':    ['dhanaulti', 'chopta', 'neem-karoli'],
  'neem-karoli': ['kedarnath', 'chopta', 'nainital'],
  'auli':        ['munsiyari', 'chopta', 'kedarnath'],
  'chopta':      ['auli', 'munsiyari', 'kedarnath'],
  'munsiyari':   ['auli', 'chopta', 'kedarnath'],
  'kedarnath':   ['char-dham', 'do-dham', 'chopta'],
  'badrinath':   ['char-dham', 'do-dham', 'kedarnath'],
  'char-dham':   ['ek-dham', 'do-dham', 'kedarnath'],
  'ek-dham':     ['do-dham', 'char-dham', 'kedarnath'],
  'do-dham':     ['ek-dham', 'char-dham', 'kedarnath'],
  'nainital-corbett':                    ['jim-corbett-3d', 'jim-corbett', 'nainital-ranikhet-corbett', 'mussoorie-corbett-nainital-ranikhet'],
  'nainital-ranikhet-corbett':           ['nainital-corbett', 'jim-corbett-3d', 'mussoorie-corbett-nainital-ranikhet', 'almora-kausani'],
  'mussoorie-corbett-nainital-ranikhet': ['nainital-corbett', 'jim-corbett-3d', 'nainital-ranikhet-corbett', 'almora-kausani'],
  'almora-kausani':                      ['nainital-corbett', 'jim-corbett-3d', 'mussoorie-corbett-nainital-ranikhet', 'nainital-ranikhet-corbett'],
  'tehri':                               ['dhanaulti', 'chakrata', 'lansdowne'],
  'lansdowne':                           ['tehri', 'dhanaulti', 'chopta'],
  'mukteshwar':                          ['nainital', 'almora-kausani', 'nainital-corbett'],
  'jim-corbett':                         ['jim-corbett-3d', 'nainital-corbett', 'nainital-ranikhet-corbett'],
  'jim-corbett-3d':                      ['jim-corbett', 'nainital-corbett', 'nainital-ranikhet-corbett', 'mussoorie-corbett-nainital-ranikhet'],
};
const relatedPackages = (relatedIds[pkg.id] || [])
  .map(id => tourPackages.find(p => p.id === id))
  .filter(Boolean)
  .slice(0, 4);

// For day trip packages — show actual day trips including transfer routes
const dayTripYMYL: Record<string, Array<{name:string; href:string; price:string; tag:string; color:string; nd:string; highlights:string[]}>> = {
  'dhanaulti': [
    { name:'Mussoorie Day Trip',  href:'/dehradun-to-mussoorie-taxi', price:'₹3,000', tag:'Hill Station', color:'#0891b2', nd:'Day Trip', highlights:['Mall Road','Kempty Falls','Gun Hill'] },
    { name:'Haridwar Day Trip',   href:'/dehradun-to-haridwar-taxi',  price:'₹3,000', tag:'Spiritual',   color:'#f59e0b', nd:'Day Trip', highlights:['Har Ki Pauri','Ganga Aarti','Mansa Devi'] },
    { name:'Rishikesh Day Trip',  href:'/dehradun-to-rishikesh-taxi', price:'₹3,000', tag:'Adventure',   color:'#16a34a', nd:'Day Trip', highlights:['Laxman Jhula','Rafting','Triveni Ghat'] },
    { name:'Chakrata Day Trip',   href:'/packages/chakrata',          price:'₹3,599', tag:'Nature',      color:'#10b981', nd:'Day Trip', highlights:['Tiger Falls','Deoban Forest','Chilmiri Neck'] },
  ],
  'chakrata': [
    { name:'Mussoorie Day Trip',  href:'/dehradun-to-mussoorie-taxi', price:'₹3,000', tag:'Hill Station', color:'#0891b2', nd:'Day Trip', highlights:['Mall Road','Kempty Falls','Gun Hill'] },
    { name:'Haridwar Day Trip',   href:'/dehradun-to-haridwar-taxi',  price:'₹3,000', tag:'Spiritual',   color:'#f59e0b', nd:'Day Trip', highlights:['Har Ki Pauri','Ganga Aarti','Mansa Devi'] },
    { name:'Rishikesh Day Trip',  href:'/dehradun-to-rishikesh-taxi', price:'₹3,000', tag:'Adventure',   color:'#16a34a', nd:'Day Trip', highlights:['Laxman Jhula','Rafting','Triveni Ghat'] },
    { name:'Dhanaulti Day Trip',  href:'/packages/dhanaulti',         price:'₹3,599', tag:'Day Trip',    color:'#0d9488', nd:'Day Trip', highlights:['Eco Park','Surkanda Devi','Kanatal'] },
  ],
  'nainital': [
    { name:'Kainchi Dham Trip',       href:'/packages/neem-karoli', price:'₹7,199',  tag:'Spiritual',  color:'#8b5cf6', nd:'1N 2D', highlights:['Kainchi Dham Ashram','Bhowali Market','Naukuchiatal'] },
    { name:'Nainital & Mukteshwar',   href:'/packages/mukteshwar',  price:'₹13,999', tag:'Family',     color:'#0d9488', nd:'3N 4D', highlights:['Naini Lake','Mukteshwar Temple','Chauli Ki Jali'] },
    { name:'Lansdowne Tour',          href:'/packages/lansdowne',   price:'₹7,199',  tag:'Weekend',    color:'#16a34a', nd:'1N 2D', highlights:['Bhulla Lake','War Memorial','Tarkeshwar Temple'] },
    { name:'Pithoragarh & Munsiyari', href:'/packages/munsiyari',   price:'₹10,999', tag:'Hidden Gem', color:'#0891b2', nd:'2N 3D', highlights:['Pithoragarh Fort','Panchuli Peaks','Khaliya Top'] },
  ],
};
const isDayTrip = pkg.nights === 0;
const ymylItems = dayTripYMYL[pkg.id] || null;

const imgMap: Record<string, ImageMetadata> = {
  'dhanaulti': DhanaultiImg, 'neem-karoli': NeemKaroliImg,
  'nainital': NainitalImg, 'auli': AuliImg, 'munsiyari': MunsiyariImg,
  'chopta': ChoptaImg, 'kedarnath': KedarnathImg, 'badrinath': BadrinathImg,
  'ek-dham': KedarnathImg, 'do-dham': BadrinathImg, 'char-dham': CharDhamImg,
  'chakrata': ChakrataImg,
  'tehri': DhanaultiImg,
  'lansdowne': ChoptaImg,
  'mukteshwar': NainitalImg,
  'nainital-corbett':                    CorbettImg,
  'jim-corbett':                         CorbettImg,
  'jim-corbett-3d':                      CorbettImg,
  'mussoorie-corbett-nainital-ranikhet': MussoorieImg,
  'nainital-ranikhet-corbett':           NainitalImg,
  'almora-kausani':                      NainitalImg,
};
const img = imgMap[pkg.id] || CharDhamImg;

// Pickup city tiers — Delhi/Chandigarh adds ₹6,000 transfer surcharge
const dehradunTiers  = pkg.tiers;
const delhiTiers     = delhiCharDhamTiers(pkg.tiers);
const chandigarhTiers = delhiCharDhamTiers(pkg.tiers); // same differential as Delhi

const vehicleEmojis: Record<string, string> = {
  sedan: '🚗', ertiga: '🚐', innova: '🚙', traveller: '🚌',
};

// Use custom FAQs from pricing.ts if available, else fall back to generic
const pkgFaqs = pkg.faqs && pkg.faqs.length > 0 ? pkg.faqs : [
  { q: `What is included in ${pkg.name}?`, a: `${pkg.name} includes cab with experienced driver, fuel charges, toll and parking for all ${pkg.days} days. Hotel accommodation is arranged separately as per your preference.` },
  { q: `What is the starting price for ${pkg.name}?`, a: `${pkg.name} starts at ${fmt(pkg.tiers[0].discounted)} for ${pkg.tiers[0].vehicleName} (${pkg.nights}N ${pkg.days}D). This is after 10% discount. Price includes driver, fuel, toll and parking.` },
  { q: `Can I customize the ${pkg.name} itinerary?`, a: `Yes! We can customize the itinerary as per your pace and preferences. Extra days can be added at the per day rate of your chosen vehicle. Contact us on WhatsApp to discuss.` },
  { q: `How do I book ${pkg.name}?`, a: `Book via WhatsApp at +91 6397321825 or call us directly. Share your travel dates and preferred vehicle. We confirm within 15 minutes and share complete trip details.` },
  { q: `Are there any hidden charges in ${pkg.name}?`, a: `No hidden charges. The quoted price includes driver, fuel, toll and parking for all ${pkg.days} days. Hotel, meals and personal expenses are separate.` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: pkg.seoTitle,
  description: pkg.seoDesc,
  url: `https://shritaxi.com/packages/${pkg.id}`,
  touristType: 'Tourist',
  offers: {
    '@type': 'Offer',
    price: String(pkg.tiers[0].discounted),
    priceCurrency: 'INR',
    description: `${pkg.tiers[0].vehicleName} — ${pkg.nights}N ${pkg.days}D — All inclusive`,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pkgFaqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shritaxi.com' },
    { '@type': 'ListItem', position: 2, name: 'Packages', item: 'https://shritaxi.com/packages' },
    { '@type': 'ListItem', position: 3, name: pkg.name, item: `https://shritaxi.com/packages/${pkg.id}` },
  ],
};
---

<Base
  title={pkg.seoTitle}
  description={pkg.seoDesc}
  canonicalUrl={`https://shritaxi.com/packages/${pkg.id}`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- Hero -->
    <section class="pkg-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/packages" class="breadcrumb-back">← Packages</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/" class="breadcrumb-home">Home</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/packages" class="breadcrumb-link">Packages</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">{pkg.name}</span>
        </nav>
        <!-- Mobile: CTA buttons shown immediately, above fold -->
        <div class="pkg-mobile-bar">
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20${encodeURIComponent(pkg.name)}`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-mobile-btn">💬 Book Now</a>
          <a href={`tel:${phone}`} class="btn btn-saffron pkg-mobile-btn">📞 Call Us</a>
        </div>
        <div class="pkg-hero-content">
          <div class="pkg-hero-img-wrap">
            <Image src={img} alt={pkg.name} width={600} height={380} widths={[400,600,1200]} sizes="(max-width:640px) 400px,600px" format="webp" class="pkg-hero-img" loading="eager" fetchpriority="high" />
            <div class="pkg-hero-img-overlay"></div>
            <span class="pkg-hero-tag" style={`background:${pkg.badgeColor}`}>{pkg.tag}</span>
            <span class="pkg-hero-duration">{pkg.nights > 0 ? `${pkg.nights}N ` : ''}{pkg.days}D</span>
            <span class="pkg-hero-disc">10% OFF</span>
          </div>
          <div class="pkg-hero-info">
            <h1 class="pkg-hero-title">{pkg.name}</h1>
            <div class="pkg-hero-meta">
              <span class="pkg-meta-item">{pkg.nights > 0 ? `${pkg.nights}N ${pkg.days}D` : `${pkg.days}D`}</span>
              <span class="pkg-meta-sep">·</span>
              <span class="pkg-meta-item">⭐ 4.9</span>
              <span class="pkg-meta-sep">·</span>
              <span class="pkg-meta-item">🔒 All Inclusive</span>
            </div>
            <div class="pkg-highlights">
              {pkg.highlights.map(h => <span class="pkg-chip">{h}</span>)}
            </div>
            <div class="pkg-price-block">
              <p class="pkg-price-label">Starting from</p>
              <div class="pkg-price-row">
                <span class="pkg-mrp">{fmt(pkg.tiers[0].mrp)}</span>
                <span class="pkg-price">{fmt(pkg.tiers[0].discounted)}</span>
                <span class="pkg-save">Save {fmt(pkg.tiers[0].saving)}</span>
              </div>
              <p class="pkg-price-note">Per cab · {pkg.tiers[0].vehicleName} · {pkg.nights > 0 ? `${pkg.nights}N ${pkg.days}D` : `${pkg.days}D`}</p>
            </div>
            <p class="pkg-incl">✓ Driver · Fuel · Toll · Parking · All inclusive</p>
            <div class="pkg-ctas">
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20${encodeURIComponent(pkg.name)}`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">💬 Book Now</a>
              <a href={`tel:${phone}`} class="btn btn-saffron btn-lg">📞 Call Us</a>
            </div>
            <div class="pkg-trust-row">
              <span>⭐ 4.9 · 30+ Reviews</span>
              
              <span>🏆 Earn Points</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AEO Answer Block -->
    <section class="aeo-block">
      <div class="container">
        <p class="route-answer">
          <strong>{pkg.name}</strong> starts at <strong>{fmt(pkg.tiers[0].discounted)}</strong> for {pkg.tiers[0].vehicleName} ({pkg.nights > 0 ? `${pkg.nights}N ` : ''}{pkg.days}D). All inclusive — driver, fuel, toll and parking. 10% discount applied. No hidden costs. Book via WhatsApp or call +91 6397321825 for instant confirmation.
        </p>
      </div>
    </section>

    <!-- Mobile Tabs Nav (hidden on desktop) -->
    <nav class="pkg-tabs" id="pkg-tabs" aria-label="Package sections">
      <button class="pkg-tab-btn active" data-tab="vehicles">🚗 Vehicles</button>
      <button class="pkg-tab-btn" data-tab="itinerary">🗺️ Itinerary</button>
      <button class="pkg-tab-btn" data-tab="included">✓ Included</button>
      <button class="pkg-tab-btn" data-tab="faq">❓ FAQ</button>
    </nav>

    <!-- All Vehicle Prices -->
    <section class="pkg-section pkg-tab-section" id="tab-vehicles">
      <div class="container">
        <div class="section-header">
          <p class="section-label">All Vehicle Options</p>
          <h2 class="section-title">Choose Your Vehicle</h2>
          <p class="section-sub">All prices include 10% discount. All inclusive — no hidden costs.</p>
        </div>

        <!-- Pickup City Selector -->
        <div class="pickup-tabs" id="pickup-tabs" role="tablist">
          <button class="pickup-tab active" data-city="dehradun" role="tab" aria-selected="true">
            📍 From Dehradun
          </button>
          <button class="pickup-tab" data-city="delhi" role="tab" aria-selected="false">
            🏙️ From Delhi NCR
          </button>
          <button class="pickup-tab" data-city="chandigarh" role="tab" aria-selected="false">
            🏙️ From Chandigarh
          </button>
        </div>
        <p class="pickup-note" id="pickup-note" style="display:none;">
          ✈️ Includes pickup from your city to Dehradun + return transfer
        </p>

        <div class="tiers-grid" id="tiers-dehradun">
          {dehradunTiers.map((t, i) => (
            <div class={`tier-card${i === 2 ? ' tier-card--popular' : ''}`}>
              {i === 2 && <div class="tier-popular">Most Popular</div>}
              <div class="tier-emoji">{vehicleEmojis[t.vehicleId] || '🚗'}</div>
              <h3 class="tier-name">{t.vehicleName}</h3>
              <p class="tier-seats">{t.seats}+1 passengers</p>
              <div class="tier-price-block">
                <span class="tier-mrp">{fmt(t.mrp)}</span>
                <span class="tier-price">{fmt(t.discounted)}</span>
              </div>
              <span class="tier-save">Save {fmt(t.saving)}</span>
              <p class="tier-duration">{pkg.nights > 0 ? `${pkg.nights}N ` : ''}{pkg.days}D · All inclusive</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20${encodeURIComponent(pkg.name)}%20in%20${encodeURIComponent(t.vehicleName)}`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-full">💬 Book {t.vehicleName}</a>
            </div>
          ))}
        </div>

        <!-- Delhi NCR tiers -->
        <div class="tiers-grid" id="tiers-delhi" style="display:none;">
          {delhiTiers.map((t, i) => (
            <div class={`tier-card${i === 2 ? ' tier-card--popular' : ''}`}>
              {i === 2 && <div class="tier-popular">Most Popular</div>}
              <div class="tier-emoji">{vehicleEmojis[t.vehicleId] || '🚗'}</div>
              <h3 class="tier-name">{t.vehicleName}</h3>
              <p class="tier-seats">{t.seats}+1 passengers</p>
              <div class="tier-price-block">
                <span class="tier-mrp">{fmt(t.mrp)}</span>
                <span class="tier-price">{fmt(t.discounted)}</span>
              </div>
              <span class="tier-save">Save {fmt(t.saving)}</span>
              <p class="tier-duration">{pkg.nights > 0 ? `${pkg.nights}N ` : ''}{pkg.days}D · All inclusive</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20${encodeURIComponent(pkg.name)}%20from%20Delhi%20NCR%20in%20${encodeURIComponent(t.vehicleName)}`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-full">💬 Book {t.vehicleName}</a>
            </div>
          ))}
        </div>

        <!-- Chandigarh tiers -->
        <div class="tiers-grid" id="tiers-chandigarh" style="display:none;">
          {chandigarhTiers.map((t, i) => (
            <div class={`tier-card${i === 2 ? ' tier-card--popular' : ''}`}>
              {i === 2 && <div class="tier-popular">Most Popular</div>}
              <div class="tier-emoji">{vehicleEmojis[t.vehicleId] || '🚗'}</div>
              <h3 class="tier-name">{t.vehicleName}</h3>
              <p class="tier-seats">{t.seats}+1 passengers</p>
              <div class="tier-price-block">
                <span class="tier-mrp">{fmt(t.mrp)}</span>
                <span class="tier-price">{fmt(t.discounted)}</span>
              </div>
              <span class="tier-save">Save {fmt(t.saving)}</span>
              <p class="tier-duration">{pkg.nights > 0 ? `${pkg.nights}N ` : ''}{pkg.days}D · All inclusive</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20${encodeURIComponent(pkg.name)}%20from%20Chandigarh%20in%20${encodeURIComponent(t.vehicleName)}`} target="_blank" rel="noopener" class="btn btn-whatsapp btn-full">💬 Book {t.vehicleName}</a>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Itinerary if available -->
    {pkg.itinerary && pkg.itinerary.length > 0 && (
      <section class="pkg-section pkg-section--mint pkg-tab-section" id="tab-itinerary">
        <div class="container">
          <div class="section-header">
            <p class="section-label">Day by Day</p>
            <h2 class="section-title">Trip Itinerary</h2>
          </div>
          <div class="itinerary-list">
            {pkg.itinerary.map((day, i) => (
              <div class="itinerary-item">
                <div class="itinerary-day">Day {i + 1}</div>
                <div class="itinerary-text">{day}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- What's Included -->
    {pkg.includes && pkg.includes.length > 0 && (
      <section class="pkg-section pkg-tab-section" id="tab-included">
        <div class="container">
          <h2 class="section-title" style="margin-bottom:20px;">What's Included</h2>
          <div class="includes-grid">
            {pkg.includes.map(inc => (
              <div class="include-item">
                <span class="include-check">✓</span>
                <span>{inc}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="pkg-section pkg-section--light pkg-tab-section" id="tab-faq">
      <div class="container">
        <h2 class="section-title" style="margin-bottom:24px;">{pkg.name} — FAQs</h2>
        <div class="faq-list" style="max-width:780px;">
          {pkgFaqs.map(f => (
            <details class="faq-item" name="pkg-faq">
              <summary class="faq-q">
                {f.q}
                <svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- You Might Also Like -->
    {(ymylItems || relatedPackages.length > 0) && (
      <section class="pkg-section pkg-section--mint">
        <div class="container">
          <div class="section-header">
            <p class="section-label">You Might Also Like</p>
            <h2 class="section-title">{isDayTrip ? 'More Day Trips from Dehradun' : 'You Might Also Like'}</h2>
            <p class="section-sub">{isDayTrip ? 'Other popular same-day escapes at similar prices' : 'Explore more Uttarakhand tour options for your group'}</p>
          </div>
          <a href="/packages" class="related-view-all">View All Packages →</a>

          {ymylItems && (
            <div class="related-grid pkg-related-scroll">
              {ymylItems.map(item => (
                <a href={item.href} class="related-card card">
                  <div class="related-header" style={`background:linear-gradient(135deg,${item.color},#0f172a)`}>
                    <span class="related-tag">{item.tag}</span>
