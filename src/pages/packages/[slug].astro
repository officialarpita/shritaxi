<script>
  // Pickup city tab switcher
  const tabs = document.querySelectorAll('.pickup-tab');
  const note = document.getElementById('pickup-note');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update tab states
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected','true');

      const city = tab.getAttribute('data-city');

      // Show/hide tiers grids
      ['dehradun','delhi','chandigarh'].forEach(c => {
        const grid = document.getElementById(`tiers-${c}`);
        if (grid) grid.style.display = c === city ? 'grid' : 'none';
      });

      // Show transfer note for non-Dehradun
      if (note) note.style.display = city !== 'dehradun' ? 'block' : 'none';
    });
  });

// ── Mobile Tab Switching ───────────────────────────────────────
function initPkgTabs() {
  const tabs = document.querySelectorAll('.pkg-tab-btn');
  const sections = document.querySelectorAll('.pkg-tab-section');
  if (!tabs.length) return;

  // Show first tab by default on mobile
  function isMobile() { return window.innerWidth < 768; }

  function activateTab(tabName) {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabName));
    sections.forEach(s => {
      if (isMobile()) {
        s.classList.toggle('tab-active', s.id === `tab-${tabName}`);
      } else {
        s.classList.add('tab-active'); // show all on desktop
      }
    });
  }

  // Init — activate first tab on mobile
  if (isMobile()) {
    sections.forEach(s => s.classList.remove('tab-active'));
    const firstTab = tabs[0]?.dataset.tab;
    if (firstTab) activateTab(firstTab);
  }

  tabs.forEach(btn => {
    btn.addEventListener('click', () => activateTab(btn.dataset.tab));
  });

  // Re-check on resize
  window.addEventListener('resize', () => {
    if (!isMobile()) {
      sections.forEach(s => s.classList.add('tab-active'));
    }
  });
}

document.addEventListener('DOMContentLoaded', initPkgTabs);

</script>
