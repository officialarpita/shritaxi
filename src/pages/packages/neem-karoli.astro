---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyBar from '../../components/StickyBar.astro';
import SeasonBanner from '../../components/SeasonBanner.astro';
import { tourPackages, fmt } from '../../data/pricing';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';
const pkg   = tourPackages.find(p => p.id === 'neem-karoli')!;

const vNames: Record<string,string> = { sedan:'Sedan', ertiga:'Maruti Ertiga', innova:'Innova Crysta', traveller:'Tempo Traveller' };
const vIcons: Record<string,string> = { sedan:'🚗', ertiga:'🚐', innova:'🚙', traveller:'🚌' };
const vSeats: Record<string,string> = { sedan:'4 seats', ertiga:'6 seats', innova:'6–7 seats', traveller:'12 seats' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: pkg.seoTitle,
  description: pkg.seoDesc,
  offers: pkg.tiers.map(t => ({
    '@type': 'Offer', price: t.discounted, priceCurrency: 'INR', name: vNames[t.vehicleId],
  })),
};
---

<Base
  title="Neem Karoli Baba Kainchi Dham Taxi | 2 Days from Dehradun | Shri Taxi"
  description="Visit Kainchi Dham Ashram of Neem Karoli Baba from Dehradun. 1 Night 2 Days spiritual trip starting ₹7,199. All inclusive cab — driver, fuel, toll & parking."
  canonicalUrl="https://shritaxi.com/packages/neem-karoli"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg" style="background-image:url('/images/NeemKaroliDham.jpg')"></div>
      <div class="hero-scrim"></div>
      <div class="hero-inner container">
        <nav class="breadcrumb">
          <a href="/">Home</a> › <a href="/packages">Packages</a> › <span>Neem Karoli Baba Ashram</span>
        </nav>
        <div class="hero-badges">
          <span class="hbadge hbadge--purple">Spiritual</span>
          <span class="hbadge hbadge--glass">1N · 2D</span>
          <span class="hbadge hbadge--red">10% OFF</span>
        </div>
        <h1 class="hero-title">Neem Karoli Baba Kainchi Dham Trip</h1>
        <p class="hero-sub">From Dehradun · 1 Night 2 Days · All inclusive · No hidden charges</p>
        <div class="hero-bottom">
          <div class="hero-price">
            <span class="price-label">Sedan starts at</span>
            <div class="price-row">
              <span class="price-mrp">{fmt(pkg.tiers[0].mrp)}</span>
              <span class="price-now">{fmt(pkg.tiers[0].discounted)}</span>
            </div>
          </div>
          <div class="hero-ctas">
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20Neem%20Karoli%20Baba%20Kainchi%20Dham%20Trip`}
              target="_blank" rel="noopener" class="btn btn-wa">💬 Book on WhatsApp</a>
            <a href={`tel:${phone}`} class="btn btn-call">📞 Call</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ACTIVITY CHIPS -->
    <div class="chips-bar">
      <div class="chips-scroll">
        {pkg.highlights.map(h => <span class="act-chip">{h}</span>)}
      </div>
    </div>

    <!-- VEHICLE CHOOSER -->
    <section class="section">
      <div class="container">
        <h2 class="sec-title">Choose Your Vehicle</h2>
        <p class="sec-sub">All prices include 10% discount · No hidden costs</p>
        <div class="vehicle-grid">
          {pkg.tiers.map(t => (
            <div class="v-card">
              <div class="v-top">
                <span class="v-icon">{vIcons[t.vehicleId]}</span>
                <div class="v-info">
                  <span class="v-name">{vNames[t.vehicleId]}</span>
                  <span class="v-seats">{vSeats[t.vehicleId]}</span>
                </div>
                <div class="v-disc">10%<br/>OFF</div>
              </div>
              <div class="v-pricing">
                <span class="v-mrp">{fmt(t.mrp)}</span>
                <span class="v-price">{fmt(t.discounted)}</span>
              </div>
              <p class="v-save">Save {fmt(t.saving)}</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20Neem%20Karoli%20Trip%20in%20${encodeURIComponent(vNames[t.vehicleId])}`}
                target="_blank" rel="noopener" class="v-btn">Book {vNames[t.vehicleId]}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ITINERARY -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="sec-title">Itinerary</h2>
        <div class="timeline">
          <div class="tl-item">
            <div class="tl-dot"><span class="tl-num">1</span></div>
            <div class="tl-body">
              <span class="tl-label">Day 1</span>
              <p class="tl-text">Dehradun → Kainchi Dham Ashram → Bhowali (overnight)</p>
            </div>
          </div>
          <div class="tl-item">
            <div class="tl-dot"><span class="tl-num">2</span></div>
            <div class="tl-body">
              <span class="tl-label">Day 2</span>
              <p class="tl-text">Nainital Lake sightseeing → Naukuchiatal → Return Dehradun</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT KAINCHI DHAM -->
    <section class="section">
      <div class="container">
        <h2 class="sec-title">About Kainchi Dham</h2>
        <div class="about-grid">
          <div class="about-card">
            <span class="about-icon">🙏</span>
            <h3 class="about-title">Sacred Ashram</h3>
            <p class="about-desc">Kainchi Dham is the ashram of Neem Karoli Baba, one of India's most revered saints. Located in a serene valley near Bhowali at 1,400m altitude.</p>
          </div>
          <div class="about-card">
            <span class="about-icon">🌍</span>
            <h3 class="about-title">Global Devotees</h3>
            <p class="about-desc">Steve Jobs, Mark Zuckerberg and Julia Roberts all visited this ashram. It holds immense spiritual significance for devotees worldwide.</p>
          </div>
          <div class="about-card">
            <span class="about-icon">📅</span>
            <h3 class="about-title">Best Time to Visit</h3>
            <p class="about-desc">Open year round. The annual Bhandara (feast) in June draws thousands of devotees. Avoid peak summer weekends for a peaceful visit.</p>
          </div>
          <div class="about-card">
            <span class="about-icon">🚗</span>
            <h3 class="about-title">From Dehradun</h3>
            <p class="about-desc">Kainchi Dham is about 270km from Dehradun — approx 7–8 hrs. We combine it with Nainital sightseeing for the perfect 2-day itinerary.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT'S INCLUDED -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="sec-title">What's Included</h2>
        <div class="inc-grid">
          {[
            { icon:'🚗', text:'Cab with experienced driver' },
            { icon:'⛽', text:'Fuel charges' },
            { icon:'🛣️', text:'Toll & parking' },
            { icon:'🧾', text:'All taxes' },
          ].map(item => (
            <div class="inc-item">
              <span class="inc-icon">{item.icon}</span>
              <span class="inc-text">{item.text}</span>
            </div>
          ))}
        </div>
        <p class="inc-note">⭐ 4.9 rated · 500+ happy travellers · Fixed price guarantee</p>
      </div>
    </section>

    <!-- YOU MIGHT ALSO LIKE -->
    <section class="section ymyl">
      <div class="container">
        <div class="ymyl-head">
          <span class="ymyl-pill">You Might Also Like</span>
          <h2 class="sec-title">Similar Spiritual & Short Packages</h2>
          <p class="sec-sub">Other Uttarakhand trips at similar prices</p>
        </div>
        <div class="ymyl-grid">
          <a href="/packages/kedarnath" class="ymyl-card">
            <div class="ymyl-top" style="background:linear-gradient(135deg,#f59e0b,#0f172a)">
              <span class="ymyl-nd">2N 3D</span>
              <span class="ymyl-tag" style="background:#f59e0b">Pilgrimage</span>
              <span class="ymyl-icon">🙏</span>
            </div>
            <div class="ymyl-body">
              <p class="ymyl-name">Kedarnath Yatra Package</p>
              <p class="ymyl-sub">Kedarnath Temple · Sonprayag · Gaurikund</p>
              <p class="ymyl-price">from ₹10,999 <span class="ymyl-disc">10% OFF</span></p>
            </div>
          </a>
          <a href="/packages/chopta" class="ymyl-card">
            <div class="ymyl-top" style="background:linear-gradient(135deg,#10b981,#0f172a)">
              <span class="ymyl-nd">1N 2D</span>
              <span class="ymyl-tag" style="background:#10b981">Trek</span>
              <span class="ymyl-icon">🌲</span>
            </div>
            <div class="ymyl-body">
              <p class="ymyl-name">Chopta Tungnath Package</p>
              <p class="ymyl-sub">Tungnath Temple · Chandrashila · Deoria Tal</p>
              <p class="ymyl-price">from ₹7,199 <span class="ymyl-disc">10% OFF</span></p>
            </div>
          </a>
          <a href="/packages/nainital" class="ymyl-card">
            <div class="ymyl-top" style="background:linear-gradient(135deg,#0d9488,#0f172a)">
              <span class="ymyl-nd">2N 3D</span>
              <span class="ymyl-tag" style="background:#0d9488">Family</span>
              <span class="ymyl-icon">🏔️</span>
            </div>
            <div class="ymyl-body">
              <p class="ymyl-name">Nainital Tour Package</p>
              <p class="ymyl-sub">Naini Lake · Mall Road · Naina Devi Temple</p>
              <p class="ymyl-price">from ₹10,999 <span class="ymyl-disc">10% OFF</span></p>
            </div>
          </a>
          <a href="/char-dham-yatra" class="ymyl-card">
            <div class="ymyl-top" style="background:linear-gradient(135deg,#f59e0b,#b45309)">
              <span class="ymyl-nd">10N 11D</span>
              <span class="ymyl-tag" style="background:#f59e0b">Pilgrimage</span>
              <span class="ymyl-icon">🕌</span>
            </div>
            <div class="ymyl-body">
              <p class="ymyl-name">Char Dham Yatra 2026</p>
              <p class="ymyl-sub">Yamunotri · Gangotri · Kedarnath · Badrinath</p>
              <p class="ymyl-price">from ₹35,999 <span class="ymyl-disc">10% OFF</span></p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="sec-title">Neem Karoli Baba Kainchi Dham Trip — FAQs</h2>
        <div class="faq-list">
          {[
            { q:'What is included in this package?', a:'Cab with experienced driver, fuel, toll & parking, and all taxes. Hotel, meals and donations at the ashram are not included.' },
            { q:'How far is Kainchi Dham from Dehradun?', a:'Kainchi Dham is approximately 270km from Dehradun — about 7–8 hours drive. We typically depart early morning on Day 1.' },
            { q:'Can we visit Nainital on the same trip?', a:'Yes — Day 2 of the itinerary includes Nainital Lake, Mall Road and Naukuchiatal before returning to Dehradun.' },
            { q:'Is there a dress code at Kainchi Dham?', a:'Modest, respectful attire is expected. Remove footwear before entering the ashram. Photography restrictions may apply inside.' },
            { q:'When is the best time to visit Kainchi Dham?', a:'June 15th is the annual Bhandara — the most auspicious day but very crowded. For a peaceful visit, weekdays in April–May or September–October are ideal.' },
            { q:'Are there hidden charges?', a:'No hidden charges. The cab price is all-inclusive of driver, fuel, toll, parking & taxes.' },
          ].map(f => (
            <details class="faq-item">
              <summary class="faq-q">{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- BOOK CTA -->
    <section class="section book-cta">
      <div class="container book-cta-inner">
        <h2 class="cta-title">Book Neem Karoli Baba Kainchi Dham Trip</h2>
        <p class="cta-sub">10% discount · Instant confirmation · No hidden charges</p>
        <div class="cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call-lg">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Neem%20Karoli%20Baba%20Kainchi%20Dham%20Trip`}
            target="_blank" rel="noopener" class="btn btn-wa-lg">💬 WhatsApp Booking</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
*,*::before,*::after{box-sizing:border-box;}
:root{
  --accent:#8b5cf6; --accent-d:#7c3aed;
  --teal:#0d9488; --saffron:#f59e0b;
  --slate:#1e293b; --muted:#64748b;
  --border:#e2e8f0; --mint:#f0fdfa;
  --r:12px; --r-sm:8px;
}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;
  font-weight:700;border-radius:50px;text-decoration:none;
  transition:opacity .15s,transform .15s;white-space:nowrap;}
.btn:active{transform:scale(.97);}
.btn-wa    {background:#25D366;color:#fff;padding:12px 20px;font-size:15px;}
.btn-call  {background:var(--saffron);color:#fff;padding:12px 20px;font-size:15px;}
.btn-wa-lg {background:#25D366;color:#fff;padding:14px 30px;font-size:16px;}
.btn-call-lg{background:var(--saffron);color:#fff;padding:14px 30px;font-size:16px;}
.container{max-width:960px;margin:0 auto;padding:0 20px;}
.section{display:block;width:100%;padding:32px 0;}
.section--mint{background:var(--mint);}
.sec-title{font-size:clamp(20px,2.5vw,26px);font-weight:800;color:var(--slate);
  font-family:'Playfair Display',serif;margin-bottom:4px;}
.sec-sub{font-size:14px;color:var(--muted);margin-bottom:20px;}

/* HERO */
.hero{position:relative;width:100%;min-height:280px;display:flex;align-items:flex-end;overflow:hidden;}
.hero-bg{position:absolute;inset:0;background-color:#4c1d95;background-size:cover;background-position:center 40%;}
.hero-scrim{position:absolute;inset:0;background:linear-gradient(to top,rgba(10,20,40,.88) 0%,rgba(10,20,40,.45) 55%,rgba(10,20,40,.1) 100%);}
.hero-inner{position:relative;z-index:2;padding-top:28px;padding-bottom:32px;width:100%;}
.breadcrumb{font-size:12px;color:rgba(255,255,255,.6);margin-bottom:12px;}
.breadcrumb a{color:rgba(255,255,255,.75);text-decoration:none;}
.hero-badges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;}
.hbadge{font-size:11px;font-weight:800;padding:3px 12px;border-radius:20px;}
.hbadge--purple{background:var(--accent);color:#fff;}
.hbadge--glass {background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3);}
.hbadge--red   {background:#ef4444;color:#fff;}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(24px,4vw,44px);
  font-weight:800;color:#fff;line-height:1.15;margin-bottom:6px;}
.hero-sub{font-size:14px;color:rgba(255,255,255,.75);margin-bottom:20px;}
.hero-bottom{display:flex;align-items:center;gap:24px;flex-wrap:wrap;}
.price-label{font-size:11px;color:rgba(255,255,255,.6);text-transform:uppercase;
  letter-spacing:.6px;display:block;margin-bottom:2px;}
.price-row{display:flex;align-items:baseline;gap:10px;}
.price-mrp{font-size:16px;color:rgba(255,255,255,.45);text-decoration:line-through;}
.price-now{font-size:clamp(24px,3vw,34px);font-weight:900;color:#fff;font-family:'Playfair Display',serif;}
.hero-ctas{display:flex;gap:10px;flex-wrap:wrap;}

/* CHIPS */
.chips-bar{display:block;width:100%;background:#fff;border-bottom:1px solid var(--border);padding:12px 0;}
.chips-scroll{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;padding:0 20px;}
.act-chip{background:#faf5ff;color:var(--accent);font-size:13px;font-weight:600;
  padding:6px 16px;border-radius:20px;border:1px solid rgba(139,92,246,.2);}
@media(max-width:600px){
  .chips-scroll{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 16px;}
  .act-chip{text-align:center;}
}

/* VEHICLES */
.vehicle-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.v-card{background:#fff;border:1.5px solid var(--border);border-radius:var(--r);padding:16px;
  display:flex;flex-direction:column;gap:10px;box-shadow:0 2px 8px rgba(0,0,0,.05);
  transition:box-shadow .2s,transform .2s;}
.v-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.1);transform:translateY(-2px);}
.v-top{display:flex;align-items:center;gap:10px;}
.v-icon{font-size:30px;line-height:1;flex-shrink:0;}
.v-info{flex:1;min-width:0;}
.v-name{font-size:15px;font-weight:700;color:var(--slate);display:block;}
.v-seats{font-size:12px;color:var(--muted);}
.v-disc{background:#ef4444;color:#fff;font-size:9px;font-weight:900;line-height:1.2;
  text-align:center;width:36px;height:36px;border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;}
.v-pricing{display:flex;align-items:baseline;gap:8px;}
.v-mrp{font-size:13px;color:var(--muted);text-decoration:line-through;}
.v-price{font-size:clamp(18px,2vw,22px);font-weight:900;color:var(--accent);font-family:'Playfair Display',serif;}
.v-save{font-size:12px;color:#16a34a;font-weight:700;margin-top:-6px;}
.v-btn{display:block;text-align:center;background:var(--accent);color:#fff;
  font-size:13px;font-weight:700;padding:10px 8px;border-radius:var(--r-sm);
  text-decoration:none;transition:background .15s;}
.v-btn:hover{background:var(--accent-d);}

/* TIMELINE */
.timeline{display:flex;flex-direction:column;}
.tl-item{display:flex;gap:16px;position:relative;padding-bottom:20px;}
.tl-item:last-child{padding-bottom:0;}
.tl-item:not(:last-child)::before{content:'';position:absolute;left:15px;top:33px;bottom:0;
  width:2px;background:rgba(139,92,246,.25);}
.tl-dot{width:32px;height:32px;border-radius:50%;background:var(--accent);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;}
.tl-num{font-size:14px;font-weight:800;color:#fff;}
.tl-body{flex:1;padding-top:4px;}
.tl-label{font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase;
  letter-spacing:.8px;display:block;margin-bottom:2px;}
.tl-text{font-size:15px;color:var(--slate);font-weight:600;line-height:1.4;}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.about-card{background:#faf5ff;border:1px solid rgba(139,92,246,.15);
  border-radius:var(--r);padding:18px;}
.about-icon{font-size:28px;display:block;margin-bottom:8px;}
.about-title{font-size:15px;font-weight:700;color:var(--slate);margin-bottom:6px;}
.about-desc{font-size:13px;color:var(--muted);line-height:1.6;}

/* INCLUDES */
.inc-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.inc-item{display:flex;align-items:center;gap:12px;background:#fff;
  border:1px solid rgba(139,92,246,.15);border-radius:var(--r-sm);padding:14px;}
.inc-icon{font-size:24px;flex-shrink:0;}
.inc-text{font-size:14px;font-weight:600;color:var(--slate);line-height:1.3;}
.inc-note{text-align:center;font-size:13px;color:var(--muted);background:#fff;
  border:1px solid var(--border);border-radius:var(--r-sm);padding:12px;}

/* YMYL */
.ymyl{background:#f8fafc;}
.ymyl-head{text-align:center;margin-bottom:20px;}
.ymyl-pill{display:inline-block;background:var(--accent);color:#fff;
  font-size:11px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;
  padding:4px 16px;border-radius:20px;margin-bottom:10px;}
.ymyl-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.ymyl-card{border-radius:var(--r);overflow:hidden;text-decoration:none;background:#fff;
  border:1.5px solid var(--border);box-shadow:0 2px 8px rgba(0,0,0,.06);
  transition:transform .2s,box-shadow .2s;}
.ymyl-card:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,0,.1);}
.ymyl-top{position:relative;height:90px;display:flex;align-items:center;justify-content:center;}
.ymyl-nd{position:absolute;top:8px;left:8px;font-size:11px;font-weight:700;color:#fff;
  background:rgba(0,0,0,.35);padding:2px 8px;border-radius:20px;}
.ymyl-tag{position:absolute;bottom:8px;left:8px;font-size:10px;font-weight:800;
  color:#fff;padding:2px 9px;border-radius:20px;}
.ymyl-icon{font-size:34px;}
.ymyl-body{padding:12px;}
.ymyl-name{font-size:13px;font-weight:700;color:var(--slate);
  font-family:'Playfair Display',serif;line-height:1.3;margin-bottom:3px;}
.ymyl-sub{font-size:11px;color:var(--muted);margin-bottom:6px;}
.ymyl-price{font-size:14px;font-weight:800;color:var(--accent);
  display:flex;align-items:center;gap:6px;}
.ymyl-disc{font-size:10px;font-weight:800;color:#fff;background:#ef4444;
  padding:1px 7px;border-radius:20px;}

/* FAQ */
.faq-list{display:flex;flex-direction:column;gap:8px;}
.faq-item{background:#fff;border:1.5px solid var(--border);border-radius:var(--r-sm);overflow:hidden;}
.faq-q{display:block;padding:16px 44px 16px 18px;font-size:15px;font-weight:700;
  color:var(--slate);cursor:pointer;list-style:none;position:relative;}
.faq-q::-webkit-details-marker{display:none;}
.faq-q::after{content:'+';position:absolute;right:18px;top:50%;
  transform:translateY(-50%);font-size:22px;font-weight:300;color:var(--accent);}
