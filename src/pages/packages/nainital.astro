---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyBar from '../../components/StickyBar.astro';
import SeasonBanner from '../../components/SeasonBanner.astro';
import { tourPackages, fmt } from '../../data/pricing';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const pkg = tourPackages.find(p => p.id === 'nainital')!;
const relatedPkgs = tourPackages.filter(p =>
  ['nainital-corbett', 'nainital-ranikhet-corbett', 'almora-kausani', 'mussoorie-corbett-nainital-ranikhet'].includes(p.id)
);

const vehicleIcons:  Record<string,string> = { sedan:'🚗', ertiga:'🚐', innova:'🚙', traveller:'🚌' };
const vehicleNames:  Record<string,string> = { sedan:'Sedan', ertiga:'Maruti Ertiga', innova:'Innova Crysta', traveller:'Tempo Traveller' };
const vehicleSeats:  Record<string,string> = { sedan:'4 seats', ertiga:'6 seats', innova:'6–7 seats', traveller:'12 seats' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: pkg.seoTitle,
  description: pkg.seoDesc,
  offers: pkg.tiers.map(t => ({
    '@type': 'Offer',
    price: t.discounted,
    priceCurrency: 'INR',
    name: vehicleNames[t.vehicleId],
  })),
};
---

<Base
  title={pkg.seoTitle}
  description={pkg.seoDesc}
  canonicalUrl="https://shritaxi.com/packages/nainital"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg" style="background-image:url('/images/nainital.jpg')"></div>
      <div class="hero-scrim"></div>
      <div class="hero-inner container">
        <nav class="breadcrumb"><a href="/">Home</a> › <a href="/packages">Packages</a> › <span>Nainital</span></nav>
        <div class="hero-badges">
          <span class="hbadge hbadge--teal">Family Favourite</span>
          <span class="hbadge hbadge--glass">2N · 3D</span>
          <span class="hbadge hbadge--red">10% OFF</span>
        </div>
        <h1 class="hero-title">Nainital Tour Package</h1>
        <p class="hero-sub">From Dehradun · All inclusive · No hidden charges</p>
        <div class="hero-bottom">
          <div class="hero-price">
            <span class="price-label">Sedan starts at</span>
            <div class="price-row">
              <span class="price-mrp">{fmt(pkg.tiers[0].mrp)}</span>
              <span class="price-now">{fmt(pkg.tiers[0].discounted)}</span>
            </div>
          </div>
          <div class="hero-ctas">
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20Nainital%20Tour%20Package`}
              target="_blank" rel="noopener" class="btn btn-wa">💬 Book on WhatsApp</a>
            <a href={`tel:${phone}`} class="btn btn-call">📞 Call</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ACTIVITY CHIPS -->
    <div class="chips-bar">
      <div class="chips-scroll">
        {pkg.highlights.map(h => <span class="act-chip">{h}</span>)}
      </div>
    </div>

    <!-- VEHICLE CHOOSER -->
    <section class="section">
      <div class="container">
        <h2 class="sec-title">Choose Your Vehicle</h2>
        <p class="sec-sub">All prices include 10% discount · No hidden costs</p>
        <div class="vehicle-grid">
          {pkg.tiers.map(t => (
            <div class="v-card">
              <div class="v-top">
                <span class="v-icon">{vehicleIcons[t.vehicleId]}</span>
                <div class="v-info">
                  <span class="v-name">{vehicleNames[t.vehicleId]}</span>
                  <span class="v-seats">{vehicleSeats[t.vehicleId]}</span>
                </div>
                <div class="v-disc">10%<br/>OFF</div>
              </div>
              <div class="v-pricing">
                <span class="v-mrp">{fmt(t.mrp)}</span>
                <span class="v-price">{fmt(t.discounted)}</span>
              </div>
              <p class="v-save">Save {fmt(t.saving)}</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20Nainital%20Tour%20in%20${encodeURIComponent(vehicleNames[t.vehicleId])}`}
                target="_blank" rel="noopener" class="v-btn">Book {vehicleNames[t.vehicleId]}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ITINERARY -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="sec-title">Day by Day Itinerary</h2>
        <div class="timeline">
          {pkg.itinerary!.map((day, i) => (
            <div class="tl-item">
              <div class="tl-dot"><span class="tl-num">{i + 1}</span></div>
              <div class="tl-body">
                <span class="tl-label">Day {i + 1}</span>
                <p class="tl-text">{day.replace(/^Day \d+: /, '')}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MORE PACKAGES carousel -->
    <section class="section more-pkgs">
      <div class="container">
        <h2 class="sec-title">More Nainital Packages</h2>
        <p class="sec-sub">Explore other Uttarakhand tours that include Nainital</p>
        <div class="carousel">
          {relatedPkgs.map(p => (
            <a href={p.href} class="rel-card">
              <div class="rel-header" style={`background:linear-gradient(135deg,${p.badgeColor},#0f172a)`}>
                <span class="rel-nd">{p.nights}N {p.days}D</span>
                <span class="rel-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                <div class="rel-disc">10%<br/>OFF</div>
              </div>
              <div class="rel-body">
                <p class="rel-name">{p.name}</p>
                <p class="rel-price">from {fmt(p.tiers[0].discounted)}</p>
                <div class="rel-chips">
                  {p.highlights.slice(0, 3).map(h => <span class="rel-chip">{h}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT'S INCLUDED -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="sec-title">What's Included</h2>
        <div class="inc-grid">
          {[
            { icon:'🚗', text:"Cab with experienced driver" },
            { icon:'⛽', text:'Fuel charges' },
            { icon:'🛣️', text:'Toll & parking' },
            { icon:'🧾', text:'All taxes' },
          ].map(item => (
            <div class="inc-item">
              <span class="inc-icon">{item.icon}</span>
              <span class="inc-text">{item.text}</span>
            </div>
          ))}
        </div>
        <p class="inc-note">⭐ 4.9 rated · 500+ happy travellers · Fixed price guarantee</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <h2 class="sec-title">Nainital Tour Package — FAQs</h2>
        <div class="faq-list">
          {[
            { q:'What is included in Nainital Tour Package?',         a:'Cab with experienced driver, fuel, toll & parking, and all taxes. Hotel, meals and entry fees are not included.' },
            { q:'What is the starting price for Nainital Tour Package?', a:`Sedan starts at ${fmt(pkg.tiers[0].discounted)} for 3 days / 2 nights. Price includes 10% discount.` },
            { q:'Can I customize the Nainital Tour Itinerary?',       a:'Yes! Extra days can be added, or sightseeing spots adjusted to your pace. WhatsApp us to customize.' },
            { q:'How do I book Nainital Tour Package?',               a:'Simply WhatsApp or call us. We confirm your booking instantly and send all details on WhatsApp.' },
            { q:'Are there hidden charges in Nainital Package?',      a:'No hidden charges at all. Price is all-inclusive of driver, fuel, toll, parking & taxes.' },
          ].map(f => (
            <details class="faq-item">
              <summary class="faq-q">{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- BOOK CTA -->
    <section class="section book-cta">
      <div class="container book-cta-inner">
        <h2 class="cta-title">Book Nainital Tour Package Now</h2>
        <p class="cta-sub">10% discount · 500+ happy travellers · Fast reply · No hidden charges</p>
        <div class="cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call-lg">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20Nainital%20Tour%20Package`}
            target="_blank" rel="noopener" class="btn btn-wa-lg">💬 WhatsApp Booking</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
*, *::before, *::after { box-sizing: border-box; }

:root {
  --teal:   #0d9488;
  --teal-d: #0f766e;
  --saffron:#f59e0b;
  --slate:  #1e293b;
  --muted:  #64748b;
  --border: #e2e8f0;
  --mint:   #f0fdfa;
  --r:      12px;
  --r-sm:   8px;
}

/* Buttons */
.btn { display:inline-flex; align-items:center; justify-content:center; gap:7px;
  font-weight:700; border-radius:50px; text-decoration:none;
  transition:opacity .15s,transform .15s; white-space:nowrap; }
.btn:active { transform:scale(.97); }
.btn-wa     { background:#25D366; color:#fff; padding:12px 20px; font-size:15px; }
.btn-call   { background:var(--saffron); color:#fff; padding:12px 20px; font-size:15px; }
.btn-wa-lg  { background:#25D366; color:#fff; padding:14px 30px; font-size:16px; }
.btn-call-lg{ background:var(--saffron); color:#fff; padding:14px 30px; font-size:16px; }

/* Layout */
.container { max-width:960px; margin:0 auto; padding:0 20px; }
.section { display:block; width:100%; padding:32px 0; }
.section--mint { background:var(--mint); }
.sec-title { font-size:clamp(20px,2.5vw,26px); font-weight:800; color:var(--slate);
  font-family:'Playfair Display',serif; margin-bottom:4px; }
.sec-sub { font-size:14px; color:var(--muted); margin-bottom:20px; }

/* ── HERO ── */
.hero {
  position:relative; width:100%;
  min-height:280px;
  display:flex; align-items:flex-end;
  overflow:hidden;
}
.hero-bg {
  position:absolute; inset:0;
  background-color:var(--teal);   /* shown while/if image is missing */
  background-size:cover;
  background-position:center 40%;
}
.hero-scrim {
  position:absolute; inset:0;
  background:linear-gradient(to top,
    rgba(10,20,40,.88) 0%,
    rgba(10,20,40,.45) 55%,
    rgba(10,20,40,.1)  100%);
}
.hero-inner {
  position:relative; z-index:2;
  padding-top:28px; padding-bottom:32px;
  width:100%;
}
.breadcrumb { font-size:12px; color:rgba(255,255,255,.6); margin-bottom:12px; }
.breadcrumb a { color:rgba(255,255,255,.75); text-decoration:none; }

.hero-badges { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px; }
.hbadge { font-size:11px; font-weight:800; padding:3px 12px; border-radius:20px; }
.hbadge--teal  { background:var(--teal); color:#fff; }
.hbadge--glass { background:rgba(255,255,255,.15); color:#fff; border:1px solid rgba(255,255,255,.3); }
.hbadge--red   { background:#ef4444; color:#fff; }

.hero-title {
  font-family:'Playfair Display',serif;
  font-size:clamp(26px,4vw,46px);
  font-weight:800; color:#fff; line-height:1.15; margin-bottom:6px;
}
.hero-sub { font-size:14px; color:rgba(255,255,255,.75); margin-bottom:20px; }

.hero-bottom { display:flex; align-items:center; gap:24px; flex-wrap:wrap; }
.price-label { font-size:11px; color:rgba(255,255,255,.6); text-transform:uppercase;
  letter-spacing:.6px; display:block; margin-bottom:2px; }
.price-row { display:flex; align-items:baseline; gap:10px; }
.price-mrp { font-size:16px; color:rgba(255,255,255,.45); text-decoration:line-through; }
.price-now { font-size:clamp(24px,3vw,34px); font-weight:900; color:#fff;
  font-family:'Playfair Display',serif; }
.hero-ctas { display:flex; gap:10px; flex-wrap:wrap; }

/* ── CHIPS ── */
.chips-bar { display:block; width:100%; background:#fff;
  border-bottom:1px solid var(--border); padding:10px 0; }
.chips-scroll {
  display:flex; gap:8px; overflow-x:auto;
  padding:0 20px; scrollbar-width:none; -ms-overflow-style:none;
}
.chips-scroll::-webkit-scrollbar { display:none; }
.act-chip {
  flex-shrink:0; background:var(--mint); color:var(--teal);
  font-size:13px; font-weight:600; padding:6px 16px;
  border-radius:20px; border:1px solid rgba(13,148,136,.2); white-space:nowrap;
}

/* ── VEHICLE GRID ── */
.vehicle-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.v-card {
  background:#fff; border:1.5px solid var(--border);
  border-radius:var(--r); padding:16px;
  display:flex; flex-direction:column; gap:10px;
  box-shadow:0 2px 8px rgba(0,0,0,.05);
  transition:box-shadow .2s,transform .2s;
}
.v-card:hover { box-shadow:0 8px 24px rgba(0,0,0,.1); transform:translateY(-2px); }
.v-top { display:flex; align-items:center; gap:10px; }
.v-icon { font-size:30px; line-height:1; flex-shrink:0; }
.v-info { flex:1; min-width:0; }
.v-name  { font-size:15px; font-weight:700; color:var(--slate); display:block; }
.v-seats { font-size:12px; color:var(--muted); }
.v-disc  {
  background:#ef4444; color:#fff; font-size:9px; font-weight:900; line-height:1.2;
  text-align:center; width:36px; height:36px; border-radius:50%;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  flex-shrink:0;
}
.v-pricing { display:flex; align-items:baseline; gap:8px; }
.v-mrp   { font-size:13px; color:var(--muted); text-decoration:line-through; }
.v-price { font-size:clamp(18px,2vw,22px); font-weight:900; color:var(--teal);
  font-family:'Playfair Display',serif; }
.v-save  { font-size:12px; color:#16a34a; font-weight:700; margin-top:-6px; }
.v-btn   {
  display:block; text-align:center; background:var(--teal); color:#fff;
  font-size:13px; font-weight:700; padding:10px 8px; border-radius:var(--r-sm);
  text-decoration:none; transition:background .15s;
}
.v-btn:hover { background:var(--teal-d); }

/* ── TIMELINE ── */
.timeline { display:flex; flex-direction:column; }
.tl-item { display:flex; gap:16px; position:relative; padding-bottom:24px; }
.tl-item:last-child { padding-bottom:0; }
.tl-item:not(:last-child)::before {
  content:''; position:absolute;
  left:15px; top:33px; bottom:0;
  width:2px; background:rgba(13,148,136,.25);
}
.tl-dot {
  width:32px; height:32px; border-radius:50%;
  background:var(--teal); display:flex; align-items:center;
  justify-content:center; flex-shrink:0; z-index:1;
}
.tl-num   { font-size:14px; font-weight:800; color:#fff; }
.tl-body  { flex:1; padding-top:4px; }
.tl-label { font-size:11px; font-weight:700; color:var(--teal);
  text-transform:uppercase; letter-spacing:.8px; display:block; margin-bottom:2px; }
.tl-text  { font-size:15px; color:var(--slate); font-weight:600; line-height:1.4; }

/* ── CAROUSEL ── */
.more-pkgs .container { overflow:hidden; } /* clip scroll within container */
.carousel {
  display:flex; gap:14px;
  overflow-x:auto; scroll-snap-type:x mandatory;
  scrollbar-width:none; -ms-overflow-style:none;
  padding-bottom:8px;
  margin:0 -20px; padding-left:20px; padding-right:20px;
}
.carousel::-webkit-scrollbar { display:none; }

.rel-card {
  flex-shrink:0; width:210px;
  border-radius:var(--r); border:1.5px solid var(--border);
  overflow:hidden; text-decoration:none; background:#fff;
  scroll-snap-align:start;
  box-shadow:0 2px 8px rgba(0,0,0,.06);
  transition:transform .2s,box-shadow .2s;
}
.rel-card:hover { transform:translateY(-3px); box-shadow:0 8px 20px rgba(0,0,0,.1); }
.rel-header {
  position:relative; height:100px;
  display:flex; align-items:flex-end; padding:8px;
}
.rel-nd {
  position:absolute; top:8px; left:8px;
  font-size:11px; font-weight:700; color:#fff;
  background:rgba(0,0,0,.35); padding:2px 8px; border-radius:20px;
}
.rel-badge  { font-size:10px; font-weight:800; color:#fff; padding:2px 9px; border-radius:20px; }
.rel-disc   {
  position:absolute; top:8px; right:8px;
  background:#ef4444; color:#fff; font-size:8px; font-weight:900;
  line-height:1.2; text-align:center; width:30px; height:30px; border-radius:50%;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
}
.rel-body  { padding:12px; }
.rel-name  { font-size:13px; font-weight:700; color:var(--slate); line-height:1.35;
  margin-bottom:4px; font-family:'Playfair Display',serif; }
.rel-price { font-size:14px; font-weight:800; color:var(--teal); margin-bottom:8px; }
.rel-chips { display:flex; flex-wrap:wrap; gap:4px; }
.rel-chip  { font-size:10px; color:var(--muted); background:#f8fafc;
  border:1px solid var(--border); padding:2px 8px; border-radius:20px; }

/* ── INCLUDES ── */
.inc-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px; }
.inc-item {
  display:flex; align-items:center; gap:12px;
  background:#fff; border:1px solid rgba(13,148,136,.15);
  border-radius:var(--r-sm); padding:14px;
}
.inc-icon { font-size:24px; flex-shrink:0; }
.inc-text { font-size:14px; font-weight:600; color:var(--slate); line-height:1.3; }
.inc-note {
  text-align:center; font-size:13px; color:var(--muted);
  background:#fff; border:1px solid var(--border);
  border-radius:var(--r-sm); padding:12px;
}

/* ── FAQ ── */
.faq-list { display:flex; flex-direction:column; gap:8px; }
.faq-item { background:#fff; border:1.5px solid var(--border);
  border-radius:var(--r-sm); overflow:hidden; }
.faq-q {
  display:block; padding:16px 44px 16px 18px;
  font-size:15px; font-weight:700; color:var(--slate);
  cursor:pointer; list-style:none; position:relative;
}
.faq-q::-webkit-details-marker { display:none; }
.faq-q::after { content:'+'; position:absolute; right:18px; top:50%;
  transform:translateY(-50%); font-size:22px; font-weight:300; color:var(--teal); }
details[open] > .faq-q { color:var(--teal); }
details[open] > .faq-q::after { content:'−'; }
.faq-a { padding:0 18px 16px; font-size:14px; color:var(--muted); line-height:1.65; }

/* ── CTA ── */
.book-cta { background:var(--teal); }
.book-cta-inner { text-align:center; }
.cta-title { font-size:clamp(20px,3vw,28px); color:#fff;
  font-family:'Playfair Display',serif; font-weight:800; margin-bottom:8px; }
.cta-sub   { font-size:14px; color:rgba(255,255,255,.75); margin-bottom:20px; }
.cta-btns  { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }

/* ── RESPONSIVE ── */
@media (min-width:700px) {
  .hero { min-height:360px; }
  .vehicle-grid { grid-template-columns:repeat(4,1fr); }
  .carousel { margin:0; padding-left:0; padding-right:0; }
  .rel-card { width:240px; }
}
@media (max-width:480px) {
  .v-card { padding:12px; }
  .v-icon { font-size:26px; }
  .v-name { font-size:14px; }
  .inc-text { font-size:13px; }
  .faq-q { font-size:14px; padding:14px 40px 14px 16px; }
}
</style>
