---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyBar from '../../components/StickyBar.astro';
import SeasonBanner from '../../components/SeasonBanner.astro';
import { Image } from 'astro:assets';
import { tourPackages, fmt } from '../../data/pricing';

import NainitalImg from '../../assets/images/Nainital2.jpg';
import NainitalCorbettImg from '../../assets/images/Nainital2.jpg';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const pkg = tourPackages.find(p => p.id === 'nainital')!;
const relatedPkgs = tourPackages.filter(p =>
  ['nainital-corbett', 'nainital-ranikhet-corbett', 'almora-kausani', 'mussoorie-corbett-nainital-ranikhet'].includes(p.id)
);

const vehicleIcons: Record<string, string> = {
  sedan: '🚗', ertiga: '🚐', innova: '🚙', traveller: '🚌'
};
const vehicleNames: Record<string, string> = {
  sedan: 'Sedan', ertiga: 'Maruti Ertiga', innova: 'Innova Crysta', traveller: 'Tempo Traveller'
};
const vehicleSeats: Record<string, string> = {
  sedan: '4 seats', ertiga: '6 seats', innova: '6–7 seats', traveller: '12 seats'
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: pkg.seoTitle,
  description: pkg.seoDesc,
  touristType: 'Family',
  offers: pkg.tiers.map(t => ({
    '@type': 'Offer',
    price: t.discounted,
    priceCurrency: 'INR',
    name: vehicleNames[t.vehicleId],
  })),
};
---

<Base
  title={pkg.seoTitle}
  description={pkg.seoDesc}
  canonicalUrl="https://shritaxi.com/packages/nainital"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- ── HERO ── -->
    <section class="hero">
      <div class="hero-img-wrap">
        <Image src={NainitalImg} alt="Nainital Lake view" width={800} height={360}
          widths={[400,800]} sizes="100vw" format="webp" class="hero-img" loading="eager" />
        <div class="hero-scrim"></div>
      </div>
      <div class="hero-content container">
        <nav class="breadcrumb">
          <a href="/">Home</a> ›
          <a href="/packages">Packages</a> ›
          <span>Nainital</span>
        </nav>
        <div class="hero-badges">
          <span class="hbadge hbadge--teal">Family Favourite</span>
          <span class="hbadge hbadge--dark">2N · 3D</span>
          <span class="hbadge hbadge--red">10% OFF</span>
        </div>
        <h1 class="hero-title">Nainital Tour Package</h1>
        <p class="hero-sub">From Dehradun · All inclusive · No hidden charges</p>
        <div class="hero-price-row">
          <div>
            <span class="price-label">Sedan starts at</span>
            <div class="price-stack">
              <span class="price-mrp">{fmt(pkg.tiers[0].mrp)}</span>
              <span class="price-now">{fmt(pkg.tiers[0].discounted)}</span>
            </div>
          </div>
          <div class="hero-ctas">
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20Nainital%20Tour%20Package`}
              target="_blank" rel="noopener" class="btn btn-wa">💬 Book on WhatsApp</a>
            <a href={`tel:${phone}`} class="btn btn-call-sm">📞 Call</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── ACTIVITY CHIPS — horizontal scroll ── -->
    <section class="chips-bar">
      <div class="chips-scroll">
        {pkg.highlights.map(h => <span class="act-chip">{h}</span>)}
      </div>
    </section>

    <!-- ── VEHICLE CHOOSER — 2×2 grid ── -->
    <section class="section vehicles">
      <div class="container">
        <div class="section-head">
          <h2 class="sec-title">Choose Your Vehicle</h2>
          <p class="sec-sub">All prices include 10% discount · No hidden costs</p>
        </div>
        <div class="vehicle-grid">
          {pkg.tiers.map(t => (
            <div class="v-card">
              <div class="v-top">
                <span class="v-icon">{vehicleIcons[t.vehicleId]}</span>
                <div class="v-info">
                  <span class="v-name">{vehicleNames[t.vehicleId]}</span>
                  <span class="v-seats">{vehicleSeats[t.vehicleId]}</span>
                </div>
                <div class="v-disc">10%<br/>OFF</div>
              </div>
              <div class="v-pricing">
                <span class="v-mrp">{fmt(t.mrp)}</span>
                <span class="v-price">{fmt(t.discounted)}</span>
                <span class="v-save">Save {fmt(t.saving)}</span>
              </div>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Nainital%20Tour%20in%20${encodeURIComponent(vehicleNames[t.vehicleId])}`}
                target="_blank" rel="noopener" class="v-btn">Book {vehicleNames[t.vehicleId]}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── ITINERARY — compact dot timeline ── -->
    <section class="section section--mint itinerary">
      <div class="container">
        <h2 class="sec-title">Day by Day Itinerary</h2>
        <div class="timeline">
          {pkg.itinerary!.map((day, i) => (
            <div class="tl-item">
              <div class="tl-dot">
                <span class="tl-num">{i + 1}</span>
              </div>
              <div class="tl-body">
                <span class="tl-day">Day {i + 1}</span>
                <p class="tl-text">{day.replace(/^Day \d+: /, '')}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── MORE NAINITAL PACKAGES — horizontal carousel ── -->
    <section class="section more-pkgs">
      <div class="container">
        <div class="section-head">
          <h2 class="sec-title">More Nainital Packages</h2>
          <p class="sec-sub">Explore other Uttarakhand tours that include Nainital</p>
        </div>
      </div>
      <div class="carousel-wrap">
        <div class="carousel">
          {relatedPkgs.map(p => (
            <a href={p.href} class="rel-card">
              <div class="rel-header" style={`background: linear-gradient(135deg, ${p.badgeColor}, #0f172a)`}>
                <span class="rel-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                <span class="rel-nd">{p.nights}N {p.days}D</span>
                <div class="rel-disc">10%<br/>OFF</div>
              </div>
              <div class="rel-body">
                <p class="rel-name">{p.name}</p>
                <p class="rel-price">from {fmt(p.tiers[0].discounted)}</p>
                <div class="rel-chips">
                  {p.highlights.slice(0,3).map(h => <span class="rel-chip">{h}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── WHAT'S INCLUDED — 2×2 grid ── -->
    <section class="section includes">
      <div class="container">
        <h2 class="sec-title">What's Included</h2>
        <div class="inc-grid">
          {[
            { icon: '🚗', text: 'Cab with experienced driver' },
            { icon: '⛽', text: 'Fuel charges' },
            { icon: '🛣️', text: 'Toll & parking' },
            { icon: '🧾', text: 'All taxes' },
          ].map(item => (
            <div class="inc-item">
              <span class="inc-icon">{item.icon}</span>
              <span class="inc-text">{item.text}</span>
            </div>
          ))}
        </div>
        <p class="inc-note">⭐ 4.9 rated · 500+ happy travellers · Fixed price guarantee</p>
      </div>
    </section>

    <!-- ── FAQ ── -->
    <section class="section faq">
      <div class="container">
        <h2 class="sec-title">Nainital Tour Package — FAQs</h2>
        <div class="faq-list">
          {[
            { q: 'What is included in Nainital Tour Package?', a: 'Cab with experienced driver, fuel, toll & parking, and all taxes. Hotel, meals and entry fees are not included.' },
            { q: 'What is the starting price for Nainital Tour Package?', a: `Sedan starts at ${fmt(pkg.tiers[0].discounted)} for 3 days / 2 nights. Price includes 10% discount.` },
            { q: 'Can I customize the Nainital Tour Itinerary?', a: 'Yes! Extra days can be added, or sightseeing spots adjusted to your pace. WhatsApp us to customize.' },
            { q: 'How do I book Nainital Tour Package?', a: 'Simply WhatsApp or call us. We confirm your booking instantly and send all details on WhatsApp.' },
            { q: 'Are there hidden charges in Nainital Package?', a: 'No hidden charges at all. Price is all-inclusive of driver, fuel, toll, parking & taxes.' },
          ].map(f => (
            <details class="faq-item">
              <summary class="faq-q">{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ── BOOK CTA ── -->
    <section class="section book-cta">
      <div class="container book-cta-inner">
        <h2 class="book-cta-title">Book Nainital Tour Package Now</h2>
        <p class="book-cta-sub">10% discount · 500+ happy travellers · Fast reply · No hidden charges</p>
        <div class="book-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call btn-full">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Nainital%20Tour%20Package`}
            target="_blank" rel="noopener" class="btn btn-whatsapp btn-full">💬 WhatsApp Booking</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
/* ── Variables ── */
:root {
  --teal: #0d9488;
  --teal-dark: #0f766e;
  --saffron: #f59e0b;
  --slate: #1e293b;
  --muted: #64748b;
  --border: #e2e8f0;
  --mint: #f0fdfa;
  --radius: 12px;
  --radius-sm: 8px;
}

/* ── Buttons ── */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-weight: 700; border-radius: 50px; text-decoration: none; cursor: pointer;
  transition: opacity 0.15s, transform 0.15s; font-size: 15px; }
.btn:active { transform: scale(0.97); }
.btn-wa { background: #25D366; color: #fff; padding: 13px 20px; }
.btn-call-sm { background: var(--saffron); color: #fff; padding: 13px 20px; }
.btn-call { background: var(--saffron); color: #fff; padding: 14px 24px; }
.btn-whatsapp { background: #25D366; color: #fff; padding: 14px 24px; }
.btn-full { width: 100%; }

/* ── Container ── */
.container { max-width: 900px; margin: 0 auto; padding: 0 16px; }

/* ── Section base ── */
.section { padding: 28px 0; }
.section--mint { background: var(--mint); }
.section-head { margin-bottom: 16px; }
.sec-title { font-size: 20px; font-weight: 800; color: var(--slate);
  font-family: 'Playfair Display', serif; margin-bottom: 4px; }
.sec-sub { font-size: 13px; color: var(--muted); }

/* ── HERO ── */
.hero { position: relative; }
.hero-img-wrap { position: relative; height: 240px; overflow: hidden; }
.hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.hero-scrim { position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(15,23,42,0.85) 0%, rgba(15,23,42,0.2) 60%, transparent 100%); }

.hero-content {
  position: relative;
  margin-top: -90px;
  padding-bottom: 20px;
  z-index: 2;
}

.breadcrumb { font-size: 11px; color: rgba(255,255,255,0.65); margin-bottom: 10px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.breadcrumb a:hover { color: #fff; }

.hero-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
.hbadge { font-size: 10px; font-weight: 800; padding: 3px 10px; border-radius: 20px; letter-spacing: 0.3px; }
.hbadge--teal { background: var(--teal); color: #fff; }
.hbadge--dark { background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); }
.hbadge--red { background: #ef4444; color: #fff; }

.hero-title { font-size: clamp(22px, 5vw, 36px); font-weight: 800; color: #fff;
  font-family: 'Playfair Display', serif; line-height: 1.15; margin-bottom: 4px; }
.hero-sub { font-size: 13px; color: rgba(255,255,255,0.75); margin-bottom: 14px; }

.hero-price-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.price-label { font-size: 11px; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.5px; display: block; }
.price-stack { display: flex; align-items: baseline; gap: 8px; }
.price-mrp { font-size: 15px; color: rgba(255,255,255,0.5); text-decoration: line-through; }
.price-now { font-size: 26px; font-weight: 900; color: #fff; font-family: 'Playfair Display', serif; }
.hero-ctas { display: flex; gap: 8px; }

/* ── ACTIVITY CHIPS ── */
.chips-bar { background: #fff; border-bottom: 1px solid var(--border); padding: 10px 0; }
.chips-scroll {
  display: flex; gap: 8px; overflow-x: auto; padding: 0 16px;
  scrollbar-width: none; -ms-overflow-style: none;
}
.chips-scroll::-webkit-scrollbar { display: none; }
.act-chip {
  flex-shrink: 0; background: var(--mint); color: var(--teal);
  font-size: 12px; font-weight: 600; padding: 6px 14px;
  border-radius: 20px; border: 1px solid rgba(13,148,136,0.2); white-space: nowrap;
}

/* ── VEHICLE GRID — 2×2 ── */
.vehicle-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.v-card {
  background: #fff; border: 1.5px solid var(--border);
  border-radius: var(--radius); padding: 12px;
  display: flex; flex-direction: column; gap: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  transition: box-shadow 0.2s, transform 0.2s;
}
.v-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.1); transform: translateY(-2px); }

.v-top { display: flex; align-items: center; gap: 8px; position: relative; }
.v-icon { font-size: 28px; line-height: 1; }
.v-info { flex: 1; min-width: 0; }
.v-name { font-size: 13px; font-weight: 700; color: var(--slate); display: block;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.v-seats { font-size: 11px; color: var(--muted); }
.v-disc { background: #ef4444; color: #fff; font-size: 9px; font-weight: 900;
  line-height: 1.2; text-align: center; width: 34px; height: 34px; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  flex-shrink: 0; }

.v-pricing { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
.v-mrp { font-size: 12px; color: var(--muted); text-decoration: line-through; }
.v-price { font-size: 17px; font-weight: 900; color: var(--teal); font-family: 'Playfair Display', serif; }
.v-save { font-size: 11px; color: #16a34a; font-weight: 700; width: 100%; }

.v-btn { display: block; text-align: center; background: var(--teal); color: #fff;
  font-size: 12px; font-weight: 700; padding: 9px 6px; border-radius: 8px;
  text-decoration: none; transition: background 0.15s; }
.v-btn:hover { background: var(--teal-dark); }

/* ── TIMELINE ── */
.timeline { display: flex; flex-direction: column; gap: 0; }
.tl-item {
  display: flex; gap: 16px; position: relative;
  padding-bottom: 20px;
}
.tl-item:last-child { padding-bottom: 0; }
.tl-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 15px; top: 32px; bottom: 0;
  width: 2px; background: rgba(13,148,136,0.2);
}

.tl-dot {
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--teal); display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; z-index: 1;
}
.tl-num { font-size: 13px; font-weight: 800; color: #fff; }
.tl-body { flex: 1; padding-top: 4px; }
.tl-day { font-size: 10px; font-weight: 700; color: var(--teal); text-transform: uppercase;
  letter-spacing: 0.8px; display: block; margin-bottom: 2px; }
.tl-text { font-size: 14px; color: var(--slate); font-weight: 600; line-height: 1.4; }

/* ── CAROUSEL ── */
.more-pkgs .sec-title,
.more-pkgs .sec-sub { padding: 0 16px; }
.carousel-wrap { overflow: hidden; }
.carousel {
  display: flex; gap: 12px; overflow-x: auto; padding: 8px 16px 16px;
  scroll-snap-type: x mandatory; scrollbar-width: none;
}
.carousel::-webkit-scrollbar { display: none; }

.rel-card {
  flex-shrink: 0; width: 200px; border-radius: var(--radius);
  border: 1.5px solid var(--border); overflow: hidden;
  text-decoration: none; background: #fff; scroll-snap-align: start;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}
.rel-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }

.rel-header { position: relative; height: 90px; display: flex;
  align-items: flex-end; padding: 8px; }
.rel-badge { font-size: 9px; font-weight: 800; color: #fff;
  padding: 2px 8px; border-radius: 20px; }
.rel-nd { position: absolute; top: 8px; left: 8px; font-size: 10px; font-weight: 700;
  color: #fff; background: rgba(0,0,0,0.35); padding: 2px 7px; border-radius: 20px; }
.rel-disc { position: absolute; top: 8px; right: 8px; background: #ef4444; color: #fff;
  font-size: 8px; font-weight: 900; line-height: 1.2; text-align: center;
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center; }

.rel-body { padding: 10px; }
.rel-name { font-size: 12px; font-weight: 700; color: var(--slate); line-height: 1.3;
  margin-bottom: 4px; font-family: 'Playfair Display', serif; }
.rel-price { font-size: 13px; font-weight: 800; color: var(--teal); margin-bottom: 6px; }
.rel-chips { display: flex; flex-wrap: wrap; gap: 3px; }
.rel-chip { font-size: 10px; color: var(--muted); background: #f8fafc;
  border: 1px solid var(--border); padding: 2px 7px; border-radius: 20px; }

/* ── INCLUDES ── */
.inc-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px;
}
.inc-item {
  display: flex; align-items: center; gap: 10px;
  background: var(--mint); border: 1px solid rgba(13,148,136,0.15);
  border-radius: var(--radius-sm); padding: 12px;
}
.inc-icon { font-size: 22px; flex-shrink: 0; }
.inc-text { font-size: 13px; font-weight: 600; color: var(--slate); line-height: 1.3; }
.inc-note { text-align: center; font-size: 13px; color: var(--muted);
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 10px; }

/* ── FAQ ── */
.faq-list { display: flex; flex-direction: column; gap: 8px; }
.faq-item {
  background: #fff; border: 1.5px solid var(--border);
  border-radius: var(--radius-sm); overflow: hidden;
}
.faq-q {
  display: block; padding: 14px 16px; font-size: 14px; font-weight: 700;
  color: var(--slate); cursor: pointer; list-style: none;
  position: relative; padding-right: 36px;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-q::after { content: '+'; position: absolute; right: 16px; top: 50%;
  transform: translateY(-50%); font-size: 20px; font-weight: 300; color: var(--teal); }
details[open] > .faq-q::after { content: '−'; }
.faq-a { padding: 0 16px 14px; font-size: 13px; color: var(--muted); line-height: 1.6; }

/* ── BOOK CTA ── */
.book-cta { background: var(--teal); }
.book-cta-inner { text-align: center; }
.book-cta-title { font-size: 20px; color: #fff; font-family: 'Playfair Display', serif;
  font-weight: 800; margin-bottom: 6px; }
.book-cta-sub { font-size: 13px; color: rgba(255,255,255,0.75); margin-bottom: 16px; }
.book-cta-btns { display: flex; flex-direction: column; gap: 10px; }

/* ── Desktop overrides ── */
@media (min-width: 640px) {
  .hero-img-wrap { height: 360px; }
  .hero-content { margin-top: -120px; }
  .hero-title { font-size: 36px; }
  .vehicle-grid { grid-template-columns: repeat(4, 1fr); }
  .v-name { white-space: normal; }
  .rel-card { width: 240px; }
  .book-cta-btns { flex-direction: row; justify-content: center; }
  .btn-full { width: auto; }
  .more-pkgs .sec-title,
  .more-pkgs .sec-sub { padding: 0; }
  .carousel { padding: 8px 0 16px; }
}
</style>
