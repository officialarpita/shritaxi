---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Base
  title="Privacy Policy | Shri Taxi"
  description="Privacy policy for Shri Taxi — how we collect and use your information."
  canonicalUrl="https://shritaxi.com/privacy-policy"
>
  <!-- Override robots for this page only -->
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <TopBar />
  <Header currentPath="/privacy-policy" />
  <main id="main-content">
    <section class="section">
      <div class="container" style="max-width:800px;">
        <h1 style="font-family:'Playfair Display',serif;font-size:36px;margin-bottom:8px;">Privacy Policy</h1>
        <p style="color:#64748b;margin-bottom:32px;">Last updated: May 2026</p>

        <div class="policy-content">
          <h2>Information We Collect</h2>
          <p>When you book a taxi with Shri Taxi, we collect your name, phone number, pickup and drop locations, and travel date. This information is used solely to fulfill your booking.</p>

          <h2>How We Use Your Information</h2>
          <p>Your information is used to confirm bookings, assign drivers, and communicate trip details via WhatsApp or phone call. We do not sell your information to third parties.</p>

          <h2>WhatsApp Communication</h2>
          <p>When you contact us via WhatsApp, your messages are received through the WhatsApp Business platform. We use this only for booking confirmation and support.</p>

          <h2>Data Security</h2>
          <p>We take reasonable measures to protect your personal information. Your data is not shared with anyone outside our team without your consent.</p>

          <h2>Contact Us</h2>
          <p>For any privacy concerns, contact us at +91 6397321825 or via WhatsApp.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <StickyBar />
</Base>

<style>
.policy-content h2 { font-size: 20px; color: #1e293b; margin: 28px 0 10px; font-family: 'DM Sans', sans-serif; font-weight: 700; }
.policy-content p { font-size: 15px; color: #64748b; line-height: 1.75; margin-bottom: 16px; }
</style>
