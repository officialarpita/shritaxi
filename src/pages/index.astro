---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import PopularRoutes from '../components/PopularRoutes.astro';
import HomepagePackages from '../components/HomepagePackages.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Base
  title="Shri Taxi — Trusted Taxi Service in Uttarakhand | Dehradun Cab"
  description="Book reliable taxi service in Dehradun, Uttarakhand. Airport transfers, Char Dham Yatra, hill station tours & outstation cabs. Transparent pricing, verified drivers, 24/7 support."
  canonicalUrl="https://shritaxi.com/"
>
  <TopBar />
  <Header />
  <main>
    <Hero />
    <TrustBar />
    <PopularRoutes />
    <HomepagePackages />
    <WhyUs />
    <Reviews />
    <FAQ />
  </main>
  <Footer />
  <StickyBar />
</Base>
