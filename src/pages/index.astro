---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import PopularRoutes from '../components/PopularRoutes.astro';
import HomepagePackages from '../components/HomepagePackages.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['TaxiService', 'LocalBusiness'],
  name: 'Shri Taxi — Taxi Service in Uttarakhand',
  description: 'Reliable taxi service across Uttarakhand — Dehradun, Mussoorie, Haridwar, Rishikesh, Nainital, Char Dham Yatra and outstation cabs to Delhi NCR & Chandigarh. Experienced local pahadi drivers, transparent pricing, 24/7 available.',
  url: 'https://shritaxi.com',
  telephone: phone,
  priceRange: '₹₹',
  image: 'https://shritaxi.com/images/hero-mountains.jpg',
  logo: 'https://shritaxi.com/images/logo.png',
  hasMap: 'https://maps.app.goo.gl/X8hFada5oFN63vUp7',
  paymentAccepted: 'Cash, UPI, GPay, PhonePe, Paytm, Bank Transfer',
  currenciesAccepted: 'INR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Shastradhara Road',
    addressLocality: 'Dehradun',
    addressRegion: 'Uttarakhand',
    postalCode: '248001',
    addressCountry: 'IN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 30.3165,
    longitude: 78.0322,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: phone,
    contactType: 'customer service',
    availableLanguage: ['Hindi', 'English'],
    areaServed: 'Uttarakhand',
  },
  areaServed: [
    { '@type': 'City', name: 'Dehradun' },
    { '@type': 'City', name: 'Mussoorie' },
    { '@type': 'City', name: 'Haridwar' },
    { '@type': 'City', name: 'Rishikesh' },
    { '@type': 'City', name: 'Nainital' },
    { '@type': 'City', name: 'Kedarnath' },
    { '@type': 'City', name: 'Badrinath' },
    { '@type': 'City', name: 'Auli' },
    { '@type': 'City', name: 'Dhanaulti' },
    { '@type': 'City', name: 'Munsiyari' },
    { '@type': 'City', name: 'Chopta' },
    { '@type': 'City', name: 'Delhi' },
    { '@type': 'City', name: 'Chandigarh' },
    { '@type': 'State', name: 'Uttarakhand' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Taxi & Cab Services in Uttarakhand',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Airport Transfer – Jolly Grant Airport Dehradun' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Char Dham Yatra Taxi Package 2026' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Dehradun to Mussoorie' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Dehradun to Rishikesh' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Dehradun to Haridwar' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Delhi to Dehradun' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Delhi to Haridwar' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Delhi to Rishikesh' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Delhi to Mussoorie' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Taxi from Chandigarh to Dehradun' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Outstation Cab Dehradun – One Way & Round Trip' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tempo Traveller Dehradun' } },
    ],
  },
  sameAs: [`https://wa.me/${wa}`],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Shri Taxi — Uttarakhand Taxi Service',
  url: 'https://shritaxi.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://shritaxi.com/packages?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title="Taxi Service in Uttarakhand | Dehradun, Mussoorie, Char Dham & Delhi NCR | Shri Taxi"
  description="Book taxi service across Uttarakhand — Char Dham Yatra 2026, Dehradun airport transfers, Mussoorie, Haridwar, Rishikesh & outstation cabs to Delhi NCR and Chandigarh. Pahadi drivers, fixed price, 24/7 support."
  canonicalUrl="https://shritaxi.com/"
  ogImage="https://shritaxi.com/images/og.jpg"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/" />
  <main id="main-content">
    <Hero />
    <TrustBar />
    <PopularRoutes />
    <HomepagePackages />
    <WhyUs />
    <Reviews />
    <FAQ />
  </main>
  <Footer />
  <StickyBar />
</Base>
