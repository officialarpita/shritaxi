---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { Image } from 'astro:assets';
import { tourPackages, fmt } from '../data/pricing';

import CharDhamImg   from '../assets/images/CharDham1.jpeg';
import NainitalImg   from '../assets/images/Nainital2.jpg';
import AuliImg       from '../assets/images/Auli_togo.jpg';
import KedarnathImg  from '../assets/images/CharDham2.jpeg';
import BadrinathImg  from '../assets/images/Badrinath.jpeg';
import NeemKaroliImg from '../assets/images/NeemKaroli.jpeg';
import DhanaultiImg  from '../assets/images/Dhanaulti.jpeg';
import MunsiyariImg  from '../assets/images/Munsyari.jpeg';
import ChoptaImg     from '../assets/images/Chopta.jpeg';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const imgMap: Record<string, ImageMetadata> = {
  'dhanaulti':   DhanaultiImg,
  'munsiyari':   MunsiyariImg,
  'chopta':      ChoptaImg,
  'neem-karoli': NeemKaroliImg,
  'nainital':    NainitalImg,
  'auli':        AuliImg,
  'kedarnath':   KedarnathImg,
  'badrinath':   BadrinathImg,
  'ek-dham':     CharDhamImg,
  'do-dham':     CharDhamImg,
  'char-dham':   CharDhamImg,
};

// Filter packages by section
const dayPackages = tourPackages.filter(p =>
  ['dhanaulti', 'neem-karoli', 'nainital', 'auli', 'munsiyari', 'chopta', 'kedarnath', 'badrinath'].includes(p.id)
);
const charDhamPackages = tourPackages.filter(p =>
  ['ek-dham', 'do-dham', 'char-dham'].includes(p.id)
);
const multiDestPackages = tourPackages.filter(p =>
  ['nainital-corbett', 'mussoorie-corbett-nainital-ranikhet', 'nainital-ranikhet-corbett', 'almora-kausani'].includes(p.id)
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Uttarakhand Tour Packages with Cab from Dehradun',
  description: 'Curated cab packages for Char Dham Yatra, Nainital, Auli, Kedarnath, Badrinath, Neem Karoli Baba and more from Dehradun',
  itemListElement: tourPackages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `https://shritaxi.com${p.href}`,
    description: p.seoDesc,
  })),
};
---

<Base
  title="Uttarakhand Tour Packages with Cab | Char Dham, Nainital, Auli | Shri Taxi"
  description="Book Uttarakhand tour packages with cab from Dehradun. Char Dham Yatra, Nainital, Auli, Kedarnath, Badrinath, Neem Karoli Baba. All inclusive pricing. 10% discount."
  canonicalUrl="https://shritaxi.com/packages"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- Hero -->
    <section class="pkg-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> › <span>Tour Packages</span>
        </nav>
        <h1 class="pkg-hero-title">Uttarakhand Tour Packages with Cab</h1>
        <p class="pkg-hero-sub">All inclusive · Experienced hill drivers · 10% discount on all packages · Driver + fuel + toll + parking included</p>
        <div class="pkg-hero-ctas">
          <a href={`tel:${phone}`} class="btn btn-call">📞 Call Now</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20know%20about%20your%20tour%20packages`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Us</a>
        </div>
      </div>
    </section>

    <!-- Discount announcement -->
    <div class="discount-bar">
      <div class="container discount-bar-inner">
        <span class="discount-fire">🔥</span>
        <p><strong>Limited Time — 10% OFF on all packages!</strong> Book now and save up to ₹8,991 on Char Dham Yatra</p>
        <span class="discount-badge">10% OFF</span>
      </div>
    </div>


    <!-- Category Selector + Package Grid -->
    <section class="section pkg-main">
      <div class="container">

        <!-- 3 Visual Category Cards -->
        <div class="cat-selector">
          <button class="cat-card cat-card--active" data-cat="day">
            <div class="cat-card-icon">🏔️</div>
            <div class="cat-card-body">
              <h3 class="cat-card-title">Day Trips & Short Packages</h3>
              <p class="cat-card-sub">From Dehradun</p>
              <p class="cat-card-count">8 packages</p>
              <p class="cat-card-price">Starting ₹3,599</p>
            </div>
            <div class="cat-card-arrow">→</div>
          </button>

          <button class="cat-card" data-cat="chardham">
            <div class="cat-card-icon">🙏</div>
            <div class="cat-card-body">
              <h3 class="cat-card-title">Char Dham Yatra 2026</h3>
              <p class="cat-card-sub">Season Open · From Dehradun</p>
              <p class="cat-card-count">3 packages</p>
              <p class="cat-card-price">Starting ₹10,999</p>
            </div>
            <div class="cat-card-arrow">→</div>
          </button>

          <button class="cat-card cat-card--highlight" data-cat="circuits">
            <div class="cat-card-new">NEW</div>
            <div class="cat-card-icon">🏙️</div>
            <div class="cat-card-body">
              <h3 class="cat-card-title">Delhi & Chandigarh Circuits</h3>
              <p class="cat-card-sub">Same price from both cities</p>
              <p class="cat-card-count">4 packages</p>
              <p class="cat-card-price">Starting ₹17,999</p>
            </div>
            <div class="cat-card-arrow">→</div>
          </button>
        </div>

        <!-- Package Grid — Day Trips -->
        <div class="pkg-section" id="section-day">
          <h2 class="pkg-section-title">Popular Tour Packages from Dehradun</h2>
          <p class="pkg-section-sub">Curated cab packages for spiritual pilgrimages, adventure trips and cultural experiences</p>
          <div class="pkg-grid">
            {dayPackages.map(p => {
              const img = imgMap[p.id] || CharDhamImg;
              return (
                <div class="pkg-card">
                  <div class="pkg-img-wrap">
                    <Image src={img} alt={`${p.name} taxi package`} width={380} height={200} widths={[300, 380, 760]} sizes="(max-width: 640px) 300px, 380px" format="webp" class="pkg-img" loading="lazy" />
                    <div class="pkg-overlay"></div>
                    <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                    <span class="pkg-nights">{p.nights > 0 ? `${p.nights}N ` : ''}{p.days}D</span>
                    <div class="pkg-discount-circle"><span>10%</span><span>OFF</span></div>
                  </div>
                  <div class="pkg-body">
                    <h3 class="pkg-name">{p.name}</h3>
                    <div class="pkg-highlights">
                      {p.highlights.slice(0,3).map(h => <span class="pkg-highlight-chip">{h}</span>)}
                    </div>
                    <div class="pkg-pricing-table">
                      <div class="pkg-pricing-header"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                      {p.tiers.map(t => (
                        <div class="pkg-pricing-row">
                          <span class="pkg-tier-vehicle">{t.vehicleId === 'sedan' ? '🚗 Sedan' : t.vehicleId === 'ertiga' ? '🚐 Ertiga' : t.vehicleId === 'innova' ? '🚙 Innova' : '🚌 Traveller'}</span>
                          <span class="pkg-tier-mrp">{fmt(t.mrp)}</span>
                          <span class="pkg-tier-final">{fmt(t.discounted)}</span>
                          <span class="pkg-tier-save">-{fmt(t.saving)}</span>
                        </div>
                      ))}
                    </div>
                    <p class="pkg-inclusive">✓ All inclusive — driver, fuel, toll & parking</p>
                    <div class="pkg-actions">
                      <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                      <a href={`tel:${phone}`} class="btn btn-outline pkg-btn">📞 Call Us</a>
                    </div>
                    <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Package Grid — Char Dham -->
        <div class="pkg-section" id="section-chardham" style="display:none">
          <h2 class="pkg-section-title">Char Dham Yatra Packages from Dehradun</h2>
          <p class="pkg-section-sub">Complete Char Dham Yatra — Yamunotri, Gangotri, Kedarnath, Badrinath. Season open 2026.</p>
          <div class="pkg-grid">
            {charDhamPackages.map(p => (
              <div class="pkg-card">
                <div class="pkg-img-wrap">
                  <Image src={CharDhamImg} alt={`${p.name} taxi package`} width={380} height={200} widths={[300, 380, 760]} sizes="(max-width: 640px) 300px, 380px" format="webp" class="pkg-img" loading="lazy" />
                  <div class="pkg-overlay"></div>
                  <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                  <span class="pkg-nights">{p.nights}N {p.days}D</span>
                  <div class="pkg-discount-circle"><span>10%</span><span>OFF</span></div>
                </div>
                <div class="pkg-body">
                  <h3 class="pkg-name">{p.name}</h3>
                  <div class="pkg-highlights">
                    {p.highlights.slice(0,3).map(h => <span class="pkg-highlight-chip">{h}</span>)}
                  </div>
                  <div class="pkg-pricing-table">
                    <div class="pkg-pricing-header"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                    {p.tiers.map(t => (
                      <div class="pkg-pricing-row">
                        <span class="pkg-tier-vehicle">{t.vehicleId === 'sedan' ? '🚗 Sedan' : t.vehicleId === 'ertiga' ? '🚐 Ertiga' : t.vehicleId === 'innova' ? '🚙 Innova' : '🚌 Traveller'}</span>
                        <span class="pkg-tier-mrp">{fmt(t.mrp)}</span>
                        <span class="pkg-tier-final">{fmt(t.discounted)}</span>
                        <span class="pkg-tier-save">-{fmt(t.saving)}</span>
                      </div>
                    ))}
                  </div>
                  <p class="pkg-inclusive">✓ All inclusive — driver, fuel, toll & parking</p>
                  <div class="pkg-actions">
                    <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                    <a href="/char-dham-yatra" class="btn btn-outline pkg-btn">View Details</a>
                  </div>
                  <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Package Grid — Delhi Circuits -->
        <div class="pkg-section" id="section-circuits" style="display:none">
          <h2 class="pkg-section-title">Uttarakhand Circuit Tour Packages</h2>
          <p class="pkg-section-sub">From Delhi NCR & Chandigarh — same price, cab only, all inclusive</p>
          <div class="multi-notice"><span>📍</span><p><strong>Same price from Delhi NCR & Chandigarh.</strong> Cab only — hotel, meals & safari not included.</p></div>
          <div class="pkg-grid">
            {multiDestPackages.map(p => (
              <div class="pkg-card">
                <div class="pkg-img-wrap pkg-img-wrap--no-img">
                  <div class="pkg-no-img-bg" style={`background:${p.badgeColor}`}>
                    <span class="pkg-no-img-icon">🏔️</span>
                    <span class="pkg-no-img-nights">{p.nights}N {p.days}D</span>
                  </div>
                  <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                  <div class="pkg-discount-circle"><span>10%</span><span>OFF</span></div>
                </div>
                <div class="pkg-body">
                  <h3 class="pkg-name">{p.name}</h3>
                  <div class="pkg-highlights">
                    {p.highlights.slice(0,3).map(h => <span class="pkg-highlight-chip">{h}</span>)}
                  </div>
                  <div class="pkg-pricing-table">
                    <div class="pkg-pricing-header"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                    {p.tiers.map(t => (
                      <div class="pkg-pricing-row">
                        <span class="pkg-tier-vehicle">{t.vehicleId === 'sedan' ? '🚗 Sedan' : t.vehicleId === 'ertiga' ? '🚐 Ertiga' : t.vehicleId === 'innova' ? '🚙 Innova' : '🚌 Traveller'}</span>
                        <span class="pkg-tier-mrp">{fmt(t.mrp)}</span>
                        <span class="pkg-tier-final">{fmt(t.discounted)}</span>
                        <span class="pkg-tier-save">-{fmt(t.saving)}</span>
                      </div>
                    ))}
                  </div>
                  <p class="pkg-inclusive">✓ Cab — driver, fuel, toll & parking included</p>
                  {p.excludes && (
                    <details class="pkg-excl">
                      <summary class="pkg-excl-summary">View Exclusions ▾</summary>
                      <ul class="pkg-excl-list">{p.excludes.map(e => <li>✗ {e}</li>)}</ul>
                    </details>
                  )}
                  <div class="pkg-actions">
                    <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                    <a href={`tel:${phone}`} class="btn btn-outline pkg-btn">📞 Call Us</a>
                  </div>
                  <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- Why Book -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Why Book Your Uttarakhand Tour with Shri Taxi?</h2>
        <div class="why-grid">
          {[
            { icon: '💰', title: '10% Discount', desc: 'Get 10% off on all tour packages. Save up to ₹8,991 on Char Dham Yatra.' },
            { icon: '✓', title: 'All Inclusive', desc: 'Driver, fuel, toll and parking all included. No surprise charges at the end.' },
            { icon: '🏔️', title: 'Pahadi Drivers', desc: 'Our drivers know every mountain road. Safe, experienced and local.' },
            { icon: '📞', title: '24/7 Support', desc: 'We are available round the clock for any assistance during your trip.' },
            { icon: '🚗', title: 'Premium Fleet', desc: 'Choose from Sedan, Ertiga, Innova Crysta and Tempo Traveller.' },
            { icon: '⚡', title: 'Instant Booking', desc: 'Confirm your booking via WhatsApp or call. No waiting, no forms.' },
          ].map(w => (
            <div class="why-card">
              <span class="why-icon">{w.icon}</span>
              <h3 class="why-title">{w.title}</h3>
              <p class="why-desc">{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section pkg-cta">
      <div class="container pkg-cta-inner">
        <div>
          <h2>Ready to Book Your Uttarakhand Tour?</h2>
          <p>Get 10% discount on all packages. All inclusive pricing. No hidden charges.</p>
        </div>
        <div class="pkg-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20tour%20package`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Now</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll<HTMLElement>('.cat-card');
    const sections = document.querySelectorAll<HTMLElement>('.pkg-section');

    function switchTo(cat: string) {
      // Update cards
      cards.forEach(c => c.classList.toggle('cat-card--active', c.dataset.cat === cat));
      // Show/hide sections
      sections.forEach(s => {
        s.style.display = s.id === `section-${cat}` ? '' : 'none';
      });
      // Scroll to section smoothly
      document.getElementById(`section-${cat}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Default
    switchTo('day');

    cards.forEach(card => {
      card.addEventListener('click', () => switchTo(card.dataset.cat || 'day'));
    });
  });
</script>

<style>
/* ── Hero ── */
.pkg-hero { background: linear-gradient(135deg, #0d9488, #0f766e); padding: 52px 0 40px; }
.pkg-hero-label { font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 12px; }
.pkg-hero-title { font-size: clamp(28px, 4vw, 44px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 10px; line-height: 1.2; }
.pkg-hero-sub { font-size: 16px; color: rgba(255,255,255,0.8); margin-bottom: 24px; }
.pkg-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

/* ── Discount Bar ── */
.discount-bar { background: var(--saffron); padding: 10px 0; }
.discount-bar-inner { display: flex; align-items: center; gap: 10px; justify-content: center; flex-wrap: wrap; }
.discount-fire { font-size: 18px; }
.discount-bar-inner p { font-size: 13px; color: #fff; }
.discount-badge { background: #fff; color: var(--saffron); font-size: 12px; font-weight: 800; padding: 3px 12px; border-radius: 20px; }

/* ── Category Selector ── */
.pkg-main { padding-top: 40px; }

.cat-selector {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 40px;
}

.cat-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  background: var(--white);
  border: 2px solid var(--border);
  border-radius: var(--radius-lg);
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  transition: all 0.2s;
  position: relative;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.cat-card:hover {
  border-color: var(--teal);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.cat-card--active {
  border-color: var(--teal);
  background: linear-gradient(135deg, rgba(13,148,136,0.05), rgba(13,148,136,0.08));
  box-shadow: 0 4px 16px rgba(13,148,136,0.15);
}

.cat-card--highlight {
  border-color: var(--saffron);
}

.cat-card--highlight.cat-card--active {
  background: linear-gradient(135deg, rgba(251,146,60,0.05), rgba(251,146,60,0.08));
  box-shadow: 0 4px 16px rgba(251,146,60,0.15);
}

.cat-card--highlight:hover {
  border-color: var(--saffron);
}

.cat-card-new {
  position: absolute;
  top: -10px;
  right: 14px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 20px;
  letter-spacing: 0.5px;
}

.cat-card-icon { font-size: 36px; flex-shrink: 0; }

.cat-card-body { flex: 1; }
.cat-card-title { font-size: 15px; font-weight: 700; color: var(--slate); margin-bottom: 2px; line-height: 1.3; }
.cat-card-sub { font-size: 11px; color: var(--muted); margin-bottom: 6px; }
.cat-card-count { font-size: 12px; font-weight: 600; color: var(--teal); margin-bottom: 2px; }
.cat-card-price { font-size: 13px; font-weight: 700; color: var(--saffron); }
.cat-card--active .cat-card-title { color: var(--teal); }
.cat-card--highlight.cat-card--active .cat-card-title { color: #c2410c; }

.cat-card-arrow { font-size: 18px; color: var(--muted); transition: transform 0.2s; flex-shrink: 0; }
.cat-card--active .cat-card-arrow { color: var(--teal); transform: translateX(4px); }

/* ── Package Section ── */
.pkg-section-title { font-size: 24px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 6px; }
.pkg-section-sub { font-size: 14px; color: var(--muted); margin-bottom: 24px; }

/* ── Package Grid ── */
.pkg-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
  margin-top: 16px;
}

/* ── Package Card ── */
.pkg-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s, transform 0.2s;
}
.pkg-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }

.pkg-img-wrap { position: relative; height: 200px; overflow: hidden; }
.pkg-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
.pkg-card:hover .pkg-img { transform: scale(1.05); }
.pkg-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 60%); }
.pkg-badge { position: absolute; top: 10px; left: 10px; color: #fff; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
.pkg-nights { position: absolute; bottom: 10px; left: 10px; color: #fff; font-size: 12px; font-weight: 700; background: rgba(0,0,0,0.4); padding: 2px 8px; border-radius: 20px; }
.pkg-discount-circle { position: absolute; top: 10px; right: 10px; background: #ef4444; color: #fff; width: 44px; height: 44px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; line-height: 1.2; }

/* No image fallback for Delhi circuits */
.pkg-img-wrap--no-img { height: 140px; }
.pkg-no-img-bg { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
.pkg-no-img-icon { font-size: 40px; }
.pkg-no-img-nights { color: #fff; font-size: 14px; font-weight: 700; background: rgba(0,0,0,0.3); padding: 3px 10px; border-radius: 20px; }

/* Card body */
.pkg-body { padding: 16px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
.pkg-name { font-size: 16px; font-weight: 700; color: var(--slate); font-family: 'Playfair Display', serif; line-height: 1.3; }

.pkg-highlights { display: flex; flex-wrap: wrap; gap: 5px; }
.pkg-highlight-chip { background: var(--mint); color: var(--teal); font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid rgba(13,148,136,0.2); }

/* Pricing table */
