---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { Image } from 'astro:assets';
import { tourPackages, fmt } from '../data/pricing';

import CharDhamImg   from '../assets/images/CharDham1.jpeg';
import NainitalImg   from '../assets/images/Nainital2.jpg';
import AuliImg       from '../assets/images/Auli_togo.jpg';
import KedarnathImg  from '../assets/images/CharDham2.jpeg';
import BadrinathImg  from '../assets/images/Badrinath.jpeg';
import NeemKaroliImg from '../assets/images/NeemKaroli.jpeg';
import DhanaultiImg  from '../assets/images/Dhanaulti.jpeg';
import MunsiyariImg  from '../assets/images/Munsyari.jpeg';
import ChoptaImg     from '../assets/images/Chopta.jpeg';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const imgMap: Record<string, ImageMetadata> = {
  'dhanaulti':   DhanaultiImg,
  'munsiyari':   MunsiyariImg,
  'chopta':      ChoptaImg,
  'neem-karoli': NeemKaroliImg,
  'nainital':    NainitalImg,
  'auli':        AuliImg,
  'kedarnath':   KedarnathImg,
  'badrinath':   BadrinathImg,
  'ek-dham':     KedarnathImg,
  'do-dham':     BadrinathImg,
  'char-dham':   CharDhamImg,
};

const dayPackages = tourPackages.filter(p =>
  ['dhanaulti', 'neem-karoli', 'nainital', 'auli', 'munsiyari', 'chopta'].includes(p.id)
);
const charDhamPackages = tourPackages.filter(p =>
  ['ek-dham', 'do-dham', 'char-dham'].includes(p.id)
);
const delhiPackages = tourPackages.filter(p =>
  ['nainital-corbett', 'mussoorie-corbett-nainital-ranikhet', 'nainital-ranikhet-corbett', 'almora-kausani'].includes(p.id)
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Uttarakhand Tour Packages with Cab',
  description: 'Curated cab packages for Char Dham Yatra, Nainital, Auli, Kedarnath, Badrinath and Delhi circuits',
  itemListElement: tourPackages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `https://shritaxi.com${p.href}`,
  })),
};

const vLabel = (id: string) =>
  id === 'sedan' ? '🚗 Sedan' : id === 'ertiga' ? '🚐 Ertiga' : id === 'innova' ? '🚙 Innova' : '🚌 Tempo';
---

<Base
  title="Uttarakhand Tour Packages with Cab | Char Dham, Hill Stations & Delhi Circuits | Shri Taxi"
  description="Book Uttarakhand tour packages with cab — Char Dham Yatra, Nainital, Auli, Kedarnath, Delhi circuits. All inclusive, 10% discount, experienced drivers."
  canonicalUrl="https://shritaxi.com/packages"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- Hero -->
    <section class="pkg-hero">
      <div class="container">
        <nav class="breadcrumb"><a href="/">Home</a> › <span>Tour Packages</span></nav>
        <p class="pkg-hero-label">Uttarakhand Tour Packages</p>
        <h1 class="pkg-hero-title">Uttarakhand Tour Packages with Cab</h1>
        <p class="pkg-hero-sub">All inclusive · Experienced hill drivers · 10% discount · Driver + fuel + toll + parking</p>
        <div class="pkg-hero-ctas">
          <a href={`tel:${phone}`} class="btn btn-call">📞 Call Now</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20know%20about%20your%20tour%20packages`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Us</a>
        </div>
      </div>
    </section>

    <!-- Discount Bar -->
    <div class="discount-bar">
      <div class="container discount-bar-inner">
        <span>🔥</span>
        <p><strong>Limited Time — 10% OFF on all packages!</strong> Book now and save up to ₹8,991 on Char Dham Yatra</p>
        <span class="discount-badge">10% OFF</span>
      </div>
    </div>

    <!-- Sticky Pill Nav -->
    <div class="pill-nav-wrap">
      <nav class="pill-nav" aria-label="Package categories">
        <a href="#day-trips"  class="pill active">🏔️ Day Trips</a>
        <a href="#char-dham"  class="pill">🙏 Char Dham</a>
        <a href="#delhi-tours" class="pill">🏙️ Delhi Tours</a>
      </nav>
    </div>

    <!-- ─── SECTION 1: Day Trips ─── -->
    <section class="pkg-section" id="day-trips">
      <div class="container">
        <div class="sec-head sec-head--teal">
          <div class="sec-head-left">
            <span class="sec-icon">🏔️</span>
            <div>
              <h2 class="sec-title">Day Trips & Short Packages</h2>
              <p class="sec-sub">From Dehradun · {dayPackages.length} packages · Starting ₹3,599</p>
            </div>
          </div>
          <span class="sec-price">₹3,599+</span>
        </div>

        <div class="pkg-grid">
          {dayPackages.map(p => {
            const img = imgMap[p.id] || CharDhamImg;
            const isDedicated = p.href.startsWith('/packages/');
            return (
              <div class="pkg-card" id={p.id}>
                <div class="pkg-img-wrap">
                  <Image src={img} alt={`${p.name} taxi package`} width={380} height={200}
                    widths={[300,380,760]} sizes="(max-width:640px) 300px, 380px"
                    format="webp" class="pkg-img" loading="lazy" />
                  <div class="pkg-overlay"></div>
                  <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                  <span class="pkg-nights">{p.nights > 0 ? `${p.nights}N ` : ''}{p.days}D</span>
                  <div class="pkg-disc"><span>10%</span><span>OFF</span></div>
                </div>
                <div class="pkg-body">
                  <h3 class="pkg-name">{p.name}</h3>
                  <div class="pkg-chips-wrap">
                    {p.highlights.slice(0,3).map(h => <span class="pkg-chip">{h}</span>)}
                  </div>
                  <div class="pkg-table">
                    <div class="pkg-table-head"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                    {p.tiers.map(t => (
                      <div class="pkg-table-row">
                        <span>{vLabel(t.vehicleId)}</span>
                        <span class="t-mrp">{fmt(t.mrp)}</span>
                        <span class="t-price">{fmt(t.discounted)}</span>
                        <span class="t-save">-{fmt(t.saving)}</span>
                      </div>
                    ))}
                  </div>
                  <p class="pkg-incl">✓ All inclusive — driver, fuel, toll & parking</p>
                  <div class="pkg-actions">
                    <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}`}
                      target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                    {isDedicated
                      ? <a href={p.href} class="btn btn-outline pkg-btn">View Details</a>
                      : <a href={`tel:${phone}`} class="btn btn-outline pkg-btn">📞 Call Us</a>
                    }
                  </div>
                  <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ─── SECTION 2: Char Dham ─── -->
    <section class="pkg-section pkg-section--saffron" id="char-dham">
      <div class="container">
        <div class="sec-head sec-head--saffron">
          <div class="sec-head-left">
            <span class="sec-icon">🙏</span>
            <div>
              <h2 class="sec-title">Char Dham Yatra 2026 <span class="sec-badge-season">Season Open</span></h2>
              <p class="sec-sub">From Dehradun · {charDhamPackages.length} packages · Starting ₹10,999</p>
            </div>
          </div>
          <span class="sec-price">₹10,999+</span>
        </div>

        <div class="pkg-grid">
          {charDhamPackages.map(p => (
            <div class="pkg-card" id={p.id}>
              <div class="pkg-img-wrap">
                <Image src={imgMap[p.id] || CharDhamImg} alt={`${p.name} taxi package`}
                  width={380} height={200} widths={[300,380,760]}
                  sizes="(max-width:640px) 300px, 380px" format="webp" class="pkg-img" loading="lazy" />
                <div class="pkg-overlay"></div>
                <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                <span class="pkg-nights">{p.nights}N {p.days}D</span>
                <div class="pkg-disc"><span>10%</span><span>OFF</span></div>
              </div>
              <div class="pkg-body">
                <h3 class="pkg-name">{p.name}</h3>
                <div class="pkg-chips-wrap">
                  {p.highlights.slice(0,3).map(h => <span class="pkg-chip pkg-chip--saffron">{h}</span>)}
                </div>
                <div class="pkg-table">
                  <div class="pkg-table-head pkg-table-head--saffron"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                  {p.tiers.map(t => (
                    <div class="pkg-table-row">
                      <span>{vLabel(t.vehicleId)}</span>
                      <span class="t-mrp">{fmt(t.mrp)}</span>
                      <span class="t-price t-price--saffron">{fmt(t.discounted)}</span>
                      <span class="t-save">-{fmt(t.saving)}</span>
                    </div>
                  ))}
                </div>
                <p class="pkg-incl">✓ All inclusive — driver, fuel, toll & parking</p>
                <div class="pkg-actions">
                  <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}%202026`}
                    target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                  <a href="/char-dham-yatra" class="btn btn-outline-saffron pkg-btn">View Details</a>
                </div>
                <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── SECTION 3: Delhi & Chandigarh Tours ─── -->
    <section class="pkg-section pkg-section--purple" id="delhi-tours">
      <div class="container">
        <div class="sec-head sec-head--purple">
          <div class="sec-head-left">
            <span class="sec-icon">🏙️</span>
            <div>
              <h2 class="sec-title">Delhi & Chandigarh Circuit Tours <span class="sec-badge-new">NEW</span></h2>
              <p class="sec-sub">Same price from Delhi & Chandigarh · {delhiPackages.length} packages · Starting ₹17,999</p>
            </div>
          </div>
          <span class="sec-price">₹17,999+</span>
        </div>

        <div class="multi-notice">
          <span>📍</span>
          <p><strong>Pickup from Delhi NCR or Chandigarh — same price.</strong> Cab only — hotel, meals & safari not included.</p>
        </div>

        <div class="pkg-grid">
          {delhiPackages.map(p => (
            <div class="pkg-card" id={p.id}>
              <div class="pkg-img-no-img" style={`background:linear-gradient(135deg,${p.badgeColor},#1e1b4b)`}>
                <span class="pkg-no-icon">🏔️</span>
                <span class="pkg-nights-center">{p.nights}N {p.days}D</span>
                <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                <div class="pkg-disc"><span>10%</span><span>OFF</span></div>
              </div>
              <div class="pkg-body">
                <h3 class="pkg-name">{p.name}</h3>
                <div class="pkg-chips-wrap">
                  {p.highlights.slice(0,3).map(h => <span class="pkg-chip pkg-chip--purple">{h}</span>)}
                </div>
                {p.itinerary && (
                  <div class="pkg-itinerary">
                    {p.itinerary.map(d => <p class="pkg-day">📍 {d}</p>)}
                  </div>
                )}
                <div class="pkg-table">
                  <div class="pkg-table-head pkg-table-head--purple"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                  {p.tiers.map(t => (
                    <div class="pkg-table-row">
                      <span>{vLabel(t.vehicleId)}</span>
                      <span class="t-mrp">{fmt(t.mrp)}</span>
                      <span class="t-price t-price--purple">{fmt(t.discounted)}</span>
                      <span class="t-save">-{fmt(t.saving)}</span>
                    </div>
                  ))}
                </div>
                <p class="pkg-incl">✓ Cab — driver, fuel, toll & parking included</p>
                <div class="pkg-actions">
                  <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}`}
                    target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                  <a href={`tel:${phone}`} class="btn btn-outline pkg-btn">📞 Call Us</a>
                </div>
                <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Book -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="section-title">Why Book Your Uttarakhand Tour with Shri Taxi?</h2>
        <div class="why-grid">
          {[
            { icon:'🏔️', title:'Local Pahadi Drivers', desc:'Our drivers know every mountain road, shortcut and rest stop. Safety is our top priority.' },
            { icon:'💰', title:'10% Discount Always', desc:'All packages come with 10% discount. Transparent pricing — no hidden charges ever.' },
            { icon:'✓',  title:'All Inclusive',        desc:'Driver + fuel + toll + parking included. No surprise bills at the end of your trip.' },
            { icon:'📞', title:'24/7 Support',         desc:'Our team is available round the clock during your journey for any assistance.' },
            { icon:'🚗', title:'All Vehicle Types',    desc:'Sedan, Ertiga, Innova Crysta or Tempo Traveller — we have the right vehicle for your group.' },
            { icon:'📋', title:'Flexible Itinerary',   desc:'Customize your trip. Extra days can be added. We adapt to your pace and preferences.' },
          ].map(w => (
            <div class="why-card">
              <div class="why-icon">{w.icon}</div>
              <h3 class="why-title">{w.title}</h3>
              <p class="why-desc">{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section pkg-cta">
      <div class="container pkg-cta-inner">
        <div>
          <h2>Ready to Book Your Uttarakhand Tour?</h2>
          <p>Call or WhatsApp us — we respond within 15 minutes</p>
        </div>
        <div class="pkg-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20tour%20package`}
            target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Booking</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
/* ── Tokens ── */
:root {
  --teal:   #0d9488; --teal-d: #0f766e;
  --saffron:#f59e0b; --saff-d: #d97706;
  --purple: #7c3aed; --purp-d: #6d28d9;
  --slate:  #1e293b; --muted:  #64748b;
  --border: #e2e8f0; --mint:   #f0fdfa;
  --r:12px; --r-sm:8px;
}

/* ── Buttons ── */
.btn { display:inline-flex; align-items:center; justify-content:center; gap:7px;
  font-weight:700; border-radius:50px; text-decoration:none;
  transition:opacity .15s,transform .15s; }
.btn:active { transform:scale(.97); }
.btn-call      { background:var(--saffron); color:#fff; padding:12px 24px; font-size:15px; }
.btn-whatsapp  { background:#25D366; color:#fff; padding:12px 24px; font-size:15px; }
.btn-outline   { background:#fff; color:var(--teal); border:2px solid var(--teal);
  padding:10px 16px; font-size:14px; }
.btn-outline-saffron { background:#fff; color:var(--saffron); border:2px solid var(--saffron);
  padding:10px 16px; font-size:14px; border-radius:50px; font-weight:700; text-decoration:none;
  display:inline-flex; align-items:center; justify-content:center; transition:opacity .15s; }

/* ── Layout ── */
.container { max-width:1080px; margin:0 auto; padding:0 20px; }
.section     { padding:40px 0; }
.section--mint { background:var(--mint); }
.section-title { font-size:clamp(20px,3vw,26px); font-weight:800; color:var(--slate);
  font-family:'Playfair Display',serif; margin-bottom:20px; }

/* ── Hero ── */
.pkg-hero { background:linear-gradient(135deg,#0d9488,#0f766e); padding:48px 0 36px; }
.breadcrumb { font-size:12px; color:rgba(255,255,255,.6); margin-bottom:12px; }
.breadcrumb a { color:rgba(255,255,255,.75); text-decoration:none; }
.pkg-hero-label { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
  color:rgba(255,255,255,.6); margin-bottom:10px; }
.pkg-hero-title { font-size:clamp(26px,4vw,42px); color:#fff; font-family:'Playfair Display',serif;
  margin-bottom:10px; line-height:1.2; }
.pkg-hero-sub { font-size:15px; color:rgba(255,255,255,.8); margin-bottom:24px; }
.pkg-hero-ctas { display:flex; gap:12px; flex-wrap:wrap; }

/* ── Discount Bar ── */
.discount-bar { background:var(--saffron); padding:10px 0; }
.discount-bar-inner { display:flex; align-items:center; gap:10px; justify-content:center; flex-wrap:wrap; }
.discount-bar-inner p { font-size:14px; color:#fff; text-align:center; }
.discount-badge { background:#fff; color:var(--saffron); font-size:12px; font-weight:800;
  padding:3px 12px; border-radius:20px; white-space:nowrap; }

/* ── Sticky Pill Nav ── */
.pill-nav-wrap {
  position:sticky; top:0; z-index:40;
  background:#fff; border-bottom:2px solid var(--border);
  box-shadow:0 2px 8px rgba(0,0,0,.08);
  padding:10px 0;
}
.pill-nav {
  display:flex; gap:8px; overflow-x:auto;
  padding:0 20px; scrollbar-width:none; -ms-overflow-style:none;
  justify-content:center;
}
.pill-nav::-webkit-scrollbar { display:none; }
.pill {
  flex-shrink:0; padding:9px 20px; border-radius:50px; font-size:14px; font-weight:700;
  text-decoration:none; color:var(--muted);
  border:2px solid var(--border); background:#fff;
  transition:all .2s; white-space:nowrap;
}
.pill:hover, .pill.active { background:var(--teal); color:#fff; border-color:var(--teal); }

/* ── Package Sections ── */
.pkg-section { padding:40px 0; background:#fff; }
.pkg-section--saffron { background:#fffbeb; }
.pkg-section--purple  { background:#f5f3ff; }

/* Section header */
.sec-head {
  display:flex; align-items:center; justify-content:space-between; gap:16px;
  padding:20px 24px; border-radius:var(--r); margin-bottom:24px;
  flex-wrap:wrap;
}
.sec-head--teal   { background:linear-gradient(135deg,#0d9488,#0f766e); }
.sec-head--saffron{ background:linear-gradient(135deg,#f59e0b,#d97706); }
.sec-head--purple { background:linear-gradient(135deg,#7c3aed,#6d28d9); }

.sec-head-left { display:flex; align-items:center; gap:16px; flex:1; }
.sec-icon { font-size:36px; flex-shrink:0; }
.sec-title {
  font-size:clamp(18px,2.5vw,22px); font-weight:800; color:#fff;
  font-family:'Playfair Display',serif; margin-bottom:3px;
  display:flex; align-items:center; gap:8px; flex-wrap:wrap;
}
.sec-sub   { font-size:13px; color:rgba(255,255,255,.8); }
.sec-price { font-size:20px; font-weight:900; color:#fff;
  font-family:'Playfair Display',serif; white-space:nowrap; flex-shrink:0; }

.sec-badge-season {
  background:#fff; color:#d97706; font-size:10px; font-weight:800;
  padding:2px 8px; border-radius:20px; font-family:'DM Sans',sans-serif;
}
.sec-badge-new {
  background:#ef4444; color:#fff; font-size:10px; font-weight:800;
  padding:2px 8px; border-radius:20px; font-family:'DM Sans',sans-serif;
}

/* ── Package Grid — 2-col mobile, auto desktop ── */
.pkg-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}

/* ── Package Card ── */
.pkg-card {
  background:#fff; border:1.5px solid var(--border);
  border-radius:var(--r); overflow:hidden;
  display:flex; flex-direction:column;
  box-shadow:0 2px 8px rgba(0,0,0,.06);
  transition:box-shadow .2s,transform .2s;
}
.pkg-card:hover { box-shadow:0 8px 24px rgba(0,0,0,.1); transform:translateY(-3px); }

.pkg-img-wrap { position:relative; height:140px; overflow:hidden; }
.pkg-img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .3s; }
.pkg-card:hover .pkg-img { transform:scale(1.05); }
.pkg-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.5),transparent 60%); }

.pkg-img-no-img {
  position:relative; height:120px;
  display:flex; align-items:center; justify-content:center;
}
.pkg-no-icon { font-size:40px; }
.pkg-nights-center {
  position:absolute; bottom:8px; left:8px; color:#fff; font-size:11px; font-weight:700;
  background:rgba(0,0,0,.4); padding:2px 7px; border-radius:20px;
}

.pkg-badge  { position:absolute; top:8px; left:8px; color:#fff; font-size:10px;
  font-weight:700; padding:2px 9px; border-radius:20px; z-index:1; }
.pkg-nights { position:absolute; bottom:8px; left:8px; color:#fff; font-size:11px;
  font-weight:700; background:rgba(0,0,0,.4); padding:2px 7px; border-radius:20px; z-index:1; }
.pkg-disc   { position:absolute; top:8px; right:8px; background:#ef4444; color:#fff;
  width:38px; height:38px; border-radius:50%; display:flex; flex-direction:column;
  align-items:center; justify-content:center; font-size:8px; font-weight:900;
  line-height:1.2; z-index:1; }

/* Card body */
.pkg-body { padding:12px; display:flex; flex-direction:column; gap:8px; flex:1; }
.pkg-name { font-size:14px; font-weight:700; color:var(--slate);
  font-family:'Playfair Display',serif; line-height:1.3; }
.pkg-chips-wrap { display:flex; flex-wrap:wrap; gap:4px; }
.pkg-chip         { background:var(--mint); color:var(--teal); font-size:11px; font-weight:600;
  padding:2px 9px; border-radius:20px; border:1px solid rgba(13,148,136,.15); }
.pkg-chip--saffron{ background:#fffbeb; color:#d97706;
  border:1px solid rgba(245,158,11,.2); font-size:11px; font-weight:600;
  padding:2px 9px; border-radius:20px; }
.pkg-chip--purple { background:#f5f3ff; color:#7c3aed;
  border:1px solid rgba(124,58,237,.2); font-size:11px; font-weight:600;
  padding:2px 9px; border-radius:20px; }

/* Pricing table */
.pkg-table { border:1px solid var(--border); border-radius:var(--r-sm); overflow:hidden; }
.pkg-table-head {
  display:grid; grid-template-columns:1.6fr .8fr .8fr .7fr;
  padding:6px 8px; background:var(--teal); color:#fff;
  font-weight:700; font-size:10px; text-transform:uppercase; letter-spacing:.3px;
}
.pkg-table-head--saffron { background:var(--saffron); }
.pkg-table-head--purple  { background:var(--purple); }
.pkg-table-row {
  display:grid; grid-template-columns:1.6fr .8fr .8fr .7fr;
  padding:6px 8px; border-top:1px solid var(--border);
  align-items:center; font-size:11px;
}
.pkg-table-row:nth-child(even) { background:#fafafa; }
.t-mrp  { color:var(--muted); text-decoration:line-through; }
.t-price { font-weight:800; color:var(--teal); }
.t-price--saffron { color:var(--saffron); }
.t-price--purple  { color:var(--purple); }
.t-save { color:#16a34a; font-weight:700; font-size:10px; }

.pkg-incl  { font-size:12px; color:var(--teal); font-weight:500; }
.pkg-trust { font-size:11px; color:var(--muted); text-align:center;
  padding-top:4px; border-top:1px solid var(--border); margin-top:auto; }
.pkg-actions { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
.pkg-btn  { font-size:12px; padding:10px 6px; }

/* Multi-dest */
.multi-notice { display:flex; align-items:center; gap:10px; background:#fff7ed;
  border:1.5px solid #fcd34d; border-radius:var(--r-sm); padding:12px 16px;
  margin-bottom:16px; font-size:13px; color:var(--slate); }
.pkg-itinerary { background:rgba(0,0,0,.03); border-radius:var(--r-sm); padding:8px;
  display:grid; grid-template-columns:1fr 1fr; gap:4px; }
.pkg-day { font-size:11px; color:var(--muted); }

/* ── Why Book ── */
.why-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.why-card { background:#fff; border:1px solid var(--border);
  border-radius:var(--r); padding:20px; text-align:center; }
.why-icon  { font-size:32px; margin-bottom:10px; }
.why-title { font-size:15px; font-weight:700; color:var(--slate); margin-bottom:6px; }
.why-desc  { font-size:13px; color:var(--muted); line-height:1.6; }

/* ── CTA ── */
.pkg-cta { background:var(--teal); padding:40px 0; }
.pkg-cta-inner { display:flex; justify-content:space-between; align-items:center;
  gap:24px; flex-wrap:wrap; }
.pkg-cta h2 { font-size:22px; color:#fff; font-family:'Playfair Display',serif; margin-bottom:6px; }
.pkg-cta p  { font-size:14px; color:rgba(255,255,255,.75); }
.pkg-cta-btns { display:flex; gap:10px; flex-wrap:wrap; }

/* ── Responsive ── */
@media (min-width:900px) {
  .pkg-grid { grid-template-columns:repeat(3,1fr); }
  .pill-nav { justify-content:center; }
}
@media (min-width:1080px) {
  .pkg-grid { grid-template-columns:repeat(3,1fr); }
  .pkg-img-wrap { height:180px; }
  .pkg-name { font-size:16px; }
  .pkg-body { padding:16px; }
}
@media (max-width:600px) {
  .pkg-grid { grid-template-columns:1fr 1fr; gap:10px; }
  .pill-nav { justify-content:flex-start; }
  .sec-head { padding:14px 16px; }
  .sec-icon { font-size:28px; }
  .pkg-body { padding:10px; gap:6px; }
  .pkg-name { font-size:13px; }
  .pkg-table-head, .pkg-table-row { font-size:9px; padding:5px 6px; }
  .pkg-actions { grid-template-columns:1fr 1fr; }
  .pkg-btn { font-size:11px; padding:8px 4px; }
  .why-grid { grid-template-columns:1fr 1fr; }
  .pkg-cta-inner { flex-direction:column; }
  .pkg-cta-btns { width:100%; flex-direction:column; }
  .pkg-cta-btns .btn { justify-content:center; }
  .discount-bar-inner { flex-direction:column; text-align:center; gap:6px; }
  .pkg-itinerary { grid-template-columns:1fr; }
}
@media (max-width:380px) {
  .pkg-grid { grid-template-columns:1fr; }
}
</style>

<script>
// Highlight active pill on scroll
const sections = document.querySelectorAll('.pkg-section[id]');
const pills    = document.querySelectorAll('.pill');
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      pills.forEach(p => p.classList.remove('active'));
      const active = document.querySelector(`.pill[href="#${e.target.id}"]`);
      if (active) active.classList.add('active');
    }
  });
}, { rootMargin: '-40% 0px -55% 0px' });
sections.forEach(s => observer.observe(s));
</script>
