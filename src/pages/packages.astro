---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { Image } from 'astro:assets';
import { tourPackages, fmt } from '../data/pricing';

import CharDhamImg   from '../assets/images/CharDham1.jpeg';
import NainitalImg   from '../assets/images/Nainital2.jpg';
import AuliImg       from '../assets/images/Auli_togo.jpg';
import KedarnathImg  from '../assets/images/CharDham2.jpeg';
import BadrinathImg  from '../assets/images/Badrinath.jpeg';
import NeemKaroliImg from '../assets/images/NeemKaroli.jpeg';
import DhanaultiImg  from '../assets/images/Dhanaulti.jpeg';
import MunsiyariImg  from '../assets/images/Munsyari.jpeg';
import ChoptaImg     from '../assets/images/Chopta.jpeg';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const imgMap: Record<string, ImageMetadata> = {
  'dhanaulti':   DhanaultiImg,
  'munsiyari':   MunsiyariImg,
  'chopta':      ChoptaImg,
  'neem-karoli': NeemKaroliImg,
  'nainital':    NainitalImg,
  'auli':        AuliImg,
  'kedarnath':   KedarnathImg,
  'badrinath':   BadrinathImg,
  'ek-dham':     KedarnathImg,
  'do-dham':     BadrinathImg,
  'char-dham':   CharDhamImg,
};

const dayPackages = tourPackages.filter(p =>
  ['dhanaulti', 'neem-karoli', 'nainital', 'auli', 'munsiyari', 'chopta', 'kedarnath', 'badrinath'].includes(p.id)
);
const charDhamPackages = tourPackages.filter(p =>
  ['ek-dham', 'do-dham', 'char-dham'].includes(p.id)
);
const multiDestPackages = tourPackages.filter(p =>
  ['nainital-corbett', 'mussoorie-corbett-nainital-ranikhet', 'nainital-ranikhet-corbett', 'almora-kausani'].includes(p.id)
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Uttarakhand Tour Packages with Cab',
  description: 'Curated cab packages for Char Dham Yatra, Nainital, Auli, Kedarnath, Badrinath and Delhi circuits',
  itemListElement: tourPackages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `https://shritaxi.com${p.href}`,
  })),
};
---

<Base
  title="Uttarakhand Tour Packages with Cab | Char Dham, Hill Stations & Delhi Circuits | Shri Taxi"
  description="Book Uttarakhand tour packages with cab — Char Dham Yatra, Nainital, Auli, Kedarnath, Delhi circuits. All inclusive, 10% discount, experienced drivers."
  canonicalUrl="https://shritaxi.com/packages"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/packages" />

  <main id="main-content">

    <!-- Hero -->
    <section class="pkg-hero">
      <div class="container">
        <nav class="breadcrumb"><a href="/">Home</a> › <span>Tour Packages</span></nav>
        <p class="pkg-hero-label">Uttarakhand Tour Packages</p>
        <h1 class="pkg-hero-title">Uttarakhand Tour Packages with Cab</h1>
        <p class="pkg-hero-sub">All inclusive · Experienced hill drivers · 10% discount on all packages · Driver + fuel + toll + parking included</p>
        <div class="pkg-hero-ctas">
          <a href={`tel:${phone}`} class="btn btn-call">📞 Call Now</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20know%20about%20your%20tour%20packages`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Us</a>
        </div>
      </div>
    </section>

    <!-- Discount Bar -->
    <div class="discount-bar">
      <div class="container discount-bar-inner">
        <span>🔥</span>
        <p><strong>Limited Time — 10% OFF on all packages!</strong> Book now and save up to ₹8,991 on Char Dham Yatra</p>
        <span class="discount-badge">10% OFF</span>
      </div>
    </div>

    <!-- 3 Accordions -->
    <section class="section pkg-accordions">
      <div class="container">

        <!-- Accordion 1 — Day Trips (Teal/Green) -->
        <details class="acc acc--teal">
          <summary class="acc-header">
            <div class="acc-header-left">
              <span class="acc-icon">🏔️</span>
              <div class="acc-meta">
                <h2 class="acc-title">Day Trips & Short Packages</h2>
                <p class="acc-sub">From Dehradun · {dayPackages.length} packages · Starting ₹3,599</p>
              </div>
            </div>
            <div class="acc-header-right">
              <span class="acc-price">₹3,599+</span>
              <div class="acc-cta">
                <span class="acc-explore">Explore</span>
                <svg class="acc-chevron acc-chevron--bounce" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>
          </summary>
          <div class="acc-body">
            <div class="pkg-grid">
              {dayPackages.map(p => {
                const img = imgMap[p.id] || CharDhamImg;
                return (
                  <div class="pkg-card">
                    <div class="pkg-img-wrap">
                      <Image src={img} alt={`${p.name} taxi package`} width={380} height={200} widths={[300, 380, 760]} sizes="(max-width: 640px) 300px, 380px" format="webp" class="pkg-img" loading="lazy" />
                      <div class="pkg-overlay"></div>
                      <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                      <span class="pkg-nights">{p.nights > 0 ? `${p.nights}N ` : ''}{p.days}D</span>
                      <div class="pkg-disc"><span>10%</span><span>OFF</span></div>
                    </div>
                    <div class="pkg-body">
                      <h3 class="pkg-name">{p.name}</h3>
                      <div class="pkg-chips-wrap">
                        {p.highlights.slice(0,3).map(h => <span class="pkg-chip">{h}</span>)}
                      </div>
                      <div class="pkg-table">
                        <div class="pkg-table-head"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                        {p.tiers.map(t => (
                          <div class="pkg-table-row">
                            <span>{t.vehicleId === 'sedan' ? '🚗 Sedan' : t.vehicleId === 'ertiga' ? '🚐 Ertiga' : t.vehicleId === 'innova' ? '🚙 Innova' : '🚌 Tempo'}</span>
                            <span class="t-mrp">{fmt(t.mrp)}</span>
                            <span class="t-price">{fmt(t.discounted)}</span>
                            <span class="t-save">-{fmt(t.saving)}</span>
                          </div>
                        ))}
                      </div>
                      <p class="pkg-incl">✓ All inclusive — driver, fuel, toll & parking</p>
                      <div class="pkg-actions">
                        <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                        <a href={`tel:${phone}`} class="btn btn-outline pkg-btn">📞 Call Us</a>
                      </div>
                      <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </details>

        <!-- Accordion 2 — Char Dham (Saffron/Orange) -->
        <details class="acc acc--saffron">
          <summary class="acc-header">
            <div class="acc-header-left">
              <span class="acc-icon">🙏</span>
              <div class="acc-meta">
                <h2 class="acc-title">Char Dham Yatra 2026 <span class="acc-badge-season">Season Open</span></h2>
                <p class="acc-sub">From Dehradun · {charDhamPackages.length} packages · Starting ₹10,999</p>
              </div>
            </div>
            <div class="acc-header-right">
              <span class="acc-price">₹10,999+</span>
              <div class="acc-cta">
                <span class="acc-explore">Explore</span>
                <svg class="acc-chevron acc-chevron--bounce acc-chevron--delay1" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>
          </summary>
          <div class="acc-body">
            <div class="pkg-grid">
              {charDhamPackages.map(p => (
                <div class="pkg-card">
                  <div class="pkg-img-wrap">
                    <Image src={imgMap[p.id] || CharDhamImg} alt={`${p.name} taxi package`} width={380} height={200} widths={[300, 380, 760]} sizes="(max-width: 640px) 300px, 380px" format="webp" class="pkg-img" loading="lazy" />
                    <div class="pkg-overlay"></div>
                    <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                    <span class="pkg-nights">{p.nights}N {p.days}D</span>
                    <div class="pkg-disc"><span>10%</span><span>OFF</span></div>
                  </div>
                  <div class="pkg-body">
                    <h3 class="pkg-name">{p.name}</h3>
                    <div class="pkg-chips-wrap">
                      {p.highlights.slice(0,3).map(h => <span class="pkg-chip">{h}</span>)}
                    </div>
                    <div class="pkg-table">
                      <div class="pkg-table-head"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                      {p.tiers.map(t => (
                        <div class="pkg-table-row">
                          <span>{t.vehicleId === 'sedan' ? '🚗 Sedan' : t.vehicleId === 'ertiga' ? '🚐 Ertiga' : t.vehicleId === 'innova' ? '🚙 Innova' : '🚌 Tempo'}</span>
                          <span class="t-mrp">{fmt(t.mrp)}</span>
                          <span class="t-price">{fmt(t.discounted)}</span>
                          <span class="t-save">-{fmt(t.saving)}</span>
                        </div>
                      ))}
                    </div>
                    <p class="pkg-incl">✓ All inclusive — driver, fuel, toll & parking</p>
                    <div class="pkg-actions">
                      <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                      <a href="/char-dham-yatra" class="btn btn-outline pkg-btn">View Details</a>
                    </div>
                    <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </details>

        <!-- Accordion 3 — Delhi Circuits (Purple/Indigo) -->
        <details class="acc acc--purple">
          <summary class="acc-header">
            <div class="acc-header-left">
              <span class="acc-icon">🏙️</span>
              <div class="acc-meta">
                <h2 class="acc-title">Delhi & Chandigarh Circuit Tours <span class="acc-badge-new">NEW</span></h2>
                <p class="acc-sub">Same price from Delhi & Chandigarh · {multiDestPackages.length} packages · Starting ₹17,999</p>
              </div>
            </div>
            <div class="acc-header-right">
              <span class="acc-price">₹17,999+</span>
              <div class="acc-cta">
                <span class="acc-explore">Explore</span>
                <svg class="acc-chevron acc-chevron--bounce acc-chevron--delay2" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>
          </summary>
          <div class="acc-body">
            <div class="multi-notice"><span>📍</span><p><strong>Pickup from Delhi NCR or Chandigarh — same price.</strong> Cab only — hotel, meals & safari not included.</p></div>
            <div class="pkg-grid">
              {multiDestPackages.map(p => (
                <div class="pkg-card">
                  <div class="pkg-img-wrap pkg-img-no-img" style={`background:linear-gradient(135deg,${p.badgeColor},#1e1b4b)`}>
                    <span class="pkg-no-icon">🏔️</span>
                    <span class="pkg-nights pkg-nights--center">{p.nights}N {p.days}D</span>
                    <span class="pkg-badge" style={`background:${p.badgeColor}`}>{p.tag}</span>
                    <div class="pkg-disc"><span>10%</span><span>OFF</span></div>
                  </div>
                  <div class="pkg-body">
                    <h3 class="pkg-name">{p.name}</h3>
                    <div class="pkg-chips-wrap">
                      {p.highlights.slice(0,3).map(h => <span class="pkg-chip">{h}</span>)}
                    </div>
                    {p.itinerary && (
                      <div class="pkg-itinerary">
                        {p.itinerary.map(d => <p class="pkg-day">📍 {d}</p>)}
                      </div>
                    )}
                    <div class="pkg-table">
                      <div class="pkg-table-head"><span>Vehicle</span><span>MRP</span><span>You Pay</span><span>Save</span></div>
                      {p.tiers.map(t => (
                        <div class="pkg-table-row">
                          <span>{t.vehicleId === 'sedan' ? '🚗 Sedan' : t.vehicleId === 'ertiga' ? '🚐 Ertiga' : t.vehicleId === 'innova' ? '🚙 Innova' : '🚌 Tempo'}</span>
                          <span class="t-mrp">{fmt(t.mrp)}</span>
                          <span class="t-price">{fmt(t.discounted)}</span>
                          <span class="t-save">-{fmt(t.saving)}</span>
                        </div>
                      ))}
                    </div>
                    <p class="pkg-incl">✓ Cab — driver, fuel, toll & parking included</p>
                    {p.excludes && (
                      <details class="excl">
                        <summary class="excl-summary">View Exclusions ▾</summary>
                        <ul class="excl-list">{p.excludes.map(e => <li>✗ {e}</li>)}</ul>
                      </details>
                    )}
                    <div class="pkg-actions">
                      <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%27m%20interested%20in%20${encodeURIComponent(p.name)}`} target="_blank" rel="noopener" class="btn btn-whatsapp pkg-btn">💬 Book Now</a>
                      <a href={`tel:${phone}`} class="btn btn-outline pkg-btn">📞 Call Us</a>
                    </div>
                    <p class="pkg-trust">⭐ 4.9 · 30+ Reviews · Fixed Price</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </details>

      </div>
    </section>

    <!-- Why Book -->
    <section class="section section--mint">
      <div class="container">
        <h2 class="section-title">Why Book Your Uttarakhand Tour with Shri Taxi?</h2>
        <div class="why-grid">
          {[
            { icon: '🏔️', title: 'Local Pahadi Drivers', desc: 'Our drivers know every mountain road, shortcut and rest stop. Safety is our top priority.' },
            { icon: '💰', title: '10% Discount Always', desc: 'All packages come with 10% discount. Transparent pricing — no hidden charges ever.' },
            { icon: '✓', title: 'All Inclusive', desc: 'Driver + fuel + toll + parking included. No surprise bills at the end of your trip.' },
            { icon: '📞', title: '24/7 Support', desc: 'Our team is available round the clock during your journey for any assistance.' },
            { icon: '🚗', title: 'All Vehicle Types', desc: 'Sedan, Ertiga, Innova Crysta or Tempo Traveller — we have the right vehicle for your group.' },
            { icon: '📋', title: 'Flexible Itinerary', desc: 'Customize your trip. Extra days can be added. We adapt to your pace and preferences.' },
          ].map(w => (
            <div class="why-card">
              <div class="why-icon">{w.icon}</div>
              <h3 class="why-title">{w.title}</h3>
              <p class="why-desc">{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section pkg-cta">
      <div class="container pkg-cta-inner">
        <div>
          <h2>Ready to Book Your Uttarakhand Tour?</h2>
          <p>Call or WhatsApp us — we respond within 15 minutes</p>
        </div>
        <div class="pkg-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20tour%20package`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Booking</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<script>
  // Auto-open correct accordion based on URL hash
  document.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash;
    const accordions = document.querySelectorAll<HTMLDetailsElement>('.acc[id]');

    if (hash) {
      // Close all first
      accordions.forEach(acc => { acc.open = false; acc.style.display = 'none'; });

      // Open the matching one
      const target = document.querySelector<HTMLDetailsElement>(hash);
      if (target) {
        target.style.display = '';
        target.open = true;
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
      }
    }
  });
</script>

<style>
/* ── Hero ── */
.pkg-hero { background: linear-gradient(135deg, #0d9488, #0f766e); padding: 48px 0 36px; }
.breadcrumb { font-size: 12px; color: rgba(255,255,255,0.6); margin-bottom: 12px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.pkg-hero-label { font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 10px; }
.pkg-hero-title { font-size: clamp(26px, 4vw, 42px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 10px; line-height: 1.2; }
.pkg-hero-sub { font-size: 15px; color: rgba(255,255,255,0.8); margin-bottom: 24px; }
.pkg-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

/* ── Discount Bar ── */
.discount-bar { background: var(--saffron); padding: 10px 0; }
.discount-bar-inner { display: flex; align-items: center; gap: 10px; justify-content: center; flex-wrap: wrap; }
.discount-bar-inner p { font-size: 14px; color: #fff; text-align: center; }
.discount-badge { background: #fff; color: var(--saffron); font-size: 12px; font-weight: 800; padding: 3px 12px; border-radius: 20px; white-space: nowrap; }

/* ── Accordions ── */
.pkg-accordions { padding-top: 32px; padding-bottom: 32px; }

.acc {
  border-radius: var(--radius-lg);
  margin-bottom: 16px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

/* Teal — Day Trips */
.acc--teal { border: 2px solid #0d9488; }
.acc--teal > summary { background: linear-gradient(135deg, #0d9488, #0f766e); }
.acc--teal > summary:hover { background: linear-gradient(135deg, #0f766e, #115e59); }
.acc--teal .acc-body { background: #f0fdfa; border-top: 2px solid #0d9488; }

/* Saffron — Char Dham */
.acc--saffron { border: 2px solid #f59e0b; }
.acc--saffron > summary { background: linear-gradient(135deg, #f59e0b, #d97706); }
.acc--saffron > summary:hover { background: linear-gradient(135deg, #d97706, #b45309); }
.acc--saffron .acc-body { background: #fffbeb; border-top: 2px solid #f59e0b; }

/* Purple — Delhi Circuits */
.acc--purple { border: 2px solid #7c3aed; }
.acc--purple > summary { background: linear-gradient(135deg, #7c3aed, #6d28d9); }
.acc--purple > summary:hover { background: linear-gradient(135deg, #6d28d9, #5b21b6); }
.acc--purple .acc-body { background: #f5f3ff; border-top: 2px solid #7c3aed; }

/* Accordion header */
.acc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  cursor: pointer;
  list-style: none;
  gap: 16px;
}
.acc-header::-webkit-details-marker { display: none; }

.acc-header-left { display: flex; align-items: center; gap: 16px; flex: 1; }
.acc-icon { font-size: 32px; flex-shrink: 0; }
.acc-meta { flex: 1; }
.acc-title { font-size: 20px; font-weight: 700; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 3px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.acc-sub { font-size: 14px; color: rgba(255,255,255,0.8); }

.acc-header-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.acc-price { font-size: 18px; font-weight: 800; color: #fff; font-family: 'Playfair Display', serif; white-space: nowrap; }

.acc-cta { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.acc-explore { font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.85); letter-spacing: 0.8px; text-transform: uppercase; }

.acc-chevron { color: rgba(255,255,255,0.9); transition: transform 0.25s; flex-shrink: 0; }
details[open] > summary .acc-chevron { transform: rotate(180deg); }
details[open] > summary .acc-explore { display: none; }

@keyframes bounce-arrow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(5px); }
}
.acc-chevron--bounce { animation: bounce-arrow 1.2s ease-in-out infinite; }
.acc-chevron--delay1 { animation-delay: 0.2s; }
.acc-chevron--delay2 { animation-delay: 0.4s; }
details[open] > summary .acc-chevron--bounce { animation: none; }

.acc-badge-season {
  background: #fff;
  color: #d97706;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 20px;
  font-family: 'DM Sans', sans-serif;
}
.acc-badge-new {
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 20px;
  font-family: 'DM Sans', sans-serif;
}

/* Accordion body */
.acc-body { padding: 24px; }

/* ── Package Grid ── */
.pkg-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}

/* ── Package Card ── */
.pkg-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  transition: box-shadow 0.2s, transform 0.2s;
}
.pkg-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }

.pkg-img-wrap { position: relative; height: 180px; overflow: hidden; }
.pkg-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
.pkg-card:hover .pkg-img { transform: scale(1.05); }
.pkg-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 60%); }

.pkg-img-no-img { display: flex; align-items: center; justify-content: center; height: 140px; }
.pkg-no-icon { font-size: 48px; }

