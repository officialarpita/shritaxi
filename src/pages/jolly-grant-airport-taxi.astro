---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import RelatedRoutes from '../components/RelatedRoutes.astro';
import { fleet } from '../data/fleet';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const faqs = [
  { q: 'What is the taxi fare from Jolly Grant Airport to Dehradun?', a: 'The taxi fare from Jolly Grant Airport (DED) to Dehradun city is ₹1,000 fixed price. This is all inclusive — no hidden charges.' },
  { q: 'How far is Jolly Grant Airport from Dehradun?', a: 'Jolly Grant Airport is located 27 km from Dehradun city centre. The journey takes approximately 45 minutes.' },
  { q: 'Is there airport pickup available at night?', a: 'Yes! Shri Taxi provides 24/7 airport pickup service including late night and early morning flights. Our driver tracks your flight status.' },
  { q: 'Can I book airport taxi to Mussoorie, Rishikesh or Haridwar directly?', a: 'Absolutely! We provide direct airport transfers to Mussoorie (₹1,800), Rishikesh (₹2,200), Haridwar (₹2,500) and all Uttarakhand destinations.' },
  { q: 'Do you provide meet and greet at airport arrivals?', a: 'Yes, our driver will be waiting at the arrivals gate with your name on a placard. We track your flight for delays.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: 'Shri Taxi — Jolly Grant Airport Taxi',
  description: 'Fixed price taxi from Jolly Grant Airport Dehradun. ₹1,000 to city. 24/7 available, flight tracking.',
  url: 'https://shritaxi.com/jolly-grant-airport-taxi',
  telephone: phone,
  areaServed: [{ '@type': 'City', name: 'Dehradun' }],
  offers: {
    '@type': 'Offer',
    name: 'Jolly Grant Airport Taxi to Dehradun',
    price: '1000',
    priceCurrency: 'INR',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const airportTransfers = [
  { to: 'Dehradun City',   price: '₹1,000', duration: '45 min' },
  { to: 'Mussoorie',       price: '₹1,800', duration: '2 hrs'  },
  { to: 'Rishikesh',       price: '₹2,200', duration: '1.5 hrs'},
  { to: 'Haridwar',        price: '₹2,500', duration: '1.5 hrs'},
  { to: 'Uttarkashi',      price: '₹4,500', duration: '5 hrs'  },
  { to: 'Kedarnath Base',  price: '₹5,500', duration: '8 hrs'  },
];
---

<Base
  title="Jolly Grant Airport Taxi | ₹1,000 Fixed Fare | Dehradun Airport Cab"
  description="Book reliable taxi from Jolly Grant Airport (DED) Dehradun. Fixed ₹1,000 fare to city. 24/7 available, flight tracking, meet & greet. All Uttarakhand destinations covered."
  canonicalUrl="https://shritaxi.com/jolly-grant-airport-taxi"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/jolly-grant-airport-taxi" />

  <main id="main-content">

    <!-- Hero -->
    <section class="loc-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> › <a href="/cab-services">Cab Services</a> › <span>Jolly Grant Airport Taxi</span>
        </nav>
        <h1 class="loc-title">Jolly Grant Airport Taxi — Dehradun</h1>
        <p class="loc-sub">₹1,000 fixed fare · 24/7 available · Flight tracking · Meet & greet service</p>

        <div class="price-cards">
          <div class="price-card price-card--primary">
            <div class="price-card-label">✈️ Airport → Dehradun</div>
            <div class="price-card-amount">₹1,000</div>
            <div class="price-card-note">Fixed fare · All inclusive</div>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20airport%20pickup%20from%20Jolly%20Grant`} target="_blank" rel="noopener" class="btn btn-whatsapp">Book Now</a>
          </div>
          <div class="price-card">
            <div class="price-card-label">🕐 Available</div>
            <div class="price-card-amount">24/7</div>
            <div class="price-card-note">All flights · Early & late</div>
            <a href={`tel:${phone}`} class="btn btn-call">Call Now</a>
          </div>
          <div class="price-card price-card--info">
            <div class="price-card-label">Why Choose Us</div>
            <div class="features-grid">
              <div>✈️ Flight tracking</div>
              <div>🪧 Name placard</div>
              <div>⏰ On-time guarantee</div>
              <div>💰 Fixed price</div>
              <div>🏔️ Local drivers</div>
              <div>📞 24/7 support</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- All destinations from airport -->
    <section class="section">
      <div class="container">
        <p class="section-label">Airport Transfers</p>
        <h2 class="section-title">Jolly Grant Airport to All Uttarakhand Destinations</h2>
        <p class="section-sub">Direct cab from Jolly Grant Airport (DED) to any destination in Uttarakhand — fixed price, no waiting</p>

        <div class="destinations-grid">
          {airportTransfers.map(t => (
            <div class="dest-card">
              <div class="dest-info">
                <strong>Airport → {t.to}</strong>
                <span>⏱ {t.duration}</span>
              </div>
              <div class="dest-price">{t.price}</div>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20airport%20taxi%20to%20${encodeURIComponent(t.to)}`} target="_blank" rel="noopener" class="btn btn-teal btn-sm">Book</a>
            </div>
          ))}
        </div>
        <p class="dest-note">* Starting prices for Sedan. Higher for Ertiga, Innova Crysta, Tempo Traveller. Contact for exact quote.</p>
      </div>
    </section>

    <!-- Content -->
    <section class="section section--mint">
      <div class="container">
        <div class="content-block">
          <h2>Dehradun Jolly Grant Airport (DED) — Complete Guide</h2>
          <p>Jolly Grant Airport (IATA: DED) is the only airport serving Dehradun and the Garhwal Himalayan region of Uttarakhand. Located 27 km from Dehradun city centre in Jolly Grant village, the airport serves flights from Delhi, Mumbai, Bengaluru and other major Indian cities.</p>

          <h3>How to Book Airport Taxi in Dehradun</h3>
          <p>Booking a taxi from Jolly Grant Airport with Shri Taxi is simple. WhatsApp us your flight details before landing or call us directly. Our driver will be waiting at the arrivals gate with a placard bearing your name.</p>

          <h3>Airlines Operating at Jolly Grant Airport</h3>
          <p>IndiGo, Air India, SpiceJet and Alliance Air operate regular flights to/from Jolly Grant Airport. The airport is well-connected to Delhi (IGI) with multiple daily flights making it convenient to reach Uttarakhand's hill stations and Char Dham destinations.</p>

          <h3>Taxi from Airport to Popular Destinations</h3>
          <p>From Jolly Grant Airport, our taxis can take you directly to Mussoorie (2 hrs), Rishikesh (1.5 hrs), Haridwar (1.5 hrs), and as far as the Char Dham circuit. We cover all destinations in Uttarakhand with fixed transparent pricing.</p>

          <h3>Why Book Airport Taxi in Advance?</h3>
          <p>Pre-booking your airport taxi ensures you have a vehicle waiting when you land — especially important for late night flights or during Char Dham peak season (April-June) when taxis are in high demand. Advance booking also locks in the fixed price.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item" name="airport-faq">
              <summary class="faq-q">
                {f.q}
                <svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section loc-cta">
      <div class="container loc-cta-inner">
        <div>
          <h2>Book Your Airport Taxi Now</h2>
          <p>Share your flight details — we'll be there when you land.</p>
        </div>
        <div class="loc-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20airport%20taxi%20from%20Jolly%20Grant`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Flight Details</a>
        </div>
      </div>
    </section>


    <!-- Cross-sell Delhi banner -->
    <div class="delhi-crosssell">
      <div class="container delhi-crosssell-inner">
        <span class="delhi-crosssell-icon">🏙️</span>
        <div>
          <strong>Travelling from Delhi or Chandigarh?</strong>
          <p>We cover all Uttarakhand routes from Delhi NCR & Chandigarh at fixed prices.</p>
        </div>
        <a href="/packages#multi-dest-packages" class="btn btn-call delhi-crosssell-btn">View Delhi Packages →</a>
      </div>
    </div>

    <RelatedRoutes currentPage="/jolly-grant-airport-taxi" />

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
.loc-hero {
  background: linear-gradient(135deg, #0d9488, #0f766e);
  padding: 48px 0 40px;
}
.breadcrumb { font-size: 12px; color: rgba(255,255,255,0.65); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.loc-title { font-size: clamp(24px, 4vw, 40px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 8px; }
.loc-sub { font-size: 14px; color: rgba(255,255,255,0.8); margin-bottom: 28px; }

.price-cards { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 16px; }
.price-card { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); border-radius: var(--radius-lg); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
.price-card--primary { background: rgba(255,255,255,0.2); border-color: var(--saffron); }
.price-card-label { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px; }
.price-card-amount { font-size: 32px; font-weight: 800; color: #fff; font-family: 'Playfair Display', serif; line-height: 1; }
.price-card-note { font-size: 11px; color: rgba(255,255,255,0.6); }
.features-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px; color: rgba(255,255,255,0.85); }

.destinations-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
.dest-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 14px 16px; display: flex; align-items: center; gap: 12px; transition: box-shadow 0.2s; }
.dest-card:hover { box-shadow: var(--shadow-sm); }
.dest-info { flex: 1; display: flex; flex-direction: column; gap: 3px; }
.dest-info strong { font-size: 14px; color: var(--slate); }
.dest-info span { font-size: 12px; color: var(--muted); }
.dest-price { font-size: 16px; font-weight: 700; color: var(--teal); font-family: 'Playfair Display', serif; white-space: nowrap; }
.dest-note { font-size: 12px; color: var(--muted); font-style: italic; }
.btn-sm { padding: 8px 14px; font-size: 12px; white-space: nowrap; }

.content-block { max-width: 800px; }
.content-block h2 { font-size: 24px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 14px; }
.content-block h3 { font-size: 18px; font-weight: 600; color: var(--teal); margin: 20px 0 8px; }
.content-block p { font-size: 14px; color: var(--muted); line-height: 1.75; margin-bottom: 12px; }

.faq-list { display: flex; flex-direction: column; max-width: 800px; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-child { border-top: 1px solid var(--border); }
.faq-q { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; cursor: pointer; font-size: 15px; font-weight: 600; color: var(--slate); list-style: none; }
.faq-q::-webkit-details-marker { display: none; }
.faq-chevron { flex-shrink: 0; color: var(--muted); transition: transform 0.2s; }
details[open] .faq-chevron { transform: rotate(180deg); color: var(--teal); }
details[open] .faq-q { color: var(--teal); }
.faq-a { font-size: 14px; color: var(--muted); line-height: 1.7; padding-bottom: 16px; }

.loc-cta { background: var(--teal); }
.loc-cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
.loc-cta h2 { font-size: 24px; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 6px; }
.loc-cta p { font-size: 14px; color: rgba(255,255,255,0.75); }
.loc-cta-btns { display: flex; gap: 10px; flex-wrap: wrap; }

@media (max-width: 900px) {
  .price-cards { grid-template-columns: 1fr 1fr; }
  .price-card--info { grid-column: 1 / -1; }
  .destinations-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .price-cards { grid-template-columns: 1fr; }
  .destinations-grid { grid-template-columns: 1fr; }
  .loc-cta-inner { flex-direction: column; }
  .loc-cta-btns { width: 100%; flex-direction: column; }
  .loc-cta-btns .btn { justify-content: center; }
}

.delhi-crosssell {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-top: 2px solid var(--saffron);
  border-bottom: 2px solid var(--saffron);
  padding: 16px 0;
}
.delhi-crosssell-inner {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.delhi-crosssell-icon { font-size: 28px; flex-shrink: 0; }
.delhi-crosssell-inner strong { font-size: 15px; color: var(--slate); display: block; margin-bottom: 2px; }
.delhi-crosssell-inner p { font-size: 13px; color: var(--muted); margin: 0; }
.delhi-crosssell-btn { margin-left: auto; white-space: nowrap; flex-shrink: 0; }
@media (max-width: 600px) {
  .delhi-crosssell-inner { flex-direction: column; align-items: flex-start; }
  .delhi-crosssell-btn { margin-left: 0; width: 100%; justify-content: center; }
}

</style>
