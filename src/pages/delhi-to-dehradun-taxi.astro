---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import RelatedRoutes from '../components/RelatedRoutes.astro';
import { fmt, transferRates } from '../data/pricing';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const vehicles = [
  { name: 'Sedan (Dzire/Baleno)', icon: '🚗', seats: '4+1', price: transferRates.dehradunDelhi.sedan },
  { name: 'Maruti Ertiga',        icon: '🚐', seats: '6+1', price: transferRates.dehradunDelhi.ertiga },
  { name: 'Toyota Innova Crysta', icon: '🚙', seats: '6+1', price: transferRates.dehradunDelhi.innova },
  { name: 'Tempo Traveller',      icon: '🚌', seats: '12+1', price: transferRates.dehradunDelhi.traveller },
];

const faqs = [
  { q: 'What is the taxi fare from Delhi to Dehradun?', a: 'Taxi fare from Delhi to Dehradun starts at ₹3,500 for Sedan, ₹4,500 for Ertiga, ₹5,670 for Innova Crysta and ₹8,000 for Tempo Traveller. All prices are fixed and all inclusive — toll, fuel and driver charges included.' },
  { q: 'How long does it take from Delhi to Dehradun by taxi?', a: 'Delhi to Dehradun taxi takes approximately 6-7 hours depending on traffic. The distance is around 310 km via NH58 or NH7.' },
  { q: 'Is the price fixed from Delhi to Dehradun?', a: 'Yes, Shri Taxi charges a fixed price with no hidden charges. The fare includes driver, fuel, toll and parking. No surge pricing.' },
  { q: 'Can I book a one-way taxi from Delhi to Dehradun?', a: 'Yes, we offer one-way and round-trip taxi from Delhi to Dehradun. One-way starts at ₹3,500 and round-trip at ₹7,000 for Sedan.' },
  { q: 'Do you pick up from Delhi Airport?', a: 'Yes, we pick up from Indira Gandhi International Airport (IGI), New Delhi Railway Station, Noida, Gurgaon and all Delhi NCR locations.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: 'Delhi to Dehradun Taxi — Shri Taxi',
  description: 'Book taxi from Delhi to Dehradun starting ₹3,500. Fixed price, all inclusive. Sedan, Ertiga, Innova Crysta, Tempo Traveller available.',
  url: 'https://shritaxi.com/delhi-to-dehradun-taxi',
  telephone: phone,
  areaServed: [{ '@type': 'City', name: 'Delhi' }, { '@type': 'City', name: 'Dehradun' }],
  offers: { '@type': 'Offer', price: '3500', priceCurrency: 'INR', description: 'Delhi to Dehradun taxi — Sedan, one way, all inclusive' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Delhi to Dehradun Taxi | ₹3,500 Fixed Price | Shri Taxi"
  description="Book taxi from Delhi to Dehradun at ₹3,500 fixed price. All inclusive — toll, fuel, driver. Sedan, Ertiga, Innova Crysta, Tempo Traveller. 24/7 available."
  canonicalUrl="https://shritaxi.com/delhi-to-dehradun-taxi"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/delhi-to-dehradun-taxi" />

  <main id="main-content">

    <!-- Hero -->
    <section class="loc-hero">
      <div class="container">
        <nav class="breadcrumb"><a href="/">Home</a> › <span>Delhi to Dehradun Taxi</span></nav>
        <h1 class="loc-title">Delhi to Dehradun Taxi</h1>
        <p class="loc-sub">₹3,500 Fixed Price · All Inclusive · 24/7 Available</p>
        <p class="loc-desc">Book reliable taxi from Delhi NCR to Dehradun with experienced pahadi drivers. Fixed price — no surge, no hidden charges. Pickup from IGI Airport, New Delhi Railway Station, Noida, Gurgaon and all Delhi NCR locations.</p>
        <div class="loc-ctas">
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20cab%20from%20Delhi%20to%20Dehradun`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 Book Now</a>
          <a href={`tel:${phone}`} class="btn btn-call">📞 Call Us</a>
        </div>
      </div>
    </section>

    <!-- Route info strip -->
    <div class="loc-strip">
      <div class="container loc-strip-inner">
        <div class="loc-stat"><span class="loc-stat-val">310 km</span><span class="loc-stat-label">Distance</span></div>
        <div class="loc-stat"><span class="loc-stat-val">6-7 hrs</span><span class="loc-stat-label">Duration</span></div>
        <div class="loc-stat"><span class="loc-stat-val">₹3,500</span><span class="loc-stat-label">Starting From</span></div>
        <div class="loc-stat"><span class="loc-stat-val">24/7</span><span class="loc-stat-label">Available</span></div>
        <div class="loc-stat"><span class="loc-stat-val">Fixed</span><span class="loc-stat-label">Price</span></div>
      </div>
    </div>

    <!-- Pricing -->
    <section class="section">
      <div class="container">
        <p class="section-label">Fixed Fare</p>
        <h2 class="section-title">Delhi to Dehradun Taxi Fare</h2>
        <p class="section-sub">All prices fixed and all inclusive — driver, fuel, toll and parking included</p>

        <div class="pricing-grid">
          {vehicles.map(v => (
            <div class="pricing-card">
              <div class="pricing-icon">{v.icon}</div>
              <h3 class="pricing-vehicle">{v.name}</h3>
              <p class="pricing-seats">{v.seats} seats</p>
              <div class="pricing-prices">
                <div class="pricing-row">
                  <span class="pricing-label">One Way</span>
                  <span class="pricing-val">{fmt(v.price)}</span>
                </div>
                <div class="pricing-row">
                  <span class="pricing-label">Round Trip</span>
                  <span class="pricing-val">{fmt(v.price * 2)}</span>
                </div>
              </div>
              <p class="pricing-note">✓ All inclusive</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20${encodeURIComponent(v.name)}%20from%20Delhi%20to%20Dehradun`} target="_blank" rel="noopener" class="btn btn-whatsapp pricing-btn">Book Now</a>
            </div>
          ))}
        </div>

        <!-- Pickup points -->
        <div class="pickup-section">
          <h3 class="pickup-title">Delhi Pickup Points</h3>
          <div class="pickup-grid">
            {['IGI Airport (T1/T2/T3)', 'New Delhi Railway Station', 'Hazrat Nizamuddin Station', 'Noida (Sector 18, 62)', 'Gurgaon (Cyber City)', 'Faridabad', 'Ghaziabad', 'Greater Noida'].map(p => (
              <span class="pickup-chip">📍 {p}</span>
            ))}
          </div>
          <p class="pickup-note">Not in the list? We pick up from anywhere in Delhi NCR — just WhatsApp us your location.</p>
        </div>
      </div>
    </section>

    <!-- About route -->
    <section class="section section--mint">
      <div class="container loc-about">
        <div>
          <h2>Delhi to Dehradun — Route Guide</h2>
          <p>Dehradun, the capital of Uttarakhand, is approximately 310 km from Delhi and takes 6-7 hours by road. The most common route is via NH58 through Roorkee and Haridwar or via Meerut and Muzaffarnagar.</p>
          <h3>Why Choose Taxi over Train/Bus?</h3>
          <ul>
            <li>✓ Door-to-door pickup from anywhere in Delhi NCR</li>
            <li>✓ No luggage restrictions</li>
            <li>✓ Travel at your own pace with stops</li>
            <li>✓ More comfortable for families and groups</li>
            <li>✓ Comparable cost for 3-4 people</li>
          </ul>
          <h3>Popular Stops on the Way</h3>
          <ul>
            <li>📍 Roorkee — IIT Roorkee, Solani Aqueduct</li>
            <li>📍 Haridwar — Har Ki Pauri, Ganga Aarti</li>
            <li>📍 Rishikesh — Laxman Jhula, riverside cafes</li>
          </ul>
        </div>
        <div>
          <div class="cta-card">
            <h3>Ready to Book?</h3>
            <p>Get instant confirmation via WhatsApp. Our team responds within 15 minutes.</p>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20cab%20from%20Delhi%20to%20Dehradun`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Now</a>
            <a href={`tel:${phone}`} class="btn btn-call" style="margin-top:10px">📞 {phone}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Delhi to Dehradun Taxi — FAQ</h2>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item" name="delhi-ddn-faq">
              <summary class="faq-q">{f.q}<svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedRoutes currentPage="/delhi-to-dehradun-taxi" />

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
.loc-hero { background: linear-gradient(135deg, #0d9488, #0f766e); padding: 52px 0 40px; }
.breadcrumb { font-size: 12px; color: rgba(255,255,255,0.65); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.loc-title { font-size: clamp(26px, 4vw, 42px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 8px; }
.loc-sub { font-size: 16px; color: var(--saffron); font-weight: 600; margin-bottom: 10px; }
.loc-desc { font-size: 14px; color: rgba(255,255,255,0.8); line-height: 1.7; max-width: 680px; margin-bottom: 24px; }
.loc-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

.loc-strip { background: var(--teal-dark); padding: 16px 0; }
.loc-strip-inner { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
.loc-stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.loc-stat-val { font-size: 20px; font-weight: 800; color: #fff; font-family: 'Playfair Display', serif; }
.loc-stat-label { font-size: 11px; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.5px; }

.pricing-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px; }
.pricing-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; transition: box-shadow 0.2s; }
.pricing-card:hover { box-shadow: var(--shadow-md); }
.pricing-icon { font-size: 36px; }
.pricing-vehicle { font-size: 14px; font-weight: 700; color: var(--slate); }
.pricing-seats { font-size: 12px; color: var(--muted); }
.pricing-prices { width: 100%; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
.pricing-row { display: flex; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid var(--border); }
.pricing-row:last-child { border-bottom: none; }
.pricing-label { font-size: 12px; color: var(--muted); }
.pricing-val { font-size: 15px; font-weight: 700; color: var(--teal); }
.pricing-note { font-size: 11px; color: var(--teal); font-weight: 500; }
.pricing-btn { width: 100%; justify-content: center; font-size: 13px; margin-top: auto; }

.pickup-section { background: var(--mint); border-radius: var(--radius-lg); padding: 24px; }
.pickup-title { font-size: 18px; font-weight: 700; color: var(--slate); margin-bottom: 14px; }
.pickup-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.pickup-chip { background: var(--white); border: 1px solid var(--border); border-radius: 20px; padding: 5px 12px; font-size: 13px; color: var(--slate); }
.pickup-note { font-size: 12px; color: var(--muted); }

.loc-about { display: grid; grid-template-columns: 1fr 320px; gap: 48px; align-items: start; }
.loc-about h2 { font-size: 24px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 12px; }
.loc-about h3 { font-size: 17px; font-weight: 600; color: var(--teal); margin: 18px 0 8px; }
.loc-about p { font-size: 14px; color: var(--muted); line-height: 1.75; margin-bottom: 10px; }
.loc-about ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
.loc-about li { font-size: 14px; color: var(--muted); }

.cta-card { background: var(--teal); border-radius: var(--radius-lg); padding: 28px; display: flex; flex-direction: column; gap: 12px; position: sticky; top: 80px; }
.cta-card h3 { font-size: 20px; color: #fff; font-family: 'Playfair Display', serif; }
.cta-card p { font-size: 13px; color: rgba(255,255,255,0.8); line-height: 1.6; }

.faq-list { display: flex; flex-direction: column; max-width: 800px; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-child { border-top: 1px solid var(--border); }
.faq-q { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; cursor: pointer; font-size: 15px; font-weight: 600; color: var(--slate); list-style: none; }
.faq-q::-webkit-details-marker { display: none; }
.faq-chevron { flex-shrink: 0; color: var(--muted); transition: transform 0.2s; }
details[open] .faq-chevron { transform: rotate(180deg); color: var(--teal); }
details[open] .faq-q { color: var(--teal); }
.faq-a { font-size: 14px; color: var(--muted); line-height: 1.7; padding-bottom: 16px; }

@media (max-width: 900px) { .pricing-grid { grid-template-columns: repeat(2, 1fr); } .loc-about { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .pricing-grid { grid-template-columns: 1fr 1fr; } .loc-strip-inner { gap: 20px; } .loc-ctas { flex-direction: column; } }
</style>
