---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { Image } from 'astro:assets';
import { tourPackages, fmt, delhiCharDhamTiers } from '../data/pricing';

import CharDham1Img from '../assets/images/CharDham1.jpeg';
import CharDham2Img from '../assets/images/CharDham2.jpeg';
import BadrinathImg from '../assets/images/Badrinath.jpeg';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const ekDham   = tourPackages.find(p => p.id === 'ek-dham')!;
const doDham   = tourPackages.find(p => p.id === 'do-dham')!;
const charDham = tourPackages.find(p => p.id === 'char-dham')!;

// Delhi pricing = Dehradun + ₹6,000 per package
const ekDhamDelhi   = delhiCharDhamTiers(ekDham.tiers);
const doDhamDelhi   = delhiCharDhamTiers(doDham.tiers);
const charDhamDelhi = delhiCharDhamTiers(charDham.tiers);

const cities = [
  { id: 'dehradun', label: '📍 From Dehradun', active: true },
  { id: 'delhi',    label: '🏙️ From Delhi NCR', active: false },
  { id: 'haridwar', label: '🛕 From Haridwar', active: false },
];

const faqs = [
  { q: 'When does Char Dham Yatra 2026 open?', a: 'Char Dham Yatra 2026 typically opens in April-May. Yamunotri and Gangotri open on Akshaya Tritiya, while Kedarnath and Badrinath open a few days later. The season closes in October-November.' },
  { q: 'What is the taxi fare for Char Dham Yatra from Dehradun?', a: 'Char Dham Yatra taxi from Dehradun starts at ₹35,999 for Sedan (10 days), ₹44,999 for Ertiga, ₹56,699 for Innova Crysta and ₹80,999 for Tempo Traveller. All prices include 10% discount.' },
  { q: 'Is driver experienced for Char Dham routes?', a: 'Yes, all our drivers are experienced local pahadi drivers who have made the Char Dham circuit multiple times. They know every road condition, rest stop and temple timing.' },
  { q: 'What is included in the Char Dham Yatra package?', a: 'Our Char Dham package includes cab with experienced driver, fuel charges, toll, parking and all taxes. Hotel accommodation is arranged separately as per your preference.' },
  { q: 'Can I customize the Char Dham itinerary?', a: 'Yes! We can customize the itinerary based on your pace and preferences. Extra days can be added at the per day rate of your chosen vehicle.' },
  { q: 'What is Do Dham Yatra?', a: 'Do Dham Yatra covers 2 of the 4 dhams — usually Kedarnath + Badrinath or Yamunotri + Gangotri. It takes 5 days and starts at ₹17,999 for Sedan.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: 'Char Dham Yatra Taxi Package 2026 from Dehradun',
  description: 'Complete Char Dham Yatra taxi package covering Yamunotri, Gangotri, Kedarnath and Badrinath from Dehradun. Starting ₹35,999 for Sedan (10 days).',
  url: 'https://shritaxi.com/char-dham-yatra',
  touristType: 'Pilgrim',
  itinerary: {
    '@type': 'ItemList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Yamunotri — First Dham' },
      { '@type': 'ListItem', position: 2, name: 'Gangotri — Second Dham' },
      { '@type': 'ListItem', position: 3, name: 'Kedarnath — Third Dham' },
      { '@type': 'ListItem', position: 4, name: 'Badrinath — Fourth Dham' },
    ]
  },
  offers: {
    '@type': 'Offer',
    price: '35999',
    priceCurrency: 'INR',
    description: 'Char Dham Yatra taxi for 10 days — Sedan, all inclusive, 10% discount',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Char Dham Yatra Taxi Package 2026 | Ek Dham, Do Dham, Char Dham | Shri Taxi"
  description="Book Char Dham Yatra taxi from Dehradun 2026. Ek Dham from ₹10,999, Do Dham from ₹17,999, Char Dham from ₹35,999. All inclusive, 10% discount, experienced drivers."
  canonicalUrl="https://shritaxi.com/char-dham-yatra"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/char-dham-yatra" />

  <main id="main-content">

    <!-- Hero -->
    <section class="cd-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> › <a href="/packages">Packages</a> › <span>Char Dham Yatra</span>
        </nav>
        <div class="cd-hero-content">
          <div>
            <div class="cd-season-badge">🙏 Char Dham 2026 Season OPEN</div>
            <h1 class="cd-title">Char Dham Yatra Taxi Package 2026</h1>
            <p class="cd-sub">Yamunotri · Gangotri · Kedarnath · Badrinath</p>
            <p class="cd-desc">Complete Char Dham Yatra from Dehradun with experienced pahadi drivers. All inclusive pricing — fuel, toll, parking and driver charges included. 10% discount on all packages.</p>
            <div class="cd-hero-ctas">
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Char%20Dham%20Yatra%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 Book Now</a>
              <a href={`tel:${phone}`} class="btn btn-call">📞 Call Us</a>
              <a href="#packages" class="btn btn-outline-white">View Packages ↓</a>
            </div>
          </div>
          <div class="cd-hero-image">
            <Image src={CharDham1Img} alt="Char Dham Yatra taxi from Dehradun 2026" width={500} height={350} widths={[400, 500, 900]}
            sizes="(max-width: 640px) 400px, (max-width: 1024px) 500px, 900px" format="webp" class="cd-hero-img" loading="eager" fetchpriority="high" fetchpriority="high" fetchpriority="high"/>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <div class="cd-trust-strip">
      <div class="container cd-trust-inner">
        {[
          { icon: '🏔️', text: 'Pahadi Drivers' },
          { icon: '✓', text: 'All Inclusive' },
          { icon: '💰', text: '10% Discount' },
          { icon: '📞', text: '24/7 Support' },
          { icon: '🛡️', text: '100% Safe' },
          { icon: '⚡', text: 'Instant Booking' },
        ].map(t => (
          <div class="cd-trust-item">
            <span>{t.icon}</span>
            <span>{t.text}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Packages -->
    <section class="section" id="packages">
      <div class="container">
        <p class="section-label">Char Dham Yatra 2026</p>
        <h2 class="section-title">Choose Your Char Dham Package</h2>
        <p class="section-sub">From single dham to the complete circuit — we cover all routes</p>

        <!-- City selector -->
        <div class="city-selector">
          <p class="city-selector-label">📍 Your pickup city:</p>
          <div class="city-tabs">
            {cities.map(c => (
              <button class={`city-tab${c.active ? ' city-tab--active' : ''}`} data-city={c.id}>
                {c.label}
              </button>
            ))}
          </div>
          <p class="city-note" id="city-note-dehradun">Prices shown are from Dehradun — all inclusive</p>
          <p class="city-note" id="city-note-delhi" style="display:none">Prices shown are from Delhi NCR — includes Delhi ↔ Dehradun transfer (+₹6,000). All inclusive.</p>
          <p class="city-note" id="city-note-haridwar" style="display:none">Prices shown are from Haridwar — same as Dehradun rates. All inclusive.</p>
        </div>

        <div class="cd-packages">

          <!-- Ek Dham -->
          <div class="cd-package-card" id="ek-dham">
            <div class="cd-pkg-header">
              <div class="cd-pkg-header-left">
                <div class="cd-pkg-icon">🙏</div>
                <div>
                  <span class="cd-pkg-tag" style="background:#fb923c">Ek Dham · {ekDham.nights}N {ekDham.days}D</span>
                  <h3 class="cd-pkg-name">{ekDham.name}</h3>
                  <p class="cd-pkg-duration">Choose any 1 Dham — Kedarnath, Badrinath, Yamunotri or Gangotri</p>
                </div>
              </div>
              <div class="cd-pkg-discount-badge">10% OFF</div>
            </div>
            <div class="cd-highlights">
              {ekDham.highlights.map(h => <span class="cd-highlight">{h}</span>)}
            </div>
            <div class="cd-pricing-table" id="ek-pricing-dehradun">
              {ekDham.tiers.map(t => (
                <div class="cd-tier">
                  <span class="cd-tier-name">
                    {t.vehicleId === 'sedan' ? '🚗' : t.vehicleId === 'ertiga' ? '🚐' : t.vehicleId === 'innova' ? '🚙' : '🚌'}
                    {t.vehicleName}
                    <span class="cd-tier-seats">({t.seats}+1)</span>
                  </span>
                  <div class="cd-tier-prices">
                    <span class="cd-tier-mrp">{fmt(t.mrp)}</span>
                    <span class="cd-tier-final">{fmt(t.discounted)}</span>
                    <span class="cd-tier-save">Save {fmt(t.saving)}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="cd-pricing-table" id="ek-pricing-delhi" style="display:none">
              {ekDhamDelhi.map(t => (
                <div class="cd-tier">
                  <span class="cd-tier-name">
                    {t.vehicleId === 'sedan' ? '🚗' : t.vehicleId === 'ertiga' ? '🚐' : t.vehicleId === 'innova' ? '🚙' : '🚌'}
                    {t.vehicleName}
                    <span class="cd-tier-seats">({t.seats}+1)</span>
                  </span>
                  <div class="cd-tier-prices">
                    <span class="cd-tier-mrp">{fmt(t.mrp)}</span>
                    <span class="cd-tier-final">{fmt(t.discounted)}</span>
                    <span class="cd-tier-save">+₹6,000 incl. Delhi transfer</span>
                  </div>
                </div>
              ))}
            </div>
            <p class="cd-inclusive">✓ All inclusive — driver, fuel, toll & parking</p>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Ek%20Dham%20Yatra%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp cd-book-btn">💬 Book Ek Dham</a>
          </div>

          <!-- Do Dham -->
          <div class="cd-package-card" id="do-dham">
            <div class="cd-pkg-header">
              <div class="cd-pkg-header-left">
                <div class="cd-pkg-icon">🙏🙏</div>
                <div>
                  <span class="cd-pkg-tag" style="background:#fb923c">Do Dham · {doDham.nights}N {doDham.days}D</span>
                  <h3 class="cd-pkg-name">{doDham.name}</h3>
                  <p class="cd-pkg-duration">Kedarnath + Badrinath · OR Yamunotri + Gangotri</p>
                </div>
              </div>
              <div class="cd-pkg-discount-badge">10% OFF</div>
            </div>
            <div class="cd-highlights">
              {doDham.highlights.map(h => <span class="cd-highlight">{h}</span>)}
            </div>
            <div class="cd-pricing-table" id="do-pricing-dehradun">
              {doDham.tiers.map(t => (
                <div class="cd-tier">
                  <span class="cd-tier-name">
                    {t.vehicleId === 'sedan' ? '🚗' : t.vehicleId === 'ertiga' ? '🚐' : t.vehicleId === 'innova' ? '🚙' : '🚌'}
                    {t.vehicleName}
                    <span class="cd-tier-seats">({t.seats}+1)</span>
                  </span>
                  <div class="cd-tier-prices">
                    <span class="cd-tier-mrp">{fmt(t.mrp)}</span>
                    <span class="cd-tier-final">{fmt(t.discounted)}</span>
                    <span class="cd-tier-save">Save {fmt(t.saving)}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="cd-pricing-table" id="do-pricing-delhi" style="display:none">
              {doDhamDelhi.map(t => (
                <div class="cd-tier">
                  <span class="cd-tier-name">
                    {t.vehicleId === 'sedan' ? '🚗' : t.vehicleId === 'ertiga' ? '🚐' : t.vehicleId === 'innova' ? '🚙' : '🚌'}
                    {t.vehicleName}
                    <span class="cd-tier-seats">({t.seats}+1)</span>
                  </span>
                  <div class="cd-tier-prices">
                    <span class="cd-tier-mrp">{fmt(t.mrp)}</span>
                    <span class="cd-tier-final">{fmt(t.discounted)}</span>
                    <span class="cd-tier-save">+₹6,000 incl. Delhi transfer</span>
                  </div>
                </div>
              ))}
            </div>
            <p class="cd-inclusive">✓ All inclusive — driver, fuel, toll & parking</p>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Do%20Dham%20Yatra%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp cd-book-btn">💬 Book Do Dham</a>
          </div>

          <!-- Char Dham -->
          <div class="cd-package-card cd-package-card--featured" id="char-dham">
            <div class="cd-featured-banner">⭐ Most Popular</div>
            <div class="cd-pkg-header">
              <div class="cd-pkg-header-left">
                <div class="cd-pkg-icon">🙏🙏🙏🙏</div>
                <div>
                  <span class="cd-pkg-tag" style="background:#fb923c">Char Dham · {charDham.nights}N {charDham.days}D</span>
                  <h3 class="cd-pkg-name">{charDham.name}</h3>
                  <p class="cd-pkg-duration">Yamunotri · Gangotri · Kedarnath · Badrinath — All 4 Dhams</p>
                </div>
              </div>
              <div class="cd-pkg-discount-badge">10% OFF</div>
            </div>
            <div class="cd-highlights">
              {charDham.highlights.map(h => <span class="cd-highlight">{h}</span>)}
            </div>
            <div class="cd-itinerary">
              {charDham.itinerary?.map(day => <div class="cd-day">📍 {day}</div>)}
            </div>
            <div class="cd-pricing-table" id="char-pricing-dehradun">
              {charDham.tiers.map(t => (
                <div class="cd-tier">
                  <span class="cd-tier-name">
                    {t.vehicleId === 'sedan' ? '🚗' : t.vehicleId === 'ertiga' ? '🚐' : t.vehicleId === 'innova' ? '🚙' : '🚌'}
                    {t.vehicleName}
                    <span class="cd-tier-seats">({t.seats}+1)</span>
                  </span>
                  <div class="cd-tier-prices">
                    <span class="cd-tier-mrp">{fmt(t.mrp)}</span>
                    <span class="cd-tier-final">{fmt(t.discounted)}</span>
                    <span class="cd-tier-save">Save {fmt(t.saving)}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="cd-pricing-table" id="char-pricing-delhi" style="display:none">
              {charDhamDelhi.map(t => (
                <div class="cd-tier">
                  <span class="cd-tier-name">
                    {t.vehicleId === 'sedan' ? '🚗' : t.vehicleId === 'ertiga' ? '🚐' : t.vehicleId === 'innova' ? '🚙' : '🚌'}
                    {t.vehicleName}
                    <span class="cd-tier-seats">({t.seats}+1)</span>
                  </span>
                  <div class="cd-tier-prices">
                    <span class="cd-tier-mrp">{fmt(t.mrp)}</span>
                    <span class="cd-tier-final">{fmt(t.discounted)}</span>
                    <span class="cd-tier-save">+₹6,000 incl. Delhi transfer</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="cd-includes">
              {charDham.includes.map(inc => <span class="cd-include">✓ {inc}</span>)}
            </div>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Char%20Dham%20Yatra%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp cd-book-btn">💬 Book Char Dham Yatra</a>
          </div>

        </div>
      </div>
    </section>

    <!-- About Char Dham -->
    <section class="section section--mint">
      <div class="container cd-about">
        <div class="cd-about-text">
          <h2>Char Dham Yatra 2026 — Complete Guide</h2>
          <p>Char Dham Yatra is one of the most sacred pilgrimages in Hinduism, covering four holy shrines nestled in the Garhwal Himalayas of Uttarakhand. The four dhams — Yamunotri, Gangotri, Kedarnath and Badrinath — are believed to wash away all sins and grant moksha (liberation).</p>

          <h3>The Four Dhams</h3>
          <ul>
            <li><strong>Yamunotri (3,293m)</strong> — Source of the Yamuna river. Famous for hot water springs and Divya Shila rock.</li>
            <li><strong>Gangotri (3,048m)</strong> — Origin of the Ganga river. Gangotri Glacier and Bhagirathi river.</li>
            <li><strong>Kedarnath (3,583m)</strong> — One of the twelve Jyotirlingas. Requires trek or helicopter from Gaurikund.</li>
            <li><strong>Badrinath (3,133m)</strong> — Dedicated to Lord Vishnu. Tapt Kund hot springs nearby.</li>
          </ul>

          <h3>Char Dham 2026 Opening Dates</h3>
          <p>Yamunotri and Gangotri temples open on Akshaya Tritiya (April/May). Kedarnath and Badrinath open shortly after. The season typically runs until Diwali (October/November). Book early as cabs fill up fast during peak season.</p>

          <h3>Why Choose Shri Taxi for Char Dham?</h3>
          <ul>
            <li>✓ Experienced pahadi drivers who know every mountain pass</li>
            <li>✓ 10% discount on all Char Dham packages</li>
            <li>✓ All inclusive — no surprise charges</li>
            <li>✓ 24/7 support throughout the journey</li>
            <li>✓ Flexible itinerary as per your pace</li>
          </ul>
        </div>
        <div class="cd-about-images">
          <Image src={CharDham2Img} alt="Kedarnath temple Char Dham Yatra" width={450} height={280} widths={[350, 450, 800]}
            sizes="(max-width: 640px) 350px, (max-width: 1024px) 450px, 800px" format="webp" class="cd-about-img" loading="lazy" />
          <Image src={BadrinathImg} alt="Badrinath temple Char Dham Yatra taxi" width={450} height={280} widths={[350, 450, 800]}
          sizes="(max-width: 640px) 350px, (max-width: 1024px) 450px, 800px" format="webp" class="cd-about-img" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Char Dham Yatra — Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item" name="chardham-faq">
              <summary class="faq-q">{f.q}<svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cd-cta">
      <div class="container cd-cta-inner">
        <div>
          <h2>Book Char Dham Yatra 2026 Now</h2>
          <p>Limited cabs available for peak season. Confirm your booking today!</p>
        </div>
        <div class="cd-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20Char%20Dham%20Yatra%202026`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Booking</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <StickyBar />
</Base>

<script>
  // City selector tabs
  const cityTabs = document.querySelectorAll('.city-tab');
  const cityNotes = document.querySelectorAll('.city-note');

  cityTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const city = (tab as HTMLElement).dataset.city;

      // Update tabs
      cityTabs.forEach(t => t.classList.remove('city-tab--active'));
      tab.classList.add('city-tab--active');

      // Update notes
      cityNotes.forEach(n => (n as HTMLElement).style.display = 'none');
      const note = document.getElementById(`city-note-${city}`);
      if (note) note.style.display = 'block';

      // Toggle pricing tables
      const ddhIds = ['ek-pricing-dehradun', 'do-pricing-dehradun', 'char-pricing-dehradun'];
      const dliIds = ['ek-pricing-delhi',     'do-pricing-delhi',    'char-pricing-delhi'];

      if (city === 'dehradun' || city === 'haridwar') {
        ddhIds.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = ''; });
        dliIds.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
      } else if (city === 'delhi') {
        ddhIds.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
        dliIds.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = ''; });
      }
    });
  });
</script>
/* Hero */
.cd-hero {
  background: linear-gradient(135deg, #0d9488, #0f766e);
  padding: 52px 0 48px;
}
.breadcrumb { font-size: 12px; color: rgba(255,255,255,0.65); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.cd-hero-content { display: grid; grid-template-columns: 1fr 480px; gap: 48px; align-items: center; }
.cd-season-badge { display: inline-block; background: var(--saffron); color: #fff; font-size: 12px; font-weight: 700; padding: 4px 14px; border-radius: 20px; margin-bottom: 14px; }
.cd-title { font-size: clamp(26px, 4vw, 42px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 8px; line-height: 1.2; }
.cd-sub { font-size: 16px; color: rgba(255,255,255,0.8); margin-bottom: 12px; font-style: italic; }
.cd-desc { font-size: 14px; color: rgba(255,255,255,0.75); line-height: 1.7; margin-bottom: 24px; }
.cd-hero-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
.btn-outline-white { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.5); padding: 10px 20px; border-radius: var(--radius-md); font-weight: 600; font-size: 14px; text-decoration: none; }
.cd-hero-img { width: 100%; border-radius: var(--radius-lg); object-fit: cover; }

/* Trust strip */
.cd-trust-strip { background: var(--teal-dark); padding: 12px 0; }
.cd-trust-inner { display: flex; justify-content: center; gap: 32px; flex-wrap: wrap; }
.cd-trust-item { display: flex; align-items: center; gap: 6px; font-size: 13px; color: rgba(255,255,255,0.85); font-weight: 500; }

/* Package cards */
.cd-packages { display: flex; flex-direction: column; gap: 24px; }

.cd-package-card {
