</style>

<script>
  const wa = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

  // Vehicle data for display
  const vehicleData: Record<string, { name: string; segment: string; icon: string }> = {
    sedan:      { name: 'Maruti Dzire',        segment: 'Sedan',      icon: '🚙' },
    innova:     { name: 'Toyota Innova Crysta', segment: 'SUV',        icon: '🚐' },
    baleno:     { name: 'Maruti Baleno',        segment: 'Hatchback',  icon: '🚗' },
    traveller:  { name: 'Tempo Traveller',      segment: 'Mini-coach', icon: '🚌' },
  };

  // Set min date
  const dateInput = document.querySelector('#fleet-booking-form input[name="date"]') as HTMLInputElement;
  if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];

  // Book button click — show form with pre-selected vehicle
  document.querySelectorAll('.fleet-book').forEach(btn => {
    btn.addEventListener('click', () => {
      const vehicleId = (btn as HTMLElement).getAttribute('data-vehicle') || 'innova';
      const vehicle = vehicleData[vehicleId];

      // Update form vehicle
      const vehicleInput = document.getElementById('fleet-vehicle-input') as HTMLInputElement;
      if (vehicleInput) vehicleInput.value = vehicle.name;

      // Update display
      const icon = document.getElementById('selected-vehicle-icon');
      const name = document.getElementById('selected-vehicle-name');
      const segment = document.getElementById('selected-vehicle-segment');
      const title = document.getElementById('fleet-booking-vehicle');
      if (icon) icon.textContent = vehicle.icon;
      if (name) name.textContent = vehicle.name;
      if (segment) segment.textContent = vehicle.segment;
      if (title) title.textContent = vehicle.name;

      // Open form
      const form = document.getElementById('fleet-booking');
      form?.classList.add('open');
      form?.setAttribute('aria-hidden', 'false');

      // Smooth scroll to form
      setTimeout(() => {
        form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);

      // Render Turnstile if needed
      // @ts-ignore
      if (window.turnstile) {
        const container = document.querySelector('.fleet-turnstile') as HTMLElement;
        if (container && !container.hasChildNodes()) {
          // @ts-ignore
          window.turnstile.render(container, {
            sitekey: container.getAttribute('data-sitekey'),
            size: 'flexible',
          });
        }
      }
    });
  });

  // Close form
  document.getElementById('fleet-booking-close')?.addEventListener('click', () => {
    const form = document.getElementById('fleet-booking');
    form?.classList.remove('open');
    form?.setAttribute('aria-hidden', 'true');
  });

  // Form submission
  const fleetForm = document.getElementById('fleet-booking-form') as HTMLFormElement;
  fleetForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = fleetForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (!fleetForm.checkValidity()) { fleetForm.reportValidity(); return; }

    const fd = new FormData(fleetForm);
    const token = (fd.get('cf-turnstile-response') || '').toString();
    if (!token) {
      btn.textContent = 'Complete security check first';
      setTimeout(() => btn.textContent = 'Confirm Booking →', 3000);
      return;
    }

    const payload: Record<string, string> = {};
    fd.forEach((v, k) => { payload[k] = v.toString(); });
    payload.turnstile_token = token;

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong.');

      btn.textContent = '✓ Booking Confirmed!';
      btn.style.background = 'var(--whatsapp)';
      fleetForm.reset();
      // @ts-ignore
      if (window.turnstile) window.turnstile.reset();

      setTimeout(() => {
        btn.textContent = 'Confirm Booking →';
        btn.style.background = '';
        btn.disabled = false;
        document.getElementById('fleet-booking')?.classList.remove('open');
      }, 4000);

    } catch {
      btn.textContent = 'Failed — try WhatsApp';
      btn.style.background = 'var(--saffron)';
      btn.disabled = false;
      setTimeout(() => {
        btn.textContent = 'Confirm Booking →';
        btn.style.background = '';
      }, 3000);
    }
  });
</script>
