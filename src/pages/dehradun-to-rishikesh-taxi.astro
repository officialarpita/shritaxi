---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import RelatedRoutes from '../components/RelatedRoutes.astro';
import { fleet } from '../data/fleet';
import { Image } from 'astro:assets';
import RishikeshImg  from '../assets/images/Hrisikesh1.jpeg';
import Rishikesh2Img from '../assets/images/Hrisikesh2.jpeg';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const faqs = [
  { q: 'What is the taxi fare from Dehradun to Rishikesh?', a: 'The taxi fare from Dehradun to Rishikesh starts at ₹2,000 for Sedan one way. Round trip is ₹3,500. All prices are fixed and all inclusive.' },
  { q: 'How far is Rishikesh from Dehradun?', a: 'Rishikesh is 46 km from Dehradun. The journey takes approximately 1 hour 15 minutes by taxi.' },
  { q: 'Can I go for rafting in Rishikesh on a day trip from Dehradun?', a: 'Absolutely! Many travellers do a Rishikesh day trip from Dehradun for river rafting at Shivpuri, visiting Laxman Jhula and Ram Jhula, and exploring the ashrams.' },
  { q: 'What is the best vehicle for Dehradun to Rishikesh?', a: 'A Sedan is perfect for couples or small groups. For larger families or groups wanting more comfort on the way to adventure activities, Ertiga or Innova Crysta is recommended.' },
  { q: 'Can I book Rishikesh + Haridwar same day from Dehradun?', a: 'Yes! Our special Haridwar + Rishikesh combo trip covers both cities in one day starting at ₹3,499 for Sedan. Both cities are just 24 km apart.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: 'Shri Taxi — Dehradun to Rishikesh',
  description: 'Fixed price taxi from Dehradun to Rishikesh starting ₹2,000. All inclusive, experienced drivers.',
  url: 'https://shritaxi.com/dehradun-to-rishikesh-taxi',
  telephone: phone,
  offers: { '@type': 'Offer', name: 'Dehradun to Rishikesh Taxi', price: '2000', priceCurrency: 'INR' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Dehradun to Rishikesh Taxi | ₹2,000 One Way | ₹3,500 Round Trip | Shri Taxi"
  description="Book taxi from Dehradun to Rishikesh at ₹2,000 one way or ₹3,500 round trip. Fixed price, all inclusive. Rafting, Laxman Jhula, Beatles Ashram. 24/7 available."
  canonicalUrl="https://shritaxi.com/dehradun-to-rishikesh-taxi"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/dehradun-to-rishikesh-taxi" />

  <main id="main-content">

    <section class="loc-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> › <a href="/cab-services">Cab Services</a> › <span>Dehradun to Rishikesh Taxi</span>
        </nav>
        <h1 class="loc-title">Taxi from Dehradun to Rishikesh</h1>
        <p class="loc-sub">Fixed price · All inclusive · Adventure capital of India · 24/7 available</p>

        <div class="price-cards">
          <div class="price-card price-card--primary">
            <div class="price-card-label">One Way</div>
            <div class="price-card-amount">₹2,000</div>
            <div class="price-card-note">Starting price · All inclusive</div>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20taxi%20from%20Dehradun%20to%20Rishikesh`} target="_blank" rel="noopener" class="btn btn-whatsapp">Book Now</a>
          </div>
          <div class="price-card">
            <div class="price-card-label">Round Trip</div>
            <div class="price-card-amount">₹3,500</div>
            <div class="price-card-note">Starting price · All inclusive</div>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20round%20trip%20Dehradun%20to%20Rishikesh`} target="_blank" rel="noopener" class="btn btn-teal">Book Now</a>
          </div>
          <div class="price-card price-card--special">
            <div class="price-card-label">🔥 Combo Deal</div>
            <div class="price-card-amount">₹3,499</div>
            <div class="price-card-note">Haridwar + Rishikesh same day · Sedan</div>
            <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20Haridwar%20%2B%20Rishikesh%20same%20day%20combo`} target="_blank" rel="noopener" class="btn btn-saffron">Book Combo</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="section-title">Dehradun to Rishikesh Taxi Fare by Vehicle</h2>
        <p class="section-sub">All prices fixed and all inclusive — toll, parking and driver charges included</p>
        <div class="fleet-table">
          <div class="fleet-table-head">
            <span>Vehicle</span><span>Seats</span><span>One Way</span><span>Round Trip</span><span>Book</span>
          </div>
          {[
            { ...fleet[0], oneWay: '₹2,000', rt: '₹3,500' },
            { ...fleet[1], oneWay: '₹2,400', rt: '₹4,200' },
            { ...fleet[2], oneWay: '₹3,000', rt: '₹5,200' },
            { ...fleet[3], oneWay: '₹4,500', rt: '₹8,000' },
          ].map(v => (
            <div class="fleet-table-row">
              <div class="fleet-vehicle-info">
                <span class="fleet-icon">{v.icon}</span>
                <div><strong>{v.name}</strong><span class="fleet-segment">{v.segment}</span></div>
              </div>
              <span>{v.seats}+1</span>
              <span class="fleet-price">{v.oneWay}*</span>
              <span class="fleet-price">{v.rt}*</span>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20${encodeURIComponent(v.name)}%20from%20Dehradun%20to%20Rishikesh`} target="_blank" rel="noopener" class="btn btn-teal btn-sm">Book</a>
            </div>
          ))}
          <p class="fleet-table-note">* Starting prices · All inclusive · Prices may vary by date</p>
        </div>
      </div>
    </section>

    <section class="section section--mint">
      <div class="container loc-content">
        <div class="loc-text">
          <h2>Dehradun to Rishikesh — Adventure & Spirituality Guide</h2>
          <p>Rishikesh, known as the "Yoga Capital of the World" and "Adventure Capital of India", is a must-visit destination just 46 km from Dehradun. Situated at the foothills of the Himalayas where the holy Ganges descends from the mountains, Rishikesh offers a unique blend of spirituality, adventure and natural beauty.</p>

          <h3>Top Attractions in Rishikesh</h3>
          <ul>
            <li><strong>Laxman Jhula</strong> — Iconic suspension bridge over the Ganges, 5 km from town</li>
            <li><strong>Ram Jhula</strong> — Another famous hanging bridge connecting the two banks</li>
            <li><strong>River Rafting at Shivpuri</strong> — White water rafting on the Ganges, 16 km from Rishikesh</li>
            <li><strong>Beatles Ashram (Chaurasi Kutia)</strong> — Where The Beatles stayed in 1968 and wrote famous songs</li>
            <li><strong>Triveni Ghat</strong> — Sacred bathing ghat with evening Ganga Aarti</li>
            <li><strong>Rajaji National Park</strong> — Wildlife sanctuary nearby for elephant and tiger sightings</li>
          </ul>

          <h3>Haridwar + Rishikesh Same Day Trip from Dehradun</h3>
          <p>The most popular day trip from Dehradun covers both Haridwar and Rishikesh. Since the two cities are just 24 km apart, you can visit Haridwar's Har Ki Pauri in the morning, then explore Rishikesh's Laxman Jhula and ashrams in the afternoon. Our special combo starts at ₹3,499 for Sedan — all inclusive.</p>

          <h3>Best Time to Visit Rishikesh</h3>
          <p>Rishikesh is pleasant year-round. February to May is ideal for river rafting before monsoon raises water levels. September to November offers great weather post-monsoon. The International Yoga Festival in March draws yoga practitioners worldwide.</p>
        </div>
        <div class="loc-image">
          <Image src={RishikeshImg} alt="Rishikesh taxi from Dehradun Laxman Jhula" width={500} height={350} widths={[380, 500, 900]}
            sizes="(max-width: 640px) 380px, (max-width: 1024px) 500px, 900px" format="webp" class="loc-img" loading="lazy" />
          <Image src={Rishikesh2Img} alt="Dehradun to Rishikesh cab service" width={500} height={350} widths={[380, 500, 900]}
            sizes="(max-width: 640px) 380px, (max-width: 1024px) 500px, 900px" format="webp" class="loc-img" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item" name="rishikesh-faq">
              <summary class="faq-q">{f.q}<svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section loc-cta">
      <div class="container loc-cta-inner">
        <div>
          <h2>Book Dehradun to Rishikesh Taxi Today</h2>
          <p>Fixed price · Confirmed in minutes · Adventure awaits!</p>
        </div>
        <div class="loc-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-call">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20taxi%20Dehradun%20to%20Rishikesh`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Now</a>
          <a href="/#booking" class="btn btn-teal">Book Online →</a>
        </div>
      </div>
    </section>


    <!-- Cross-sell Delhi banner -->
    <div class="delhi-crosssell">
      <div class="container delhi-crosssell-inner">
        <span class="delhi-crosssell-icon">🏙️</span>
        <div>
          <strong>Travelling from Delhi or Chandigarh?</strong>
          <p>We cover all Uttarakhand routes from Delhi NCR & Chandigarh at fixed prices.</p>
        </div>
        <a href="/packages#multi-dest-packages" class="btn btn-call delhi-crosssell-btn">View Delhi Packages →</a>
      </div>
    </div>

    <RelatedRoutes currentPage="/dehradun-to-rishikesh-taxi" />

  </main>

  <Footer />
  <StickyBar />
</Base>

<style>
.loc-hero { background: linear-gradient(135deg, #0d9488, #0f766e); padding: 48px 0 40px; }
.breadcrumb { font-size: 12px; color: rgba(255,255,255,0.65); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.loc-title { font-size: clamp(24px, 4vw, 40px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 8px; }
.loc-sub { font-size: 14px; color: rgba(255,255,255,0.8); margin-bottom: 28px; }
.price-cards { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
.price-card { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); border-radius: var(--radius-lg); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
.price-card--primary { background: rgba(255,255,255,0.2); border-color: var(--saffron); }
.price-card--special { background: rgba(251,146,60,0.2); border-color: var(--saffron); }
.price-card-label { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px; }
.price-card-amount { font-size: 32px; font-weight: 800; color: #fff; font-family: 'Playfair Display', serif; line-height: 1; }
.price-card-note { font-size: 11px; color: rgba(255,255,255,0.6); }
.btn-saffron { background: var(--saffron); color: #fff; padding: 10px 20px; border-radius: var(--radius-md); font-weight: 600; font-size: 14px; text-decoration: none; text-align: center; }
.fleet-table { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
.fleet-table-head { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; background: var(--teal); color: #fff; padding: 12px 20px; font-size: 13px; font-weight: 600; }
.fleet-table-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; padding: 14px 20px; border-bottom: 1px solid var(--border); align-items: center; transition: background 0.15s; }
.fleet-table-row:last-of-type { border-bottom: none; }
.fleet-table-row:hover { background: var(--mint); }
.fleet-vehicle-info { display: flex; align-items: center; gap: 10px; }
.fleet-icon { font-size: 24px; }
.fleet-vehicle-info strong { display: block; font-size: 14px; color: var(--slate); }
.fleet-segment { font-size: 11px; color: var(--muted); }
.fleet-price { font-size: 15px; font-weight: 700; color: var(--teal); }
.btn-sm { padding: 8px 14px; font-size: 12px; }
.fleet-table-note { padding: 10px 20px; font-size: 11px; color: var(--muted); background: var(--mint); }
.loc-content { display: grid; grid-template-columns: 1fr 400px; gap: 48px; align-items: start; }
.loc-text h2 { font-size: 24px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 14px; }
.loc-text h3 { font-size: 18px; font-weight: 600; color: var(--teal); margin: 20px 0 8px; }
.loc-text p { font-size: 14px; color: var(--muted); line-height: 1.75; margin-bottom: 12px; }
.loc-text ul { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.loc-text li { font-size: 14px; color: var(--muted); padding-left: 8px; }
.loc-image { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 80px; }
.loc-img { width: 100%; border-radius: var(--radius-lg); object-fit: cover; }
.faq-list { display: flex; flex-direction: column; max-width: 800px; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-child { border-top: 1px solid var(--border); }
.faq-q { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; cursor: pointer; font-size: 15px; font-weight: 600; color: var(--slate); list-style: none; }
.faq-q::-webkit-details-marker { display: none; }
.faq-chevron { flex-shrink: 0; color: var(--muted); transition: transform 0.2s; }
details[open] .faq-chevron { transform: rotate(180deg); color: var(--teal); }
details[open] .faq-q { color: var(--teal); }
.faq-a { font-size: 14px; color: var(--muted); line-height: 1.7; padding-bottom: 16px; }
.loc-cta { background: var(--teal); }
.loc-cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
.loc-cta h2 { font-size: 24px; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 6px; }
.loc-cta p { font-size: 14px; color: rgba(255,255,255,0.75); }
.loc-cta-btns { display: flex; gap: 10px; flex-wrap: wrap; }
@media (max-width: 900px) {
  .price-cards { grid-template-columns: 1fr 1fr; }
  .loc-content { grid-template-columns: 1fr; }
  .loc-image { position: static; }
}
@media (max-width: 600px) {
  .price-cards { grid-template-columns: 1fr; }
  .fleet-table-head, .fleet-table-row { grid-template-columns: 2fr 1fr 1fr; }
  .fleet-table-head span:nth-child(4), .fleet-table-head span:nth-child(5), .fleet-table-row span:nth-child(4), .fleet-table-row a { display: none; }
  .loc-cta-inner { flex-direction: column; }
  .loc-cta-btns { width: 100%; flex-direction: column; }
  .loc-cta-btns .btn { justify-content: center; }
}

.delhi-crosssell {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-top: 2px solid var(--saffron);
  border-bottom: 2px solid var(--saffron);
  padding: 16px 0;
}
.delhi-crosssell-inner {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.delhi-crosssell-icon { font-size: 28px; flex-shrink: 0; }
.delhi-crosssell-inner strong { font-size: 15px; color: var(--slate); display: block; margin-bottom: 2px; }
.delhi-crosssell-inner p { font-size: 13px; color: var(--muted); margin: 0; }
.delhi-crosssell-btn { margin-left: auto; white-space: nowrap; flex-shrink: 0; }
@media (max-width: 600px) {
  .delhi-crosssell-inner { flex-direction: column; align-items: flex-start; }
  .delhi-crosssell-btn { margin-left: 0; width: 100%; justify-content: center; }
}

</style>
