---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { transfers } from '../data/pricing';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const dehradunRoutes = transfers.filter(t => t.group === 'dehradun');
const delhiRoutes    = transfers.filter(t => t.group === 'delhi');
const chandigarhRoutes = transfers.filter(t => t.group === 'chandigarh');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What are the most popular taxi routes from Dehradun?', acceptedAnswer: { '@type': 'Answer', text: 'Most popular routes from Dehradun: Airport (₹1,000), Mussoorie (₹1,500), Haridwar (₹2,000), Rishikesh (₹2,000), Delhi (₹3,500). All fixed price, all inclusive.' } },
    { '@type': 'Question', name: 'What is the taxi fare from Delhi to Dehradun?', acceptedAnswer: { '@type': 'Answer', text: 'Delhi to Dehradun taxi fare is ₹3,500 fixed price for Sedan. Ertiga ₹4,500, Innova Crysta ₹5,670. All inclusive — driver, fuel, toll, parking. Available 24/7.' } },
    { '@type': 'Question', name: 'Does Shri Taxi operate from Chandigarh?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Chandigarh to Dehradun taxi is ₹3,500 fixed price — same as Delhi NCR rate. Available 24/7, all inclusive.' } },
  ],
};
---

<Base
  title="Popular Taxi Routes in Uttarakhand | Dehradun, Delhi & Chandigarh | Shri Taxi"
  description="Popular taxi routes — Airport ₹1,000 · Mussoorie ₹1,500 · Haridwar ₹2,000 · Delhi to Dehradun ₹3,500. Fixed price, all inclusive, 24/7."
  canonicalUrl="https://shritaxi.com/popular-routes"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <TopBar />
  <SeasonBanner />
  <Header currentPath="/popular-routes" />

  <main id="main-content">

    <section class="routes-hero">
      <div class="container">
        <nav class="breadcrumb"><a href="/">Home</a> › <span>Popular Routes</span></nav>
        <h1 class="routes-hero-title">Popular Taxi Routes</h1>
        <p class="routes-hero-sub">Fixed price cab service from Dehradun, Delhi NCR & Chandigarh — all inclusive, no hidden costs, 24/7</p>
        <div class="trust-pills">
          <span class="trust-pill">⭐ 4.9 Rating</span>
          <span class="trust-pill">✓ No Hidden Costs</span>
          <span class="trust-pill">🏔️ Pahadi Drivers</span>
          <span class="trust-pill">📞 24/7 Available</span>
        </div>
      </div>
    </section>

    <!-- AEO Block -->
    <section class="aeo-block">
      <div class="container">
        <p class="aeo-answer">Shri Taxi operates popular taxi routes across Uttarakhand from Dehradun, Delhi NCR and Chandigarh. Airport transfer starts at ₹1,000, Mussoorie at ₹1,500, Haridwar and Rishikesh at ₹2,000, Delhi to Dehradun at ₹3,500. All prices fixed, all inclusive — driver, fuel, toll and parking. Available 24/7.</p>
      </div>
    </section>

    <!-- Tab Selector -->
    <section class="section">
      <div class="container">
        <div class="route-tabs">
          <button class="route-tab route-tab--active" data-tab="dehradun">📍 From Dehradun</button>
          <button class="route-tab" data-tab="delhi">🏙️ From Delhi NCR</button>
          <button class="route-tab" data-tab="chandigarh">🏔️ From Chandigarh</button>
        </div>

        <!-- Dehradun Routes -->
        <div class="route-tab-content" id="tab-dehradun">
          <div class="routes-table">
            <div class="routes-table-head">
              <span>Route</span>
              <span>Distance</span>
              <span>Duration</span>
              <span>Sedan</span>
              <span>Innova</span>
              <span>Action</span>
            </div>
            {dehradunRoutes.map(r => (
              <div class="routes-table-row">
                <div class="routes-table-route">
                  <a href={`/routes/${r.id}`} class="route-link">{r.from} → {r.to}</a>
                  <span class="route-table-tag">{r.tag}</span>
                </div>
                <span class="route-table-val">{r.distance}</span>
                <span class="route-table-val">{r.duration}</span>
                <span class="route-table-price">₹{r.oneWay.toLocaleString('en-IN')}</span>
                <span class="route-table-price">₹{Math.round(r.oneWay * 1.62).toLocaleString('en-IN')}</span>
                <a href={`/routes/${r.id}`} class="btn btn-teal btn-sm">View →</a>
              </div>
            ))}
            <!-- Jim Corbett package route from Dehradun -->
            <div class="routes-table-row">
              <div class="routes-table-route">
                <a href="/packages/jim-corbett-3d" class="route-link">Dehradun → Jim Corbett</a>
                <span class="route-table-tag">Wildlife</span>
              </div>
              <span class="route-table-val">185 km</span>
              <span class="route-table-val">4-5 hrs</span>
              <span class="route-table-price">₹10,799</span>
              <span class="route-table-price">₹16,999</span>
              <a href="/packages/jim-corbett-3d" class="btn btn-teal btn-sm">View →</a>
            </div>
            <div class="routes-table-row">
              <div class="routes-table-route">
                <a href="/packages/nainital-corbett" class="route-link">Dehradun → Nainital &amp; Jim Corbett</a>
                <span class="route-table-tag">Wildlife + Hills</span>
              </div>
              <span class="route-table-val">293 km</span>
              <span class="route-table-val">6-7 hrs</span>
              <span class="route-table-price">₹17,999</span>
              <span class="route-table-price">₹28,999</span>
              <a href="/packages/nainital-corbett" class="btn btn-teal btn-sm">View →</a>
            </div>
          </div>
        </div>

        <!-- Delhi Routes -->
        <div class="route-tab-content" id="tab-delhi" style="display:none">
          <div class="routes-table">
            <div class="routes-table-head">
              <span>Route</span>
              <span>Distance</span>
              <span>Duration</span>
              <span>Sedan</span>
              <span>Innova</span>
              <span>Action</span>
            </div>
            {delhiRoutes.map(r => (
              <div class="routes-table-row">
                <div class="routes-table-route">
                  <a href={`/routes/${r.id}`} class="route-link">{r.from} → {r.to}</a>
                  <span class="route-table-tag">{r.tag}</span>
                </div>
                <span class="route-table-val">{r.distance}</span>
                <span class="route-table-val">{r.duration}</span>
                <span class="route-table-price">₹{r.oneWay.toLocaleString('en-IN')}</span>
                <span class="route-table-price">₹{Math.round(r.oneWay * 1.62).toLocaleString('en-IN')}</span>
                <a href={`/routes/${r.id}`} class="btn btn-teal btn-sm">View →</a>
              </div>
            ))}
            <!-- Multi-day package routes from Delhi -->
            <div class="routes-table-row">
              <div class="routes-table-route">
                <a href="/packages/nainital" class="route-link">Delhi NCR → Nainital</a>
                <span class="route-table-tag">Hill Station</span>
              </div>
              <span class="route-table-val">293 km</span>
              <span class="route-table-val">6-7 hrs</span>
              <span class="route-table-price">₹10,999</span>
              <span class="route-table-price">₹17,999</span>
              <a href="/packages/nainital" class="btn btn-teal btn-sm">View →</a>
            </div>
            <div class="routes-table-row">
              <div class="routes-table-route">
                <a href="/packages/jim-corbett-3d" class="route-link">Delhi NCR → Jim Corbett</a>
                <span class="route-table-tag">Wildlife</span>
              </div>
              <span class="route-table-val">240 km</span>
              <span class="route-table-val">5-6 hrs</span>
              <span class="route-table-price">₹10,799</span>
              <span class="route-table-price">₹16,999</span>
              <a href="/packages/jim-corbett-3d" class="btn btn-teal btn-sm">View →</a>
            </div>
            <div class="routes-table-row">
              <div class="routes-table-route">
                <a href="/packages/nainital-corbett" class="route-link">Delhi NCR → Nainital &amp; Jim Corbett</a>
                <span class="route-table-tag">Wildlife + Hills</span>
              </div>
              <span class="route-table-val">293 km</span>
              <span class="route-table-val">6-7 hrs</span>
              <span class="route-table-price">₹17,999</span>
              <span class="route-table-price">₹28,999</span>
              <a href="/packages/nainital-corbett" class="btn btn-teal btn-sm">View →</a>
            </div>
          </div>
        </div>

        <!-- Chandigarh Routes -->
        <div class="route-tab-content" id="tab-chandigarh" style="display:none">
          <div class="routes-table">
            <div class="routes-table-head">
              <span>Route</span>
              <span>Distance</span>
              <span>Duration</span>
              <span>Sedan</span>
              <span>Innova</span>
              <span>Action</span>
            </div>
            {chandigarhRoutes.map(r => (
              <div class="routes-table-row">
                <div class="routes-table-route">
                  <a href={`/routes/${r.id}`} class="route-link">{r.from} → {r.to}</a>
                  <span class="route-table-tag">{r.tag}</span>
                </div>
                <span class="route-table-val">{r.distance}</span>
                <span class="route-table-val">{r.duration}</span>
                <span class="route-table-price">₹{r.oneWay.toLocaleString('en-IN')}</span>
                <span class="route-table-price">₹{Math.round(r.oneWay * 1.62).toLocaleString('en-IN')}</span>
                <a href={`/routes/${r.id}`} class="btn btn-teal btn-sm">View →</a>
              </div>
            ))}
          </div>
        </div>

        <p class="routes-note">✓ All prices are fixed and all inclusive — driver, fuel, toll & parking. No hidden costs.</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="section routes-cta">
      <div class="container routes-cta-inner">
        <div>
          <h2>Book Any Route Now</h2>
          <p>Fixed price · Instant confirmation · 24/7 available</p>
        </div>
        <div class="routes-cta-btns">
          <a href={`tel:${phone}`} class="btn btn-saffron">📞 {phone}</a>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20want%20to%20book%20a%20cab`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <StickyBar />
</Base>

<style>
.routes-hero { background: linear-gradient(135deg, #1e3a5f, #0d9488); padding: 48px 0 36px; }
.routes-hero-title { font-size: clamp(28px, 4vw, 42px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 10px; }
.routes-hero-sub { font-size: 16px; color: rgba(255,255,255,0.8); margin-bottom: 20px; max-width: 600px; }
.aeo-block { background: var(--mint); border-top: 3px solid var(--teal); padding: 20px 0; }
.aeo-answer { font-size: 16px; color: var(--slate); line-height: 1.75; max-width: 900px; }

.route-tabs { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
.route-tab { padding: 10px 20px; border: 2px solid var(--border); background: #fff; border-radius: 30px; font-size: 14px; font-weight: 600; color: var(--slate); cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.15s; }
.route-tab:hover { border-color: var(--teal); color: var(--teal); }
.route-tab--active { background: var(--teal); border-color: var(--teal); color: #fff; }

.routes-table { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
.routes-table-head { display: grid; grid-template-columns: 2fr 1fr 1.2fr 0.8fr 0.8fr 0.8fr; padding: 12px 16px; background: var(--teal); color: #fff; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
.routes-table-row { display: grid; grid-template-columns: 2fr 1fr 1.2fr 0.8fr 0.8fr 0.8fr; padding: 14px 16px; border-top: 1px solid var(--border); align-items: center; transition: background 0.15s; }
.routes-table-row:hover { background: var(--mint); }
.routes-table-route { display: flex; flex-direction: column; gap: 4px; }
.route-link { font-size: 14px; font-weight: 600; color: var(--teal); transition: color 0.15s; }
.route-link:hover { color: var(--teal-dark); }
.route-table-tag { font-size: 10px; font-weight: 700; color: var(--muted); background: var(--light); padding: 1px 6px; border-radius: 10px; width: fit-content; }
.route-table-val { font-size: 13px; color: var(--muted); }
.route-table-price { font-size: 15px; font-weight: 700; color: var(--teal); font-family: system-ui, -apple-system, sans-serif; }
.routes-note { font-size: 13px; color: var(--teal); margin-top: 12px; font-weight: 500; }

.routes-cta { background: var(--teal); }
.routes-cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
.routes-cta h2 { font-size: 22px; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 6px; }
.routes-cta p { font-size: 14px; color: rgba(255,255,255,0.75); }
.routes-cta-btns { display: flex; gap: 10px; flex-wrap: wrap; }

@media (max-width: 1024px) {
  .routes-table-head, .routes-table-row { grid-template-columns: 2fr 1fr 0.8fr 0.8fr 0.8fr; }
  .routes-table-head span:nth-child(3), .routes-table-row span:nth-child(3) { display: none; }
}
@media (max-width: 640px) {
  .routes-table-head, .routes-table-row { grid-template-columns: 1.8fr 0.8fr 0.8fr 0.7fr; }
  .routes-table-head span:nth-child(3), .routes-table-row span:nth-child(3),
  .routes-table-head span:nth-child(5), .routes-table-row span:nth-child(5) { display: none; }
  .routes-cta-inner { flex-direction: column; }
  .routes-cta-btns { flex-direction: column; width: 100%; }
  .routes-cta-btns .btn { justify-content: center; }
}
</style>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.route-tab');
  const contents = document.querySelectorAll<HTMLElement>('.route-tab-content');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('route-tab--active'));
      tab.classList.add('route-tab--active');
      const id = tab.dataset.tab;
      contents.forEach(c => c.style.display = c.id === `tab-${id}` ? '' : 'none');
    });
  });
</script>
