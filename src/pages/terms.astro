---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Base
  title="Terms of Service | Shri Taxi"
  description="Terms and conditions for using Shri Taxi services."
  canonicalUrl="https://shritaxi.com/terms"
>
  <!-- Override robots for this page only -->
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <TopBar />
  <Header currentPath="/terms" />
  <main id="main-content">
    <section class="section">
      <div class="container" style="max-width:800px;">
        <h1 style="font-family:'Playfair Display',serif;font-size:36px;margin-bottom:8px;">Terms of Service</h1>
        <p style="color:#64748b;margin-bottom:32px;">Last updated: May 2026</p>

        <div class="policy-content">
          <h2>Booking & Confirmation</h2>
          <p>All bookings are confirmed via WhatsApp or phone call. A booking is considered confirmed only after you receive confirmation from our team with driver details.</p>

          <h2>Pricing</h2>
          <p>All prices quoted include driver charges, fuel, toll and parking. Prices are fixed as quoted — no additional charges will be added at the end of your journey unless mutually agreed upon for route changes.</p>

          <h2>Cancellation Policy</h2>
          <p>Cancellations must be communicated via WhatsApp or phone call. Cancellations made more than 24 hours before the trip are eligible for a full refund. Cancellations within 24 hours may be subject to a cancellation fee.</p>

          <h2>Passenger Responsibility</h2>
          <p>Passengers are responsible for their luggage and personal belongings. Shri Taxi is not liable for loss or damage to personal items during the journey.</p>

          <h2>Driver Conduct</h2>
          <p>Our drivers are trained professionals. Any concerns about driver conduct should be reported to us immediately via WhatsApp at +91 6397321825.</p>

          <h2>Contact Us</h2>
          <p>For any queries regarding these terms, contact us at +91 6397321825.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <StickyBar />
</Base>

<style>
.policy-content h2 { font-size: 20px; color: #1e293b; margin: 28px 0 10px; font-family: 'DM Sans', sans-serif; font-weight: 700; }
.policy-content p { font-size: 15px; color: #64748b; line-height: 1.75; margin-bottom: 16px; }
</style>
