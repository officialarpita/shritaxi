---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import RelatedRoutes from '../components/RelatedRoutes.astro';
import { fmt } from '../data/pricing';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE || '+916397321825';
const wa    = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '916397321825';

const vehicles = [
  { name: 'Sedan (Dzire/Baleno)', icon: '🚗', seats: '4+1', oneWay: 41999, roundTrip: 41999 },
  { name: 'Maruti Ertiga',        icon: '🚐', seats: '6+1', oneWay: 50999, roundTrip: 50999 },
  { name: 'Toyota Innova Crysta', icon: '🚙', seats: '6+1', oneWay: 62699, roundTrip: 62699 },
  { name: 'Tempo Traveller',      icon: '🚌', seats: '12+1', oneWay: 86999, roundTrip: 86999 },
];

const faqs = [
  { q: 'What is the Char Dham Yatra taxi fare from Delhi?', a: 'Char Dham Yatra taxi from Delhi starts at ₹41,999 for Sedan (10 days), ₹50,999 for Ertiga, ₹62,699 for Innova Crysta. This includes Delhi pickup and the complete Char Dham circuit.' },
  { q: 'How is Delhi Char Dham different from Dehradun Char Dham?', a: 'Delhi Char Dham package includes Delhi to Dehradun transfer (extra ₹6,000) plus the Char Dham circuit. Dehradun package starts from Dehradun at ₹35,999 for Sedan.' },
  { q: 'Can I be picked up from Delhi Airport for Char Dham?', a: 'Yes, we pick up from IGI Airport, New Delhi Railway Station and all Delhi NCR locations for Char Dham Yatra.' },
  { q: 'How many days for Char Dham Yatra from Delhi?', a: 'Char Dham Yatra from Delhi requires 12 days — 2 extra days compared to Haridwar or Dehradun start, to account for Delhi to Dehradun travel and return. The circuit covers Yamunotri, Gangotri, Kedarnath and Badrinath.' },
  { q: 'Is Char Dham registration mandatory for Delhi pilgrims?', a: 'Yes. Char Dham Yatra registration is compulsory for all pilgrims including those starting from Delhi. Register free at registrationandtouristcare.uk.gov.in before your journey.' },
  { q: 'What is included in Delhi Char Dham taxi package?', a: 'Delhi Char Dham package includes Delhi to Dehradun transfer, complete Char Dham circuit (Yamunotri, Gangotri, Kedarnath, Badrinath), experienced pahadi driver, fuel, toll, parking and driver night allowance. Package starts at ₹41,999 for Sedan (12 days).' },
  { q: 'Can senior citizens do Char Dham Yatra from Delhi?', a: 'Yes. Many senior citizens travel Char Dham from Delhi by taxi. We recommend Innova Crysta for comfort on mountain roads. Health screening is mandatory for pilgrims above 55 years. We advise extra buffer days for rest.' },
  { q: 'Why choose Shri Taxi for Delhi to Char Dham Yatra?', a: 'Shri Taxi has 7+ years of Char Dham Yatra experience, local pahadi drivers who know every mountain route, transparent fixed pricing and 24/7 support. We handle all logistics so you focus on your pilgrimage.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: 'Delhi to Char Dham Yatra Taxi 2026 — Shri Taxi',
  url: 'https://shritaxi.com/delhi-to-char-dham-taxi',
  telephone: phone,
  offers: { '@type': 'Offer', price: '41999', priceCurrency: 'INR' },
};


const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Shri Taxi — Uttarakhand Taxi Service',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '30',
    bestRating: '5',
    worstRating: '1',
  },
  review: [
    {
      '@type': 'Review',
      author: { '@type': 'Person', name: 'Subhash Chaudhary' },
      reviewRating: { '@type': 'Rating', ratingValue: '5' },
      reviewBody: 'Excellent service! Driver was very professional and punctual. Highly recommend Shri Taxi for Uttarakhand travel.',
      datePublished: '2025-11-01',
    },
    {
      '@type': 'Review',
      author: { '@type': 'Person', name: 'Ghanshyam Sharma' },
      reviewRating: { '@type': 'Rating', ratingValue: '5' },
      reviewBody: 'Best cab service for Char Dham Yatra. Driver knew all the routes perfectly. Very comfortable journey.',
      datePublished: '2026-05-09',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Delhi to Char Dham Taxi Package 2026 | ₹41,999 | Shri Taxi"
  description="Book Delhi to Char Dham Yatra taxi 2026 starting ₹41,999 (Sedan, 10 days). Yamunotri, Gangotri, Kedarnath, Badrinath. All inclusive fixed price."
  canonicalUrl="https://shritaxi.com/delhi-to-char-dham-taxi"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewSchema)} slot="head" />

  <TopBar />
  <SeasonBanner />
  <Header currentPath="/delhi-to-char-dham-taxi" />

  <main id="main-content">

    <section class="loc-hero">
      <div class="container">
        <nav class="breadcrumb"><a href="/">Home</a> › <span>Delhi to Char Dham Yatra Taxi 2026</span></nav>
        <h1 class="loc-title">Delhi to Char Dham Yatra Taxi 2026</h1>
        <p class="loc-sub">Complete Char Dham Package from Delhi · Starting ₹41,999</p>
        <p class="loc-desc">Complete Char Dham Yatra from Delhi covering all four sacred shrines — Yamunotri, Gangotri, Kedarnath and Badrinath. Our Delhi Char Dham packages include the Delhi to Dehradun transfer and the complete Uttarakhand circuit.</p>
        <div class="loc-ctas">
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20cab%20from%20Delhi%20NCR%20to%20Char%20Dham`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 Book Now</a>
          <a href={`tel:${phone}`} class="btn btn-call">📞 Call Us</a>
        </div>
      </div>
    </section>

    <div class="loc-strip">
      <div class="container loc-strip-inner">
        <div class="loc-stat"><span class="loc-stat-val">350+ km</span><span class="loc-stat-label">Distance</span></div>
        <div class="loc-stat"><span class="loc-stat-val">7+ hrs to base</span><span class="loc-stat-label">Duration</span></div>
        <div class="loc-stat"><span class="loc-stat-val">₹41,999</span><span class="loc-stat-label">Starting From</span></div>
        <div class="loc-stat"><span class="loc-stat-val">24/7</span><span class="loc-stat-label">Available</span></div>
        <div class="loc-stat"><span class="loc-stat-val">Fixed</span><span class="loc-stat-label">Price</span></div>
      </div>
    </div>

    <section class="section">
      <div class="container">
        <p class="section-label">Fixed Fare</p>
        <h2 class="section-title">Delhi to Char Dham Yatra Taxi 2026 Fare</h2>
        <p class="section-sub">All prices fixed and all inclusive — driver, fuel, toll and parking included</p>
        <div class="pricing-grid">
          {vehicles.map(v => (
            <div class="pricing-card">
              <div class="pricing-icon">{v.icon}</div>
              <h3 class="pricing-vehicle">{v.name}</h3>
              <p class="pricing-seats">{v.seats} seats</p>
              <div class="pricing-prices">
                <div class="pricing-row">
                  <span class="pricing-label">One Way</span>
                  <span class="pricing-val">{fmt(v.oneWay)}</span>
                </div>
                <div class="pricing-row">
                  <span class="pricing-label">Round Trip</span>
                  <span class="pricing-val">{fmt(v.roundTrip)}</span>
                </div>
              </div>
              <p class="pricing-note">✓ All inclusive</p>
              <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20${encodeURIComponent(v.name)}%20from%20Delhi%20NCR%20to%20Char%20Dham`} target="_blank" rel="noopener" class="btn btn-whatsapp pricing-btn">Book Now</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--mint">
      <div class="container loc-about">
        <div>
          <h2>Delhi to Char Dham Yatra Taxi 2026 — Route Guide</h2>
          <p>Complete Char Dham Yatra from Delhi covering all four sacred shrines — Yamunotri, Gangotri, Kedarnath and Badrinath. Our Delhi Char Dham packages include the Delhi to Dehradun transfer and the complete Uttarakhand circuit.</p>
          <h3>Stops on the Way</h3>
          <ul>
            <li>📍 Delhi → Dehradun (Day 1)</li>
            <li>📍 Dehradun → Yamunotri (Day 2-3)</li>
            <li>📍 Gangotri (Day 4-5)</li>
            <li>📍 Kedarnath (Day 6-7)</li>
            <li>📍 Badrinath (Day 8-9)</li>
            <li>📍 Return Delhi (Day 10)</li>
          </ul>
        </div>
        <div class="cta-card">
          <h3>Ready to Book?</h3>
          <p>Get instant confirmation via WhatsApp. Our team responds within 15 minutes.</p>
          <a href={`https://wa.me/${wa}?text=Hi%20Shri%20Taxi%2C%20I%20need%20a%20cab%20from%20Delhi%20NCR%20to%20Char%20Dham`} target="_blank" rel="noopener" class="btn btn-whatsapp">💬 WhatsApp Now</a>
          <a href={`tel:${phone}`} class="btn btn-call" style="margin-top:10px">📞 {phone}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="section-title">Delhi to Char Dham Yatra Taxi 2026 — FAQ</h2>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item" name="faq-delhi-to-char-dham-taxi">
              <summary class="faq-q">{f.q}<svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedRoutes
      currentPage="/delhi-to-char-dham-taxi"
      routes={[
    { title: 'Delhi to Dehradun Taxi',       href: '/delhi-to-dehradun-taxi',     price: '₹3,500', duration: '6 hrs',       tag: 'Outstation'  },
    { title: 'Haridwar to Char Dham Taxi',   href: '/haridwar-to-char-dham-taxi', price: '₹35,999', duration: '10 Days',    tag: 'Pilgrimage'  },
    { title: 'Chandigarh to Dehradun Taxi',  href: '/chandigarh-to-dehradun-taxi',price: '₹3,500', duration: '5 hrs',       tag: 'Outstation'  },
    { title: 'Delhi to Haridwar Taxi',       href: '/delhi-to-haridwar-taxi',     price: '₹3,500', duration: '5 hrs',       tag: 'Spiritual'   },
  ]}
      packages={[
    { title: 'Char Dham Yatra Package',      href: '/char-dham-yatra',            price: '₹35,999', duration: '10 Days',    tag: 'Pilgrimage'  },
    { title: 'Char Dham by Taxi',            href: '/packages/char-dham',         price: '₹35,999', duration: '10 Days',    tag: 'Pilgrimage'  },
  ]}
    />

  </main>
  <Footer />
  <StickyBar />
</Base>

<style>
.loc-hero { background: linear-gradient(135deg, #0d9488, #0f766e); padding: 52px 0 40px; }
.breadcrumb { font-size: 12px; color: rgba(255,255,255,0.65); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.loc-title { font-size: clamp(26px, 4vw, 42px); color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 8px; }
.loc-sub { font-size: 16px; color: var(--saffron); font-weight: 600; margin-bottom: 10px; }
.loc-desc { font-size: 14px; color: rgba(255,255,255,0.8); line-height: 1.7; max-width: 680px; margin-bottom: 24px; }
.loc-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.loc-strip { background: var(--teal-dark); padding: 16px 0; }
.loc-strip-inner { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
.loc-stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.loc-stat-val { font-size: 20px; font-weight: 800; color: #fff; font-family: 'Playfair Display', serif; }
.loc-stat-label { font-size: 11px; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.5px; }
.pricing-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
.pricing-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
.pricing-icon { font-size: 36px; }
.pricing-vehicle { font-size: 14px; font-weight: 700; color: var(--slate); }
.pricing-seats { font-size: 12px; color: var(--muted); }
.pricing-prices { width: 100%; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
.pricing-row { display: flex; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid var(--border); }
.pricing-row:last-child { border-bottom: none; }
.pricing-label { font-size: 12px; color: var(--muted); }
.pricing-val { font-size: 15px; font-weight: 700; color: var(--teal); }
.pricing-note { font-size: 11px; color: var(--teal); font-weight: 500; }
.pricing-btn { width: 100%; justify-content: center; font-size: 13px; margin-top: auto; }
.loc-about { display: grid; grid-template-columns: 1fr 320px; gap: 48px; align-items: start; }
.loc-about h2 { font-size: 24px; font-family: 'Playfair Display', serif; color: var(--slate); margin-bottom: 12px; }
.loc-about h3 { font-size: 17px; font-weight: 600; color: var(--teal); margin: 18px 0 8px; }
.loc-about p { font-size: 14px; color: var(--muted); line-height: 1.75; margin-bottom: 10px; }
.loc-about ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
.loc-about li { font-size: 14px; color: var(--muted); }
.cta-card { background: var(--teal); border-radius: var(--radius-lg); padding: 28px; display: flex; flex-direction: column; gap: 12px; position: sticky; top: 80px; }
.cta-card h3 { font-size: 20px; color: #fff; font-family: 'Playfair Display', serif; }
.cta-card p { font-size: 13px; color: rgba(255,255,255,0.8); line-height: 1.6; }
.faq-list { display: flex; flex-direction: column; max-width: 800px; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-child { border-top: 1px solid var(--border); }
.faq-q { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; cursor: pointer; font-size: 15px; font-weight: 600; color: var(--slate); list-style: none; }
.faq-q::-webkit-details-marker { display: none; }
.faq-chevron { flex-shrink: 0; color: var(--muted); transition: transform 0.2s; }
details[open] .faq-chevron { transform: rotate(180deg); color: var(--teal); }
details[open] .faq-q { color: var(--teal); }
.faq-a { font-size: 14px; color: var(--muted); line-height: 1.7; padding-bottom: 16px; }
@media (max-width: 900px) { .pricing-grid { grid-template-columns: repeat(2, 1fr); } .loc-about { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .loc-strip-inner { gap: 20px; } .loc-ctas { flex-direction: column; } }
</style>
