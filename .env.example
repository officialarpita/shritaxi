# Server-side (set as Cloudflare Pages environment variables — not exposed to the browser)
TELEGRAM_BOT_TOKEN=123456:ABC-telegram-bot-token-from-BotFather
TELEGRAM_CHAT_ID=123456789
TURNSTILE_SECRET_KEY=0x4AAAAAAA...secret
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# Client-side (PUBLIC_ prefix — Astro exposes these to the browser bundle)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...sitekey
PUBLIC_WHATSAPP_NUMBER=+919999999999
PUBLIC_BUSINESS_PHONE=+919999999999
